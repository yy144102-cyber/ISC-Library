;ENDFOLD
SPTP Xp6 WITH $VEL_AXIS[1] = SVEL_JOINT(10.0), $TOOL = STOOL2(Fp6), $BASE = SBASE(Fp6.BASE_NO), $IPO_MODE = SIPO_MODE(Fp6.IPO_FRAME), $LOAD = SLOAD(Fp6.TOOL_NO), $ACC_AXIS[1] = SACC_JOINT(PPDAT1), $APO = SAPO_PTP(PPDAT1), $GEAR_JERK[1] = SGEAR_JERK(PPDAT1), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0) C_Spl
