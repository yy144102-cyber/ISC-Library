GLOBAL DEF ATA_UserCall(UserCallType:IN)
DECL enArcUsrCall_T UserCallType
SWITCH UserCallType
  CASE #MaxIgnErrAbort
    IF ATAu_Test == TRUE THEN
      ArcMsgWrite(,#NOTIFY,"MaxIgnErrAbort - Max ignition errors - Cancel","ATA_User")
    ENDIF
  CASE #MaxWeldErrAbort
    IF ATAu_Test == TRUE THEN
      ArcMsgWrite(,#NOTIFY,"MaxWeldErrAbort - Max seam errors - Cancel","ATA_User")
    ENDIF
  CASE #MaxIgnErrRetry
    IF ATAu_Test == TRUE THEN
      ArcMsgWrite(,#NOTIFY,"MaxIgnErrRetry - Max ignition errors - Retry","ATA_User")
    ENDIF
  CASE #MaxWeldErrRetry
    IF ATAu_Test == TRUE THEN
      ArcMsgWrite(,#NOTIFY,"MaxWeldErrRetry -  Max seam errors - Retry","ATA_User")
    ENDIF
  CASE #AdvErrIgnition
    IF ATAu_Test == TRUE THEN
      ArcMsgWrite(,#NOTIFY,"AdvErrIgnition - Max ignition errors - AdvErrorRecovery","ATA_User")
    ENDIF
  CASE #AdvErrWeld
    IF ATAu_Test == TRUE THEN
      ArcMsgWrite(,#NOTIFY,"AdvErrWeld - Max seam errors - AdvErrorRecovery","ATA_User")
    ENDIF
  CASE #AdvErrSeamRepeat
    IF ATAu_Test == TRUE THEN
      ArcMsgWrite(,#NOTIFY,"AdvErrSeamRepeat - Seam will be repeated - AdvErrorRecovery","ATA_User")
    ENDIF
  CASE #AdvErrSeamSkip
    IF ATAu_Test == TRUE THEN
      ArcMsgWrite(,#NOTIFY,"AdvErrSeamSkip - Seam will be skipped - AdvErrorRecovery","ATA_User")
    ENDIF
ENDSWITCH
END