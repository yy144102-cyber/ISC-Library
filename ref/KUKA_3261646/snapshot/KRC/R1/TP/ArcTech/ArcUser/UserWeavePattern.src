&ACCESS RO2
&REL 2
&COMMENT ArcTech User Pettern Figure
DEF UserWeavePattern( )
;FOLD Figure Kuka Examples
;********************************************************
;No weaving
;********************************************************
;Y  
; 1 |
;   |
;   |
; 0 |# # # # # # # # # 
;   |
;   |
;-1 |
;  - - - - - - - - - - - - - - - > X

;********************************************************
;Triangle
;********************************************************
;y 
; 1 |         #
;   |        # #
;   |       #   #
; 0 |#     #     #
;   | #   #    
;   |  # #
;-1 |   #
;  - - - - - - - - - - - - - - - > X

;********************************************************
;Trapezoid
;********************************************************
;y  
; 1 |             # # #
;   |            #     #
;   |           #       #
; 0 |#         #         #
;   | #       #    
;   |  #     #
;-1 |   # # #
;  - - - - - - - - - - - - - - - > X

;********************************************************
;Asymmetrical trapezoid
;********************************************************
;y  
; 1 |             # # #
;   |            #     #
;   |           #       #
; 0 |#         #         #
;   | #       #    
;   |  #     #
;-1 |   # # #
;  - - - - - - - - - - - - - - - > X

;********************************************************
;Spiral
;********************************************************
;y  
; 1 |
;   |
;   |
; 0 | # # # # # # # # # # #
;   |      #  #      #  #
;   |     #    #    #    #
;-1 |      #  #      #  #
;  - - - - - - - - - - - - - - - > X

;********************************************************
;Double8
;********************************************************
;y  
; 1 |    #  #     #  #
;   |   #    #   #    #
;   |    #  #     #  #
; 0 | # # # # # # # # # # #
;   |        #  #     #  #
;   |       #    #   #    #
;-1 |        #  #     #  #
;  - - - - - - - - - - - - - - - > X
;********************************************************
;On Seam
;********************************************************
;y  
; 1 |   
;   |   
;   |    
; 0 | # <# <# <# <# <# <#
;   |   
;   |   
;-1 |   
;  - - - - - - - - - - - - - - - > X
;ENDFOLD
