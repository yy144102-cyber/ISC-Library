&ACCESS R2
&COMMENT ArcTech
DEF ArcAdaptiveWeldingDiag( )
END
;*************************************************************************
;[GLOBAL Routine] Init Adaptive Welding diagnostic information
;*************************************************************************
GLOBAL DEF AawInitDiag()
DECL INT tI
IF (gAawDiagEnable == 0) THEN
  RETURN
ENDIF
mAawPosDiagStrike  = 1
mAawPosDiagWeld    = 1
mAawPosDiagCrater  = 1
FOR tI = 1 TO mAawArrayWeld
  mAawDiagWeld[tI] = mAawDiagIni
ENDFOR
END
;*************************************************************************
;[GLOBAL Routine] Write Adaptive Welding diagnostic information
;*************************************************************************
GLOBAL DEF AawWriteDiag(tRoutine :IN,tMode :IN, tParam :IN,tCh :IN,tSourceNr :IN,tAdaptiveWelding :IN,tSouceState :IN,tenAawWeaveConst :IN)
DECL BOOL tBool
DECL INT tMode
DECL INT tParam
DECL INT tCh
DECL INT tSourceNr
DECL CHAR tState[11]
DECL stSource_T tSource
DECL enAawSwc_T tRoutine
DECL srAawDiag_T tAawDiag
DECL stAdaptiveWelding_T tAdaptiveWelding
DECL enAawSourceState_T tSouceState
DECL enAawWeaveConst_T tenAawWeaveConst
IF (gAawDiagEnable == 0) THEN
  RETURN
ENDIF
SWITCH tRoutine
  CASE #STRIKE
    IF ((gAawDiagEnable B_AND cAawStrikeEnable) == 0) THEN
      RETURN
    ENDIF
    tenAawWeaveConst = #NONE
  CASE #WELDING
    IF ((gAawDiagEnable B_AND cAawWeldingEnable) == 0) THEN
      RETURN
    ENDIF
    IF (mAawPosDiagWeld >= mAawArrayWeld) THEN
      mAawDiagWeld[mAawArrayWeld].State[]     = "OutOfArray"
      RETURN
    ENDIF
  CASE #CRATER
    IF ((gAawDiagEnable B_AND cAawCraterEnable) == 0) THEN
      RETURN
    ENDIF
    tenAawWeaveConst = #NONE
ENDSWITCH
tState[]     = "NODATA"
SWITCH tSouceState
  CASE #ILF           ;Source Disable valu from ILF
    tState[] = "ILF"
    tSourceNr = 0
  CASE #ILFWEAVEDEACTIV   ;Amplitude or Length ILF Deactive
    tState[] = "ILFWEAVEOFF"
  CASE #PEAK              ;Peak on Source Value
    tState[] = "PEAK"
    tenAawWeaveConst = #None
  CASE #FUNCTION          ;Source Function Enable
    tState[] = "FUNCTION"
  CASE #DEACTIVE          ;Source Out of Function
    IF (mAawActiveAllDiag == FALSE) THEN
      RETURN
    ENDIF
    tState[] = "DEACTIVE"
ENDSWITCH
tAawDiag.State[]          = tState[]
tAawDiag.Mode             = tMode
tAawDiag.Param            = tParam
tAawDiag.Ch               = tCh
tAawDiag.SetName[]        = tAdaptiveWelding.Name[]
tAawDiag.InValue          = tAdaptiveWelding.InValue
tAawDiag.KrlId            = tAdaptiveWelding.KrlId
tAawDiag.WeaveConst       = tenAawWeaveConst
tAawDiag.Filter           = gAawPerCentFilter ;[tAdaptiveWelding.Filter]
tAawDiag.OvAppl           = $OV_APPL
tAawDiag.VelAppl          = $VEL_APPL
tAawDiag.VelAct           = $VEL_ACT
tAawDiag.OnRange          = tAdaptiveWelding.OnRange
tAawDiag.IlfValue         = tAdaptiveWelding.IlfValue
tAawDiag.CalcValue        = tAdaptiveWelding.CalcValue
tAawDiag.OutValue         = tAdaptiveWelding.OutValue
tAawDiag.Source           = tSourceNr
tSource = {FromNum 0.0, ToNum 0.0, LastValue{Val1 0.0,Val2 0.0,Val3 0.0,Val4 0.0,Val5 0.0}}
SWITCH tSourceNr
  CASE 1
    IF (tAdaptiveWelding.Source1.Active == TRUE) THEN
      tSource = AawCheckLastValue(tAdaptiveWelding.Source1)
    ENDIF
  CASE 2
    IF (tAdaptiveWelding.Source2.Active == TRUE) THEN
      tSource = AawCheckLastValue(tAdaptiveWelding.Source2)
    ENDIF
  CASE 3
    IF (tAdaptiveWelding.Source3.Active == TRUE) THEN
      tSource = AawCheckLastValue(tAdaptiveWelding.Source3)
    ENDIF
  CASE 4
    IF (tAdaptiveWelding.Source4.Active == TRUE) THEN
      tSource = AawCheckLastValue(tAdaptiveWelding.Source4)
    ENDIF
  CASE 5
    IF (tAdaptiveWelding.Source5.Active == TRUE) THEN
      tSource = AawCheckLastValue(tAdaptiveWelding.Source5)
    ENDIF
ENDSWITCH
tAawDiag.FromNum                      = tSource.FromNum
tAawDiag.ToNum                        = tSource.ToNum
tAawDiag.LastVal1                     = tSource.LastValue.Val1
tAawDiag.LastVal2                     = tSource.LastValue.Val2
tAawDiag.LastVal3                     = tSource.LastValue.Val3
tAawDiag.LastVal4                     = tSource.LastValue.Val4
tAawDiag.LastVal5                     = tSource.LastValue.Val5
tAawDiag.Distance                     = $DISTANCE
tAawDiag.RobTimer                     = $ROB_TIMER
SWITCH tRoutine
  CASE #STRIKE
    mAawPosDiagStrike                 = 1
    tBool                             = STRCLEAR(mAawDiagStrike[mAawPosDiagStrike].State[])
    tBool                             = STRCLEAR(mAawDiagStrike[mAawPosDiagStrike].SetName[])
    mAawDiagStrike[mAawPosDiagStrike] = tAawDiag
  CASE #WELDING
    tBool                             = STRCLEAR(mAawDiagWeld[mAawPosDiagWeld].State[])
    tBool                             = STRCLEAR(mAawDiagWeld[mAawPosDiagWeld].SetName[])
    mAawDiagWeld[mAawPosDiagWeld]     = tAawDiag
    mAawPosDiagWeld                   = mAawPosDiagWeld + 1
  CASE #CRATER
    mAawPosDiagCrater                 = 1
    tBool                             = STRCLEAR(mAawDiagCrater[mAawPosDiagCrater].State[])
    tBool                             = STRCLEAR(mAawDiagCrater[mAawPosDiagCrater].SetName[])
    mAawDiagCrater[mAawPosDiagCrater] = tAawDiag
ENDSWITCH
END
;*************************************************************************
;[Routine] Show Active WeaveFrequency
;*************************************************************************
DEFFCT CHAR[15] AawWeaveFrequency()
IF ((gAawCFrequencyValue.Velocity.Active == FALSE) AND (gAawCFrequencyValue.Length.Active == FALSE)) THEN
  RETURN "None"
ENDIF
IF ((gAawCFrequencyValue.Velocity.Active == TRUE) AND (gAawCFrequencyValue.Length.Active == FALSE)) THEN
  RETURN "ConstVelocity"
ENDIF
IF ((gAawCFrequencyValue.Velocity.Active == FALSE) AND (gAawCFrequencyValue.Length.Active == TRUE)) THEN
  RETURN "ConstLength"
ENDIF
IF ((gAawCFrequencyValue.Velocity.Active == TRUE) AND (gAawCFrequencyValue.Length.Active == TRUE)) THEN
  RETURN "Overload"
ENDIF
RETURN "???"
ENDFCT
;*************************************************************************
;[Routine] Check Last value
;*************************************************************************
DEFFCT stSource_T AawCheckLastValue(tSource :IN)
DECL stSource_T tSource
DECL stSource_T tReturnSource
  ERR_CLEAR($ERR)
  ON_ERROR_PROCEED
  tReturnSource.FromNum   = tSource.FromNum
    IF ($ERR.NUMBER > 0) THEN
    ERR_CLEAR($ERR)
    tReturnSource.FromNum = -1
  ENDIF
  ON_ERROR_PROCEED
  tReturnSource.ToNum   = tSource.ToNum
    IF ($ERR.NUMBER > 0) THEN
    ERR_CLEAR($ERR)
    tReturnSource.ToNum = -1
  ENDIF
  ON_ERROR_PROCEED
  tReturnSource.LastValue.Val1 =tSource.LastValue.Val1
  IF ($ERR.NUMBER > 0) THEN
    ERR_CLEAR($ERR)
    tReturnSource.LastValue.Val1 = -1
  ENDIF
  ON_ERROR_PROCEED
  tReturnSource.LastValue.Val2 =tSource.LastValue.Val2
  IF ($ERR.NUMBER > 0) THEN
    ERR_CLEAR($ERR)
    tReturnSource.LastValue.Val2 = -1
  ENDIF
  ON_ERROR_PROCEED
  tReturnSource.LastValue.Val3 =tSource.LastValue.Val3
  IF ($ERR.NUMBER > 0) THEN
    ERR_CLEAR($ERR)
    tReturnSource.LastValue.Val3 = -1
  ENDIF
  ON_ERROR_PROCEED
  tReturnSource.LastValue.Val4 =tSource.LastValue.Val4
  IF ($ERR.NUMBER > 0) THEN
    ERR_CLEAR($ERR)
    tReturnSource.LastValue.Val4 = -1
  ENDIF
  ON_ERROR_PROCEED
  tReturnSource.LastValue.Val5 =tSource.LastValue.Val5
  IF ($ERR.NUMBER > 0) THEN
    ERR_CLEAR($ERR)
    tReturnSource.LastValue.Val5 = 1
  ENDIF
  RETURN tReturnSource
ENDFCT
;*************************************************************************
;[Global Routine] Call from Robot Save diagnostic to File
;*************************************************************************
GLOBAL DEF AawDiagSaveToFile()
DECL INT tI
DECL DATE tDate
DECL CHAR tModeOp[8]
DECL CHAR tFilterType[20]
DECL CHAR tStrCh[80]
DECL CHAR tStrHead[227]
DECL CHAR tStrLine[153]
DECL REAL tTimeStamp
DECL srAawDiag_T tAawDiag
IF (gAawDiagEnable == 0) THEN
  gAawDiagSaveToFile = FALSE
  RETURN
ENDIF
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;Set Variable to execute routine
;Save to specific file
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
IF (gAawDiagSaveToFile == FALSE) THEN
  RETURN
ENDIF
IF (enArcCurrentState == #Welding) THEN
  RETURN
ENDIF
tTimeStamp = $ROB_TIMER
tStrLine[] = "**********;**********;**********;**********;**********;**********;**********;**********;**********;**********;**********;**********;**********;**********"
tStrHead[] = "Mode;Param;Ch;Source;Filter;RobTimer;State;SetName;KrlId;WeaveFrequency;VelApplMode;OutValueOnRange;InValue;FromNum;ToNum;IlfValue;CalcValue;OutValue;LastVal1;LastVal2;LastVal3;LastVal4;LastVal5;Distance;OvAppl;VelApplCp;VelAct"
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;Set Maximum number of files
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  AawFileFunc(#NumberOfFiles)
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;Close All file open
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  AawFileFunc(#CloseAllFiles)
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;Make Directory
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  AawFileFunc(#MkDir)
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;Make File
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  AawFileFunc(#OpenFileToWrite)
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;Write to File Robot Information
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  tDate = $DATE
  tModeOp[] = " "
  SWITCH $MODE_OP
    CASE #T1
      tModeOp[] = "T1 "
    CASE #T2
      tModeOp[] = "T2 "
    CASE #AUT
      tModeOp[] = "AUT"
    CASE #EX
      tModeOp[] = "EX "
  ENDSWITCH
  tFilterType[] = " "
  SWITCH gAawFilterType
    CASE #Disabled
      tFilterType[] = "Disabled"
    CASE #AverageSource
      tFilterType[] = "AverageSource"
    CASE #CutSourcePeak
      tFilterType[] = "CutSourcePeak"
  ENDSWITCH  
  AawFileFuncStr(#VarToBuffer3,"%s'h0a'%s%s'h0a'","Adaptive Diagnostic",tStrLine[],tStrLine[])
  AawFileFuncInt(#VarToBuffer6,"Date;%d/%d/%d'h0a'Time;%d:%d:%d'h0a'",tDate.YEAR,tDate.MONTH,tDate.DAY,tDate.HOUR,tDate.MIN,tDate.SEC)
  AawFileFuncStr(#VarToBuffer3,"Robot Type;%s'h0a'Prog;%s'h0a'$MODE_OP;%s'h0a'",$TRAFONAME[],$PROG_INFO[1].SEL_NAME[],tModeOp[])
  AawFileFuncInt(#VarToBuffer4,"$OV_PRO;%d'h0a'$OV_APPL;%d'h0a'$ACT_TOOL;%d'h0a'$ACT_BASE;%d'h0a'",$OV_PRO,$OV_APPL,$ACT_TOOL,$ACT_BASE)
  AawFileFuncStr(#VarToBuffer1,"Filter Type;%s'h0a'",tFilterType[])  
  AawFileFuncStr(#VarToBuffer1,"Motion Type;%s'h0a'",AawMotionEnumToStr(stArcCallState.MoveType))
  AawFileFuncStr(#VarToBuffer2,"%s%s'h0a'",tStrLine[],tStrLine[])
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;Write Strike Information
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  IF ((gAawDiagEnable B_AND cAawStrikeEnable) <> 0) THEN
    AawFileFuncStr(#VarToBuffer4,"%s'h0a'%s%s'h0a'%s'h0a'","STRIKE",tStrLine[],tStrLine[],tStrHead[])
    AawDiagnostic(mAawDiagStrike[1])
  ENDIF
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;Write Welding Information
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  IF ((gAawDiagEnable B_AND cAawWeldingEnable) <> 0) THEN
    AawFileFuncStr(#VarToBuffer4,"%s'h0a'%s%s'h0a'%s'h0a'","WELDING",tStrLine[],tStrLine[],tStrHead[])
    FOR tI = 1 TO (mAawPosDiagWeld - 1)
      AawDiagnostic(mAawDiagWeld[tI])
    ENDFOR
  ENDIF
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;Write Crater Information
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  IF ((gAawDiagEnable B_AND cAawCraterEnable) <> 0) THEN
    AawFileFuncStr(#VarToBuffer4,"%s'h0a'%s%s'h0a'%s'h0a'","CRATER",tStrLine[],tStrLine[],tStrHead[])
    AawDiagnostic(mAawDiagCrater[1])
  ENDIF
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;Close File
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  tTimeStamp = $ROB_TIMER - tTimeStamp
  AawFileFuncInt(#VarToBuffer1,"'h0a'TimeStamp;%d",tTimeStamp)
  AawFileFunc(#BufferToFile)
  AawFileFunc(#CloseFile)
  gAawDiagSaveToFile = FALSE
END
;*************************************************************************
;[Routine] Get Diagnostic
;*************************************************************************
DEF AawDiagnostic(tAawDiag :IN)
DECL srAawDiag_T tAawDiag
  AawFileFuncInt(#VarToBuffer6,"%d;%d;%d;%d;%d;%d;",tAawDiag.Mode,tAawDiag.Param,tAawDiag.Ch,tAawDiag.Source,tAawDiag.Filter,tAawDiag.RobTimer)
  AawFileFuncStr(#VarToBuffer6,"%s;%s;%s;%s;%s;%s;",tAawDiag.State[],tAawDiag.SetName[],AawChEnumToStr(tAawDiag.KrlId),AawChWeaveEnumToStr(tAawDiag.WeaveConst),AawSwOnOffEnumToStr(tAawDiag.VelAppl.Mode),AawRangeNumToStr(tAawDiag.OnRange))
  AawFileFuncReal(#VarToBuffer6,"%f;%f;%f;%f;%f;%f;",tAawDiag.InValue,tAawDiag.FromNum,tAawDiag.ToNum,tAawDiag.IlfValue,tAawDiag.CalcValue,tAawDiag.OutValue)
  AawFileFuncReal(#VarToBuffer7,"%f;%f;%f;%f;%f;%f;%f;",tAawDiag.LastVal1,tAawDiag.LastVal2,tAawDiag.LastVal3,tAawDiag.LastVal4,tAawDiag.LastVal5,tAawDiag.Distance,tAawDiag.OvAppl)    
  AawFileFuncReal(#VarToBuffer2,"%f;%f'h0a'",tAawDiag.VelAppl.CP,tAawDiag.VelAct)
END
;*************************************************************************
;[Routine] File Function
;*************************************************************************
DEF AawFileFunc(tFileFunc :IN,tStr[] :IN)
DECL BOOL tBool
DECL INT tOffset
DECL CHAR tStr[]
DECL enFileFunc_T tFileFunc
  mMode = #SYNC
  SWITCH tFileFunc
    CASE #NumberOfFiles
      IF (mActDiagFiles < 1) THEN
       mActDiagFiles = 1
      ENDIF 
      IF (mActDiagFiles >  cAawMaxDiagFiles) THEN
       mActDiagFiles = 1
      ENDIF 
    CASE #CloseAllFiles
      CWRITE($FCT_CALL, mState, mMode, "krl_fclose_all", -99)
      AawErrorMsg(mState.MSG_NO,"CloseAllFiles")
      mFileHandle = 0
    CASE #MkDir
      CWRITE($FCT_CALL, mState, mMode, "krl_mkdir", mDirName[])
      AawErrorMsg(mState.MSG_NO,"MkDir")
    CASE #OpenFileToWrite
      tOffset = 0
      tBool = STRCLEAR(mPathToFile[])
      SWRITE(mPathToFile[],mState,tOffset,"%s/%s_%d.csv",mDirName[],mFileName[],mActDiagFiles)
      mFileHandle = 0
      CWRITE($FCT_CALL, mState, mMode, "krl_fopen", mPathToFile[],"w",mFileHandle)
      AawErrorMsg(mState.MSG_NO,"OpenFileToWrite")
    CASE #StrToBuffer
      CWRITE($FCT_CALL, mState, mMode, "krl_fputs", mFileHandle, tStr[])
      AawErrorMsg(mState.MSG_NO,"StrToBuffer")
    CASE #NlStrToBuffer
      CWRITE($FCT_CALL, mState, mMode, "krl_fwriteln", mFileHandle, tStr[])
      AawErrorMsg(mState.MSG_NO,"NlStrToBuffer")
    CASE #BufferToFile
      CWRITE($FCT_CALL, mState, mMode, "krl_fflush", mFileHandle)
      AawErrorMsg(mState.MSG_NO,"BufferToFile")
    CASE #CloseFile
      CWRITE($FCT_CALL, mState, mMode, "krl_fclose", mFileHandle)
      ArcMsgWriteS(,#NOTIFY,"SaveDiagFileTo:'h0a'C:\KRC\ROBOTER\UserFiles\%1","AAW",1,Opt_NOVLSTOP_NOLOG,mPathToFile[])
      mActDiagFiles = mActDiagFiles + 1
      AawErrorMsg(mState.MSG_NO,"CloseFile")
  ENDSWITCH
END
;*************************************************************************
;[Routine] Write Integer To Bufer
;*************************************************************************
DEF AawFileFuncInt(tFileFunc :IN,tConvStr[] :IN,tVar1 :IN,tVar2 :IN,tVar3 :IN,tVar4 :IN,tVar5 :IN,tVar6 :IN,tVar7 :IN,tVar8 :IN)
DECL INT tVar1,tVar2,tVar3,tVar4,tVar5,tVar6,tVar7,tVar8
DECL CHAR tConvStr[]
DECL enFileFunc_T tFileFunc
  mMode = #SYNC
  SWITCH tFileFunc
    CASE #VarToBuffer1
      CWRITE($FCT_CALL, mState, mMode, "krl_fprintf", mFileHandle,tConvStr[],tVar1)
      AawErrorMsg(mState.MSG_NO,"IntVar1")
    CASE #VarToBuffer2
      CWRITE($FCT_CALL, mState, mMode, "krl_fprintf", mFileHandle,tConvStr[],tVar1,tVar2)
      AawErrorMsg(mState.MSG_NO,"IntVar2")
    CASE #VarToBuffer3
      CWRITE($FCT_CALL, mState, mMode, "krl_fprintf", mFileHandle,tConvStr[],tVar1,tVar2,tVar3)
      AawErrorMsg(mState.MSG_NO,"IntVar3")
    CASE #VarToBuffer4
      CWRITE($FCT_CALL, mState, mMode, "krl_fprintf", mFileHandle,tConvStr[],tVar1,tVar2,tVar3,tVar4)
      AawErrorMsg(mState.MSG_NO,"IntVar4")
    CASE #VarToBuffer5
      CWRITE($FCT_CALL, mState, mMode, "krl_fprintf", mFileHandle,tConvStr[],tVar1,tVar2,tVar3,tVar4,tVar5)
      AawErrorMsg(mState.MSG_NO,"IntVar5")
    CASE #VarToBuffer6
      CWRITE($FCT_CALL, mState, mMode, "krl_fprintf", mFileHandle,tConvStr[],tVar1,tVar2,tVar3,tVar4,tVar5,tVar6)
      AawErrorMsg(mState.MSG_NO,"IntVar6")
    CASE #VarToBuffer7
      CWRITE($FCT_CALL, mState, mMode, "krl_fprintf", mFileHandle,tConvStr[],tVar1,tVar2,tVar3,tVar4,tVar5,tVar6,tVar7)
      AawErrorMsg(mState.MSG_NO,"IntVar7")
    CASE #VarToBuffer8
      CWRITE($FCT_CALL, mState, mMode, "krl_fprintf", mFileHandle,tConvStr[],tVar1,tVar2,tVar3,tVar4,tVar5,tVar6,tVar7,tVar8)
      AawErrorMsg(mState.MSG_NO,"IntVar8")
  ENDSWITCH
END
;*************************************************************************
;[Routine] Write Real To Bufer
;*************************************************************************
DEF AawFileFuncReal(tFileFunc :IN,tConvStr[] :IN,tVar1 :IN,tVar2 :IN,tVar3 :IN,tVar4 :IN,tVar5 :IN,tVar6 :IN,tVar7 :IN,tVar8 :IN)
DECL REAL tVar1,tVar2,tVar3,tVar4,tVar5,tVar6,tVar7,tVar8
DECL CHAR tConvStr[]
DECL enFileFunc_T tFileFunc
  mMode = #SYNC
  SWITCH tFileFunc
    CASE #VarToBuffer1
      CWRITE($FCT_CALL, mState, mMode, "krl_fprintf", mFileHandle,tConvStr[],tVar1)
      AawErrorMsg(mState.MSG_NO,"RealVar1")
    CASE #VarToBuffer2
      CWRITE($FCT_CALL, mState, mMode, "krl_fprintf", mFileHandle,tConvStr[],tVar1,tVar2)
      AawErrorMsg(mState.MSG_NO,"RealVar2")
    CASE #VarToBuffer3
      CWRITE($FCT_CALL, mState, mMode, "krl_fprintf", mFileHandle,tConvStr[],tVar1,tVar2,tVar3)
      AawErrorMsg(mState.MSG_NO,"RealVar3")
    CASE #VarToBuffer4
      CWRITE($FCT_CALL, mState, mMode, "krl_fprintf", mFileHandle,tConvStr[],tVar1,tVar2,tVar3,tVar4)
      AawErrorMsg(mState.MSG_NO,"RealVar4")
    CASE #VarToBuffer5
      CWRITE($FCT_CALL, mState, mMode, "krl_fprintf", mFileHandle,tConvStr[],tVar1,tVar2,tVar3,tVar4,tVar5)
      AawErrorMsg(mState.MSG_NO,"RealVar5")
    CASE #VarToBuffer6
      CWRITE($FCT_CALL, mState, mMode, "krl_fprintf", mFileHandle,tConvStr[],tVar1,tVar2,tVar3,tVar4,tVar5,tVar6)
      AawErrorMsg(mState.MSG_NO,"RealVar6")
    CASE #VarToBuffer7
      CWRITE($FCT_CALL, mState, mMode, "krl_fprintf", mFileHandle,tConvStr[],tVar1,tVar2,tVar3,tVar4,tVar5,tVar6,tVar7)
      AawErrorMsg(mState.MSG_NO,"RealVar7")
    CASE #VarToBuffer8
      CWRITE($FCT_CALL, mState, mMode, "krl_fprintf", mFileHandle,tConvStr[],tVar1,tVar2,tVar3,tVar4,tVar5,tVar6,tVar7,tVar8)
      AawErrorMsg(mState.MSG_NO,"RealVar8")
  ENDSWITCH
END
;*************************************************************************
;[Routine] Write String To Bufer
;*************************************************************************
DEF AawFileFuncStr(tFileFunc :IN,tConvStr[] :IN,tVar1[] :IN,tVar2[] :IN,tVar3[] :IN,tVar4[] :IN,tVar5[] :IN,tVar6[] :IN,tVar7[] :IN,tVar8[] :IN)
DECL CHAR tVar1[],tVar2[],tVar3[],tVar4[],tVar5[],tVar6[],tVar7[],tVar8[]
DECL CHAR tConvStr[]
DECL enFileFunc_T tFileFunc
  mMode = #SYNC
  SWITCH tFileFunc
    CASE #VarToBuffer1
      CWRITE($FCT_CALL, mState, mMode, "krl_fprintf", mFileHandle,tConvStr[],tVar1[])
      AawErrorMsg(mState.MSG_NO,"StrVar1")
    CASE #VarToBuffer2
      CWRITE($FCT_CALL, mState, mMode, "krl_fprintf", mFileHandle,tConvStr[],tVar1[],tVar2[])
      AawErrorMsg(mState.MSG_NO,"StrVar2")
    CASE #VarToBuffer3
      CWRITE($FCT_CALL, mState, mMode, "krl_fprintf", mFileHandle,tConvStr[],tVar1[],tVar2[],tVar3[])
      AawErrorMsg(mState.MSG_NO,"StrVar3")
    CASE #VarToBuffer4
      CWRITE($FCT_CALL, mState, mMode, "krl_fprintf", mFileHandle,tConvStr[],tVar1[],tVar2[],tVar3[],tVar4[])
      AawErrorMsg(mState.MSG_NO,"StrVar4")
    CASE #VarToBuffer5
      CWRITE($FCT_CALL, mState, mMode, "krl_fprintf", mFileHandle,tConvStr[],tVar1[],tVar2[],tVar3[],tVar4[],tVar5[])
      AawErrorMsg(mState.MSG_NO,"StrVar5")
    CASE #VarToBuffer6
      CWRITE($FCT_CALL, mState, mMode, "krl_fprintf", mFileHandle,tConvStr[],tVar1[],tVar2[],tVar3[],tVar4[],tVar5[],tVar6[])
      AawErrorMsg(mState.MSG_NO,"StrVar6")
    CASE #VarToBuffer7
      CWRITE($FCT_CALL, mState, mMode, "krl_fprintf", mFileHandle,tConvStr[],tVar1[],tVar2[],tVar3[],tVar4[],tVar5[],tVar6[],tVar7[])
      AawErrorMsg(mState.MSG_NO,"StrVar7")
    CASE #VarToBuffer8
      CWRITE($FCT_CALL, mState, mMode, "krl_fprintf", mFileHandle,tConvStr[],tVar1[],tVar2[],tVar3[],tVar4[],tVar5[],tVar6[],tVar7[],tVar8[])
      AawErrorMsg(mState.MSG_NO,"StrVar8")
  ENDSWITCH
END
;*************************************************************************
;[Routine] Convert enAawWeaveConst_T Enum to String
;*************************************************************************
DEFFCT CHAR[14] AawChWeaveEnumToStr(tWeaveConst :IN)
DECL enAawWeaveConst_T tWeaveConst
  SWITCH tWeaveConst
    CASE #None
      RETURN "None"
    CASE #ConstLength
      RETURN "ConstLength"
    CASE #ConstVelocity
      RETURN "ConstVelocity"
    CASE #Overload
      RETURN "Overload"
    CASE #Deactivated
      RETURN "Deactivated"
  ENDSWITCH
RETURN "???"
ENDFCT
;*************************************************************************
;[Routine] Convert SW_ONOFF Enum to String
;*************************************************************************
DEFFCT CHAR[3] AawSwOnOffEnumToStr(tSwOnOff :IN)
DECL SW_ONOFF tSwOnOff
  SWITCH tSwOnOff
    CASE #On
      RETURN "On"
    CASE #Off
      RETURN "Off"
  ENDSWITCH
RETURN "???"
ENDFCT
;*************************************************************************
;[Routine] Convert Enum to String
;*************************************************************************
DEFFCT CHAR[24] AawChEnumToStr(tKrlId :IN)
DECL enKrlId_T tKrlId
  SWITCH tKrlId
    CASE #None
      RETURN "NONE"
    CASE #Channel1
      RETURN "Channel1"
    CASE #Channel2
      RETURN "Channel2"
    CASE #Channel3
      RETURN "Channel3"
    CASE #Channel4
      RETURN "Channel4"
    CASE #Channel5
      RETURN "Channel5"
    CASE #Channel6
      RETURN "Channel6"
    CASE #Channel7
      RETURN "Channel7"
    CASE #Channel8
      RETURN "Channel8"
    CASE #PurgeTime
      RETURN "PurgeTime"
    CASE #StartTime
      RETURN "StartTime"
    CASE #PreFlowTime
      RETURN "PreFlowTime"
    CASE #Velocity
      RETURN "Velocity"
    CASE #Pattern
      RETURN "Pattern"
    CASE #Length
      RETURN "Length"
    CASE #Amplitude
      RETURN "Amplitude"
    CASE #Angle
      RETURN "Angle"
    CASE #CraterTime
      RETURN "CraterTime"
    CASE #PostFlowTime
    RETURN "PostFlowTime"
    CASE #wArcBurnFreeTimePulse
      RETURN "wArcBurnFreeTimePulse"
    CASE #wArcBurnFreeGasFlowTime
      RETURN "wArcBurnFreeGasFlowTime"
    CASE #wArcBurnFreeMaxRetries
      RETURN "wArcBurnFreeMaxRetries"
    CASE #WeaveDelayLeft
      RETURN "WeaveDelayLeft"
    CASE #WeaveDelayRight
      RETURN "WeaveDelayRight"
  ENDSWITCH
RETURN "???"
ENDFCT
;*************************************************************************
;[Routine] Convert Motion Enum to String
;*************************************************************************
DEFFCT CHAR[10] AawMotionEnumToStr(tenArcMoveState :IN)
DECL enArcMoveState_T tenArcMoveState
SWITCH tenArcMoveState
  CASE #Std
    RETURN "Std"
  CASE #SplBlock
    RETURN "SplBlock"
  CASE #SplSingle
    RETURN "SplSingle"
ENDSWITCH
RETURN "???"
ENDFCT
;*************************************************************************
;[Routine] Convert INT Range to String
;*************************************************************************
DEFFCT CHAR[14] AawRangeNumToStr(tOnRange :IN)
DECL INT tOnRange
SWITCH tOnRange
  CASE 1
    RETURN "OK"
  CASE -1
    RETURN "TooSmall"
  CASE -2
    RETURN "TooBig"
  CASE -3
    RETURN "Disable"    
ENDSWITCH
RETURN "***"
ENDFCT
;*************************************************************************
;[Routine] Write error message
;*************************************************************************
DEF AawErrorMsg(tNr :IN,tStr[] :IN)
DECL int tInt
DECL INT tNR
DECL INT tMsgNR
DECL CHAR tStr[]
IF (tNr >= 0) THEN
  RETURN
ENDIF
tMsgNR = tNr * (-1)
tInt = 0
gAawDiagSaveToFile = FALSE
SWITCH tNr
  CASE -1
    ArcMsgWriteS(tInt,#QUIT,"Internal error",tStr[],tMsgNR,Opt_NOVLSTOP_NOLOG)
  CASE -2
    ArcMsgWriteS(tInt,#QUIT,"Operation failed,because the file was opened outside a KRL or does not exist",tStr[],tMsgNR,Opt_NOVLSTOP_NOLOG)
  CASE -3
    ArcMsgWriteS(tInt,#QUIT,"There is no file open",tStr[],tMsgNR,Opt_NOVLSTOP_NOLOG)
  CASE -4
    ArcMsgWriteS(tInt,#QUIT,"End of file has been reached",tStr[],tMsgNR,Opt_NOVLSTOP_NOLOG)
  CASE -5
    ;ArcMsgWriteS(tInt,#QUIT,"Maximum size of directory C:\KRC\ROBOTER\UserFiles has been reached",tStr[],tMsgNR,Opt_NOVLSTOP_NOLOG)
  CASE -6
    ArcMsgWriteS(tInt,#QUIT,"File already open",tStr[],tMsgNR,Opt_NOVLSTOP_NOLOG)
  CASE -7
    ArcMsgWriteS(tInt,#QUIT,"Positioning of the file pointer outside the limits of the file",tStr[],tMsgNR,Opt_NOVLSTOP_NOLOG)
  CASE -8
    ArcMsgWriteS(tInt,#QUIT,"File system not available: error in specification of target directory",tStr[],tMsgNR,Opt_NOVLSTOP_NOLOG)
  CASE -10
    ArcMsgWriteS(tInt,#QUIT,"Invalid number of function parameters transferred",tStr[],tMsgNR,Opt_NOVLSTOP_NOLOG)
  CASE -11
    ArcMsgWriteS(tInt,#QUIT,"At least one function parameter has an invalid value",tStr[],tMsgNR,Opt_NOVLSTOP_NOLOG)
  CASE -12
    ArcMsgWriteS(tInt,#QUIT,"At least one function parameter has an incorrect data type",tStr[],tMsgNR,Opt_NOVLSTOP_NOLOG)
  CASE -13
    ArcMsgWriteS(tInt,#QUIT,"At least one function parameter is not a variable although a variable is expected",tStr[],tMsgNR,Opt_NOVLSTOP_NOLOG)
  CASE -14
    ArcMsgWriteS(tInt,#QUIT,"At least one function parameter string is blank",tStr[],tMsgNR,Opt_NOVLSTOP_NOLOG)
  CASE -15
    ArcMsgWriteS(tInt,#QUIT,"At least one function parameter string is too long",tStr[],tMsgNR,Opt_NOVLSTOP_NOLOG)
  CASE -16
    ArcMsgWriteS(tInt,#QUIT,"At least one function parameter string contains invalid characters",tStr[],tMsgNR,Opt_NOVLSTOP_NOLOG)
  CASE -30
    ArcMsgWriteS(tInt,#QUIT,"Direct access to the ROBOTER directory is not permissible",tStr[],tMsgNR,Opt_NOVLSTOP_NOLOG)
  CASE -31
    ArcMsgWriteS(tInt,#QUIT,"Invalid absolute path",tStr[],tMsgNR,Opt_NOVLSTOP_NOLOG)
  CASE -32
    ArcMsgWriteS(tInt,#QUIT,"Mount point not found",tStr[],tMsgNR,Opt_NOVLSTOP_NOLOG)
  CASE -40
    ArcMsgWriteS(tInt,#QUIT,"File cannot be opened because 11 files are already open",tStr[],tMsgNR,Opt_NOVLSTOP_NOLOG)
  CASE -41
    ArcMsgWriteS(tInt,#QUIT,"One value could not be read. The values before this value were read correctly",tStr[],tMsgNR,Opt_NOVLSTOP_NOLOG)
  CASE -42
    ArcMsgWriteS(tInt,#QUIT,"The format string contains an invalid format statement",tStr[],tMsgNR,Opt_NOVLSTOP_NOLOG)
  CASE -43
    ArcMsgWriteS(tInt,#QUIT,"The number of values does not correspond to the number of transferred parameters",tStr[],tMsgNR,Opt_NOVLSTOP_NOLOG)
  CASE -44
    ArcMsgWriteS(tInt,#QUIT,"An invalid format was specified for one parameter",tStr[],tMsgNR,Opt_NOVLSTOP_NOLOG)
  DEFAULT
    ArcMsgWriteS(tInt,#QUIT,"No Message",tStr[],tMsgNR,Opt_NOVLSTOP_NOLOG)
ENDSWITCH
END
