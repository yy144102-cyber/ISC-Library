  CASE #Channel3        
    tStrike.Channel3    = tAdaptiveWelding.OutValue
  CASE #Channel4        
    tStrike.Channel4    = tAdaptiveWelding.OutValue
  CASE #Channel5        
    tStrike.Channel5    = tAdaptiveWelding.OutValue
  CASE #Channel6        
    tStrike.Channel6    = tAdaptiveWelding.OutValue
  CASE #Channel7        
    tStrike.Channel7    = tAdaptiveWelding.OutValue
  CASE #Channel8        
    tStrike.Channel8    = tAdaptiveWelding.OutValue
  CASE #PurgeTime
    tStrike.PurgeTime   = tAdaptiveWelding.OutValue
  CASE #PreFlowTime
    tStrike.PreFlowTime = tAdaptiveWelding.OutValue
  CASE #StartTime
    tStrike.StartTime   = tAdaptiveWelding.OutValue
ENDSWITCH
RETURN tStrike
ENDFCT
