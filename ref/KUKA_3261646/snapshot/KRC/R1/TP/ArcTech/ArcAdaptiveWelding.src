;*****************************************************************************************
;[Routine] Check Min Max Value
;*****************************************************************************************
GLOBAL DEFFCT stAdaptiveWelding_T AawCheckMinMaxValue(tAdaptiveWelding : IN,tParam :IN)
DECL INT tOnRange
DECL stParam_T tParam
DECL stAdaptiveWelding_T tAdaptiveWelding
tAdaptiveWelding.OnRange = -3 ;Disable
IF (tParam.Active == TRUE) THEN  
  tAdaptiveWelding.OutValue = ArcSetRangeValue(tAdaptiveWelding.OutValue,tParam.SetMin,tParam.SetMax,tOnRange)
  tAdaptiveWelding.OnRange = tOnRange
ENDIF
RETURN tAdaptiveWelding
ENDFCT
;*****************************************************************************************
;[Routine] Source Value Filter
;*****************************************************************************************
GLOBAL DEFFCT BOOL AawSourceFilter(tSource :OUT,tInValue :OUT)
DECL REAL tInValue
DECL REAL tAverage
DECL REAL tMinVal
DECL REAL tMaxVal
DECL REAL tPerCentFilter
DECL stSource_T tSource
SWITCH gAawFilterType
  CASE #Disabled
    RETURN TRUE ;Filter Disable
  CASE #AverageSource  ;Avarage Source Value (Return Avarage Source value)
    ;Load reference value
    tSource.LastValue.Val5 = tSource.LastValue.Val4
    tSource.LastValue.Val4 = tSource.LastValue.Val3
    tSource.LastValue.Val3 = tSource.LastValue.Val2
    tSource.LastValue.Val2 = tSource.LastValue.Val1
    tSource.LastValue.Val1 = tInValue
    IF (tSource.LastValue.Val5 == 0) THEN
      RETURN TRUE ;Missing Avarage Value
    ENDIF
    tAverage = ((ABS(tSource.LastValue.Val1) + ABS(tSource.LastValue.Val2) + ABS(tSource.LastValue.Val3) + ABS(tSource.LastValue.Val4) + ABS(tSource.LastValue.Val5)) / 5.0)
    tInValue = tAverage 
    RETURN TRUE
  CASE #CutSourcePeak     ;Wall Source (Return same Value )
    ;Load reference value
    IF (tSource.LastValue.Val5 == 0) THEN
      tSource.LastValue.Val5 = tSource.LastValue.Val4
      tSource.LastValue.Val4 = tSource.LastValue.Val3
      tSource.LastValue.Val3 = tSource.LastValue.Val2
      tSource.LastValue.Val2 = tSource.LastValue.Val1
      tSource.LastValue.Val1 = tInValue
      RETURN TRUE ;Missing Avarage Value
    ENDIF
    tAverage = ((ABS(tSource.LastValue.Val1) + ABS(tSource.LastValue.Val2) + ABS(tSource.LastValue.Val3) + ABS(tSource.LastValue.Val4) + ABS(tSource.LastValue.Val5)) / 5.0)
    tPerCentFilter = ArcSetRangeValue(gAawPerCentFilter,cArcFilterPerCentMin,cArcFilterPerCentMax)
    tMaxVal = (ABS(tAverage) + (ABS(tAverage) * (tPerCentFilter / 100.0)))
    tMinVal = tMaxVal * (-1)
    IF (ArcCheckRangeValue(tInValue,tMinVal,tMaxVal) <> 1) THEN
      RETURN FALSE ;Value from source wrong
    ENDIF
    tSource.LastValue.Val5 = tSource.LastValue.Val4
    tSource.LastValue.Val4 = tSource.LastValue.Val3
    tSource.LastValue.Val3 = tSource.LastValue.Val2
    tSource.LastValue.Val2 = tSource.LastValue.Val1
    tSource.LastValue.Val1 = tInValue
    RETURN TRUE
ENDSWITCH
RETURN TRUE
ENDFCT
;*****************************************************************************************
;[Routine] Set Value To
;*****************************************************************************************
GLOBAL DEF AawSetValueWeld(tAdaptiveWelding : IN,tWeave :IN)
DECL INT tError
DECL INT tOnRange
DECL stWeave_T tWeave
DECL stAdaptiveWelding_T tAdaptiveWelding
IF (tAdaptiveWelding.Active == FALSE) THEN
  RETURN
ENDIF
SWITCH tAdaptiveWelding.KrlId
  CASE #Length,#Amplitude
    IF (tWeave.Pattern == #NONE) THEN
      RETURN
    ENDIF
    IF (ArcCallFromRoutine() <> 3) THEN ;Must been Call from SubMit
      RETURN
    ENDIF
  CASE #Angle
    IF (tWeave.Pattern == #NONE) THEN
      RETURN
    ENDIF
    IF (ArcCallFromRoutine() <> 4) THEN ;Must been Call from SubMit Trigger
      RETURN
    ENDIF
ENDSWITCH
SWITCH tAdaptiveWelding.KrlId
  CASE #Channel1
    tError = ArcSetValueToChannel(#None,gArcActIlfWelder,gArcActModeSwi,1,tAdaptiveWelding.OutValue)
    IF (tError < 0) THEN
      ArcMsgWriteR(mHandle[11],#STATE,"WarningOnWriteValueToChannel","AAW",60014,OPt_VLSTOP_LOG,tAdaptiveWelding.OutValue,1,tError)
    ENDIF
  CASE #Channel2 
    tError = ArcSetValueToChannel(#None,gArcActIlfWelder,gArcActModeSwi,2,tAdaptiveWelding.OutValue)
    IF (tError < 0) THEN
      ArcMsgWriteR(mHandle[12],#STATE,"WarningOnWriteValueToChannel","AAW",60014,OPt_VLSTOP_LOG,tAdaptiveWelding.OutValue,2,tError)
    ENDIF
  CASE #Channel3 
    tError = ArcSetValueToChannel(#None,gArcActIlfWelder,gArcActModeSwi,3,tAdaptiveWelding.OutValue)  
    IF (tError < 0) THEN
      ArcMsgWriteR(mHandle[13],#STATE,"WarningOnWriteValueToChannel","AAW",60014,OPt_VLSTOP_LOG,tAdaptiveWelding.OutValue,3,tError)
    ENDIF
  CASE #Channel4 
    tError = ArcSetValueToChannel(#None,gArcActIlfWelder,gArcActModeSwi,4,tAdaptiveWelding.OutValue)  
    IF (tError < 0) THEN
      ArcMsgWriteR(mHandle[14],#STATE,"WarningOnWriteValueToChannel","AAW",60014,OPt_VLSTOP_LOG,tAdaptiveWelding.OutValue,4,tError)
    ENDIF
  CASE #Channel5 
    tError = ArcSetValueToChannel(#None,gArcActIlfWelder,gArcActModeSwi,5,tAdaptiveWelding.OutValue)  
    IF (tError < 0) THEN
      ArcMsgWriteR(mHandle[15],#STATE,"WarningOnWriteValueToChannel","AAW",60014,OPt_VLSTOP_LOG,tAdaptiveWelding.OutValue,5,tError)
    ENDIF
  CASE #Channel6 
    tError = ArcSetValueToChannel(#None,gArcActIlfWelder,gArcActModeSwi,6,tAdaptiveWelding.OutValue)    
    IF (tError < 0) THEN
      ArcMsgWriteR(mHandle[16],#STATE,"WarningOnWriteValueToChannel","AAW",60014,OPt_VLSTOP_LOG,tAdaptiveWelding.OutValue,6,tError)
    ENDIF
  CASE #Channel7 
    tError = ArcSetValueToChannel(#None,gArcActIlfWelder,gArcActModeSwi,7,tAdaptiveWelding.OutValue)    
    IF (tError < 0) THEN
      ArcMsgWriteR(mHandle[17],#STATE,"WarningOnWriteValueToChannel","AAW",60014,OPt_VLSTOP_LOG,tAdaptiveWelding.OutValue,7,tError)
    ENDIF
  CASE #Channel8
    tError = ArcSetValueToChannel(#None,gArcActIlfWelder,gArcActModeSwi,8,tAdaptiveWelding.OutValue)  
    IF (tError < 0) THEN
      ArcMsgWriteR(mHandle[18],#STATE,"WarningOnWriteValueToChannel","AAW",60014,OPt_VLSTOP_LOG,tAdaptiveWelding.OutValue,8,tError)
    ENDIF
  CASE #Velocity
    tAdaptiveWelding.OutValue = ArcSetRangeValue(tAdaptiveWelding.OutValue,cArcVelApplMin,cArcVelApplMax,tOnRange)
     SWITCH tOnRange
      CASE 1
        ArcMsgWriteClearHandle(mHandle[19])
      CASE -1,-2
        ArcMsgWriteR(mHandle[19],#STATE,"WarningOnWriteValueToVelocity","AAW",60010,OPt_VLSTOP_LOG,cArcVelApplMin,tAdaptiveWelding.OutValue,cArcVelApplMax)
    ENDSWITCH
    ArcVelApplSet(3,tAdaptiveWelding.OutValue)
  CASE #Length
    SWITCH ArcSwitchActiveTech()
    CASE #STT
      tAdaptiveWelding.OutValue = gAawCFrequencyValue.Velocity.ValueIlf * 1000 / tAdaptiveWelding.OutValue
    ENDSWITCH
    tAdaptiveWelding.OutValue = ArcSetRangeValue(tAdaptiveWelding.OutValue,cArcWeaveMinLength,cArcWeaveMaxLength)
    tError                    = ArcSetValue(gArcActIlfWelder,gArcActModeSwi,tAdaptiveWelding.KrlId,tAdaptiveWelding.OutValue) ;TODO Check
    SWITCH ArcSwitchActiveTech()
      CASE #ARS,#RSI
        IF (tError < 0) THEN
          ArcMsgWriteR(mHandle[21],#STATE,"WarningArcSenseWriteLength","AAW",60002,OPt_VLSTOP_LOG,tAdaptiveWelding.OutValue)
        ENDIF
      CASE #STT
        IF (tError < 0) THEN
          ArcMsgWriteR(mHandle[22],#STATE,"WarningSTTWriteLength","AAW",60003,OPt_VLSTOP_LOG,tAdaptiveWelding.OutValue)
        ENDIF
    ENDSWITCH
  CASE #Amplitude
    tAdaptiveWelding.OutValue = ArcSetRangeValue(tAdaptiveWelding.OutValue,cArcWeaveMinAmplitude,cArcWeaveMaxAmplitude)
    tError                    = ArcSetValue(gArcActIlfWelder,gArcActModeSwi,tAdaptiveWelding.KrlId,tAdaptiveWelding.OutValue) ;TODO Check
    SWITCH ArcSwitchActiveTech()
      CASE #ARS,#RSI
        IF (tError < 0) THEN
          ArcMsgWriteR(mHandle[23],#STATE,"WarningArcSenseWriteAmplitude","AAW",60004,OPt_VLSTOP_LOG,tAdaptiveWelding.OutValue)
        ENDIF
      CASE #STT
        IF (tError < 0) THEN
          ArcMsgWriteR(mHandle[24],#STATE,"WarningSTTWriteAmplitude","AAW",60005,OPt_VLSTOP_LOG,tAdaptiveWelding.OutValue)
        ENDIF
    ENDSWITCH
  CASE #Angle
    tAdaptiveWelding.OutValue = ArcSetRangeValue(tAdaptiveWelding.OutValue,cArcWeaveMinAngle,cArcWeaveMaxAngle)
    tError                    = ArcSetValue(gArcActIlfWelder,gArcActModeSwi,tAdaptiveWelding.KrlId,tAdaptiveWelding.OutValue) ;TODO Check
    SWITCH ArcSwitchActiveTech()
      CASE #FG
        ;TODO With Trigger Check if it is possible
      CASE #ARS,#RSI
        ;TODO Check if it is possible?
      CASE #STT
        ;TODO Check if it is possible?
    ENDSWITCH
ENDSWITCH
END
;*****************************************************************************************
;[Routine] Load Source Value
;*****************************************************************************************
GLOBAL DEFFCT REAL AawLoadSourceValue(tSource : IN)
DECL INT tError
DECL stSource_T tSource
IF (tSource.Active == TRUE) THEN
  SWITCH tSource.SourceInput
    CASE #ISenPrea
      IF (tSource.SourceNr > 0) AND (tSource.SourceNr < 129) THEN
        RETURN $SEN_PREA[tSource.SourceNr]
      ELSE
        ArcMsgWriteI(mHandle[25],#STATE,"WarningSenpreaOutOfRange","AAW",60006,OPt_VLSTOP_LOG,tSource.SourceNr)
      ENDIF
    CASE #ISenPint
      IF (tSource.SourceNr > 0) AND (tSource.SourceNr < 129) THEN
        RETURN $SEN_PINT[tSource.SourceNr]
      ELSE
        ArcMsgWriteI(mHandle[26],#STATE,"WarningSenpintOutOfRange","AAW",60007,OPt_VLSTOP_LOG,tSource.SourceNr)
      ENDIF
    CASE #IAnalog
      IF (tSource.SourceNr > 0) AND (tSource.SourceNr < 33) THEN
        RETURN ($ANIN[tSource.SourceNr]) * gAawAnalogFactor
      ELSE
        ArcMsgWriteI(mHandle[27],#STATE,"WarningAnalogOutOfRange","AAW",60008,OPt_VLSTOP_LOG,tSource.SourceNr)
      ENDIF
    CASE #ISoftPlcReal
      IF (tSource.SourceNr > 0) AND (tSource.SourceNr < $IOSYS_IN_TRUE) THEN
        RETURN $SOFTPLCREAL[tSource.SourceNr]
      ELSE
        ArcMsgWriteI(mHandle[28],#STATE,"WarningSoftplcintOutOfRange","AAW",60009,OPt_VLSTOP_LOG,tSource.SourceNr)
      ENDIF
  ENDSWITCH
ENDIF
RETURN 0
ENDFCT
;*****************************************************************************************
;[Routine] Check Struc Exist
;*****************************************************************************************
GLOBAL DEFFCT BOOL AawStrucExist(tAdaptiveWelding : OUT,tSelectMode :IN,tSelectParam :IN,tPos :IN)
DECL INT tSelectMode
DECL INT tSelectParam
DECL INT tPos
DECL stAdaptiveWelding_T tAdaptiveWelding[,,]
ON_ERROR_PROCEED
tAdaptiveWelding[tSelectMode,tSelectParam,tPos] = tAdaptiveWelding[tSelectMode,tSelectParam,tPos]
IF ($ERR.NUMBER > 0) THEN
  ERR_CLEAR($ERR)
  RETURN FALSE
ENDIF
ON_ERROR_PROCEED
tAdaptiveWelding[tSelectMode,tSelectParam,tPos].KrlId = tAdaptiveWelding[tSelectMode,tSelectParam,tPos].KrlId
IF ($ERR.NUMBER > 0) THEN
  ERR_CLEAR($ERR)
  RETURN FALSE
ENDIF
RETURN TRUE
ENDFCT
;*****************************************************************************************
;[Routine] Check Sourse Exist
;*****************************************************************************************
GLOBAL DEFFCT BOOL AawSourceExist(tAdaptiveWelding : OUT,tPos :IN)
DECL INT tPos
DECL stAdaptiveWelding_T tAdaptiveWelding[]
ON_ERROR_PROCEED
tAdaptiveWelding[tPos].Source1.Active = tAdaptiveWelding[tPos].Source1.Active
IF ($ERR.NUMBER > 0) THEN
  ERR_CLEAR($ERR)
  RETURN FALSE
ENDIF
ON_ERROR_PROCEED
tAdaptiveWelding[tPos].Source2.Active = tAdaptiveWelding[tPos].Source2.Active
IF ($ERR.NUMBER > 0) THEN
  ERR_CLEAR($ERR)
  RETURN FALSE
ENDIF
ON_ERROR_PROCEED
tAdaptiveWelding[tPos].Source3.Active = tAdaptiveWelding[tPos].Source3.Active
IF ($ERR.NUMBER > 0) THEN
  ERR_CLEAR($ERR)
  RETURN FALSE
ENDIF
ON_ERROR_PROCEED
tAdaptiveWelding[tPos].Source4.Active = tAdaptiveWelding[tPos].Source4.Active
IF ($ERR.NUMBER > 0) THEN
  ERR_CLEAR($ERR)
  RETURN FALSE
ENDIF
ON_ERROR_PROCEED
tAdaptiveWelding[tPos].Source5.Active = tAdaptiveWelding[tPos].Source5.Active
IF ($ERR.NUMBER > 0) THEN
  ERR_CLEAR($ERR)
  RETURN FALSE
ENDIF
RETURN TRUE
ENDFCT
;*****************************************************************************************
;[Routine] Routine Operator
;L    = Less & Max
;LE   = Less or Equal & Max
;G    = Min & Greater
;GE   = Min & Greater or Equal
;LG   = Less & Greater
;LEG  = Less or Equal & Greater
;LGE  = Less & Greater or Equal
;LEGE = Less or Equal & Greater or Equal
;*****************************************************************************************
GLOBAL DEFFCT BOOL AawOperator(tInValue :IN,tSource : IN)
DECL REAL tInValue
DECL stSource_T tSource
SWITCH tSource.Operator
  CASE #L
    RETURN  (tInValue >  tSource.FromNum)
  CASE #LE  
    RETURN  (tInValue >= tSource.FromNum)
  CASE #G   
    RETURN  (tInValue <  tSource.ToNum)
  CASE #GE  
    RETURN  (tInValue <= tSource.ToNum)
  CASE #LG
    RETURN ((tInValue >  tSource.FromNum) AND (tInValue <  tSource.ToNum))
  CASE #LEG
    RETURN ((tInValue >= tSource.FromNum) AND (tInValue <  tSource.ToNum))
  CASE #LGE
    RETURN ((tInValue >  tSource.FromNum) AND (tInValue <= tSource.ToNum))
  CASE #LEGE
    RETURN ((tInValue >= tSource.FromNum) AND (tInValue <= tSource.ToNum))
ENDSWITCH
RETURN FALSE
ENDFCT
;*****************************************************************************************
;[Routine] Set weave variable 
;*****************************************************************************************
GLOBAL DEF AawDisableIlfWeave(tAdaptiveWelding:IN, tSourceState:IN)
DECL stAdaptiveWelding_T tAdaptiveWelding
DECL enAawSourceState_T tSourceState
SWITCH tSourceState
  CASE #ILF,#FUNCTION 
    SWITCH tAdaptiveWelding.KrlId
      CASE #Amplitude
        gAawWeaveValue.AmplitudeActive   = TRUE
        gAawWeaveValue.Amplitude = tAdaptiveWelding.OutValue
      CASE #Length
        gAawWeaveValue.LengthActive   = TRUE
        gAawWeaveValue.Length   = tAdaptiveWelding.OutValue
    ENDSWITCH
  CASE #DEACTIVE
    SWITCH tAdaptiveWelding.KrlId
      CASE #Amplitude
        gAawWeaveValue.AmplitudeActive   = FALSE
        gAawWeaveValue.Amplitude = 0.0
      CASE #Length
        gAawWeaveValue.LengthActive   = FALSE
        gAawWeaveValue.Length   = 0.0
    ENDSWITCH
  ENDSWITCH
END
;*****************************************************************************************
;[Routine]Aww Init LastValue
;*****************************************************************************************
GLOBAL DEFFCT stAdaptiveWelding_T AawInitLastValue(tAdaptiveWelding :IN)
DECL stAdaptiveWelding_T tAdaptiveWelding
  IF (tAdaptiveWelding.Source1.Active == TRUE) THEN
    tAdaptiveWelding.Source1.LastValue = gLastValueInit
  ENDIF
  IF (tAdaptiveWelding.Source2.Active == TRUE) THEN
    tAdaptiveWelding.Source2.LastValue = gLastValueInit
  ENDIF
  IF (tAdaptiveWelding.Source3.Active == TRUE) THEN
    tAdaptiveWelding.Source3.LastValue = gLastValueInit
  ENDIF
  IF (tAdaptiveWelding.Source4.Active == TRUE) THEN
    tAdaptiveWelding.Source4.LastValue = gLastValueInit
  ENDIF
  IF (tAdaptiveWelding.Source5.Active == TRUE) THEN
    tAdaptiveWelding.Source5.LastValue = gLastValueInit
  ENDIF
RETURN tAdaptiveWelding
ENDFCT
;*************************************************************************
;[Routine] AawSetConstant
;*************************************************************************
GLOBAL DEFFCT enAawWeaveConst_T AawSetConstant(tAdaptiveWelding :IN,tConstOut :OUT)
DECL stAdaptiveWelding_T tConstOut
DECL stAdaptiveWelding_T tAdaptiveWelding
SWITCH tAdaptiveWelding.KrlId
  CASE #Velocity
    gAawCFrequencyValue.Velocity.OutValue = tAdaptiveWelding.OutValue
  CASE #Length
    gAawCFrequencyValue.Length.OutValue = tAdaptiveWelding.OutValue
ENDSWITCH
IF (tAdaptiveWelding.Active == FALSE) THEN
  RETURN #None
ENDIF
IF (gAawCFrequencyValue.Velocity.LoadVal == FALSE) OR (gAawCFrequencyValue.Length.LoadVal == FALSE) THEN
  RETURN #None
ENDIF
IF ((gAawCFrequencyValue.Velocity.Active == TRUE) AND (gAawCFrequencyValue.Length.Active == TRUE)) THEN
  RETURN #Overload
ENDIF
IF (gAawConstFrequency == FALSE) THEN
  RETURN #Deactivated
ENDIF
SWITCH tAdaptiveWelding.KrlId
  CASE #Velocity
    gAawCFrequencyValue.Velocity.Active = TRUE
    tConstOut = tAdaptiveWelding
    tConstOut.KrlId = #Length
    tConstOut.IlfVAlue = gAawCFrequencyValue.Length.ValueIlf
    tConstOut.OutValue = (gAawCFrequencyValue.Velocity.OutValue * gAawCFrequencyValue.Length.ValueIlf)/gAawCFrequencyValue.Velocity.ValueIlf
    RETURN #ConstVelocity
  CASE #Length
    gAawCFrequencyValue.Length.Active = TRUE
    tConstOut = tAdaptiveWelding
    tConstOut.KrlId = #Velocity
    tConstOut.IlfVAlue = gAawCFrequencyValue.Velocity.ValueIlf
    tConstOut.OutValue = (gAawCFrequencyValue.Length.OutValue * gAawCFrequencyValue.Velocity.ValueIlf)/gAawCFrequencyValue.Length.ValueIlf
    RETURN #ConstLength
ENDSWITCH
RETURN #None
ENDFCT
