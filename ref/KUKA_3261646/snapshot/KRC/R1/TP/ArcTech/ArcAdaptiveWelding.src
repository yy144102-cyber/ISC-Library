;*****************************************************************************************
;[Routine] Load Weld Default value 
;*****************************************************************************************
GLOBAL DEFFCT stAdaptiveWelding_T AawStrikeLoadDefValue(tAdaptiveWelding : IN,tStrike :IN)
DECL stStrike_T tStrike
DECL stAdaptiveWelding_T tAdaptiveWelding
SWITCH tAdaptiveWelding.KrlId
  CASE #Channel1
    tAdaptiveWelding.IlfValue = tStrike.Channel1
  CASE #Channel2
    tAdaptiveWelding.IlfValue = tStrike.Channel2
  CASE #Channel3
    tAdaptiveWelding.IlfValue = tStrike.Channel3
  CASE #Channel4
    tAdaptiveWelding.IlfValue = tStrike.Channel4
  CASE #Channel5
    tAdaptiveWelding.IlfValue = tStrike.Channel5
  CASE #Channel6
    tAdaptiveWelding.IlfValue = tStrike.Channel6
  CASE #Channel7
    tAdaptiveWelding.IlfValue = tStrike.Channel7
  CASE #Channel8
    tAdaptiveWelding.IlfValue = tStrike.Channel8
  CASE #PurgeTime
    tAdaptiveWelding.IlfValue = tStrike.PurgeTime
  CASE #PreFlowTime
    tAdaptiveWelding.IlfValue = tStrike.PreFlowTime
  CASE #StartTime
    tAdaptiveWelding.IlfValue = tStrike.StartTime
ENDSWITCH
RETURN tAdaptiveWelding
ENDFCT
;*****************************************************************************************
;[Routine] Load Weld Default value 
;*****************************************************************************************
GLOBAL DEFFCT stAdaptiveWelding_T AawWeldLoadDefValue(tAdaptiveWelding : IN,tWeld :IN,tWeave :IN)
DECL stWeld_T tWeld
DECL stWeave_T tWeave
DECL stAdaptiveWelding_T tAdaptiveWelding
SWITCH tAdaptiveWelding.KrlId
  CASE #Channel1
    tAdaptiveWelding.IlfValue = tWeld.Channel1
  CASE #Channel2
    tAdaptiveWelding.IlfValue = tWeld.Channel2
  CASE #Channel3
    tAdaptiveWelding.IlfValue = tWeld.Channel3
  CASE #Channel4
    tAdaptiveWelding.IlfValue = tWeld.Channel4
  CASE #Channel5
    tAdaptiveWelding.IlfValue = tWeld.Channel5
  CASE #Channel6
    tAdaptiveWelding.IlfValue = tWeld.Channel6
  CASE #Channel7
    tAdaptiveWelding.IlfValue = tWeld.Channel7
  CASE #Channel8
    tAdaptiveWelding.IlfValue = tWeld.Channel8
  CASE #Velocity
    tAdaptiveWelding.IlfValue = tWeld.Velocity
    gAawCFrequencyValue.Velocity.LoadVal = TRUE
    gAawCFrequencyValue.Velocity.ValueIlf = tWeld.Velocity
  CASE #Length
    tAdaptiveWelding.IlfValue = tWeave.Length
    gAawCFrequencyValue.Length.LoadVal = TRUE
    gAawCFrequencyValue.Length.ValueIlf = tWeave.Length
  CASE #Amplitude
    IF (tWeave.Amplitude > 100) THEN
      tAdaptiveWelding.IlfValue = tWeave.Amplitude - 100
    ELSE
    tAdaptiveWelding.IlfValue = tWeave.Amplitude
    ENDIF
  CASE #Angle
    ;TODO tAdaptiveWelding.IlfValue = tWeave.Angle
ENDSWITCH
RETURN tAdaptiveWelding
ENDFCT
