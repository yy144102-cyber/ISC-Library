&ACCESS R2
&REL 1
&COMMENT ArcTech
&PARAM DISKPATH = KRC:\R1\TP\ArcTech
DEF ArcFunction( )
END
;*****************************************************************************************
;[Global Routine] Check SUBMIT LoopTime
;*****************************************************************************************
GLOBAL DEF ArcSubmitMsg()
DECL REAL tActTimer
SWITCH $PRO_STATE1
  CASE #P_ACTIVE,#P_STOP
    IF (ArcIsSubMitOverTime(gMaxSubmitTimerAllow,tActTimer)) THEN
      ArcMsgWriteR(mMsgHandleLoop,#STATE, "SubMitLoopSlow","ARC",10141,Opt_NOVLSTOP_LOG,tActTimer,gMaxSubmitTimerAllow)
    ELSE
      ArcMsgWriteClearHandle(mMsgHandleLoop)
    ENDIF
  DEFAULT
    ArcMsgWriteClearHandle(mMsgHandleLoop)
ENDSWITCH
END
;******************************************************************************
;[Global Power Source] Power source Error Msg Init
;******************************************************************************
GLOBAL DEF ArcPowerSourceMsgInit()
DECL INT tI
FOR tI = 1 TO 8
  ArcMsgWriteClearHandle(mHandlMsgErrorNr[tI])
  mArcMsgErrorNr[tI] = 0
ENDFOR
END
;******************************************************************************
;[Global Power Source] Power source Error Msg SubMit
;******************************************************************************
GLOBAL DEF ArcPowerSourceMsg()
DECL INT tI
FOR tI = 1 TO 4
  ArcPowerSourceMsgType(tI,wsArcIPowerSourceMsg1[tI],wArcPsKxrFile1[tI])
  ArcPowerSourceMsgType(tI + 4,wsArcIPowerSourceMsg2[tI],wArcPsKxrFile2[tI])
ENDFOR
END
;******************************************************************************
;[Global Power Source] Power source Error Msg SubMit
;******************************************************************************
DEF ArcPowerSourceMsgType(tWelderNr :IN,tSignalMsgNr :IN ,tArcPsKxrFile :IN)
DECL INT tI
DECL INT tWelderNr
DECL INT tWelderMsgNr
DECL CHAR tMsg[80]
DECL CHAR tParam1[26]
DECL CHAR tParam2[26]
DECL CHAR tParam3[26]
DECL stArcPsKxrFile_T tArcPsKxrFile
DECL stArcSignal_T tSignalMsgNr
IF (tArcPsKxrFile.PsMsgType == #NONE) THEN
  RETURN
ENDIF
tWelderMsgNr = ArcBitToInt($IN[],tSignalMsgNr)
IF (mArcMsgErrorNr[tWelderNr] <> tWelderMsgNr) THEN
  ArcMsgWriteClearHandle(mHandlMsgErrorNr[tWelderNr])
  SWITCH tArcPsKxrFile.PsMsgType
    CASE #WARNING
      tParam2[] = "#1"
    CASE #ERROR  
      tParam2[] = "#2"
  ENDSWITCH    
  tMsg[]    = "ARC_PS_"  
  tParam1[] = "[Welder"
  tI = STRADD(tParam1[],ArcIntToStr(tWelderNr))
  tI = STRADD(tParam1[]," Nr:")
  tI = STRADD(tParam1[],ArcIntToStr(tWelderMsgNr))
  tI = STRADD(tParam1[]," ")
  tParam3[] = " $IN:"  
  tI = STRADD(tParam3[],ArcIntToStr(tSignalMsgNr.Offset.FromIndex))
  tI = STRADD(tParam3[],"-")
  tI = STRADD(tParam3[],ArcIntToStr(tSignalMsgNr.Offset.ToIndex))
  tI = STRADD(tParam3[],"]: ")  
  IF (tWelderMsgNr > 0) THEN
    tI = STRADD(tMsg[],ArcIntToStr(tWelderMsgNr))
    ArcMsgWriteS(mHandlMsgErrorNr[tWelderNr],#STATE,tMsg[],tArcPsKxrFile.KxrFile[],cPsMsgNr,Opt_NOVLSTOP_NOLOG,tParam1[],tParam2[],tParam3[])
  ENDIF
  mArcMsgErrorNr[tWelderNr] = tWelderMsgNr
ENDIF
END
;******************************************************************************
;[Global Message Routine] Send Actual KRL Message to PLC
;******************************************************************************
GLOBAL DEF ArcReadMsgBuffer()
DECL BOOL tB
DECL INT tI
DECL INT tNumMessage
DECL INT tOutNr
DECL stArcSignal_T tArcOMsgPlc
DECL stArcMsg_T tArcMsgState
DECL stArcMsg_T tArcMsgQuit
DECL stArcMsg_T tArcMsgDlg
DECL MSGBUF_T tArcMsgBuffer[100]
tArcMsgState.Active = FALSE
tArcMsgQuit.Active  = FALSE
tArcMsgDlg.Active   = FALSE
IF (wsArcOMsgPlc.Active == FALSE) OR (wsArcOMsgPlc.Length < 32) THEN
  RETURN
ENDIF
tNumMessage = GET_MSGBUFFER(tArcMsgBuffer[])
IF (tNumMessage <= 0) THEN
  ArcSetMessageNo(0)
  $OUT[wsArcOMsgPlc.Offset.FromIndex + cArcOutMsgPresentState  - 1] = FALSE
  $OUT[wsArcOMsgPlc.Offset.FromIndex + cArcOutMsgPresentQuit   - 1] = FALSE
  $OUT[wsArcOMsgPlc.Offset.FromIndex + cArcOutMsgPresentDialog - 1] = FALSE
  RETURN
ENDIF
FOR tI = tNumMessage TO 1 STEP -1 ; get oldest message in buffer
  IF (ArcMsgTypePresent(tArcMsgBuffer[tI].MODUL[]) == TRUE) THEN
    SWITCH tArcMsgBuffer[tI].TYPE
        CASE #USR_STATE
          tArcMsgState.Active = TRUE
          tArcMsgState.MsgBuf = tArcMsgBuffer[tI]
          EXIT ; get only one message
        CASE #USR_QUIT
          tArcMsgQuit.Active = TRUE
          tArcMsgQuit.MsgBuf = tArcMsgBuffer[tI]
          EXIT ; get only one message
        CASE #USR_DLG
          tArcMsgDlg.Active = TRUE
          tArcMsgDlg.MsgBuf = tArcMsgBuffer[tI]
          EXIT ; get only one message
    ENDSWITCH  
  ENDIF
ENDFOR
$OUT[wsArcOMsgPlc.Offset.FromIndex + cArcOutMsgPresentState  - 1] = tArcMsgState.Active
$OUT[wsArcOMsgPlc.Offset.FromIndex + cArcOutMsgPresentQuit   - 1] = tArcMsgQuit.Active
$OUT[wsArcOMsgPlc.Offset.FromIndex + cArcOutMsgPresentDialog - 1] = tArcMsgDlg.Active
IF (wsArcIMsgPlc.Active == FALSE) OR (wsArcIMsgPlc.Length < 32) THEN
  RETURN
ENDIF
IF (tArcMsgState.Active == TRUE) THEN
  ArcHandleMessage(#STATE,tArcMsgState, cArcInMsgShowState)
  RETURN
ENDIF
IF (tArcMsgQuit.Active == TRUE) THEN
  ArcHandleMessage(#QUIT,tArcMsgQuit, cArcInMsgShowQuit)
  RETURN
ENDIF
IF (tArcMsgDlg.Active == TRUE) THEN
  ArcHandleMessage(#DIALOG,tArcMsgDlg, cArcInMsgShowDialog)
  RETURN
ENDIF
ArcSetMessageNo(0)
END
;******************************************************************************
;[Routine] Handle message according to plc inputs
;******************************************************************************
DEF ArcHandleMessage(MsgType:IN, tArcMessage:IN, showMsgOffset:IN)
DECL stArcMsg_T tArcMessage
DECL enArcMessageType_T MsgType
DECL INT showMsgOffset
DECL INT tOutNr
DECL INT tOutSKNr
DECL INT tInSKNr
DECL INT tPlcInNr
DECL BOOL tB
IF ($IN[wsArcIMsgPlc.Offset.FromIndex + showMsgOffset - 1] == FALSE) THEN
  RETURN
ENDIF
tOutNr   = tArcMessage.MsgBuf.Nr
tOutSKNr = ArcGetDialogNrSK()
tPlcInNr = ArcGetPlcMsgNo(tArcMessage)
IF (tOutNr == tPlcInNr) THEN
  SWITCH MsgType
    CASE #STATE
      IF ($IN[wsArcIMsgPlc.Offset.FromIndex + cArcInMsgClear - 1] == TRUE) THEN
         tB = CLEAR_KRLMSG(tArcMessage.MsgBuf.HANDLE)
         tOutNr   = 0
         tOutSKNr = 0
      ENDIF
    CASE #QUIT
      IF ($IN[wsArcIMsgPlc.Offset.FromIndex + cArcInMsgClear - 1] == TRUE) THEN
         tB = CLEAR_KRLMSG(tArcMessage.MsgBuf.HANDLE)
         tOutNr   = 0
         tOutSKNr = 0
      ENDIF
    CASE #DIALOG
      IF ($IN[wsArcIMsgPlc.Offset.FromIndex + cArcInMsgClear - 1] == TRUE) THEN
         tInSKNr = ArcGetPlcDialogAnswer()
         IF (ArcCheckRangeValue(tInSKNr,1,7) == 1) THEN
            ArcSetMsgDialogAnswer(tInSKNr)
            tB = CLEAR_KRLMSG(tArcMessage.MsgBuf.HANDLE)
            tOutNr   = 0
            tOutSKNr = 0
         ENDIF
      ENDIF
    ENDSWITCH
ENDIF
ArcSetMessageNo(tOutNr)
ArcSetPlDialogcNrSK(tOutSKNr)
END
;******************************************************************************
;[Function] Get PLC message no. to be quit
;******************************************************************************
DEFFCT INT ArcGetPlcMsgNo(tArcMessage:IN)
DECL stArcMsg_T tArcMessage
DECL stArcSignal_T tArcIMsgPlc
DECL INT msgNo
tArcIMsgPlc.Offset.FromIndex = wsArcIMsgPlc.Offset.FromIndex + cArcInMsgNumberResetS - 1
tArcIMsgPlc.Offset.ToIndex   = wsArcIMsgPlc.Offset.FromIndex + cArcInMsgNumberResetE - 1
tArcIMsgPlc.Active           = TRUE
msgNo = ArcBitToInt($IN[], tArcIMsgPlc)
RETURN msgNo
ENDFCT
;******************************************************************************
;[Function] Get PLC dialog answer
;******************************************************************************
DEFFCT INT ArcGetPlcDialogAnswer()
DECL stArcSignal_T tArcIMsgPlc
DECL INT answer
tArcIMsgPlc.Offset.FromIndex = wsArcIMsgPlc.Offset.FromIndex + cArcInMsgDialogAnswerS - 1
tArcIMsgPlc.Offset.ToIndex   = wsArcIMsgPlc.Offset.FromIndex + cArcInMsgDialogAnswerE - 1
tArcIMsgPlc.Active           = TRUE
answer = ArcBitToInt($IN[], tArcIMsgPlc)
RETURN answer
ENDFCT
;******************************************************************************
;[Function] Get PLC dialog answer
;******************************************************************************
DEF ArcSetPlDialogcNrSK(tMsgNrSk:IN)
DECL INT tMsgNrSk
DECL stArcSignal_T tArcOMsgPlc
tArcOMsgPlc.Offset.FromIndex = wsArcOMsgPlc.Offset.FromIndex + cArcOutMsgDialogKeyS - 1
tArcOMsgPlc.Offset.ToIndex   = wsArcOMsgPlc.Offset.FromIndex + cArcOutMsgDialogKeyE - 1
tArcOMsgPlc.Active           = TRUE
tArcOMsgPlc.VarName          = wsArcOMsgPlc.VarName
IF (mMsgNrSk <> tMsgNrSk) THEN
  mMsgNrSk = tMsgNrSk
  ArcIntToBit($OUT[],tArcOMsgPlc, tMsgNrSk)
ENDIF
END
;******************************************************************************
;[Function] Set message no. to PLC
;******************************************************************************
DEF ArcSetMessageNo(tMsgNo:IN)
DECL INT tMsgNo
DECL stArcSignal_T tArcOMsgPlc
tArcOMsgPlc.Offset.FromIndex = wsArcOMsgPlc.Offset.FromIndex + cArcOutMsgPresentNumberS - 1
tArcOMsgPlc.Offset.ToIndex   = wsArcOMsgPlc.Offset.FromIndex + cArcOutMsgPresentNumberE - 1
tArcOMsgPlc.Active           = TRUE
tArcOMsgPlc.VarName          = wsArcOMsgPlc.VarName
IF (mMsgNo <> tMsgNo) THEN
  mMsgNo = tMsgNo
  ArcIntToBit($OUT[],tArcOMsgPlc, tMsgNo)
ENDIF
END
;*****************************************************************************************
;[Routine] ArcMsgTypePresent
;*****************************************************************************************
DEFFCT BOOL ArcMsgTypePresent(tMsgModul[] :IN)
DECL BOOL tB
DECL INT tI
DECL CHAR tMsgModul[]
DECL CHAR tArcMsgModul[3,3]
DECL CHAR tModul[3]
tArcMsgModul[1,] = "ARC"
tArcMsgModul[2,] = "AML"
tArcMsgModul[3,] = "AAW"
FOR tI = 1 TO 3
  tB = STRCOPY(tModul[],tArcMsgModul[tI,])
  IF (ArcStrComp(tMsgModul[],tModul[]) == TRUE) THEN
    RETURN TRUE
  ENDIF
ENDFOR
RETURN FALSE
ENDFCT
;*****************************************************************************************
;[Global Routine] Routine check if Array Strategy Exist exist
;*****************************************************************************************
GLOBAL DEFFCT BOOL ArcArrayStrategyExist(tVar[] :OUT,tNum :IN)
DECL stArcStrategy_T tVar[]
DECL INT tReturn,tNum
ON_ERROR_PROCEED
tVar[tNum]=tVar[tNum]
tReturn=$ERR.NUMBER
ERR_CLEAR($ERR)
RETURN (tReturn == 0)
ENDFCT
;*****************************************************************************************
;[Global Routine] Routine check if Array Variable Group Signal exist
;*****************************************************************************************
GLOBAL DEFFCT BOOL ArcArrayGroupSignalExist(tVar[] :OUT,tNum :IN)
DECL stArcSignal_T tVar[]
DECL INT tReturn,tNum
ON_ERROR_PROCEED
tVar[tNum]=tVar[tNum]
tReturn=$ERR.NUMBER
ERR_CLEAR($ERR)
RETURN (tReturn == 0)
ENDFCT
;*****************************************************************************************
;[Global Routine] Routine check if Array Variable Special Signal exist
;*****************************************************************************************
GLOBAL DEFFCT BOOL ArcArraySpecSignalExist(tVar[,] :OUT,tNum1 :IN,tNum2 :IN)
DECL stArcSignal_T tVar[,]
DECL INT tReturn,tNum1,tNum2
ON_ERROR_PROCEED
tVar[tNum1,tNum2]=tVar[tNum1,tNum2]
tReturn=$ERR.NUMBER
ERR_CLEAR($ERR)
RETURN (tReturn == 0)
ENDFCT

;***************************************************************
;[Global Routine] Time Out Delay sec
;***************************************************************
GLOBAL DEFFCT INT ArcCalcTimeoutSec(tValue :IN)
DECL REAL tValue
DECL INT tValueMilliSec
tValueMilliSec = tValue * 1000
RETURN ArcCalcRobTimerTimeout(tValueMilliSec)
ENDFCT
;***************************************************************
;[Global Routine] Time Out Delay msec
;***************************************************************
GLOBAL DEFFCT INT ArcCalcTimeoutMilliSec(tValue :IN)
DECL INT tValue
RETURN ArcCalcRobTimerTimeout(tValue)
ENDFCT
;***************************************************************
;[Global Routine] CalcRobTimerTimeout
;***************************************************************
GLOBAL DEFFCT INT ArcCalcRobTimerTimeout(tValue :IN)
DECL INT tValue
DECL INT tRobTimerDiff
tValue = ABS(tValue)
IF (tValue > 0) THEN
  tRobTimerDiff = cIntMax - $ROB_TIMER
  IF (tRobTimerDiff <= tValue) THEN
    RETURN (tValue - tRobTimerDiff)
  ELSE
    RETURN ($ROB_TIMER + tValue)
  ENDIF
ELSE
  RETURN 0
ENDIF
ENDFCT
;***************************************************************
;[Global Routine] Set Output Signals
;***************************************************************
GLOBAL DEFFCT BOOL ArcIsWelderActive(tWelderNr: IN)
DECL INT tWelderNr
SWITCH tWelderNr
  CASE 1,2,3,4
    RETURN wArcWelder[tWelderNr].Type <> #NONE
ENDSWITCH
RETURN FALSE
ENDFCT
;***************************************************************
;[Global Routine] Init All Table signals Used on SPS Init
;***************************************************************
GLOBAL DEF ArcInitAllTableSignal()
DECL INT tI
DECL INT tHandle
gArcWelderActive = FALSE
FOR tI = 1 TO 4
  IF (ArcIsWelderActive(tI) == TRUE) THEN
    gArcWelderActive = TRUE
  ENDIF
ENDFOR
IF (gArcWelderActive == FALSE) THEN
  tHandle = 0
  ArcMsgWriteS(tHandle,#QUIT ,"AtbInternalError","ARC",10094,Opt_NOVLSTOP_LOG,gArcActIlfWelderName[],"X","No active Welder found")
ENDIF
ArcInitWovTableSignal()
END
;***************************************************************
;[Routine] Init All Table signals generatde from WOV Used on SPS Init
;***************************************************************
DEF ArcInitWovTableSignal()
DECL BOOL tB
DECL INT tI
DECL INT tWelderNr
DECL INT tModiNr
DECL INT tOSpecial
DECL stArcSignal_T tArcSignal
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;Initialize number of modi
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ArcInitNumberOfArcModi()
FOR tWelderNr = 1 TO 4
  ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  ;Check Offset value
  ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  tB = ArcVarExistI(wArcIoOffset[tWelderNr].Welder.Input,0)
  tB = ArcVarExistI(wArcIoOffset[tWelderNr].Welder.Output,0)
  tB = ArcVarExistI(wArcIoOffset[tWelderNr].External.Input,0)
  tB = ArcVarExistI(wArcIoOffset[tWelderNr].External.Output,0)
  ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  ;Prepare Signal Input and Output Struc
  ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  ArcPrepareSignals(#Input,tWelderNr,,,wArcInput[,],,"wArcInput",#NONE)
  ArcPrepareSignals(#Output,tWelderNr,,,wArcOutput[,],,"wArcOutput",#NONE)
  ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  ;Prepare Signal Special Output Struc
  ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  ArcPrepareSignals(#SpecialOutput,tWelderNr,,,,wArcOSpecial[,,],"wArcOSpecial",#NONE)
  ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  ;Prepare signals block
  ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  ArcPrepareSignals(#BlockInput,tWelderNr,,,wArcIRdyWeldSource[,],,"wArcIRdyWeldSource",#NONE)
  ArcPrepareSignals(#BlockInput,tWelderNr,,,wArcIWeldPeriphery[,],,"wArcIWeldPeriphery",#NONE)
  ArcPrepareSignals(#BlockInput,tWelderNr,,,wArcIWeldStartMove[,],,"wArcIWeldStartMove",#NONE)
  ArcPrepareSignals(#BlockInput,tWelderNr,,,wArcIWeldMoving[,],,"wArcIWeldMoving",#NONE)
  ArcPrepareSignals(#BlockInput,tWelderNr,,,wArcIWeldSeamEnd[,],,"wArcIWeldSeamEnd",#NONE)
  ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  ;Input prepare signals
  ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  ArcPrepareSignals(#SingleInput,tWelderNr,,wArcIKeySwitchProcess[],,,"wArcIKeySwitchProcess",#NONE)
  ArcPrepareSignals(#SingleInput,tWelderNr,,wArcIWireFreeDetection[],,,"wArcIWireFreeDetection",#NONE)
  ArcPrepareSignals(#SingleInput,tWelderNr,,wArcIGasFlowAvailable[],,,"wArcIGasFlowAvailable",#NONE)
  ArcPrepareSignals(#SingleInput,tWelderNr,,wArcICollisionMonitoring[],,,"wArcICollisionMonitoring",#NONE)
  ArcPrepareSignals(#SingleInput,tWelderNr,,wArcIStrategyDecision[],,,"wArcIStrategyDecision",#NONE)
  ArcPrepareSignals(#SingleInput,tWelderNr,,wArcIDecisionValid[],,,"wArcIDecisionValid",#NONE)
  ArcPrepareSignals(#SingleInput,tWelderNr,,wArcIPowerSourceReady[],,,"wArcIPowerSourceReady",#NONE)
  ArcPrepareSignals(#SingleInput,tWelderNr,,wArcIHeartBeatTPSi[],,,"wArcIHeartBeatTPSi",#NONE)
  ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  ;Input prepare signals group
  ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~  
  ArcPrepareSignals(#GroupInput,tWelderNr,,wsArcIPowerSourceMsg1[],,,"wsArcIPowerSourceMsg1",#wsArcIPowerSourceMsg1)
  ArcPrepareSignals(#GroupInput,tWelderNr,,wsArcIPowerSourceMsg2[],,,"wsArcIPowerSourceMsg2",#wsArcIPowerSourceMsg2)
  ArcPrepareSignals(#GroupInput,tWelderNr,,wsArcISeamNumberCode[],,,"wsArcISeamNumberCode",#wsArcISeamNumberCode)
  ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  ;Input prepare Sense Signal group or analogic input
  ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~    
  ArcPrepareSignals(#SenseInput,tWelderNr,,wsArcISenseSignals[],,,"wsArcISenseSignals",#wsArcISenseSignals)
  ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  ;Input prepare channels
  ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~  
  ArcPrepareSignals(#ChannelInput,tWelderNr,,,wsArcIChannel[,],,"wsArcIChannel",#wsArcIChannel)
  ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  ;Output prepare signals block 
  ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  ArcPrepareSignals(#BlockOutput,tWelderNr,,,wArcOGasPreFlowStart[,],,"wArcOGasPreFlowStart",#NONE)
  ArcPrepareSignals(#BlockOutput,tWelderNr,,,wArcOWeldStart[,],,"wArcOWeldStart",#NONE)
  ArcPrepareSignals(#BlockOutput,tWelderNr,,,wArcOIgnitProblem[,],,"wArcOIgnitProblem",#NONE)
  ArcPrepareSignals(#BlockOutput,tWelderNr,,,wArcOWeldProblem[,],,"wArcOWeldProblem",#NONE)
  ArcPrepareSignals(#BlockOutput,tWelderNr,,,wArcOReceiptError[,],,"wArcOReceiptError",#NONE)
  ArcPrepareSignals(#BlockOutput,tWelderNr,,,wArcOWeldEnd[,],,"wArcOWeldEnd",#NONE)
  ArcPrepareSignals(#BlockOutput,tWelderNr,,,wArcOGasPostFlowEnd[,],,"wArcOGasPostFlowEnd",#NONE)
  ArcPrepareSignals(#BlockOutput,tWelderNr,,,wArcOClearErrorArcOff[,],,"wArcOClearErrorArcOff",#NONE)
  ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  ;Output prepare signals
  ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  ArcPrepareSignals(#SingleOutput,tWelderNr,,wArcOWireFeedForward[],,,"wArcOWireFeedForward",#NONE)
  ArcPrepareSignals(#SingleOutput,tWelderNr,,wArcOWireFeedBackward[],,,"wArcOWireFeedBackward",#NONE)
  ArcPrepareSignals(#SingleOutput,tWelderNr,,wArcOWatchDogAlive[],,,"wArcOWatchDogAlive",#NONE)
  ArcPrepareSignals(#SingleOutput,tWelderNr,,wArcOBurnFreeFault[],,,"wArcOBurnFreeFault",#NONE)
  ArcPrepareSignals(#SingleOutput,tWelderNr,,wArcOCriticalIgnitError[],,,"wArcOCriticalIgnitError",#NONE)
  ArcPrepareSignals(#SingleOutput,tWelderNr,,wArcOCriticalSeamError[],,,"wArcOCriticalSeamError",#NONE)
  ArcPrepareSignals(#SingleOutput,tWelderNr,,wArcOCollisionDetect[],,,"wArcOCollisionDetect",#NONE)
  ArcPrepareSignals(#SingleOutput,tWelderNr,,wArcODecisionRequest[],,,"wArcODecisionRequest",#NONE)
  ArcPrepareSignals(#SingleOutput,tWelderNr,,wArcOWireDetectRequest[],,,"wArcOWireDetectRequest",#NONE)
  ArcPrepareSignals(#SingleOutput,tWelderNr,,wArcOBurnBack[],,,"wArcOBurnBack",#NONE)
  ArcPrepareSignals(#SingleOutput,tWelderNr,,wArcOPlcCleanPosition[],,,"wArcOPlcCleanPosition",#NONE)
  ArcPrepareSignals(#SingleOutput,tWelderNr,,wArcOGasActive[],,,"wArcOGasActive",#NONE)
  ArcPrepareSignals(#SingleOutput,tWelderNr,,wArcOAcknowledgePowerSrc[],,,"wArcOAcknowledgePowerSrc",#NONE)
  ArcPrepareSignals(#SingleOutput,tWelderNr,,wArcOTeachMode[],,,"wArcOTeachMode",#NONE)
  ArcPrepareSignals(#SingleOutput,tWelderNr,,wArcOProcessHot[],,,"wArcOProcessHot",#NONE)
  ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  ;Output prepare signals group
  ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  ArcPrepareSignals(#GroupOutput,tWelderNr,,wsArcOModiCoding[],,,"wsArcOModiCoding",#wsArcOModiCoding)
  ArcPrepareSignals(#GroupOutput,tWelderNr,,wsArcOVelocity[],,,"wsArcOVelocity",#wsArcOVelocity)
  ArcPrepareSignals(#GroupOutput,tWelderNr,,wsArcOSeamNumberCode[],,,"wsArcOSeamNumberCode",#wsArcOSeamNumberCode)
  ArcPrepareSignals(#GroupOutput,tWelderNr,,wsArcOWeldSelect[],,,"wsArcOWeldSelect",#wsArcOWeldSelect)
  ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  ;Output prepare channels
  ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~   
  ArcPrepareSignals(#ChannelOutput,tWelderNr,,,wsArcOChannel[,],,"wsArcOChannel",#wsArcOChannel)
ENDFOR
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;Output prepare PLC signals
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ArcPrepareSignals(#PlcGroupInput,1,wsArcIErrRecoveryPlcSign,,,,"wsArcIErrRecoveryPlcSign",#wsArcIErrRecoveryPlcSign)
ArcPrepareSignals(#PlcGroupInput,1,wsArcIMsgPlc,,,,"wsArcIMsgPlc",#wsArcIMsgPlc)
ArcPrepareSignals(#PlcGroupOutput,1,wsArcOMsgPlc,,,,"wsArcOMsgPlc",#wsArcOMsgPlc)
ArcPrepareSignals(#PlcGroupOutput,1,wsArcOWelderId,,,,"wsArcOWelderId",#wsArcOWelderId)

;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;SeamLength prepare signals
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ArcPrepareSignals(#PlcGroupInput,1,wArcISLPartId,,,,"wArcISLPartId",#wArcISLPartId)
ArcPrepareSignals(#PlcGroupOutput,1,wArcOSLErrorCode,,,,"wArcOSLErrorCode",#wArcOSLErrorCode)
ArcPrepareSignals(#PlcGroupOutput,1,wArcOSLSeamNum,,,,"wArcOSLSeamNum",#wArcOSLSeamNum)

FOR tI = 1 TO 4
  tArcSignal = ArcGetPartSignal(#SIN,tI)
  ArcPrepareSignals(#PlcSingleInput, 1,tArcSignal,,,,"mArcPartInput",#NONE)
  ArcSetPartSignal(#SIN,tI,tArcSignal)
ENDFOR
FOR tI = 1 TO 4
  tArcSignal = ArcGetPartSignal(#SOUT,tI)
  ArcPrepareSignals(#PlcSingleOutput, 1,tArcSignal,,,,"mArcPartOutput",#NONE)
  ArcSetPartSignal(#SOUT,tI,tArcSignal)
ENDFOR

;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;Reset memory message different Id Showed
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
mArcCheckModeIdShowed = FALSE
gArcForceTableInit    = FALSE
END
;***************************************************************
;[Routine] Prepare signals struc table
;***************************************************************
DEF ArcPrepareSignals(tStrucType :IN,tWelderNr: IN,tInStruc0 :OUT,tInStruc1[] :OUT,tInStruc2[,] :OUT,tInStruc3[,,] :OUT,tVarName[] :IN,tArcSignalVarName :IN)
DECL BOOL tB
DECL INT tI
DECL INT tI2
DECL INT tWelderNr
DECL enStrucType tStrucType
DECL stArcSignal_T tStruc
DECL stArcSignal_T tInStruc0
DECL stArcSignal_T tInStruc1[]
DECL stArcSignal_T tInStruc2[,]
DECL stArcSignal_T tInStruc3[,,]
DECL CHAR tVarName[]
DECL enArcSignalVarName_T tArcSignalVarName
tB = STRCOPY(mVarName[],tVarName[])
SWITCH tStrucType
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
  CASE #Input  ;Signal Input. . . . . ($IN[x])
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
    FOR tI = 1 TO 35
      tStruc                  = tInStruc2[tWelderNr,tI]
      IF (ArcVarExistI(tStruc.Offset.Offset) == TRUE) AND (gArcForceTableInit == FALSE) THEN
        RETURN ;Initialization Already done
      ENDIF
      tStruc.SigType          = #SIN
      tB                      = ArcVarExistI(tStruc.SignNr,0)
      tStruc.Source           = ArcGetSignalSource(tStruc)
      tStruc.Offset           = ArcGetOffset(tWelderNr,tStruc)
      tStruc.Active           = ArcGetSignalActive(tWelderNr,tStruc)
      tStruc.Description[]    = ArcGetSignalDescription(tStruc)
      tStruc.VarName          = tArcSignalVarName
      tInStruc2[tWelderNr,tI] = tStruc
      ArcCheckValue(tStruc,tI)
    ENDFOR
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
  CASE #SingleInput  ;Single Signal Input. . . . . ($IN[x1])
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
   tStruc                  = tInStruc1[tWelderNr]
   IF (ArcVarExistI(tStruc.Offset.Offset) == TRUE) AND (gArcForceTableInit == FALSE) THEN
     RETURN ;Initialization Already done
   ENDIF
   tStruc.SigType          = #SIN
   tB                      = ArcVarExistB(tStruc.State,FALSE) 
   tB                      = ArcVarExistI(tStruc.Index,0) 
   tB                      = ArcVarExistR(tStruc.TimeOut,0.0)
   tStruc.SignNr           = ArcGetFromIndexSignNr(tWelderNr,tStruc)
   tStruc.Source           = ArcGetFromIndexSource(tWelderNr,tStruc)
   tStruc.Offset           = ArcGetOffset(tWelderNr,tStruc)
   tStruc.Active           = ArcGetSignalActive(tWelderNr,tStruc)
   tStruc.Description[]    = ArcGetFromIndexDescript(tWelderNr,tStruc)
   tStruc.VarName          = tArcSignalVarName
   tInStruc1[tWelderNr]    = tStruc
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
  CASE #BlockInput  ;Block Signal Input. . . . . ($IN[x1] AND $IN[x2] AND $IN[x3] AND $IN[x4] AND $IN[x5] AND $IN[x6])
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
   tI2 = 1
   FOR tI = 1 TO 6
     tStruc                   = tInStruc2[tWelderNr,tI]
     IF (ArcVarExistI(tStruc.Offset.Offset) == TRUE) AND (gArcForceTableInit == FALSE) THEN
       RETURN ;Initialization Already done
     ENDIF
     tStruc.SigType           = #SIN
     tB                       = ArcVarExistB(tStruc.State,FALSE)
     tB                       = ArcVarExistI(tStruc.Index,0)
     tB                       = ArcVarExistR(tStruc.TimeOut,0.0)
     tStruc.SignNr            = ArcGetFromIndexSignNr(tWelderNr,tStruc)
     tStruc.Source            = ArcGetFromIndexSource(tWelderNr,tStruc)
     tStruc.Offset            = ArcGetOffset(tWelderNr,tStruc)
     tStruc.Active            = ArcGetSignalActive(tWelderNr,tStruc)
     tStruc.Description[]     = ArcGetFromIndexDescript(tWelderNr,tStruc)
     tStruc.VarName           = tArcSignalVarName
     tInStruc2[tWelderNr,tI2] = tStruc
     IF (tStruc.Active == TRUE) THEN
       tI2 = tI2 + 1
     ELSE
       tInStruc2[tWelderNr,tI].Active = FALSE
     ENDIF
   ENDFOR
   FOR tI = tI2 TO 6
     tInStruc2[tWelderNr,tI] = tInStruc2[tWelderNr,1]
     tInStruc2[tWelderNr,tI].Active = FALSE
     tB = STRCOPY(tInStruc2[tWelderNr,tI].Description[]," ")
   ENDFOR
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
  CASE #GroupInput  ;Signal Group Input  . ($IN[x]  TO $IN[xx])
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
    tStruc                  = tInStruc1[tWelderNr]
    IF (ArcVarExistI(tStruc.Offset.Offset) == TRUE) AND (gArcForceTableInit == FALSE) THEN
      RETURN ;Initialization Already done
    ENDIF    
    tStruc.SigType          = #GIN 
    tB                      = ArcVarExistI(tStruc.FromIndex,0)
    tB                      = ArcVarExistI(tStruc.ToIndex,0)
    tB                      = ArcVarExistI(tStruc.Length,0)
    tStruc.Source           = ArcGetSignalSource(tStruc)
    ArcGetSignalFromToLength(tStruc)
    tStruc.Offset           = ArcGetOffset(tWelderNr,tStruc)
    tStruc.Active           = ArcGetSignalActive(tWelderNr,tStruc)
    tStruc.VarName          = tArcSignalVarName
    tInStruc1[tWelderNr]    = tStruc
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
  CASE #ChannelInput  ;Channel Signal Group Input  . ($IN[x]  TO $IN[xx])
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
    FOR tI = 1 TO 8    
      tStruc                  = tInStruc2[tWelderNr,tI]   
      IF (ArcVarExistI(tStruc.Offset.Offset) == TRUE) AND (gArcForceTableInit == FALSE) THEN
        RETURN ;Initialization Already done
      ENDIF      
      tStruc.SigType          = #GIN
      tB                      = ArcVarExistI(tStruc.FromIndex,0)
      tB                      = ArcVarExistI(tStruc.ToIndex,0)
      tB                      = ArcVarExistI(tStruc.Length,0)
      tStruc.Source           = ArcGetSignalSource(tStruc)
      ArcGetSignalFromToLength(tStruc)
      tStruc.Offset           = ArcGetOffset(tWelderNr,tStruc)
      tStruc.Active           = ArcGetSignalActive(tWelderNr,tStruc)
      tStruc.VarName          = tArcSignalVarName
      tInStruc2[tWelderNr,tI] = tStruc
    ENDFOR
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
  CASE #PlcSingleInput  ;Single Signal Input. . . . . ($IN)
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
   tStruc                  = tInStruc0
   IF (ArcVarExistI(tStruc.Offset.Offset) == TRUE) AND (gArcForceTableInit == FALSE) THEN
     RETURN ;Initialization Already done
   ENDIF
   tStruc.SigType          = #SIN
   tB                      = ArcVarExistB(tStruc.State,FALSE) 
   tB                      = ArcVarExistI(tStruc.Index,0) 
   tB                      = ArcVarExistR(tStruc.TimeOut,0.0)
   tStruc.SignNr           = ArcGetFromIndexSignNr(tWelderNr,tStruc)
   tStruc.Source           = ArcGetFromIndexSource(tWelderNr,tStruc)
   tStruc.Offset           = ArcGetOffset(tWelderNr,tStruc)
   tStruc.Active           = ArcGetSignalActive(tWelderNr,tStruc)
   tStruc.Description[]    = ArcGetFromIndexDescript(tWelderNr,tStruc)
   tStruc.VarName          = tArcSignalVarName
   tInStruc0               = tStruc
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
  CASE #PlcGroupInput  ;Channel Signal Group Input  . ($IN[x]  TO $IN[xx])
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
    tStruc                  = tInStruc0
    IF (ArcVarExistI(tStruc.Offset.Offset) == TRUE) AND (gArcForceTableInit == FALSE) THEN
      RETURN ;Initialization Already done
    ENDIF    
    tStruc.SigType          = #GIN    
    tB                      = ArcVarExistI(tStruc.FromIndex,0)
    tB                      = ArcVarExistI(tStruc.ToIndex,0)
    tB                      = ArcVarExistI(tStruc.Length,0)
    tStruc.Source           = ArcGetSignalSource(tStruc)
    ArcGetSignalFromToLength(tStruc)      
    tStruc.Offset           = ArcGetOffset(tWelderNr,tStruc)
    tStruc.Active           = ArcGetSignalActive(tWelderNr,tStruc)
    tStruc.VarName          = tArcSignalVarName
    tInStruc0               = tStruc     
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
  CASE #SenseInput  ;Sense Signal Input  . ($IN[x]  TO $IN[xx]) OR Analog Input($ANIN[X]) 
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
    tStruc                  = tInStruc1[tWelderNr]
    IF (ArcVarExistI(tStruc.Offset.Offset) == TRUE) AND (gArcForceTableInit == FALSE) THEN
      RETURN ;Initialization Already done
    ENDIF    
    tB                      = ArcVarExistI(tStruc.FromIndex,0)
    tB                      = ArcVarExistI(tStruc.ToIndex,0)
    tB                      = ArcVarExistI(tStruc.Length,0)
    tB                      = ArcVarExistI(tStruc.AnaIndex,0)
    tStruc.Source           = ArcGetSignalSource(tStruc)
    tStruc.SigType          = ArcGetSignalSigType(tStruc)
    tStruc.VarName          = tArcSignalVarName
    SWITCH tStruc.SigType
      CASE #GIN
        ArcGetSignalFromToLength(tStruc)
        tStruc.Offset       = ArcGetOffset(tWelderNr,tStruc)
    ENDSWITCH    
    tStruc.Active           = ArcGetSignalActive(tWelderNr,tStruc)
    tInStruc1[tWelderNr]    = tStruc
    
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
  CASE #Output ;Signal Output . . . . ($OUT[x])                                                             
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
    FOR tI = 1 TO 35
      tStruc                  = tInStruc2[tWelderNr,tI]
      IF (ArcVarExistI(tStruc.Offset.Offset) == TRUE) AND (gArcForceTableInit == FALSE) THEN
        RETURN ;Initialization Already done
      ENDIF      
      tStruc.SigType          = #SOUT
      tB                      = ArcVarExistI(tStruc.SignNr,0)
      tB                      = ArcVarExistB(tStruc.InitState,FALSE)
      tStruc.Source           = ArcGetSignalSource(tStruc)
      tStruc.Offset           = ArcGetOffset(tWelderNr,tStruc)
      tStruc.Active           = ArcGetSignalActive(tWelderNr,tStruc)
      tStruc.Description[]    = ArcGetSignalDescription(tStruc)
      tStruc.VarName          = tArcSignalVarName
      tInStruc2[tWelderNr,tI] = tStruc
      ArcCheckValue(tStruc,tI)
    ENDFOR    
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
  CASE #SingleOutput  ;Single Signal Output. . . . . ($OUT[x1])
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
   tStruc                     = tInStruc1[tWelderNr]
   IF (ArcVarExistI(tStruc.Offset.Offset) == TRUE) AND (gArcForceTableInit == FALSE) THEN
     RETURN ;Initialization Already done
   ENDIF   
   tStruc.SigType             = #SOUT  
   tB                         = ArcVarExistB(tStruc.State,FALSE)
   tB                         = ArcVarExistI(tStruc.Index,0) 
   tB                         = ArcVarExistR(tStruc.PulsTime,0.0)
   tStruc.SignNr              = ArcGetFromIndexSignNr(tWelderNr,tStruc)
   tStruc.Source              = ArcGetFromIndexSource(tWelderNr,tStruc)
   tStruc.Offset              = ArcGetOffset(tWelderNr,tStruc)
   tStruc.Active              = ArcGetSignalActive(tWelderNr,tStruc)
   tStruc.Description[]       = ArcGetFromIndexDescript(tWelderNr,tStruc)
   tStruc.VarName             = tArcSignalVarName
   tInStruc1[tWelderNr]       = tStruc    
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
  CASE #BlockOutput  ;Block Signal Output. . . . . ($OUT[x1] AND $OUT[x2] AND $OUT[x3] AND $OUT[x4] AND $OUT[x5] AND $OUT[x6])
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
   FOR tI = 1 TO 6
     tStruc                   = tInStruc2[tWelderNr,tI] 
     IF (ArcVarExistI(tStruc.Offset.Offset) == TRUE) AND (gArcForceTableInit == FALSE) THEN
       RETURN ;Initialization Already done
     ENDIF     
     tStruc.SigType           = #SOUT
     tB                       = ArcVarExistB(tStruc.State,FALSE)
     tB                       = ArcVarExistI(tStruc.Index,0)  
     tB                       = ArcVarExistR(tStruc.PulsTime,0.0)
     tStruc.SignNr            = ArcGetFromIndexSignNr(tWelderNr,tStruc)
     tStruc.Source            = ArcGetFromIndexSource(tWelderNr,tStruc)
     tStruc.Offset            = ArcGetOffset(tWelderNr,tStruc)
     tStruc.Active            = ArcGetSignalActive(tWelderNr,tStruc)
     tStruc.Description[]     = ArcGetFromIndexDescript(tWelderNr,tStruc)
     tStruc.VarName           = tArcSignalVarName
     tInStruc2[tWelderNr,tI]  = tStruc
   ENDFOR
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
  CASE #GroupOutput  ;Signal Group Output  . ($OUT[x]  TO $OUT[xx])
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
    tStruc                    = tInStruc1[tWelderNr]  
    IF (ArcVarExistI(tStruc.Offset.Offset) == TRUE) AND (gArcForceTableInit == FALSE) THEN
      RETURN ;Initialization Already done
    ENDIF    
    tStruc.SigType            = #GOUT 
    tB                        = ArcVarExistI(tStruc.FromIndex,0)
    tB                        = ArcVarExistI(tStruc.ToIndex,0)
    tB                        = ArcVarExistI(tStruc.Length,0)
    ArcGetSignalFromToLength(tStruc)
    tStruc.Source             = ArcGetSignalSource(tStruc)
    tStruc.Offset             = ArcGetOffset(tWelderNr,tStruc)
    tStruc.Active             = ArcGetSignalActive(tWelderNr,tStruc)
    tStruc.VarName            = tArcSignalVarName
    tInStruc1[tWelderNr]      = tStruc    
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
  CASE #ChannelOutput  ;Channel Signal Group Output  . ($OUT[x]  TO $OUT[xx])
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
    FOR tI = 1 TO 8
      tStruc                  = tInStruc2[tWelderNr,tI]
      IF (ArcVarExistI(tStruc.Offset.Offset) == TRUE) AND (gArcForceTableInit == FALSE) THEN
        RETURN ;Initialization Already done
      ENDIF      
      tStruc.SigType          = #GOUT       
      tB                      = ArcVarExistI(tStruc.FromIndex,0)
      tB                      = ArcVarExistI(tStruc.ToIndex,0)
      tB                      = ArcVarExistI(tStruc.Length,0)
      ArcGetSignalFromToLength(tStruc)
      tStruc.Source           = ArcGetSignalSource(tStruc)
      tStruc.Offset           = ArcGetOffset(tWelderNr,tStruc)
      tStruc.Active           = ArcGetSignalActive(tWelderNr,tStruc)
      tStruc.VarName          = tArcSignalVarName
      tInStruc2[tWelderNr,tI] = tStruc      
    ENDFOR
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
  CASE #PlcSingleOutput  ;Single Signal Output. . . . . ($OUT)
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
   tStruc                     = tInStruc0
   IF (ArcVarExistI(tStruc.Offset.Offset) == TRUE) AND (gArcForceTableInit == FALSE) THEN
     RETURN ;Initialization Already done
   ENDIF   
   tStruc.SigType             = #SOUT  
   tB                         = ArcVarExistB(tStruc.State,FALSE)
   tB                         = ArcVarExistI(tStruc.Index,0) 
   tB                         = ArcVarExistR(tStruc.PulsTime,0.0)
   tStruc.SignNr              = ArcGetFromIndexSignNr(tWelderNr,tStruc)
   tStruc.Source              = ArcGetFromIndexSource(tWelderNr,tStruc)
   tStruc.Offset              = ArcGetOffset(tWelderNr,tStruc)
   tStruc.Active              = ArcGetSignalActive(tWelderNr,tStruc)
   tStruc.Description[]       = ArcGetFromIndexDescript(tWelderNr,tStruc)
   tStruc.VarName             = tArcSignalVarName
   tInStruc0                  = tStruc        
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
  CASE #PlcGroupOutput  ;Channel Signal Group Output  . ($OUT[x]  TO $OUT[xx])
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
    tStruc                    = tInStruc0    
    IF (ArcVarExistI(tStruc.Offset.Offset) == TRUE) AND (gArcForceTableInit == FALSE) THEN
      RETURN ;Initialization Already done
    ENDIF    
    tStruc.SigType            = #GOUT   
    tB                        = ArcVarExistI(tStruc.FromIndex,0)
    tB                        = ArcVarExistI(tStruc.ToIndex,0)
    tB                        = ArcVarExistI(tStruc.Length,0)
    tStruc.Source             = ArcGetSignalSource(tStruc)
    ArcGetSignalFromToLength(tStruc)     
    tStruc.Offset             = ArcGetOffset(tWelderNr,tStruc)
    tStruc.Active             = ArcGetSignalActive(tWelderNr,tStruc)
    tStruc.VarName            = tArcSignalVarName
    tInStruc0                 = tStruc      
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
  CASE #SpecialOutput  ;Special Signal Output  . ($OUT[x])
;<><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
    FOR tI = 1 TO 16
      FOR tI2 = 1 TO 8
        tStruc                      = tInStruc3[tWelderNr,tI,tI2]
        IF (ArcVarExistI(tStruc.Offset.Offset) == TRUE) AND (gArcForceTableInit == FALSE) THEN
          RETURN ;Initialization Already done
        ENDIF        
        tStruc.SigType              = #SOUT
        tB                          = ArcVarExistB(tStruc.State,FALSE)
        tB                          = ArcVarExistI(tStruc.SignNr,0)
        tStruc.Offset               = ArcGetOffset(tWelderNr,tStruc)
        tStruc.Active               = ArcGetSignalActive(tWelderNr,tStruc)
        tStruc.VarName              = tArcSignalVarName
        tInStruc3[tWelderNr,tI,tI2] = tStruc      
      ENDFOR
    ENDFOR    
ENDSWITCH
END
;***************************************************************
;[Routine] Get Wov Offset value from signal struc
;***************************************************************
DEFFCT INT ArcGetWovSignalOffset(tWelderNr :IN,tStruc :OUT)
DECL INT tWelderNr
DECL stArcSignal_T tStruc
ON_ERROR_PROCEED
tStruc.Source = tStruc.Source
IF ($ERR.NUMBER > 0) THEN
  ERR_CLEAR($ERR)
  RETURN 0
ENDIF
SWITCH tStruc.Source
  CASE #Welder
    SWITCH tStruc.SigType
      CASE #SIN,#GIN
         RETURN wArcIoOffset[tWelderNr].Welder.Input
      CASE #SOUT,#GOUT
        RETURN wArcIoOffset[tWelderNr].Welder.Output
    ENDSWITCH
    RETURN 0
  CASE #External
    SWITCH tStruc.SigType
      CASE #SIN,#GIN
         RETURN wArcIoOffset[tWelderNr].External.Input
      CASE #SOUT,#GOUT
        RETURN wArcIoOffset[tWelderNr].External.Output
    ENDSWITCH
    RETURN 0
ENDSWITCH
RETURN 0
ENDFCT
;***************************************************************
;[Routine] Get Active value from signal struc
;***************************************************************
DEFFCT BOOL ArcGetSignalActive(tWelderNr :IN,tStruc :OUT)
DECL BOOL tB
DECL BOOL tActive
DECL INT tI
DECL INT tWelderNr
DECL stArcSignal_T tStruc
ON_ERROR_PROCEED
tActive = tStruc.Active
IF ($ERR.NUMBER > 0) THEN
  ERR_CLEAR($ERR)
  tActive = TRUE
ENDIF
tActive = tActive AND ArcIsWelderActive(tWelderNr)
SWITCH tStruc.SigType
  CASE #SIN,#SOUT
    tActive = tActive AND (tStruc.Offset.SignNr > 0)
    IF (tActive == TRUE) THEN
      tB = ArcCheckSignal(tWelderNr,tStruc.Offset.SignNr,tStruc.SigType)
    ENDIF
  CASE #GIN,#GOUT
    tActive = tActive AND (tStruc.Offset.FromIndex > 0)
    tActive = tActive AND (tStruc.Offset.ToIndex > 0)
    tActive = tActive AND (tStruc.Offset.ToIndex >= tStruc.Offset.FromIndex)
    IF (tActive == TRUE) THEN
      FOR tI = tStruc.Offset.FromIndex TO tStruc.Offset.ToIndex
        tB = ArcCheckSignal(tWelderNr,tI,tStruc.SigType)
      ENDFOR    
    ENDIF
  CASE #AIN,#AOUT
    tActive = tActive AND (tStruc.AnaIndex >= 1)
    tActive = tActive AND (tStruc.AnaIndex <= 32)
  DEFAULT 
    tActive = FALSE
ENDSWITCH
RETURN tActive
ENDFCT
;***************************************************************
;[Routine] Check Value and Active
;***************************************************************
DEF ArcCheckValue(tStruc :OUT,tIndex :IN)
DECL BOOL tWrongConfig
DECL INT tHandle
DECL INT tIndex
DECL stArcSignal_T tStruc
tHandle = 0
tWrongConfig = (tStruc.Active == FALSE) AND (tStruc.Offset.SignNr > 0)
IF (tWrongConfig) THEN
  ArcMsgWriteS(tHandle,#QUIT,"AtbInternalError","ARC",10094,OPT_VLSTOP_LOG,gArcActIlfWelderName[],mVarName[],ArcIntToStr(tIndex))
ENDIF
END
;***************************************************************
;[Routine] Get Active value from signal struc
;***************************************************************
DEFFCT stArcSignalOffset_T ArcGetOffset(tWelderNr :IN,tStruc :OUT)
DECL INT tWelderNr
DECL INT tHandle
DECL stArcSignal_T tStruc
DECL stArcSignalOffset_T tStrucOffset
tHandle = 0
tStrucOffset.Offset = ArcGetWovSignalOffset(tWelderNr,tStruc)
ON_ERROR_PROCEED
SWITCH tStruc.SigType
  CASE #SIN,#SOUT
    tStrucOffset.SignNr = tStruc.SignNr + tStrucOffset.Offset
  CASE #GIN,#GOUT
    tStrucOffset.FromIndex = tStruc.FromIndex + tStrucOffset.Offset
    tStrucOffset.ToIndex   = tStruc.ToIndex + tStrucOffset.Offset
ENDSWITCH
RETURN tStrucOffset
ENDFCT
;***************************************************************
;[Routine] Get Signal Source value from signal struc
;***************************************************************
DEFFCT enArcSignalSource ArcGetSignalSource(tStruc :OUT)
DECL stArcSignal_T tStruc
ON_ERROR_PROCEED
tStruc.Source = tStruc.Source
IF ($ERR.NUMBER > 0) THEN
  ERR_CLEAR($ERR)
  RETURN #NONE
ENDIF
RETURN tStruc.Source
ENDFCT
;***************************************************************
;[Routine] Get Signal SigType
;***************************************************************
DEFFCT enSignalType ArcGetSignalSigType(tStruc :OUT)
DECL stArcSignal_T tStruc
ON_ERROR_PROCEED
tStruc.SigType = tStruc.SigType
IF ($ERR.NUMBER > 0) THEN
  ERR_CLEAR($ERR)
  RETURN #NONE
ENDIF
RETURN tStruc.SigType
ENDFCT
;***************************************************************
;[Routine] Get Signal Description
;***************************************************************
DEFFCT CHAR[40] ArcGetSignalDescription(tStruc :OUT)
DECL BOOL tB
DECL CHAR tDescription[40]
DECL stArcSignal_T tStruc
IF (STRLEN(tStruc.Description[]) < 2) THEN
  RETURN " "
ENDIF
SWITCH tStruc.SigType
  CASE #SIN,#SOUT
    IF (tStruc.Active == FALSE) THEN
      RETURN " "
    ENDIF
  DEFAULT 
    RETURN " "
ENDSWITCH
tDescription[] = " "
tB = STRCOPY(tDescription[],ArcStrRemoveLeft(tStruc.Description[],"]-"))
RETURN tDescription[]
ENDFCT
;***************************************************************
;[Routine] Get SignalNr value from index
;***************************************************************
DEFFCT INT ArcGetFromIndexSignNr(tWelderNr :IN,tStruc :OUT)
DECL INT tWelderNr
DECL INT tVal
DECL stArcSignal_T tStruc
DECL stArcSignal_T tIOStruc
tVal = 0
tIOStruc = ArcGetInputOutput(tWelderNr,tStruc)
ON_ERROR_PROCEED
tVal = tIOStruc.SignNr
IF ($ERR.NUMBER > 0) THEN
  ERR_CLEAR($ERR)
  RETURN 0
ENDIF
RETURN tVal
ENDFCT
;***************************************************************
;[Routine] Get Source value from index
;***************************************************************
DEFFCT enArcSignalSource ArcGetFromIndexSource(tWelderNr :IN,tStruc :OUT)
DECL INT tWelderNr
DECL enArcSignalSource tSource
DECL stArcSignal_T tStruc
DECL stArcSignal_T tIOStruc
tSource = #NONE
tIOStruc = ArcGetInputOutput(tWelderNr,tStruc)
ON_ERROR_PROCEED
tSource = tIOStruc.Source
IF ($ERR.NUMBER > 0) THEN
  ERR_CLEAR($ERR)
  RETURN #NONE
ENDIF
RETURN tSource
ENDFCT
;***************************************************************
;[Routine] Get Description value from index
;***************************************************************
DEFFCT CHAR[40] ArcGetFromIndexDescript(tWelderNr :IN,tStruc :OUT)
DECL BOOL tB
DECL INT tI
DECL INT tWelderNr
DECL CHAR tDes[40]
DECL CHAR tDescription[40]
DECL stArcSignal_T tStruc
DECL stArcSignal_T tIOStruc
tDes[] = " "
tDescription[] = " "
IF (tStruc.Active == FALSE) THEN
  RETURN " "
ENDIF
tIOStruc = ArcGetInputOutput(tWelderNr,tStruc)
SWITCH tStruc.SigType
  CASE #SIN
    ON_ERROR_PROCEED
    tB = STRCOPY(tDes[],tIOStruc.Description[])
    tDescription[] = "$IN["
  CASE #SOUT
    ON_ERROR_PROCEED
    tB = STRCOPY(tDes[],tIOStruc.Description[])
    tDescription[] = "$OUT["
  DEFAULT
    RETURN " "
ENDSWITCH
IF ($ERR.NUMBER > 0) THEN
  ERR_CLEAR($ERR)
  RETURN " "
ENDIF
tI = STRADD(tDescription[],ArcIntToStr(tStruc.Offset.SignNr))
tI = STRADD(tDescription[],"]-")
tI = STRADD(tDescription[],tDes[])
RETURN tDescription[]
ENDFCT
;***************************************************************
;[Routine] Get input / Output value from database
;***************************************************************
DEFFCT stArcSignal_T ArcGetInputOutput(tWelderNr :IN,tStruc :OUT)
DECL INT tWelderNr
DECL stArcSignal_T tStruc
IF (tStruc.Index <= 0) THEN
  RETURN {Active FALSE}
ENDIF
SWITCH tStruc.SigType
  CASE #SIN
    RETURN wArcInput[tWelderNr,tStruc.Index]
  CASE #SOUT
    RETURN wArcOutput[tWelderNr,tStruc.Index]
ENDSWITCH         
ENDFCT
;***************************************************************
;[Routine] Check Signal if is system variable
;0: FALSE and not simulated
;1: TRUE and not simulated
;2: FALSE and simulated
;3: TRUE and simulated
;4: FALSE and not simulated and system input
;5: TRUE and not simulated and system input
;6: FALSE and simulated and system input
;7: TRUE and simulated and system input
;***************************************************************
DEFFCT BOOL ArcCheckSignal(tWelderNr :IN,tSignalNr :IN,tSigType :IN)
DECL BOOL tActive
DECL INT tWelderNr
DECL INT tSignalNr
DECL INT tHandle
DECL CHAR tSys[2]
DECL enSignalType tSigType
tHandle = 0
tActive = TRUE
SWITCH tSigType
  CASE #SIN,#GIN
    IF (tSignalNr > 0) THEN
      tSys[1] = $IOSIM_IN[tSignalNr]
      SWITCH ArcStrToInt(tSys[])
        CASE 4,5,6,7
          ArcMsgWriteS(tHandle,#QUIT,"SystemInputValue","ARC",10151,Opt_NOVLSTOP_LOG,ArcIntToStr(tWelderNr),ArcIntToStr(tSignalNr),mVarName[])
          tActive = FALSE
      ENDSWITCH
    ENDIF
  CASE #SOUT,#GOUT
    IF (tSignalNr > 0) THEN
      tSys[1] = $IOSIM_OUT[tSignalNr]
      SWITCH ArcStrToInt(tSys[])
        CASE 4,5,6,7
          ArcMsgWriteS(tHandle,#QUIT,"SystemOutputValue","ARC",10152,Opt_NOVLSTOP_LOG,ArcIntToStr(tWelderNr),ArcIntToStr(tSignalNr),mVarName[])
          tActive = FALSE
      ENDSWITCH
    ENDIF      
ENDSWITCH
RETURN tActive
ENDFCT
;***************************************************************
;[Routine] Get signal ToIndex and Length and from FromIndex 
;***************************************************************
DEF ArcGetSignalFromToLength(tStruc :OUT)
DECL stArcSignal_T tStruc
IF ((tStruc.ToIndex == 0) AND (tStruc.Length == 0)) THEN
  RETURN 
ENDIF
IF ((tStruc.ToIndex > 0) AND (tStruc.Length > 0)) THEN
  RETURN 
ENDIF
IF ((tStruc.ToIndex > 0) AND (tStruc.Length == 0)) THEN
  tStruc.Length = tStruc.ToIndex - tStruc.FromIndex + 1
  RETURN 
ENDIF
IF ((tStruc.ToIndex == 0) AND (tStruc.Length > 0)) THEN
  tStruc.ToIndex = tStruc.FromIndex + tStruc.Length
  RETURN 
ENDIF
END
;***************************************************************
;[Global Routine] Check Group Output Signals
;***************************************************************
GLOBAL DEFFCT BOOL ArcOutputCheckGroup(tWelderNr: IN,tStruc[,] :OUT)
DECL INT tI
DECL INT tWelderNr
DECL stArcSignal_T tStruc[,]
DECL BOOL tAnyOutActive
tAnyOutActive = FALSE
FOR tI = 1 TO 6
  IF (tStruc[tWelderNr,tI].Active == TRUE) THEN
     tAnyOutActive = TRUE
  ENDIF
RETURN tAnyOutActive
ENDFOR
ENDFCT
;***************************************************************
;[Global Routine] Check Output in Group
;***************************************************************
GLOBAL DEFFCT BOOL ArcOutputCheckInGroup(tWelderNr: IN,tStrucOut[] :OUT,tStrucGout[,] :OUT)
DECL INT tI
DECL INT tWelderNr
DECL INT tSigNr
DECL stArcSignal_T tStrucOut[]
DECL stArcSignal_T tStrucGout[,]
DECL BOOL tOutputIsInGroup
tOutputIsInGroup = FALSE
tSigNr = 0

IF (tStrucOut[tWelderNr].Active == TRUE) THEN
  tSigNr = tStrucOut[tWelderNr].Offset.SignNr
ENDIF

FOR tI = 1 TO 6
  IF (tStrucGout[tWelderNr,tI].Active == TRUE) THEN
    IF (tStrucGout[tWelderNr,tI].Offset.SignNr == tSigNr) THEN
      tOutputIsInGroup = TRUE
    ENDIF
  ENDIF
ENDFOR

RETURN tOutputIsInGroup
ENDFCT
;***************************************************************
;[Global Routine] Set Output Signals
;***************************************************************
GLOBAL DEF ArcOutputSet(tWelderNr: IN,tStruc[] :OUT)
DECL INT tWelderNr
DECL stArcSignal_T tStruc[]
IF (tStruc[tWelderNr].Active == TRUE) THEN
  $OUT[tStruc[tWelderNr].Offset.SignNr] = tStruc[tWelderNr].State
ENDIF
END
;***************************************************************
;[Global Routine] Reset Output Signals
;***************************************************************
GLOBAL DEF ArcOutputReset(tWelderNr: IN,tStruc[] :OUT)
DECL INT tWelderNr
DECL stArcSignal_T tStruc[]
IF (tStruc[tWelderNr].Active == TRUE) THEN
  $OUT[tStruc[tWelderNr].Offset.SignNr] = NOT tStruc[tWelderNr].State
ENDIF
END
;***************************************************************
;[Global Routine] Set Group Output Signals
;***************************************************************
GLOBAL DEF ArcOutputGroupSet(tWelderNr: IN,tStruc[,] :OUT)
DECL INT tI
DECL INT tWelderNr
DECL stArcSignal_T tStruc[,]
FOR tI = 1 TO 6
  IF (tStruc[tWelderNr,tI].Active == TRUE) THEN
    $OUT[tStruc[tWelderNr,tI].Offset.SignNr] = tStruc[tWelderNr,tI].State
  ENDIF
ENDFOR
END
;***************************************************************
;[Global Routine] Set Group Output Signals
;***************************************************************
GLOBAL DEF ArcOutputGroupReset(tWelderNr: IN,tStruc[,] :OUT)
DECL INT tI
DECL INT tWelderNr
DECL stArcSignal_T tStruc[,]
FOR tI = 1 TO 6
  IF (tStruc[tWelderNr,tI].Active == TRUE) THEN
    $OUT[tStruc[tWelderNr,tI].Offset.SignNr] = NOT tStruc[tWelderNr,tI].State
  ENDIF  
ENDFOR
END
;***************************************************************
;[Global Routine] Set Pulse Output Signals
;Default pulse time from structure or user pulse time
;***************************************************************
GLOBAL DEF ArcOutputPulseSet(tWelderNr :IN,tStruc[] :OUT, tPulseTime :OUT, tWaitPulseEnd :IN)
DECL BOOL tWaitPulseEnd
DECL INT tWelderNr
DECL REAL tPulseTime,tPulseTimeCalc
DECL stArcSignal_T tStruc[]
IF (tStruc[tWelderNr].Active == FALSE) THEN
  RETURN
ENDIF
ERR_CLEAR($ERR)
ON_ERROR_PROCEED
tPulseTime = tPulseTime
IF ($ERR.NUMBER <> 0) THEN 
  tPulseTime = tStruc[tWelderNr].PulsTime
ENDIF
tPulseTimeCalc=tPulseTime
IF (tPulseTime < 0.1) THEN
  tPulseTime = 0.1
ENDIF
PULSE($OUT[tStruc[tWelderNr].Offset.SignNr],tStruc[tWelderNr].State,tPulseTime)
ERR_CLEAR($ERR)
ON_ERROR_PROCEED
tWaitPulseEnd = tWaitPulseEnd
IF ($ERR.NUMBER == 0) THEN 
  IF (tWaitPulseEnd == TRUE) THEN
    WAIT SEC tPulseTimeCalc
  ENDIF
ELSE
  ERR_CLEAR($ERR)
ENDIF
END
;***************************************************************
;[Global Routine] Set Group Pulse Output Signals
;***************************************************************
GLOBAL DEF ArcOutputPulseGroupSet(tWelderNr :IN,tStruc[,] :OUT)
DECL INT tI
DECL INT tWelderNr
DECL stArcSignal_T tStruc[,]
FOR tI = 1 TO 6
  IF (tStruc[tWelderNr,tI].Active == TRUE) THEN
    IF (tStruc[tWelderNr,tI].PulsTime > 0) THEN
      PULSE($OUT[tStruc[tWelderNr,tI].Offset.SignNr],tStruc[tWelderNr,tI].State,tStruc[tWelderNr,tI].PulsTime)
    ELSE
      $OUT[tStruc[tWelderNr,tI].Offset.SignNr] = tStruc[tWelderNr,tI].State
    ENDIF
  ENDIF
ENDFOR
END
;***************************************************************
;[Global Routine] Initialize Output Signals
;***************************************************************
GLOBAL DEF ArcOutputInit(tWelderNr :IN,tStruc[] :OUT)
DECL INT tWelderNr
DECL stArcSignal_T tStruc[]
IF (tStruc[tWelderNr].Active == TRUE) THEN
  $OUT[tStruc[tWelderNr].Offset.SignNr] = tStruc[tWelderNr].InitState
ENDIF
END
;***************************************************************
;[Global Routine] InitState All Output Signals
;TODO
;***************************************************************
GLOBAL DEF ArcInitStateOutputs(tWelderNr :IN)
DECL INT tI
DECL INT tWelderNr
DECL stArcSignal_T tStruc
  FOR tI = 1 TO 50
    ON_ERROR_PROCEED
    tStruc = wArcOutput[tWelderNr,tI]
    IF ($ERR.NUMBER > 0) THEN
      ERR_CLEAR($ERR)
      RETURN
    ENDIF
    IF (tStruc.Active == TRUE) THEN
      IF (tStruc.Offset.SignNr <> wArcOWatchDogAlive[tWelderNr].Offset.SignNr) THEN ;Don't Reset Robot Ready Signal
        $OUT[tStruc.Offset.SignNr] = tStruc.InitState
      ENDIF
    ENDIF
  ENDFOR
END
;***************************************************************
;[Global Routine] Initialize All Output Signals
;TODO
;***************************************************************
GLOBAL DEF ArcClearOutputs(tWelderNr :IN,tResetType :IN)
DECL INT tReturn
DECL INT tWelderNr
DECL INT tI
DECL BOOL tResetMode
DECL BOOL tResetChannels
DECL BOOL tResetSpecFunc
DECL stArcSignal_T tOChannel
DECL stPowerSource_T tPowerSource
DECL enArcResetType_T tResetType
IF (ArcIsWelderActive(tWelderNr) == FALSE) THEN
  ;ArcWriteDiag(gArcGeneralDebug,"[RESET OUT] Disable")
  RETURN
ENDIF

tResetMode        = FALSE
tResetChannels    = FALSE
tResetSpecFunc    = FALSE

SWITCH tResetType
  CASE #SubmitInit
    ArcWriteDiag(gArcGeneralDebug,"[RESET OUT] SubmitInit")
    ArcInitStateOutputs(tWelderNr)
    tResetMode      = TRUE
    tResetSpecFunc  = TRUE
    tResetChannels  = TRUE

  CASE #ProgReset
    ;ArcWriteDiag(gArcGeneralDebug,"[RESET OUT] ProgReset")
    ArcInitStateOutputs(tWelderNr)
    tResetMode      = FALSE
    tResetSpecFunc  = FALSE
    tResetChannels  = FALSE

  CASE #ArcOff
    ;ArcWriteDiag(gArcGeneralDebug,"[RESET OUT] ArcOff")
    SWITCH wArcWelder[tWelderNr].Type
      CASE #ARCLINKXT,#FRONIUS_TPS,#FRONIUS_TPSI,#FRONIUS_TWIN
        tResetMode      = FALSE
        tResetSpecFunc  = FALSE
        tResetChannels  = FALSE
      DEFAULT
        tResetMode      = FALSE
        tResetSpecFunc  = FALSE
        tResetChannels  = FALSE
    ENDSWITCH

  CASE #LineSel
    ;ArcWriteDiag(gArcGeneralDebug,"[RESET OUT] LineSel")
    tResetMode      = FALSE
    tResetSpecFunc  = FALSE
    tResetChannels  = FALSE

  CASE #StatKeyReset
    ;ArcWriteDiag(gArcGeneralDebug,"[RESET OUT] StatKeyReset")
    tResetMode      = TRUE
    tResetSpecFunc  = TRUE
    tResetChannels  = TRUE

  CASE #StatKeyCold
    ;ArcWriteDiag(gArcGeneralDebug,"[RESET OUT] StatkeyCold")
    tResetMode        = TRUE
    tResetSpecFunc    = TRUE
    tResetChannels    = TRUE

  DEFAULT
    ;ArcWriteDiag(gArcGeneralDebug,"[RESET OUT] Default")
    tResetMode      = FALSE
    tResetSpecFunc  = FALSE
    tResetChannels  = FALSE
ENDSWITCH

SWITCH wArcWelder[tWelderNr].Type
  CASE #ARCLINKXT
    tPowerSource = stArcInitArcLinkXT
  CASE #FRONIUS_TPSI
    tPowerSource = stArcInitFroniusTpsI
  CASE #FRONIUS_TPS
    tPowerSource = stArcInitFroniusTps
  CASE #FRONIUS_TWIN
    tPowerSource = stArcInitFroniusTwin
  CASE #EWM
    tPowerSource = stArcInitEwm
  CASE #LORCH
    tPowerSource = stArcInitLorch
  CASE #KEMPPI
    tPowerSource = stArcInitKemppi
  DEFAULT
    tPowerSource = stArcInitStandard
ENDSWITCH

IF (gArcClearArcMode == TRUE) THEN
  tResetMode = TRUE
ENDIF

IF (gArcClearChannels == TRUE) THEN
  tResetChannels  = TRUE
ENDIF

IF (gArcClearSpecFunc == TRUE) THEN
  tResetSpecFunc = TRUE
ENDIF

IF (tResetMode == TRUE) THEN
  IF (gArcSignalGroupSelection == TRUE) THEN
    ArcOutSignalGroup(wsArcOModiCoding[tWelderNr],tWelderNr,0,tPowerSource.Mode)
  ELSE
    ArcIntToBit($OUT[],wsArcOModiCoding[tWelderNr],tPowerSource.Mode)
  ENDIF
ENDIF

IF (tResetChannels == TRUE) THEN
  IF (gArcSignalGroupSelection == TRUE) THEN
    ArcOutSignalGroup(wsArcOChannel[tWelderNr,1],tWelderNr,1,tPowerSource.Channel1)
    ArcOutSignalGroup(wsArcOChannel[tWelderNr,2],tWelderNr,2,tPowerSource.Channel2)
    ArcOutSignalGroup(wsArcOChannel[tWelderNr,3],tWelderNr,3,tPowerSource.Channel3)
    ArcOutSignalGroup(wsArcOChannel[tWelderNr,4],tWelderNr,4,tPowerSource.Channel4)
    ArcOutSignalGroup(wsArcOChannel[tWelderNr,5],tWelderNr,5,tPowerSource.Channel5)
    ArcOutSignalGroup(wsArcOChannel[tWelderNr,6],tWelderNr,6,tPowerSource.Channel6)
    ArcOutSignalGroup(wsArcOChannel[tWelderNr,7],tWelderNr,7,tPowerSource.Channel7)
    ArcOutSignalGroup(wsArcOChannel[tWelderNr,8],tWelderNr,8,tPowerSource.Channel8)
  ELSE
    tOChannel   = wsArcOChannel[tWelderNr,1]
    ArcSetSignalGroupValue(tOChannel,tPowerSource.Channel1)
    tOChannel   = wsArcOChannel[tWelderNr,2]
    ArcSetSignalGroupValue(tOChannel,tPowerSource.Channel2)
    tOChannel   = wsArcOChannel[tWelderNr,3]
    ArcSetSignalGroupValue(tOChannel,tPowerSource.Channel3)
    tOChannel   = wsArcOChannel[tWelderNr,4]
    ArcSetSignalGroupValue(tOChannel,tPowerSource.Channel4)
    tOChannel   = wsArcOChannel[tWelderNr,5]
    ArcSetSignalGroupValue(tOChannel,tPowerSource.Channel5)
    tOChannel   = wsArcOChannel[tWelderNr,6]
    ArcSetSignalGroupValue(tOChannel,tPowerSource.Channel6)
    tOChannel   = wsArcOChannel[tWelderNr,7]
    ArcSetSignalGroupValue(tOChannel,tPowerSource.Channel7)
    tOChannel   = wsArcOChannel[tWelderNr,8]
    ArcSetSignalGroupValue(tOChannel,tPowerSource.Channel8)
  ENDIF
ENDIF

IF (tResetSpecFunc == TRUE) THEN
  ArcOutputSpecAllInit(tWelderNr,FALSE)
ENDIF
END
;***************************************************************
;[Global Routine] Initialize All Special Mode Output Signals
;***************************************************************
GLOBAL DEF ArcOutputSpecAllInit(tWelderNr :IN,tInitValue :IN)
DECL BOOL tInitValue
DECL INT tI, tArcMode
DECL INT tWelderNr
DECL stArcSignal_T tSpecial
tArcMode = 1
FOR tI = 1 TO 8
  ON_ERROR_PROCEED
  tSpecial = wArcOSpecial[tWelderNr,tArcMode,tI]
  IF ($ERR.NUMBER > 0) THEN
    ERR_CLEAR($ERR)
    RETURN
  ENDIF
  IF (tSpecial.Active == TRUE) THEN
    $OUT[tSpecial.Offset.SignNr] = tInitValue
  ENDIF
ENDFOR
END
;***************************************************************
;[Global Routine] is input or output signal Active
;Parameter:
;         -tStruc: Structure
; Return:
;        TRUE  = Active
;        FALSE = Disable
;***************************************************************
GLOBAL DEFFCT BOOL ArcIsSignalActive(tStruc:IN)
DECL stArcSignal_T tStruc
RETURN tStruc.Active
ENDFCT
;***************************************************************
;[Global Routine] Input Single Status On with timeout
;Parameter:
;         -tStruc: Structure
;         -tTimeOut    :time out signal
; Return:
;        -1 = Not Used
;         0 = Signal FALSE
;         1 = Signal TRUE
;***************************************************************
GLOBAL DEFFCT INT ArcInputSingleStatusOn(tStruc :OUT,tTimeOut :IN)
DECL REAL tTimeOut
DECL stArcSignal_T tStruc
IF (tStruc.Active == FALSE) THEN
  RETURN -1
ENDIF
IF (tTimeOut > 0)THEN
  WAIT FOR (($IN[tStruc.Offset.SignNr] == tStruc.State) OR TIMER_LIMIT(tTimeOut))
ENDIF
IF ($IN[tStruc.Offset.SignNr] == tStruc.State) THEN
  RETURN 1
ELSE
  RETURN 0
ENDIF
RETURN -1
ENDFCT
;***************************************************************
;[Global Routine] Input Single Status Off with timeout
;Parameter:
;         -tStruc: Structure
;         -tTimeOut    :time out signal
; Return:
;        -1 = Not Used
;         0 = Signal FALSE
;         1 = Signal TRUE
;***************************************************************
GLOBAL DEFFCT INT ArcInputSingleStatusOff(tStruc :OUT,tTimeOut :IN)
DECL REAL tTimeOut
DECL stArcSignal_T tStruc
IF (tStruc.Active == FALSE) THEN
  RETURN -1
ENDIF
IF (tTimeOut > 0)THEN
  WAIT FOR (($IN[tStruc.Offset.SignNr] <> tStruc.State) OR TIMER_LIMIT(tTimeOut))
ENDIF
IF ($IN[tStruc.Offset.SignNr] <> tStruc.State) THEN
  RETURN 1
ELSE
  RETURN 0
ENDIF
RETURN -1
ENDFCT
;***************************************************************
;[Global Routine] Input Status On with timeout
;Parameter:
;         -tWelderNr: Welder number
;         -tInStruc: Structure
;         -tTimeOut    :time out signal
; Return:
;        -1 = Not Used
;         0 = Signal FALSE
;         1 = Signal TRUE
;***************************************************************
GLOBAL DEFFCT INT ArcInputStatusOn(tWelderNr :IN,tStruc[] :OUT,tTimeOut :IN)
DECL INT tWelderNr
DECL REAL tTimeOut
DECL stArcSignal_T tStruc[]
IF (tStruc[tWelderNr].Active == FALSE) THEN
  RETURN -1
ENDIF
IF (tTimeOut > 0)THEN
  WAIT FOR (($IN[tStruc[tWelderNr].Offset.SignNr] == tStruc[tWelderNr].State) OR TIMER_LIMIT(tTimeOut))
ENDIF
IF ($IN[tStruc[tWelderNr].Offset.SignNr] == tStruc[tWelderNr].State) THEN
  RETURN 1
ELSE
  RETURN 0
ENDIF
RETURN -1
ENDFCT
;***************************************************************
;[Global Routine] Input Status Off with timeout
;Parameter:
;         -tWelderNr: Welder number
;         -tInStruc: Structure
;         -tTimeOut    :time out signal
; Return:
;        -1 = Not Used
;         0 = Signal FALSE
;         1 = Signal TRUE
;***************************************************************
GLOBAL DEFFCT INT ArcInputStatusOff(tWelderNr :IN,tStruc[] :OUT,tTimeOut :IN)
DECL INT tWelderNr
DECL REAL tTimeOut
DECL stArcSignal_T tStruc[]
IF (tStruc[tWelderNr].Active == FALSE) THEN
  RETURN -1
ENDIF
IF (tTimeOut > 0)THEN
  WAIT FOR (($IN[tStruc[tWelderNr].Offset.SignNr] <> tStruc[tWelderNr].State) OR TIMER_LIMIT(tTimeOut))
ENDIF
IF ($IN[tStruc[tWelderNr].Offset.SignNr] <> tStruc[tWelderNr].State) THEN
  RETURN 1
ELSE
  RETURN 0
ENDIF
RETURN -1
ENDFCT
;***************************************************************
;[Global Routine] Input Group[1..6] Status On with timeout
;Parameter:
;         -tWelderNr: Welder number
;         -tInStruc: Structure
;         -tTimeOut    :time out signal
; Return:
;        -1 = Not Used
;         0 = Signal FALSE
;         1 = Signal TRUE
;***************************************************************
GLOBAL DEFFCT INT ArcInputGroupStatusOn(tWelderNr :IN,tStruc[,] :OUT,tTimeOut :IN,tSimulateError :IN)
DECL INT tWelderNr
DECL REAL tTimeOut
DECL BOOL tSimulateError
DECL stArcSignal_T tStruc[,]
IF (tStruc[tWelderNr,1].Active == FALSE) THEN
  RETURN -1
ENDIF
ON_ERROR_PROCEED
tSimulateError = tSimulateError
IF ($ERR.NUMBER > 0) THEN
  tSimulateError = FALSE
ENDIF
ERR_CLEAR($ERR)
IF (tSimulateError == TRUE) THEN
  ArcMsg("[Simulate] ArcInputGroupStatusOn RETURN 0")
  RETURN 0
ENDIF
IF (tTimeOut > 0)THEN
  WAIT FOR ((($IN[tStruc[tWelderNr,1].Offset.SignNr]==tStruc[tWelderNr,1].State)AND($IN[tStruc[tWelderNr,2].Offset.SignNr]==tStruc[tWelderNr,2].State)AND($IN[tStruc[tWelderNr,3].Offset.SignNr]==tStruc[tWelderNr,3].State)AND($IN[tStruc[tWelderNr,4].Offset.SignNr]==tStruc[tWelderNr,4].State)AND($IN[tStruc[tWelderNr,5].Offset.SignNr]==tStruc[tWelderNr,5].State)AND($IN[tStruc[tWelderNr,6].Offset.SignNr]==tStruc[tWelderNr,6].State))OR(TIMER_LIMIT(tTimeOut)))
ENDIF
IF (($IN[tStruc[tWelderNr,1].Offset.SignNr]==tStruc[tWelderNr,1].State)AND($IN[tStruc[tWelderNr,2].Offset.SignNr]==tStruc[tWelderNr,2].State)AND($IN[tStruc[tWelderNr,3].Offset.SignNr]==tStruc[tWelderNr,3].State)AND($IN[tStruc[tWelderNr,4].Offset.SignNr]==tStruc[tWelderNr,4].State)AND($IN[tStruc[tWelderNr,5].Offset.SignNr]==tStruc[tWelderNr,5].State)AND($IN[tStruc[tWelderNr,6].Offset.SignNr]==tStruc[tWelderNr,6].State)) THEN
  RETURN 1
ELSE
  RETURN 0
ENDIF
RETURN -1
ENDFCT
;***************************************************************
;[Global Routine] Input Group[1..6] Status Off with timeout
;Parameter:
;         -tWelderNr: Welder number
;         -tInStruc: Structure
;         -tTimeOut    :time out signal
; Return:
;        -1 = Not Used
;         0 = Signal FALSE
;         1 = Signal TRUE
;***************************************************************
GLOBAL DEFFCT INT ArcInputGroupStatusOff(tWelderNr :IN,tStruc[,] :OUT,tTimeOut :IN)
DECL INT tWelderNr
DECL REAL tTimeOut
DECL stArcSignal_T tStruc[,]
IF (tStruc[tWelderNr,1].Active == FALSE) THEN
  RETURN -1
ENDIF
IF (tTimeOut > 0)THEN
  WAIT FOR ((($IN[tStruc[tWelderNr,1].Offset.SignNr]<>tStruc[tWelderNr,1].State)AND($IN[tStruc[tWelderNr,2].Offset.SignNr]<>tStruc[tWelderNr,2].State)AND($IN[tStruc[tWelderNr,3].Offset.SignNr]<>tStruc[tWelderNr,3].State)AND($IN[tStruc[tWelderNr,4].Offset.SignNr]<>tStruc[tWelderNr,4].State)AND($IN[tStruc[tWelderNr,5].Offset.SignNr]<>tStruc[tWelderNr,5].State)AND($IN[tStruc[tWelderNr,6].Offset.SignNr]<>tStruc[tWelderNr,6].State))OR(TIMER_LIMIT(tTimeOut)))
ENDIF
IF (($IN[tStruc[tWelderNr,1].Offset.SignNr]<>tStruc[tWelderNr,1].State)AND($IN[tStruc[tWelderNr,2].Offset.SignNr]<>tStruc[tWelderNr,2].State)AND($IN[tStruc[tWelderNr,3].Offset.SignNr]<>tStruc[tWelderNr,3].State)AND($IN[tStruc[tWelderNr,4].Offset.SignNr]<>tStruc[tWelderNr,4].State)AND($IN[tStruc[tWelderNr,5].Offset.SignNr]<>tStruc[tWelderNr,5].State)AND($IN[tStruc[tWelderNr,6].Offset.SignNr]<>tStruc[tWelderNr,6].State)) THEN  
  RETURN 1
ELSE
  RETURN 0
ENDIF
RETURN -1
ENDFCT
;***************************************************************
;[Global Routine] Output Group Status On with timeout
;Parameter:
;         -tWelderNr: Welder number
;         -tInStruc: Structure
;         -tTimeOut    :time out signal
; Return:
;        -1 = Not Used
;         0 = Signal FALSE
;         1 = Signal TRUE
;***************************************************************
GLOBAL DEFFCT INT ArcOutputStatusOn(tWelderNr :IN,tStruc[] :OUT,tTimeOut :IN)
DECL INT tWelderNr
DECL REAL tTimeOut
DECL stArcSignal_T tStruc[]
IF (tStruc[tWelderNr].Active == FALSE) THEN
  RETURN -1
ENDIF
IF (tTimeOut > 0)THEN
  WAIT FOR (($OUT[tStruc[tWelderNr].Offset.SignNr] == tStruc[tWelderNr].State) OR (TIMER_LIMIT(tTimeOut)))
ENDIF
IF ($OUT[tStruc[tWelderNr].Offset.SignNr] == tStruc[tWelderNr].State) THEN
  RETURN 1
ELSE
  RETURN 0
ENDIF
RETURN -1
ENDFCT
;***************************************************************
;[Global Routine] Output Group Status Off with timeout
;Parameter:
;         -tWelderNr: Welder number
;         -tInStruc: Structure
;         -tTimeOut    :time out signal
; Return:
;        -1 = Not Used
;         0 = Signal FALSE
;         1 = Signal TRUE
;***************************************************************
GLOBAL DEFFCT INT ArcOutputStatusOff(tWelderNr :IN,tStruc[] :OUT,tTimeOut :IN)
DECL INT tWelderNr
DECL REAL tTimeOut
DECL stArcSignal_T tStruc[]
IF (tStruc[tWelderNr].Active == FALSE) THEN
  RETURN -1
ENDIF
IF (tTimeOut > 0)THEN
  WAIT FOR (($OUT[tStruc[tWelderNr].Offset.SignNr] <> tStruc[tWelderNr].State) OR (TIMER_LIMIT(tTimeOut)))
ENDIF
IF ($OUT[tStruc[tWelderNr].Offset.SignNr] <> tStruc[tWelderNr].State) THEN
  RETURN 1
ELSE
  RETURN 0
ENDIF   
RETURN -1
ENDFCT
;***************************************************************
;[Global Routine] Output Group[1..6] Status On with timeout
;Parameter:
;         -tStruc: Structure
;         -tTimeOut    :time out signal
; Return:
;        -1 = Not Used
;         0 = Signal FALSE
;         1 = Signal TRUE
;***************************************************************
GLOBAL DEFFCT INT ArcOutputGroupStatusOn(tWelderNr :IN,tStruc[,] :OUT,tTimeOut :IN)
DECL BOOL tExist
DECL INT tI,tII
DECL INT tWelderNr
DECL REAL tTimeOut
DECL stArcSignal_T tStruc[,]
IF (tStruc[tWelderNr,1].Active == FALSE) THEN
  RETURN -1
ENDIF
FOR tI = 1 TO 6
   IF (tStruc[tWelderNr,tI].Offset.SignNr == 0) THEN        
      tStruc[tWelderNr,tI].Offset.SignNr = $IOSYS_IN_TRUE
      tStruc[tWelderNr,tI].State = TRUE
   ENDIF
ENDFOR
IF (tTimeOut > 0)THEN
  WAIT FOR ((($OUT[tStruc[tWelderNr,1].Offset.SignNr]==tStruc[tWelderNr,1].State)AND($OUT[tStruc[tWelderNr,2].Offset.SignNr]==tStruc[tWelderNr,2].State)AND($OUT[tStruc[tWelderNr,3].Offset.SignNr]==tStruc[tWelderNr,3].State)AND($OUT[tStruc[tWelderNr,4].Offset.SignNr]==tStruc[tWelderNr,4].State)AND($OUT[tStruc[tWelderNr,5].Offset.SignNr]==tStruc[tWelderNr,5].State)AND($OUT[tStruc[tWelderNr,6].Offset.SignNr]==tStruc[tWelderNr,6].State))OR(TIMER_LIMIT(tTimeOut)))
ENDIF
IF (($OUT[tStruc[tWelderNr,1].Offset.SignNr]==tStruc[tWelderNr,1].State)AND($OUT[tStruc[tWelderNr,2].Offset.SignNr]==tStruc[tWelderNr,2].State)AND($OUT[tStruc[tWelderNr,3].Offset.SignNr]==tStruc[tWelderNr,3].State)AND($OUT[tStruc[tWelderNr,4].Offset.SignNr]==tStruc[tWelderNr,4].State)AND($OUT[tStruc[tWelderNr,5].Offset.SignNr]==tStruc[tWelderNr,5].State)AND($OUT[tStruc[tWelderNr,6].Offset.SignNr]==tStruc[tWelderNr,6].State)) THEN
  RETURN 1
ELSE
  RETURN 0
ENDIF
RETURN -1
ENDFCT
;***************************************************************
;[Global Routine] Output Group[1..6] Status Off with timeout
;Parameter:
;         -tStruc: Structure
;         -tTimeOut    :time out signal
; Return:
;        -1 = Not Used
;         0 = Signal FALSE
;         1 = Signal TRUE
;***************************************************************
GLOBAL DEFFCT INT ArcOutputGroupStatusOff(tWelderNr :IN,tStruc[,] :OUT,tTimeOut :IN)
DECL INT tI
DECL INT tWelderNr
DECL REAL tTimeOut
DECL stArcSignal_T tStruc[,]
IF (tStruc[tWelderNr,1].Active == FALSE) THEN
  RETURN -1
ENDIF
FOR tI = 1 TO 6
   IF (tStruc[tWelderNr,tI].Offset.SignNr == 0) THEN
      tStruc[tWelderNr,tI].Offset.SignNr = $IOSYS_IN_FALSE
      tStruc[tWelderNr,tI].State = FALSE
   ENDIF
ENDFOR
IF (tTimeOut > 0)THEN
  WAIT FOR ((($OUT[tStruc[tWelderNr,1].Offset.SignNr]<>tStruc[tWelderNr,1].State)AND($OUT[tStruc[tWelderNr,2].Offset.SignNr]<>tStruc[tWelderNr,2].State)AND($OUT[tStruc[tWelderNr,3].Offset.SignNr]<>tStruc[tWelderNr,3].State)AND($OUT[tStruc[tWelderNr,4].Offset.SignNr]<>tStruc[tWelderNr,4].State)AND($OUT[tStruc[tWelderNr,5].Offset.SignNr]<>tStruc[tWelderNr,5].State)AND($OUT[tStruc[tWelderNr,6].Offset.SignNr]<>tStruc[tWelderNr,6].State))OR(TIMER_LIMIT(tTimeOut)))
ENDIF
IF (($OUT[tStruc[tWelderNr,1].Offset.SignNr]<>tStruc[tWelderNr,1].State)AND($OUT[tStruc[tWelderNr,2].Offset.SignNr]<>tStruc[tWelderNr,2].State)AND($OUT[tStruc[tWelderNr,3].Offset.SignNr]<>tStruc[tWelderNr,3].State)AND($OUT[tStruc[tWelderNr,4].Offset.SignNr]<>tStruc[tWelderNr,4].State)AND($OUT[tStruc[tWelderNr,5].Offset.SignNr]<>tStruc[tWelderNr,5].State)AND($OUT[tStruc[tWelderNr,6].Offset.SignNr]<>tStruc[tWelderNr,6].State)) THEN
  RETURN 1
ELSE
  RETURN 0
ENDIF
RETURN -1
ENDFCT
;***************************************************************
;[Global Routine] Get Signal group value from In or Out
;***************************************************************
GLOBAL DEFFCT INT ArcGetSignalGroupValue(tSignalGroup :OUT)
DECL stArcSignal_T tSignalGroup
IF (tSignalGroup.Active == FALSE) THEN
  RETURN 0
ENDIF
SWITCH tSignalGroup.SigType
  CASE #GIN
    IF (gArcSignalGroupSelection == TRUE) THEN
      RETURN ArcInSignalGroup(tSignalGroup,0,0)
    ELSE
      RETURN ArcBitToInt($IN[],tSignalGroup)
    ENDIF     
  CASE #GOUT
    IF (gArcSignalGroupSelection == TRUE) THEN
      RETURN ArcInSignalGroup(tSignalGroup,0,0)
    ELSE
      RETURN ArcBitToInt($OUT[],tSignalGroup)
    ENDIF  
ENDSWITCH  
ENDFCT
;***************************************************************
;[Global Routine] Set Singular Output Signals
;***************************************************************
GLOBAL DEF ArcOutputSingleSet(tStruc :OUT)
DECL stArcSignal_T tStruc
IF (tStruc.Active == FALSE) THEN
  RETURN
ENDIF
SWITCH tStruc.SigType
  CASE #GOUT
    $OUT[tStruc.Offset.SignNr] = tStruc.State
ENDSWITCH  
END
;***************************************************************
;[Global Routine] Reset Singular Output Signals
;***************************************************************
GLOBAL DEF ArcOutputSingleReset(tStruc :OUT)
DECL stArcSignal_T tStruc
IF (tStruc.Active == FALSE) THEN
  RETURN
ENDIF
SWITCH tStruc.SigType
  CASE #GOUT
    $OUT[tStruc.Offset.SignNr] = NOT tStruc.State
ENDSWITCH  
END
;***************************************************************
;[Global Routine] Set Signal group value from In or Out
;***************************************************************
GLOBAL DEF ArcSetSignalGroupValue(tSignalGroup :OUT,tValue :IN)
DECL INT tValue
DECL stArcSignal_T tSignalGroup
IF (tSignalGroup.Active == FALSE) THEN
  RETURN
ENDIF
SWITCH tSignalGroup.SigType
  CASE #GOUT
    IF (gArcSignalGroupSelection == TRUE) THEN
      ArcOutSignalGroup(tSignalGroup,0,0,tValue)
    ELSE
      ArcIntToBit($OUT[],tSignalGroup,tValue)
    ENDIF            
ENDSWITCH  
END
;***************************************************************
;[Global Routine] Get Signal group value from In or Out
;***************************************************************
GLOBAL DEFFCT INT ArcGetSignalWelderValue(tWelderNr :IN,tSignalGroup[] :OUT)
DECL INT tWelderNr
DECL stArcSignal_T tSignalGroup[]
SWITCH tWelderNr
  CASE 1,2,3,4
  DEFAULT
    RETURN 0
ENDSWITCH
IF (tSignalGroup[tWelderNr].Active == FALSE) THEN
  RETURN 0
ENDIF
SWITCH tSignalGroup[tWelderNr].SigType
  CASE #SIN
    IF (gArcSignalGroupSelection == TRUE) THEN
      RETURN ArcInSignalGroup(tSignalGroup[tWelderNr],tWelderNr,0)
    ELSE
      RETURN ArcBitToInt($IN[],tSignalGroup[tWelderNr])
    ENDIF
  CASE #SOUT
    IF (gArcSignalGroupSelection == TRUE) THEN
      RETURN ArcInSignalGroup(tSignalGroup[tWelderNr],tWelderNr,0)
    ELSE
      RETURN ArcBitToInt($OUT[],tSignalGroup[tWelderNr])
    ENDIF
ENDSWITCH
ENDFCT
;***************************************************************
;[Global Routine] Set Signal group value from In or Out
;***************************************************************
GLOBAL DEF ArcSetSignalWelderValue(tWelderNr :IN,tSignalGroup[] :OUT,tValue :IN)
DECL INT tWelderNr
DECL INT tValue
DECL stArcSignal_T tSignalGroup[]
SWITCH tWelderNr
  CASE 1,2,3,4
  DEFAULT
    RETURN
ENDSWITCH
IF (tSignalGroup[tWelderNr].Active == FALSE) THEN
  RETURN
ENDIF
SWITCH tSignalGroup[tWelderNr].SigType
  CASE #GOUT
    IF (gArcSignalGroupSelection == TRUE) THEN
      ArcOutSignalGroup(tSignalGroup[tWelderNr],tWelderNr,0,tValue)
    ELSE
      ArcIntToBit($OUT[],tSignalGroup[tWelderNr],tValue)
    ENDIF
ENDSWITCH
END
;***************************************************************
;[Global Routine] Set Arc Mode
;***************************************************************
GLOBAL DEF ArcSetArcMode(tWelderNr :IN,tArcMode :IN)
DECL INT tI,tArcMode
DECL INT tWelderNr
DECL stArcModeCoding_T tArcModeCoding
DECL stArcSignal_T tArcOSpecial
tArcModeCoding = ArcGetModiCoding(tWelderNr,tArcMode)
IF (tArcModeCoding.InUse == FALSE) THEN
  RETURN
ENDIF
FOR tI = 1 TO 8
  ON_ERROR_PROCEED
  tArcOSpecial = wArcOSpecial[tWelderNr,tArcMode,tI]
  IF ($ERR.NUMBER == 0) THEN
    IF ((tArcOSpecial.Active == TRUE) AND (tArcOSpecial.Offset.SignNr > 0)) THEN 
      $OUT[tArcOSpecial.Offset.SignNr] = tArcOSpecial.State
    ENDIF
  ELSE
    ArcMsgWriteS(,#NOTIFY,"AtbInternalError","ARC",10094,OPT_VLSTOP_LOG, gArcActIlfWelderName[],"Cannot access wArcOSpecial")
    ERR_CLEAR($ERR)
  ENDIF
ENDFOR
ON_ERROR_PROCEED
gArcActWeldMode = tArcModeCoding.Coding
IF (gArcSignalGroupSelection == TRUE) THEN
  ArcOutSignalGroup(wsArcOModiCoding[tWelderNr],tWelderNr,0,gArcActWeldMode)
ELSE
  ArcIntToBit($OUT[],wsArcOModiCoding[tWelderNr],gArcActWeldMode)
ENDIF 
IF ($ERR.NUMBER > 0) THEN
  ERR_CLEAR($ERR)
 ;ArcMsgWriteI(,#NOTIFY,"SignalToWriteIsTooBig","ARC",10050,OPT_VLSTOP_LOG,tArcMode,tArcModeCoding.Coding)
ENDIF
SWITCH wArcWelder[tWelderNr].Type
  CASE #FRONIUS_TPSI,#FRONIUS_TWIN
    WAIT SEC cArcTPSiModeRecoveryTime
ENDSWITCH
END
;***************************************************************
;[Global Routine] Weld Condition
;***************************************************************
GLOBAL DEFFCT BOOL ArcWeldCondition(tWelderNr :IN)
DECL BOOL tReturn
DECL BOOL tCondition
DECL BOOL tNotConfigured
DECL INT tWelderNr
tCondition = ((gArcGhostMode == FALSE) AND (skArcDryRun == FALSE) AND (gArcColdSeam == FALSE) AND (gArcNoErrorRestart == FALSE))
tNotConfigured = FALSE
SWITCH (ArcInputStatusOn(tWelderNr,wArcIKeySwitchProcess[],0))
  CASE -1
    tNotConfigured = TRUE
    tReturn = TRUE
  CASE 1
    tReturn = TRUE
  CASE 0
    tReturn = FALSE
ENDSWITCH
SWITCH  $MODE_OP
  CASE #T1
    tReturn = tCondition AND skArcStatusKeyHot
  CASE #T2
    tReturn = tCondition AND skArcStatusKeyHot
  CASE #AUT
    IF (tNotConfigured == TRUE) THEN
      tReturn = tCondition AND skArcStatusKeyHot
    ELSE
      tReturn = tCondition AND tReturn
    ENDIF
  CASE #EX
    IF (tNotConfigured == TRUE) THEN
      tReturn = tCondition AND skArcStatusKeyHot
    ELSE
      tReturn = tCondition AND tReturn
    ENDIF
ENDSWITCH
gArcWeldCondition = tReturn
RETURN tReturn
ENDFCT
;***************************************************************
;[Global Routine] Is HOT
;***************************************************************
GLOBAL DEFFCT BOOL ArcIsHot(tWelderNr :IN)
DECL BOOL tReturn
DECL BOOL tCondition
DECL BOOL tNotConfigured
DECL INT tWelderNr
tCondition = ((gArcGhostMode == FALSE) AND (skArcDryRun == FALSE))
tNotConfigured = FALSE
SWITCH (ArcInputStatusOn(tWelderNr,wArcIKeySwitchProcess[],0))
  CASE -1
    tNotConfigured = TRUE
    tReturn = TRUE
  CASE 1
    tReturn = TRUE
  CASE 0
    tReturn = FALSE
ENDSWITCH
SWITCH  $MODE_OP
  CASE #T1
    tReturn = tCondition AND skArcStatusKeyHot
  CASE #T2
    tReturn = tCondition AND skArcStatusKeyHot
  CASE #AUT
    IF (tNotConfigured == TRUE) THEN
      tReturn = tCondition AND skArcStatusKeyHot
    ELSE
      tReturn = tCondition AND tReturn
    ENDIF
  CASE #EX
    IF (tNotConfigured == TRUE) THEN
      tReturn = tCondition AND skArcStatusKeyHot
    ELSE
      tReturn = tCondition AND tReturn
    ENDIF
ENDSWITCH
gArcWeldCondition = tReturn
RETURN tReturn
ENDFCT
;***************************************************************
;[Global Routine] Sys SubMit Running
;Example:
;       ArUserSubMit()
;***************************************************************
GLOBAL DEF ArcSysSubMit()
DECL INT tI
  tI = ArcSubMitActive($PRO_I_O_SYS,2,TRUE)
  WAIT FOR (gArcSubMitInitDone == TRUE) ;SubMit Init Done
END
;***************************************************************
;[Global Routine] User SubMit Running
;Example:
;       Only Check
;       - BOOL = ArUserSubMit(FALSE)
;       With Start SubMit and check stop if not on run
;       - BOOL = ArUserSubMit(TRUE)
; Return status True all SubMit on Run
;***************************************************************
GLOBAL DEFFCT BOOL ArUserSubMit(tAutoStart:IN)
DECL BOOL tAutoStart
DECL BOOL tAllSubMitOk
tAllSubMitOk = TRUE
  IF (ArcSubMitActive($PRO_I_O_PROC_ID3,3,tAutoStart) == 0) THEN
    tAllSubMitOk = FALSE
  ENDIF
  IF (ArcSubMitActive($PRO_I_O_PROC_ID4,4,tAutoStart) == 0) THEN
    tAllSubMitOk = FALSE
  ENDIF
  IF (ArcSubMitActive($PRO_I_O_PROC_ID5,5,tAutoStart) == 0) THEN
    tAllSubMitOk = FALSE
  ENDIF
  IF (ArcSubMitActive($PRO_I_O_PROC_ID6,6,tAutoStart) == 0) THEN
    tAllSubMitOk = FALSE
  ENDIF
  IF (ArcSubMitActive($PRO_I_O_PROC_ID7,7,tAutoStart) == 0) THEN
    tAllSubMitOk = FALSE
  ENDIF
  IF (ArcSubMitActive($PRO_I_O_PROC_ID8,8,tAutoStart) == 0) THEN
    tAllSubMitOk = FALSE
  ENDIF
  IF (ArcSubMitActive($PRO_I_O_PROC_ID9,9,tAutoStart) == 0) THEN
    tAllSubMitOk = FALSE
  ENDIF  
   RETURN tAllSubMitOk
ENDFCT
;***************************************************************
;[Global Routine] Is SubMit Active
;Return:
;     -1 = Non in use
;      0 = Not Active
;      1 = Active
;Example:
;       Only Check
;       - INT = ArcIsSubMitActive($PRO_I_O_SYS,2,FALSE)
;       - INT = ArcIsSubMitActive($PRO_I_O_PROC_ID3,3,FALSE)
;       - INT = ArcIsSubMitActive($PRO_I_O_PROC_ID9,9,FALSE)
;       With Start SubMit
;       - INT = ArcIsSubMitActive($PRO_I_O_SYS,2,TRUE)
;       - INT = ArcIsSubMitActive($PRO_I_O_PROC_ID3,3,TRUE)
;       - INT = ArcIsSubMitActive($PRO_I_O_PROC_ID9,9,TRUE)
;***************************************************************
GLOBAL DEFFCT INT ArcSubMitActive(tProIoT:OUT,tIndex:IN,tAutoStart:IN)
DECL BOOL tB
DECL BOOL tAutoStart
DECL INT tIndex
DECL STATE_T STAT
DECL MODUS_T MODE
DECL PRO_IO_T tProIoT
IF (tIndex == 2) THEN ;System SubMit
  IF (STRCOMP(tProIoT.MODULE[],"/R1/SPS()",#Not_CASE_Sens) == FALSE) THEN
    tB = STRCOPY(tProIoT.MODULE[],"/R1/SPS()")
    WAIT SEC 0.5
  ENDIF
ENDIF
IF (STRLEN(tProIoT.MODULE[]) > 5) OR (tIndex == 2) THEN
  SWITCH $PROG_INFO[tIndex].P_STATE
    CASE #P_ACTIVE
      RETURN 1 ;Active
    DEFAULT
      IF (tAutoStart == TRUE) THEN
        CWRITE($CMD,STAT,MODE,"RUN %s",tProIoT.MODULE[])
        IF ($PROG_INFO[tIndex].P_STATE <> #P_ACTIVE) THEN
          WAIT SEC 0.5
          WHILE ($PROG_INFO[tIndex].P_STATE <> #P_ACTIVE)
            ArcMsgWriteS(,#QUIT,"SPSNotRunning","ARC",10034,OPT_VLSTOP_LOG,tProIoT.MODULE[])
          ENDWHILE
        ENDIF        
      ENDIF
      RETURN 0 ;Deactive
  ENDSWITCH
ENDIF
RETURN -1 ;Disable
ENDFCT
;***************************************************************
;[Global Routine] Robot System Ready for Weld
;***************************************************************
GLOBAL DEF ArcRobotSysReady()
DECL INT tSubMitNr
DECL CHAR tSubMitProgName[10]
DECL CHAR tMsg[256]
DECL STATE_T STAT
DECL MODUS_T MODE
tSubMitNr = 2 ;SubMit Select Number
tSubMitProgName[] = "/R1/SPS" ;SubMit Program Name
IF (ArcStrComp($PROG_INFO[tSubMitNr].SEL_NAME[],tSubMitProgName[]) == FALSE) THEN
  IF ($PROG_INFO[tSubMitNr].P_STATE <> #P_ACTIVE) THEN
    CWRITE($CMD,STAT,MODE,"RUN %s()",tSubMitProgName[])
    WAIT SEC 0.5
  ENDIF
  WHILE (ArcStrComp($PROG_INFO[tSubMitNr].SEL_NAME[],tSubMitProgName[]) == FALSE)
    tMsg[] = ArcStrAdd3("SYS: ",tSubMitProgName[],"()")
    ArcMsgWriteS(,#QUIT,"SPSNotRunning","ARC",10034,OPT_VLSTOP_LOG,tMsg[])
  ENDWHILE
  WHILE ($PROG_INFO[tSubMitNr].P_STATE <> #P_ACTIVE)
    ArcMsgWriteS(,#QUIT,"SPSNotRunning","ARC",10034,OPT_VLSTOP_LOG,"SYS: #P_ACTIVE")
  ENDWHILE
ENDIF
IF (gArcSyncList > 1) THEN
    WHILE (gArcRobotTeamOk == FALSE)
      ArcMsgWriteS(,#QUIT,"RobotTeamNotReady","ARC",20022,OPT_VLSTOP_LOG,gArcSeamName[])
    ENDWHILE
ENDIF
END
;***************************************************************
;[Global Routine] RobotReadyForWeld
;***************************************************************
GLOBAL DEFFCT BOOL RobotReadyForWeld(tMsgType :IN)
DECL enArcMessageType_T tMsgType
DECL BOOL tReturn
tReturn = TRUE
IF ($PRO_MODE1 <> #GO) THEN
  ArcMsgWriteS(,tMsgType,"WrongProMode","ARC",10033,OPT_VLSTOP_LOG,gArcSeamName[])
  tReturn = FALSE
ENDIF
IF ($PRO_STATE0 <> #P_ACTIVE) THEN
  ArcMsgWriteS(,tMsgType,"SPSNotRunning","ARC",10034,OPT_VLSTOP_LOG,gArcSeamName[])
  tReturn = FALSE
ENDIF
IF ($SIMULATED_AXIS <> 0) THEN
  ArcMsgWriteS(,tMsgType,"AxisSimulated","ARC",10036,OPT_VLSTOP_LOG,gArcSeamName[])
  tReturn = FALSE
ENDIF
SWITCH $MODE_OP
  CASE #T1
    IF(wArcWeldingInT1Mode == TRUE)THEN
      IF($RED_T1_OV_CP == TRUE)THEN
        ArcMsgWriteS(,tMsgType,"ProcT1","ARC",10035,OPT_VLSTOP_LOG,gArcSeamName[])
        tReturn = FALSE
      ENDIF
    ELSE
      ArcMsgWriteS(,tMsgType,"WeldinginTest1NotEnabled","ARC",10049,OPT_VLSTOP_LOG,gArcSeamName[])
      tReturn = FALSE
    ENDIF
  CASE #T2
    IF (tMsgType <> #NONE) THEN
      WHILE (IsMessageSet(149))
        ArcMsgWriteS(,tMsgType,"ManualAccessToOverrideNecessary","ARC",10080,OPT_VLSTOP_LOG)
        WAIT SEC 0.2
      ENDWHILE
    ENDIF
    IF (IsMessageSet(149)) THEN
      tReturn = FALSE
    ENDIF
ENDSWITCH
SWITCH wArcToolDirection
  CASE #X
    IF (enArcKssToolDirection <> #X) THEN
      ArcMsgWrite(,tMsgType,"DifferentToolDirectionsConfigured","ARC",10077,OPT_VLSTOP_LOG)
      tReturn = FALSE
    ENDIF
  CASE #Z
    IF ($TOOL_DIRECTION_LIN_CIRC == FALSE) THEN
      ArcMsgWrite(,tMsgType,"ForToolDirectionZAdjustmentToolDirectionLinCirIsNeeded","ARC",10130,OPT_VLSTOP_LOG)
      tReturn = FALSE
    ENDIF
    IF (enArcKssToolDirection <> #Z) THEN
      ArcMsgWrite(,tMsgType,"DifferentToolDirectionsConfigured","ARC",10077,OPT_VLSTOP_LOG)
      tReturn = FALSE
    ENDIF
  DEFAULT
    ArcMsgWriteS(,tMsgType,"AtbInternalError","ARC",10094,OPT_VLSTOP_LOG,gArcActIlfWelderName[],"WoV Y is not supported")
    tReturn = FALSE
ENDSWITCH
IF (enArcKssToolDirection == #Y) THEN
  ArcMsgWriteS(,tMsgType,"AtbInternalError","ARC",10094,OPT_VLSTOP_LOG,gArcActIlfWelderName[],"Y is not supported")
  tReturn = FALSE
ENDIF
RETURN tReturn
ENDFCT
;***************************************************************
;[Global Routine] Clear all error signals on seam
;***************************************************************
GLOBAL DEF ArcClearAllErrorSignals()
DECL INT tI
FOR tI = 1 TO 4
  ArcOutputReset(tI,wArcOCriticalIgnitError[])
  ArcOutputReset(tI,wArcOCriticalSeamError[])
  ArcOutputReset(tI,wArcOWireDetectRequest[])
  ArcOutputReset(tI,wArcOBurnBack[])
  ArcOutputReset(tI,wArcOGasActive[])
  ArcOutputReset(tI,wArcODecisionRequest[])
ENDFOR
END
;***************************************************************
;[BurnBack] SetBurnBackArcLinkXt
;***************************************************************
GLOBAL DEF SetBurnBackArcLinkXt(tWelderNr: IN)
DECL INT tWelderNr
DECL REAL dBurnBackTime
SWITCH wArcWelder[tWelderNr].Type
  CASE #ARCLINKXT
    SWITCH VARSTATE("stArcActCraterSet.BurnBackTime")
      CASE #UNKNOWN,#DECLARED
        dBurnBackTime = 0.012
      DEFAULT
        IF (stArcActCraterSet.BurnBackTime < 0.012) THEN
          dBurnBackTime = 0.012
        ELSE
          dBurnBackTime=(stArcActCraterSet.BurnBackTime)
        ENDIF
    ENDSWITCH
    dBurnBackTime = dBurnBackTime - 0.004 ;4ms compensation driver cycle
    ArcOutputReset(tWelderNr,wArcOBurnBack[])
    ArcOutputPulseSet(tWelderNr,wArcOBurnBack[],dBurnBackTime)
    ArcWriteDiag(gArcGeneralDebug,"[ArcLinkXT] BurnBackStart")
ENDSWITCH
END
;***************************************************************
;[BurnBack] WaitBurnBackArcLinkXt
;***************************************************************
GLOBAL DEF BurnBackEndArcLinkXt(tWelderNr: IN)
DECL INT tWelderNr
DECL REAL dBurnBackTime
SWITCH wArcWelder[tWelderNr].Type
  CASE #ARCLINKXT
    IF ((enArcErrorState == #Nothing) OR (enArcErrorState == #InputError)) THEN
      SWITCH VARSTATE("stArcActCraterSet.BurnBackTime")
        CASE #UNKNOWN,#DECLARED
          dBurnBackTime = 0.012
        DEFAULT
          IF (stArcActCraterSet.BurnBackTime < 0.012) THEN
            dBurnBackTime = 0.012
          ELSE
            dBurnBackTime = stArcActCraterSet.BurnBackTime
          ENDIF
      ENDSWITCH
      WAIT SEC dBurnBackTime - 0.004 ;4ms compensation driver cycle
      ArcOutputReset(tWelderNr,wArcOBurnBack[])
      ArcWriteDiag(gArcGeneralDebug,"[ArcLinkXT] BurnBackDone")
    ENDIF
ENDSWITCH
END
;*****************************************************************************************
;Restore override value for none arc motion
;*****************************************************************************************
GLOBAL DEF RestoreOverride()
IF(gArcSafeOverrideValue <> (-1))THEN
  IF ($OV_PRO < gArcSafeOverrideValue) THEN
    ;Keep the lower one
  ELSE
    ;Restore the lower one => safety
    ON_ERROR_PROCEED ;Workaround Wov RDP need dead man button
    $OV_PRO = gArcSafeOverrideValue
  ENDIF
  gArcSafeOverrideValue = (-1); not yet saved
ENDIF
END
;*****************************************************************************************
;ForceRealWeldSpeedIfHot
;*****************************************************************************************
GLOBAL DEF ForceRealWeldSpeedIfHot()
IF (gArcSafeOverrideValue == (-1)) THEN
  gArcSafeOverrideValue = $OV_PRO
ENDIF
IF (stArcProcessState.WeldingActive == TRUE) THEN
  $OV_PRO = 100 ;For welding and weaving at original speed
ENDIF
END
;*****************************************************************************************
;ArcSeamNumberControl ArcOn
;*****************************************************************************************
GLOBAL DEF ArcSeamNumberControlOn(tWelderNr :IN)
DECL INT tWelderNr
DECL INT tDialogAnswer
DECL INT tTimer
DECL INT tArcOSeamNumberCode
ArcMsgWriteClearHandle(mMsgHandlePLC)
IF (gArcSignalGroupSelection == TRUE) THEN
  tArcOSeamNumberCode = ArcInSignalGroup(wsArcOSeamNumberCode[tWelderNr],tWelderNr,0)
ELSE
  tArcOSeamNumberCode = ArcBitToInt($OUT[],wsArcOSeamNumberCode[tWelderNr])
ENDIF

IF (tArcOSeamNumberCode > 0) THEN
  tTimer = ArcCalcTimeoutSec(mPLCTimeOut)
  IF (gArcSignalGroupSelection == TRUE) THEN  
    WHILE (tArcOSeamNumberCode <> ArcInSignalGroup(wsArcISeamNumberCode[tWelderNr],tWelderNr,0))
      IF ($VEL_ACT > 0.0) THEN
       BRAKE ;OnTheFly Stop
      ENDIF
      ArcMsgWriteI(mMsgHandlePLC,#STATE, "WaitingforSeamNumber","ARC",20003,Opt_NOVLSTOP_NOLOG,tArcOSeamNumberCode)
      IF ($ROB_TIMER > tTimer) THEN
        tDialogAnswer = ArcMsgWriteDialogI(,"SeamNumberTimeOut","ARC",20004,Opt_NOVLSTOP_NOLOG,"Continue",,,,,,,tArcOSeamNumberCode)
        tTimer = ArcCalcTimeoutSec(mPLCTimeOut)
      ENDIF
    ENDWHILE
  ELSE
    WHILE (tArcOSeamNumberCode <> ArcBitToInt($IN[],wsArcISeamNumberCode[tWelderNr]))
      IF ($VEL_ACT > 0.0) THEN
       BRAKE ;OnTheFly Stop
      ENDIF
      ArcMsgWriteI(mMsgHandlePLC,#STATE, "WaitingforSeamNumber","ARC",20003,Opt_NOVLSTOP_NOLOG,tArcOSeamNumberCode)
      IF ($ROB_TIMER > tTimer) THEN
        tDialogAnswer = ArcMsgWriteDialogI(,"SeamNumberTimeOut","ARC",20004,Opt_NOVLSTOP_NOLOG,"Continue",,,,,,,tArcOSeamNumberCode)
        tTimer = ArcCalcTimeoutSec(mPLCTimeOut)
      ENDIF
    ENDWHILE
  ENDIF
    
  ArcMsgWriteClearHandle(mMsgHandlePLC)
  SWITCH ArcInputStatusOn(tWelderNr,wArcIKeySwitchProcess[],0)
    CASE -1,0
      ArcMsgWriteI(mMsgHandlePLC,#STATE,"SeamRepressedbyPlc","ARC",20005,Opt_NOVLSTOP_LOG,tArcOSeamNumberCode)
    CASE 1
      ArcMsgWriteI(mMsgHandlePLC,#STATE,"ActualSeam","ARC",20006,Opt_NOVLSTOP_LOG,tArcOSeamNumberCode)
  ENDSWITCH
ENDIF
END
;*****************************************************************************************
;ArcSeamNumberControl ArcOff
;*****************************************************************************************
GLOBAL DEF ArcSeamNumberControlOff(tWelderNr :IN)
DECL INT tWelderNr
  ArcMsgWriteClearHandle(mMsgHandlePLC)
  IF (gArcSignalGroupSelection == TRUE) THEN
    ArcOutSignalGroup(wsArcOSeamNumberCode[tWelderNr],tWelderNr,0,0)
  ELSE
    ArcIntToBit($OUT[],wsArcOSeamNumberCode[tWelderNr],0)
  ENDIF 
END
;*****************************************************************************************
;ArcSlopeEnabled
;None,Distance,ToNextPoint
;*****************************************************************************************
GLOBAL DEFFCT BOOL ArcSlopeEnabled(tArcDat:IN)
DECL stArcDat_T tArcDat
DECL BOOL tSlopeEnabled
tSlopeEnabled = FALSE

SWITCH tArcDat.Advanced.SlopeOption
  CASE #ToNextPoint
    tSlopeEnabled = TRUE
  CASE #Distance
    IF (ABS(tArcDat.Advanced.SlopeDistance) >= 1) THEN
      tSlopeEnabled = TRUE
    ENDIF
ENDSWITCH
IF ((gArcOnlineOptActive == TRUE) AND (wArcOnlOptNoSlopeOption == TRUE)) THEN
  tSlopeEnabled = FALSE
ENDIF
RETURN tSlopeEnabled
ENDFCT
;*****************************************************************************************
;ArcSlop Init Loop
;*****************************************************************************************
GLOBAL DEF ArcSlopeInit()
  gArcSlopeAct                  = mArcSlopeInit
END
;*****************************************************************************************
;ArcSlop On Line Select
;*****************************************************************************************
GLOBAL DEF ArcSlopeLineSelect()
  ArcMsgWriteClearHandle(mArcUnsupportedWeave)
END
;*****************************************************************************************
;Slope Make SlopeArcOn
;*****************************************************************************************
GLOBAL DEFFCT  stArcDat_T ArcSlopeOnArcOn(tArcDat :IN)
DECL stArcDat_T tArcDat
DECL stArcDat_T tArcDatReturn
ArcMsgWriteClearHandle(mArcUnsupportedWeave)
gArcSlopeArcOn = TRUE
tArcDatReturn = tArcDat
tArcDatReturn.Weld.Channel1   = tArcDat.Strike.Channel1
tArcDatReturn.Weld.Channel2   = tArcDat.Strike.Channel2
tArcDatReturn.Weld.Channel3   = tArcDat.Strike.Channel3
tArcDatReturn.Weld.Channel4   = tArcDat.Strike.Channel4
tArcDatReturn.Weld.Channel5   = tArcDat.Strike.Channel5
tArcDatReturn.Weld.Channel6   = tArcDat.Strike.Channel6
tArcDatReturn.Weld.Channel7   = tArcDat.Strike.Channel7
tArcDatReturn.Weld.Channel8   = tArcDat.Strike.Channel8
tArcDatReturn.Weld.Velocity   = tArcDat.Weld.Velocity * 0.1
IF (tArcDatReturn.Weld.Velocity  <= wArcZeroVelocity + 0.0001) THEN
  tArcDatReturn.Weld.Velocity   = wArcZeroVelocity + 0.0001
ENDIF
tArcDatReturn.Weave.Length    = 2.0
tArcDatReturn.Weave.Amplitude = 0.5
tArcDatReturn.Weave.Angle     = 0.0
RETURN tArcDatReturn
ENDFCT
;*****************************************************************************************
;Slope Update Value
;*****************************************************************************************
GLOBAL DEF ArcSlopeUpdate(tWelderNr :IN,tArcMode :IN,tArcDatStart :IN,tArcDatEnd :IN)
DECL INT tWelderNr
DECL INT tArcMode
DECL stArcDat_T tArcDatStart
DECL stArcDat_T tArcDatEnd

gArcSlopeAct.C1.Active        = ArcGetSlopeChannel(tWelderNr,tArcMode,#Channel1)
gArcSlopeAct.C2.Active        = ArcGetSlopeChannel(tWelderNr,tArcMode,#Channel2)
gArcSlopeAct.C3.Active        = ArcGetSlopeChannel(tWelderNr,tArcMode,#Channel3)
gArcSlopeAct.C4.Active        = ArcGetSlopeChannel(tWelderNr,tArcMode,#Channel4)
gArcSlopeAct.C5.Active        = ArcGetSlopeChannel(tWelderNr,tArcMode,#Channel5)
gArcSlopeAct.C6.Active        = ArcGetSlopeChannel(tWelderNr,tArcMode,#Channel6)
gArcSlopeAct.C7.Active        = ArcGetSlopeChannel(tWelderNr,tArcMode,#Channel7)
gArcSlopeAct.C8.Active        = ArcGetSlopeChannel(tWelderNr,tArcMode,#Channel8)
gArcSlopeAct.Velocity.Active  = ArcGetSlopeChannel(tWelderNr,tArcMode,#Velocity)
gArcSlopeAct.Length.Active    = ArcGetSlopeChannel(tWelderNr,tArcMode,#Length)
gArcSlopeAct.Amplitude.Active = ArcGetSlopeChannel(tWelderNr,tArcMode,#Amplitude)
gArcSlopeAct.Angle.Active     = ArcGetSlopeChannel(tWelderNr,tArcMode,#Angle)

gArcSlopeAct.Mode               = #FromPoint
gArcSlopeAct.Time               = tArcDatEnd.Advanced.SlopeTime * 1000
gArcSlopeAct.ToPosNext          = (tArcDatEnd.Advanced.SlopeOption == #ToNextPoint)
IF (gArcSlopeAct.ToPosNext == FALSE) THEN
  gArcSlopeAct.IlfDistance      = tArcDatEnd.Advanced.SlopeDistance
ENDIF
;Slope Start
gArcSlopeAct.C1.SValue          = tArcDatStart.Weld.Channel1
gArcSlopeAct.C2.SValue          = tArcDatStart.Weld.Channel2
gArcSlopeAct.C3.SValue          = tArcDatStart.Weld.Channel3
gArcSlopeAct.C4.SValue          = tArcDatStart.Weld.Channel4
gArcSlopeAct.C5.SValue          = tArcDatStart.Weld.Channel5
gArcSlopeAct.C6.SValue          = tArcDatStart.Weld.Channel6
gArcSlopeAct.C7.SValue          = tArcDatStart.Weld.Channel7
gArcSlopeAct.C8.SValue          = tArcDatStart.Weld.Channel8
gArcSlopeAct.Velocity.SValue    = tArcDatStart.Weld.Velocity
gArcSlopeAct.Length.SValue      = tArcDatStart.Weave.Length
gArcSlopeAct.Amplitude.SValue   = tArcDatStart.Weave.Amplitude
gArcSlopeAct.Angle.SValue       = tArcDatStart.Weave.Angle
;Slope End
gArcSlopeAct.C1.EValue          = tArcDatEnd.Weld.Channel1
gArcSlopeAct.C2.EValue          = tArcDatEnd.Weld.Channel2
gArcSlopeAct.C3.EValue          = tArcDatEnd.Weld.Channel3
gArcSlopeAct.C4.EValue          = tArcDatEnd.Weld.Channel4
gArcSlopeAct.C5.EValue          = tArcDatEnd.Weld.Channel5
gArcSlopeAct.C6.EValue          = tArcDatEnd.Weld.Channel6
gArcSlopeAct.C7.EValue          = tArcDatEnd.Weld.Channel7
gArcSlopeAct.C8.EValue          = tArcDatEnd.Weld.Channel8
gArcSlopeAct.Velocity.EValue    = tArcDatEnd.Weld.Velocity
gArcSlopeAct.Length.EValue      = tArcDatEnd.Weave.Length
gArcSlopeAct.Amplitude.EValue   = tArcDatEnd.Weave.Amplitude
gArcSlopeAct.Angle.EValue       = tArcDatEnd.Weave.Angle
END
;*****************************************************************************************
;Slope Update Weave Value
;*****************************************************************************************
GLOBAL DEFFCT stWeave_T ArcSlopeUpdateWeave(tArcDatStart :IN,tArcDatEnd :IN)
DECL stArcDat_T tArcDatStart
DECL stArcDat_T tArcDatEnd
DECL stWeave_T tWeave
tWeave = mArcWeaveIni
SWITCH tArcDatStart.Weave.Pattern
  CASE #None,#Triangle,#Trapecoid,#UnsymetricTrapecoid
    SWITCH tArcDatEnd.Weave.Pattern
      CASE #Triangle,#Trapecoid,#UnsymetricTrapecoid
         tArcDatStart.Weave.Pattern = tArcDatEnd.Weave.Pattern
         tWeave = tArcDatStart.Weave
    ENDSWITCH
ENDSWITCH
SWITCH tArcDatStart.Weave.Pattern
  CASE #None,#Triangle,#Trapecoid,#UnsymetricTrapecoid
  DEFAULT
    ArcMsgWrite(mArcUnsupportedWeave,#STATE,"ArcSlopeUnsupportedWeaveFigure","ARC",20024,Opt_NOVLSTOP_NOLOG)
ENDSWITCH

SWITCH tWeave.Pattern
  CASE #Triangle,#Trapecoid,#UnsymetricTrapecoid
  DEFAULT
    gArcSlopeAct.Length.Active    = FALSE
    gArcSlopeAct.Amplitude.Active = FALSE
    gArcSlopeAct.Angle.Active     = FALSE
ENDSWITCH
IF (tWeave.Length < 2.0) THEN
  tWeave.Length               = 2.0
  gArcSlopeAct.Length.SValue  = 2.0
ENDIF
IF (tWeave.Amplitude < 0.5) THEN
  tWeave.Amplitude              = 0.5
  gArcSlopeAct.Amplitude.SValue = 0.5
ENDIF
RETURN tWeave
ENDFCT
;*****************************************************************************************
;Set Slope Active 
;*****************************************************************************************
GLOBAL DEF ArcSlopeSetActive()
ArcWriteDiag(gArcDebugSlope,"[SLOPE] INTERRUPT ArcSlopeSetActive") 
gArcActSlopeActive = TRUE
mFirstCall = FALSE
INTERRUPT OFF irtArcSlopeFunction
IF ((gArcSlopeArcOn == TRUE) AND (stArcCallState.MoveType <> #SplBlock)) THEN
  gArcStepInterval = cArcSlopeInterval
  gArcSlopeArcOn = FALSE
ELSE
  IF (gArcSlopeAct.Mode == #SplBwd) THEN
    gArcStepInterval        = $DISTANCE - cArcSlopeInterval
    gArcSlopeAct.StartDis   = $DISTANCE
  ELSE
    gArcStepInterval        = $DISTANCE + cArcSlopeInterval
  ENDIF
ENDIF
IF (gArcSlopeAct.Mode == #SplBwd) THEN
  GLOBAL INTERRUPT DECL irtArcSlopeFunction WHEN $DISTANCE < gArcStepInterval DO ArcSlopeInterrupt()
ELSE
  GLOBAL INTERRUPT DECL irtArcSlopeFunction WHEN $DISTANCE > gArcStepInterval DO ArcSlopeInterrupt()
ENDIF
INTERRUPT ON irtArcSlopeFunction
END
;*****************************************************************************************
;ArcSlopInterrupt Call from Interrupt irtArcSlopeFunction
;*****************************************************************************************
GLOBAL DEF ArcSlopeInterrupt()
DECL BOOL tEndValue
DECL REAL tReport
DECL REAL tOvAppl
DECL REAL tDistanceEnd
IF (ABS($DIST_LAST) < 1) THEN
  RETURN
ENDIF
INTERRUPT OFF irtArcSlopeFunction

IF (gArcSlopeAct.Mode == #ToPoint) THEN
  mFirstCall = TRUE
  stArcOffSlope.Active = TRUE
ENDIF

IF (gArcSlopeAct.Mode == #SplBwd) THEN
  mFirstCall = TRUE
  stArcOffSlope.Active = TRUE
ENDIF

IF (mFirstCall == FALSE) THEN
  IF (gArcSlopeAct.ToPosNext == TRUE) THEN
    gArcSlopeAct.DisBetween = $DIST_NEXT
    ArcWriteDiag(gArcDebugSlope,"[SLOPE] TRIGGER FirstCall Next")
  ELSE
    gArcSlopeAct.DisBetween = gArcSlopeAct.IlfDistance * (-1)
    IF (gArcSlopeAct.IlfDistance < 0) THEN
      IF ABS($DIST_NEXT) >= ABS(gArcSlopeAct.IlfDistance) THEN
        RETURN
      ENDIF
      ArcWriteDiag(gArcDebugSlope,"[SLOPE] TRIGGER FirstCall Distance")
      gArcSlopeAct.DisBetween = gArcSlopeAct.IlfDistance
    ENDIF
  ENDIF
  mFirstCall = TRUE
ENDIF

IF (gArcSlopeAct.Mode == #FromPoint) THEN
  IF ($DIST_LAST > 0 ) THEN
    tDistanceEnd = ABS(gArcSlopeAct.DisBetween)
    IF (tDistanceEnd > cArcSlopeInterval) THEN
      tDistanceEnd = tDistanceEnd - cArcSlopeInterval
    ENDIF
    tEndValue = ($DIST_LAST  >= tDistanceEnd)
  ELSE
    tEndValue = TRUE
    ArcWriteDiag(gArcDebugSlope,"[SLOPE] TRIGGER Last Call")
  ENDIF
ENDIF
  
IF (gArcSlopeAct.Mode == #ToPoint) THEN
  tEndValue = FALSE
  IF (ABS($DIST_NEXT) < cArcSlopeInterval) THEN
    tEndValue = TRUE
    ArcWriteDiag(gArcDebugSlope,"[SLOPE] TRIGGER Last Call")
    stArcOffSlope.Active = FALSE
  ENDIF
ENDIF

IF (gArcSlopeAct.Mode == #SplBwd) THEN
  tEndValue = FALSE
  tDistanceEnd = ABS(gArcSlopeAct.StartDis - gArcSlopeAct.IlfDistance)
  tDistanceEnd = tDistanceEnd + cArcSlopeInterval
  IF ($DISTANCE < tDistanceEnd) THEN
    tEndValue = TRUE
    ArcWriteDiag(gArcDebugSlope,"[SLOPE] TRIGGER Last Call")
    stArcOffSlope.Active = FALSE
  ENDIF
ENDIF

IF (gArcColdSeam == TRUE) THEN
  tEndValue = TRUE
ENDIF

IF (tEndValue == TRUE) THEN
  ArcSlopeSetValue(#ToEnd)
  gArcDisableOnlineOpt = FALSE
  gArcActSlopeActive = FALSE
ELSE
  ArcSlopeSetValue(#ToRun)
  gArcDisableOnlineOpt = TRUE
  INTERRUPT ON irtArcSlopeFunction
ENDIF
;ArcMsgWrite(,#NOTIFY,"TargetParamNotReachedBySlope","ARC",20002,Opt_NOVLSTOP_NOLOG)
END
;*****************************************************************************************
;PerformSlopeStep Call from Interrupt
;TRUE Set Last Value
;FALSE Set Value on Position
;GLOBAL ENUM enArcSlope_T Init,Start,End
;*****************************************************************************************
GLOBAL DEF ArcSlopeSetValue(tSlopeState :IN)
DECL BOOL tWeaveEnable
DECL INT tError
DECL INT tWelder
DECL INT tArcMode
DECL REAL tOvAppl
DECL enArcSlope_T tSlopeState
INTERRUPT OFF irtArcSlopeFunction

stArcActWeldSet.Channel1       = ArcSlopeCalcValue(gArcSlopeAct.C1,gArcSlopeAct.DisBetween,tSlopeState)
stArcActWeldSet.Channel2       = ArcSlopeCalcValue(gArcSlopeAct.C2,gArcSlopeAct.DisBetween,tSlopeState)
stArcActWeldSet.Channel3       = ArcSlopeCalcValue(gArcSlopeAct.C3,gArcSlopeAct.DisBetween,tSlopeState)
stArcActWeldSet.Channel4       = ArcSlopeCalcValue(gArcSlopeAct.C4,gArcSlopeAct.DisBetween,tSlopeState)
stArcActWeldSet.Channel5       = ArcSlopeCalcValue(gArcSlopeAct.C5,gArcSlopeAct.DisBetween,tSlopeState)
stArcActWeldSet.Channel6       = ArcSlopeCalcValue(gArcSlopeAct.C6,gArcSlopeAct.DisBetween,tSlopeState)
stArcActWeldSet.Channel7       = ArcSlopeCalcValue(gArcSlopeAct.C7,gArcSlopeAct.DisBetween,tSlopeState)
stArcActWeldSet.Channel8       = ArcSlopeCalcValue(gArcSlopeAct.C8,gArcSlopeAct.DisBetween,tSlopeState)
stArcActWeldSet.Velocity       = ArcSlopeCalcValue(gArcSlopeAct.Velocity,gArcSlopeAct.DisBetween,tSlopeState)
stArcActWeaveSet.Amplitude     = ArcSlopeCalcValue(gArcSlopeAct.Amplitude,gArcSlopeAct.DisBetween,tSlopeState)
stArcActWeaveSet.Length        = ArcSlopeCalcValue(gArcSlopeAct.Length,gArcSlopeAct.DisBetween,tSlopeState)
stArcActWeaveSet.Angle         = ArcSlopeCalcValue(gArcSlopeAct.Angle,gArcSlopeAct.DisBetween,tSlopeState)

;$ANOUT[10] = stArcActWeldSet.Channel1 ;Debug Trace Test Channel 1

tWelder = gArcActIlfWelder
SWITCH tSlopeState
  CASE #ToStart
    tArcMode = gArcActModeOn
  DEFAULT 
    tArcMode = gArcActModeSwi
ENDSWITCH

IF (ArcSetValueToChannel(#None,tWelder,tArcMode,1,stArcActWeldSet.Channel1) < 0) THEN
  ArcWriteDiag(gArcDebugSlope,"[SLOPE] ERROR: Channel1")
ENDIF
IF (ArcSetValueToChannel(#None,tWelder,tArcMode,2,stArcActWeldSet.Channel2) < 0) THEN
  ArcWriteDiag(gArcDebugSlope,"[SLOPE] ERROR: Channel2")
ENDIF
IF (ArcSetValueToChannel(#None,tWelder,tArcMode,3,stArcActWeldSet.Channel3) < 0) THEN
  ArcWriteDiag(gArcDebugSlope,"[SLOPE] ERROR: Channel3")
ENDIF
IF (ArcSetValueToChannel(#None,tWelder,tArcMode,4,stArcActWeldSet.Channel4) < 0) THEN
  ArcWriteDiag(gArcDebugSlope,"[SLOPE] ERROR: Channel4")
ENDIF
IF (ArcSetValueToChannel(#None,tWelder,tArcMode,5,stArcActWeldSet.Channel5) < 0) THEN
  ArcWriteDiag(gArcDebugSlope,"[SLOPE] ERROR: Channel5")
ENDIF
IF (ArcSetValueToChannel(#None,tWelder,tArcMode,6,stArcActWeldSet.Channel6) < 0) THEN
  ArcWriteDiag(gArcDebugSlope,"[SLOPE] ERROR: Channel6")
ENDIF
IF (ArcSetValueToChannel(#None,tWelder,tArcMode,7,stArcActWeldSet.Channel7) < 0) THEN
  ArcWriteDiag(gArcDebugSlope,"[SLOPE] ERROR: Channel7")
ENDIF
IF (ArcSetValueToChannel(#None,tWelder,tArcMode,8,stArcActWeldSet.Channel8) < 0) THEN
  ArcWriteDiag(gArcDebugSlope,"[SLOPE] ERROR: Channel8")
ENDIF

; Problem With Spline & Weave RSI:
tWeaveEnable = TRUE
IF ((stArcCallState.MoveType == #SplBlock) AND (gArcRsiWeavingActive == TRUE)) THEN 
  tWeaveEnable = FALSE
ENDIF

IF (tSlopeState <> #ToStart) THEN
  IF (tWeaveEnable == TRUE) THEN
    IF (gArcSlopeAct.Amplitude.Active == TRUE) THEN
      IF (ArcSetValue(tWelder,tArcMode,#Amplitude,stArcActWeaveSet.Amplitude) < 0) THEN
        ArcWriteDiag(gArcDebugSlope,"[SLOPE] ERROR: Amplitude")
      ENDIF
    ENDIF
    IF (gArcSlopeAct.Length.Active == TRUE) THEN
      IF (ArcSetValue(tWelder,tArcMode,#Length,stArcActWeaveSet.Length) < 0) THEN
        ArcWriteDiag(gArcDebugSlope,"[SLOPE] ERROR: Length")
      ENDIF
    ENDIF
  ENDIF
ENDIF

IF ((gArcSlopeAct.Velocity.Active == TRUE) AND (stArcCallState.MoveType == #Std)) THEN
  SWITCH tSlopeState
    CASE #ToStart
        tOvAppl                  = cOvApplDefault / (cArcVelocityRaport / stArcActWeldSet.Velocity)
        $OV_APPL                 = ArcSetRangeValue(tOvAppl,(wArcZeroVelocity + 0.0001),cOvApplDefault)
        gArcBasVelDefinition     = cArcVelocityRaport
    CASE #ToRun    
        tOvAppl                  = cOvApplDefault / (cArcVelocityRaport / stArcActWeldSet.Velocity)
        $OV_APPL                 = ArcSetRangeValue(tOvAppl,(wArcZeroVelocity + 0.0001),cOvApplDefault)
    CASE #ToEnd
        tOvAppl                  = cOvApplDefault / (cArcVelocityRaport / gArcSlopeAct.Velocity.EValue)
        $OV_APPL                 = ArcSetRangeValue(tOvAppl,(wArcZeroVelocity + 0.0001),cOvApplDefault)
        gArcBasVelDefinition     = cArcVelocityRaport
  ENDSWITCH
ENDIF

SWITCH tSlopeState
  CASE #ToRun
    IF (gArcSlopeAct.Mode == #SplBwd) THEN
      gArcStepInterval = $DISTANCE - cArcSlopeInterval
    ELSE
      gArcStepInterval = $DISTANCE + cArcSlopeInterval
    ENDIF
ENDSWITCH
END
;*****************************************************************************************
;ArcSlopeCalcValue Call from Interrupt ArcSlopeSetValue
;SValue = Start Value
;EValue = End Value
;CValue = Calc Value
;*****************************************************************************************
DEFFCT REAL ArcSlopeCalcValue(tArcSlopeOpt :OUT,tDisBetween :IN,tSlopeState :IN)
DECL BOOL tEndValue
DECL enArcSlope_T tSlopeState
DECL REAL tDisBetween, tDistValue, tStep
DECL stArcSlopeOpt_T tArcSlopeOpt
tArcSlopeOpt.CValue = tArcSlopeOpt.EValue
IF (tArcSlopeOpt.Active == TRUE) THEN
  SWITCH tSlopeState
    CASE #ToStart
      tArcSlopeOpt.CValue = tArcSlopeOpt.SValue
    CASE #ToRun
      tStep = (tArcSlopeOpt.SValue - tArcSlopeOpt.EValue) / tDisBetween
      IF (gArcSlopeAct.Mode == #SplBwd) THEN
        tDistValue = gArcSlopeAct.StartDis - $DISTANCE
        tArcSlopeOpt.CValue = (tArcSlopeOpt.SValue + (tDistValue * tStep))
        tArcSlopeOpt.CValue = ArcSetRangeValue(tArcSlopeOpt.CValue,tArcSlopeOpt.SValue,tArcSlopeOpt.EValue)
        stArcOffSlope.ActDist = ((gArcSlopeAct.StartDis - $DISTANCE) * tStep)
        stArcOffSlope.CalcValue = tArcSlopeOpt.CValue
      ENDIF
      IF (gArcSlopeAct.Mode == #FromPoint) THEN
        tArcSlopeOpt.CValue = (tArcSlopeOpt.SValue + ($DIST_LAST * tStep))
        tArcSlopeOpt.CValue = ArcSetRangeValue(tArcSlopeOpt.CValue,tArcSlopeOpt.SValue,tArcSlopeOpt.EValue)
      ENDIF
      IF (gArcSlopeAct.Mode == #ToPoint) THEN
        tDistValue = $DISTANCE - gArcSlopeAct.StartDis
        tArcSlopeOpt.CValue = (tArcSlopeOpt.SValue + (tDistValue * tStep))
        tArcSlopeOpt.CValue = ArcSetRangeValue(tArcSlopeOpt.CValue,tArcSlopeOpt.SValue,tArcSlopeOpt.EValue)
        stArcOffSlope.ActDist = (($DISTANCE - gArcSlopeAct.StartDis) * tStep)
        stArcOffSlope.CalcValue = tArcSlopeOpt.CValue
      ENDIF
    CASE #ToEnd
      tArcSlopeOpt.CValue = tArcSlopeOpt.EValue
  ENDSWITCH
ENDIF
RETURN tArcSlopeOpt.CValue
ENDFCT
;*****************************************************************************************
;Slope Make SlopeArcOff
;*****************************************************************************************
GLOBAL DEF ArcSlopeOnArcOff(tArcDat :IN)
DECL stArcDat_T tArcDat
  $OV_APPL = cOvApplDefault
END
;*****************************************************************************************
;Slope Option ArcOff
;*****************************************************************************************
GLOBAL DEF ArcSlopeOptionOff(tAdvanced :IN)
DECL stArcDat_T tArcDat
DECL stAdvanced_T tAdvanced
DECL REAL tTimeBuffer
stArcOffSlope.Option = #None
stArcOffSlope.Time = 0
stArcOffSlope.Distance = 0
stArcOffSlope.ActTime = 0
stArcOffSlope.ActDist = 0
stArcOffSlope.CalcValue = 0
stArcOffSlope.Active = FALSE
ArcMsgWriteClearHandle(mArcUnsupportedWeave)

IF ((tAdvanced.SlopeOptionOff == #Time) AND (tAdvanced.SlopeTimeOff <> 0)) THEN
  stArcOffSlope.Option = #Time
  stArcOffSlope.Time = tAdvanced.SlopeTimeOff / 1000 ;in sec
  ArcWriteDiag(gArcGeneralDebug,"[SLOPE ARC OFF] Time")
ENDIF
IF ((tAdvanced.SlopeOptionOff == #Distance) AND (tAdvanced.SlopeDistanceOff <> 0)) THEN
  stArcOffSlope.Option = #Distance
  stArcOffSlope.Distance = tAdvanced.SlopeDistanceOff
  ArcWriteDiag(gArcGeneralDebug,"[SLOPE ARC OFF] Distance")
ENDIF
IF ((tAdvanced.SlopeOptionOff == #Combined) AND (tAdvanced.SlopeDistanceOff <> 0) AND (tAdvanced.SlopeTimeOff <> 0)) THEN
  stArcOffSlope.Option = #Combined
  tTimeBuffer = (ABS(tAdvanced.SlopeDistanceOff) / (stArcActWeldSet.Velocity * 1000)) ;in sec
  stArcOffSlope.Time = tTimeBuffer  + (tAdvanced.SlopeTimeOff / 1000) ;complete time
  ArcWriteDiag(gArcGeneralDebug,"[SLOPE ARC OFF] Combined")
ENDIF

END
;*****************************************************************************************
;Slope Init Values Arc OFF
;*****************************************************************************************
GLOBAL DEF ArcSlopeInitArcOff(tArcDat :IN)
DECL INT tWelderNr
DECL INT tArcMode
DECL stArcDat_T tArcDat
tWelderNr = gArcActIlfWelder
tArcMode = gArcActModeOff ;TODO Check gArcActModeOn or gArcActModeOff
;Slope Start
gArcSlopeAct.C1.SValue          = stArcActWeldSet.Channel1
gArcSlopeAct.C2.SValue          = stArcActWeldSet.Channel2
gArcSlopeAct.C3.SValue          = stArcActWeldSet.Channel3
gArcSlopeAct.C4.SValue          = stArcActWeldSet.Channel4
gArcSlopeAct.C5.SValue          = stArcActWeldSet.Channel5
gArcSlopeAct.C6.SValue          = stArcActWeldSet.Channel6
gArcSlopeAct.C7.SValue          = stArcActWeldSet.Channel7
gArcSlopeAct.C8.SValue          = stArcActWeldSet.Channel8
;Slope End
gArcSlopeAct.C1.EValue          = tArcDat.Crater.Channel1
gArcSlopeAct.C2.EValue          = tArcDat.Crater.Channel2
gArcSlopeAct.C3.EValue          = tArcDat.Crater.Channel3
gArcSlopeAct.C4.EValue          = tArcDat.Crater.Channel4
gArcSlopeAct.C5.EValue          = tArcDat.Crater.Channel5
gArcSlopeAct.C6.EValue          = tArcDat.Crater.Channel6
gArcSlopeAct.C7.EValue          = tArcDat.Crater.Channel7
gArcSlopeAct.C8.EValue          = tArcDat.Crater.Channel8

gArcSlopeAct.C1.Active          = ArcGetSlopeChannel(tWelderNr,tArcMode,#Channel1)
gArcSlopeAct.C2.Active          = ArcGetSlopeChannel(tWelderNr,tArcMode,#Channel2)
gArcSlopeAct.C3.Active          = ArcGetSlopeChannel(tWelderNr,tArcMode,#Channel3)
gArcSlopeAct.C4.Active          = ArcGetSlopeChannel(tWelderNr,tArcMode,#Channel4)
gArcSlopeAct.C5.Active          = ArcGetSlopeChannel(tWelderNr,tArcMode,#Channel5)
gArcSlopeAct.C6.Active          = ArcGetSlopeChannel(tWelderNr,tArcMode,#Channel6)
gArcSlopeAct.C7.Active          = ArcGetSlopeChannel(tWelderNr,tArcMode,#Channel7)
gArcSlopeAct.C8.Active          = ArcGetSlopeChannel(tWelderNr,tArcMode,#Channel8)

gArcSlopeAct.DisBetween         = ABS(tArcDat.Advanced.SlopeDistanceOff) * (-1)
gArcSlopeAct.StartDis           = $DISTANCE
gArcSlopeAct.Mode               = #ToPoint
gArcSlopeAct.IlfDistance        = tArcDat.Advanced.SlopeDistanceOff
gArcSlopeAct.Velocity.Active    = FALSE
gArcSlopeAct.Length.Active      = FALSE
gArcSlopeAct.Amplitude.Active   = FALSE
gArcSlopeAct.Angle.Active       = FALSE
END
;*****************************************************************************************
;Slope ArcOff Channels
;*****************************************************************************************
GLOBAL DEF ArcSlopeChannelsArcOff(tCrater: IN)
DECL BOOL tAnySlopeActive
DECL BOOL tSlopeChannel[8]
DECL INT tI
DECL INT tWelderNr
DECL INT tArcMode
DECL INT tError
DECL REAL tDownslopeTime
DECL REAL tSteps
DECL REAL tCycle
DECL REAL ChannelValueStart[8]
DECL REAL ChannelSlopeStep[8]
DECL stCrater_T tCrater
DECL stArcDat_T tArcDat

tWelderNr = gArcActIlfWelder
tArcMode = gArcActModeOff ;TODO Check gArcActModeOn or gArcActModeOff

stArcOffSlope.Active = TRUE

stArcOffSlope.ActTime = 0
tSteps = 0
tCycle = 0.012
tAnySlopeActive = FALSE

IF (wArcSlopeOption == FALSE) THEN
  RETURN
ENDIF

;tDownslopeTime = 1
tDownslopeTime = stArcOffSlope.Time

IF (tDownslopeTime <= 0) THEN
  RETURN
ENDIF

ChannelValueStart[1] = stArcActWeldSet.Channel1
ChannelValueStart[2] = stArcActWeldSet.Channel2
ChannelValueStart[3] = stArcActWeldSet.Channel3
ChannelValueStart[4] = stArcActWeldSet.Channel4
ChannelValueStart[5] = stArcActWeldSet.Channel5
ChannelValueStart[6] = stArcActWeldSet.Channel6
ChannelValueStart[7] = stArcActWeldSet.Channel7
ChannelValueStart[8] = stArcActWeldSet.Channel8

tSteps = tDownslopeTime / tCycle

IF (tSteps <= 1) THEN
  RETURN
ENDIF

ChannelSlopeStep[1] = (stArcActWeldSet.Channel1 - tCrater.Channel1) / tSteps
ChannelSlopeStep[2] = (stArcActWeldSet.Channel2 - tCrater.Channel2) / tSteps
ChannelSlopeStep[3] = (stArcActWeldSet.Channel3 - tCrater.Channel3) / tSteps
ChannelSlopeStep[4] = (stArcActWeldSet.Channel4 - tCrater.Channel4) / tSteps
ChannelSlopeStep[5] = (stArcActWeldSet.Channel5 - tCrater.Channel5) / tSteps
ChannelSlopeStep[6] = (stArcActWeldSet.Channel6 - tCrater.Channel6) / tSteps
ChannelSlopeStep[7] = (stArcActWeldSet.Channel7 - tCrater.Channel7) / tSteps
ChannelSlopeStep[8] = (stArcActWeldSet.Channel8 - tCrater.Channel8) / tSteps

tSlopeChannel[1]          = ArcGetSlopeChannel(tWelderNr,tArcMode,#Channel1)
tSlopeChannel[2]          = ArcGetSlopeChannel(tWelderNr,tArcMode,#Channel2)
tSlopeChannel[3]          = ArcGetSlopeChannel(tWelderNr,tArcMode,#Channel3)
tSlopeChannel[4]          = ArcGetSlopeChannel(tWelderNr,tArcMode,#Channel4)
tSlopeChannel[5]          = ArcGetSlopeChannel(tWelderNr,tArcMode,#Channel5)
tSlopeChannel[6]          = ArcGetSlopeChannel(tWelderNr,tArcMode,#Channel6)
tSlopeChannel[7]          = ArcGetSlopeChannel(tWelderNr,tArcMode,#Channel7)
tSlopeChannel[8]          = ArcGetSlopeChannel(tWelderNr,tArcMode,#Channel8)

FOR tI = 1 TO 8
  IF (tSlopeChannel[tI] == TRUE) THEN
    tAnySlopeActive = TRUE
  ENDIF
ENDFOR

IF (tAnySlopeActive == FALSE) THEN
  RETURN
ENDIF

gArcMotionForwardEnable = FALSE

LOOP
  FOR tI = 1 TO 8
    IF (tSlopeChannel[tI] == TRUE) THEN
      ChannelValueStart[tI] = ChannelValueStart[tI] - ChannelSlopeStep[tI]
      tError = ArcSetValueToChannel(#None,tWelderNr,tArcMode,tI,ChannelValueStart[tI])
    ENDIF
  ENDFOR
  WAIT SEC tCycle
  stArcOffSlope.ActTime = stArcOffSlope.ActTime + tCycle
  IF (stArcOffSlope.ActTime >= (tDownslopeTime - tCycle)) THEN
    tError = ArcSetValueToChannel(#None,tWelderNr,tArcMode,1,tCrater.Channel1)
    tError = ArcSetValueToChannel(#None,tWelderNr,tArcMode,2,tCrater.Channel2)
    tError = ArcSetValueToChannel(#None,tWelderNr,tArcMode,3,tCrater.Channel3)
    tError = ArcSetValueToChannel(#None,tWelderNr,tArcMode,4,tCrater.Channel4)
    tError = ArcSetValueToChannel(#None,tWelderNr,tArcMode,5,tCrater.Channel5)
    tError = ArcSetValueToChannel(#None,tWelderNr,tArcMode,6,tCrater.Channel6)
    tError = ArcSetValueToChannel(#None,tWelderNr,tArcMode,7,tCrater.Channel7)
    tError = ArcSetValueToChannel(#None,tWelderNr,tArcMode,8,tCrater.Channel8)
    EXIT
  ENDIF
ENDLOOP
stArcOffSlope.Active = FALSE
END
;*****************************************************************************************
;ArcOff Strategy
;*****************************************************************************************
GLOBAL DEF ArcOffStrategy(tCall :IN,tArcDat :IN)
DECL enArcCall tCall
DECL stArcDat_T tArcDat
DECL enOffSlopeStart_T tSlopeStart
DECL BOOL tMoveBack

IF (gArcTechAdvancedOption == FALSE) THEN
  RETURN
ENDIF
IF (stArcFeatureState.Act.OnTheFlyOff == TRUE) THEN
  RETURN
ENDIF
IF (stMoveBackAtArcOff.Done == TRUE) THEN
  RETURN ;ArcSplineBlock calls double
ENDIF

tSlopeStart = #Invalid
tMoveBack = FALSE
ArcSlopeOptionOff(tArcDat.Advanced)

IF (ArcAtaMoveBackOption(tArcDat.Advanced) == TRUE) THEN
  IF ((stArcOffSlope.Option == #Distance) AND (tArcDat.Advanced.SlopeStartOptionOff == #BeforeArcOff)) THEN
    tSlopeStart = #BeforeArcOff
    tMoveBack = TRUE
  ENDIF
  IF ((stArcOffSlope.Option == #Distance) AND (tArcDat.Advanced.SlopeStartOptionOff == #AtArcOff)) THEN
    tSlopeStart = #AtArcOff
    tMoveBack = TRUE
  ENDIF
  IF ((stArcOffSlope.Option == #Distance) AND (tArcDat.Advanced.SlopeStartOptionOff == #AfterArcOff)) THEN
    tSlopeStart = #Invalid
  ENDIF
  IF ((stArcOffSlope.Option == #Time) AND (tArcDat.Advanced.SlopeStartOptionOff == #BeforeArcOff)) THEN
    tSlopeStart = #Invalid
  ENDIF
  IF ((stArcOffSlope.Option == #Time) AND (tArcDat.Advanced.SlopeStartOptionOff == #AtArcOff)) THEN
    tSlopeStart = #AtArcOff
    tMoveBack = TRUE
  ENDIF
  IF ((stArcOffSlope.Option == #Time) AND (tArcDat.Advanced.SlopeStartOptionOff == #AfterArcOff)) THEN
    tSlopeStart = #AfterArcOff
    tMoveBack = TRUE
  ENDIF
  IF (stArcOffSlope.Option == #Combined) THEN
    tSlopeStart = #Invalid ;Problem with 2 Interrupts (Slope and RecordPos)
  ENDIF
  IF (stArcOffSlope.Option == #None) THEN
    tSlopeStart = #None
    tMoveBack = TRUE
  ENDIF
ELSE
  IF (stArcOffSlope.Option == #Distance) THEN
    tSlopeStart = #BeforeArcOff
  ENDIF
  IF (stArcOffSlope.Option == #Time) THEN
    tSlopeStart = #AtArcOff
  ENDIF
  IF (stArcOffSlope.Option == #Combined) THEN
    tSlopeStart = #BeforeArcOff
  ENDIF
ENDIF

SWITCH tCall
  CASE #BeforeArcOff
    SWITCH tSlopeStart
      CASE #None
        ;No Action
      CASE #BeforeArcOff
        SWITCH stArcOffSlope.Option
          CASE #Distance
            ArcWriteDiag(gArcGeneralDebug,"[SLOPE ARC OFF] BeforeArcOff Distance")
            ArcSlopeInitArcOff(tArcDat)
            ArcSlopeSetActive()
          CASE #Combined
            ArcWriteDiag(gArcGeneralDebug,"[SLOPE ARC OFF] BeforeArcOff Combined")
            ArcSlopeChannelsArcOff(tArcDat.Crater)
        ENDSWITCH
      CASE #AtArcOff
        ;No Action
      CASE #AfterArcOff
        ;No Action
      CASE #Invalid
        ;No Action
    ENDSWITCH
    
  CASE #AtArcOff
    SWITCH tSlopeStart
      CASE #None
        MoveBackAtArcOff(tMoveBack,tArcDat)
      CASE #BeforeArcOff
        MoveBackAtArcOff(tMoveBack,tArcDat)
      CASE #AtArcOff
        SWITCH stArcOffSlope.Option
          CASE #Distance
            ArcWriteDiag(gArcGeneralDebug,"[SLOPE ARC OFF] AtArcOff Distance")
            ArcSlopeInitArcOff(tArcDat)
            gArcSlopeArcOn = TRUE
            IF (stArcCallState.MoveType == #SplBlock) THEN
              gArcSlopeAct.Mode = #SplBwd
            ELSE
              gArcSlopeAct.Mode = #FromPoint
            ENDIF
            ArcSlopeSetActive()
          CASE #Time
            ArcWriteDiag(gArcGeneralDebug,"[SLOPE ARC OFF] AtArcOff Time")
            IF (stArcCallState.MoveType == #SplBlock) THEN
              WAIT SEC 0
              $OV_APPL = 0
            ENDIF
            ArcSlopeChannelsArcOff(stArcActCraterSet)
            IF (stArcCallState.MoveType == #SplBlock) THEN
              $OV_APPL = cOvApplDefault
            ENDIF
        ENDSWITCH
        MoveBackAtArcOff(tMoveBack,tArcDat)
      CASE #AfterArcOff
        MoveBackAtArcOff(tMoveBack,tArcDat)
        SWITCH stArcOffSlope.Option
          CASE #Time
            ArcWriteDiag(gArcGeneralDebug,"[SLOPE ARC OFF] AfterArcOff Time")
            ArcSlopeChannelsArcOff(stArcActCraterSet)
        ENDSWITCH
      CASE #Invalid
        ;No Action
    ENDSWITCH
ENDSWITCH
END
;*****************************************************************************************
;Move back at ArcOff
;*****************************************************************************************
DEF MoveBackAtArcOff(tBoolMoveBack: IN, tArcDat :IN)
DECL BOOL tBoolMoveBack
DECL stArcDat_T tArcDat

IF (tBoolMoveBack == FALSE) THEN
  RETURN
ENDIF

stMoveBackAtArcOff.Done = TRUE
SWITCH (stArcCallState.MoveType)
  CASE #Std
    IF (stMoveBackAtArcOff.PosRecorded == FALSE) THEN
      ArcWriteDiag(gArcGeneralDebug,"[OFF MOVEBACK] Error Record Pos")
      ArcMsgWrite(,#NOTIFY,"ErrorRecordMoveBackPos","ARC",10148,OPT_VLSTOP_LOG)
      RETURN
    ENDIF
    ArcWriteDiag(gArcGeneralDebug,"[OFF MOVEBACK] Move Std")
    BAS(#CP_PARAMS,stMoveBackAtArcOff.Velocity) 
    LIN gMoveBackAtArcOffPos

  CASE #SplSingle
    IF (stMoveBackAtArcOff.PosRecorded == FALSE) THEN
      ArcWriteDiag(gArcGeneralDebug,"[OFF MOVEBACK] Error Record Pos")
      ArcMsgWrite(,#NOTIFY,"ErrorRecordMoveBackPos","ARC",10148,OPT_VLSTOP_LOG)
      RETURN
    ENDIF
    ArcWriteDiag(gArcGeneralDebug,"[OFF MOVEBACK] Move SplSingle")
    SLIN gMoveBackAtArcOffPos WITH $VEL.CP = stMoveBackAtArcOff.Velocity

  CASE #SplBlock
    ArcWriteDiag(gArcGeneralDebug,"[OFF MOVEBACK] Move SplBlock")
    IF (tArcDat.Advanced.MoveBackAtArcOffDistance > cMaxMoveBackDistance) THEN
      tArcDat.Advanced.MoveBackAtArcOffDistance = cMaxMoveBackDistance
    ENDIF
    ArcMotionSplineMoveBack(tArcDat.Advanced.MoveBackAtArcOffDistance,stMoveBackAtArcOff.Velocity,tArcDat.Advanced.MoveBackAtArcOffDistance,0.0)

  DEFAULT
  ArcWriteDiag(gArcGeneralDebug,"[OFF MOVEBACK] Not moving for move state ", ArcEnumMoveStateToStr(stArcCallState.MoveType)) 

ENDSWITCH
END
;*****************************************************************************************
;ArcCheckModeId
;*****************************************************************************************
GLOBAL DEFFCT INT ArcCheckModeId(tWelderNr :IN,tModeId[] :IN, tMsgType :IN)
DECL BOOL tB
DECL BOOL tFound
DECL INT tI
DECL INT tFoundId
DECL INT tWelderNr
DECL CHAR tModeId[]
DECL CHAR tJobModeId[24]
DECL enArcMessageType_T tMsgType
DECL stArcModeCoding_T tArcModeCoding
tFoundId = 1
tFound = FALSE
FOR tI = 1 TO gArcMaxNrOfArcModi[tWelderNr]
  tB = STRCOPY(tJobModeId[]," ")
  tArcModeCoding = ArcGetModiCoding(tWelderNr,tI)  
  tJobModeId[] = tArcModeCoding.JobModeId[]
  IF (STRCOMP(tJobModeId[],tModeId[],#NOT_CASE_SENS)) THEN
    IF StrLen(tJobModeId[]) == StrLen(tModeId[]) THEN
      tFound = TRUE
      tFoundId = tI
      EXIT
    ENDIF
  ENDIF
ENDFOR
IF (tMsgType <> #NONE) THEN
  IF (tFound == FALSE) THEN
    IF (mArcCheckModeIdShowed == FALSE) THEN
      ArcMsgWriteS(,tMsgType,"JobModeIdNotFoundUndoLastArcModeChanges","ARC",10102,Opt_NOVLSTOP_LOG,tModeId[])
    ENDIF
    mArcCheckModeIdShowed = TRUE
    ArcWriteDiag(gArcGeneralDebug,"[JobModeID] Not Found SetJobMode = 1") 
  ENDIF
ENDIF
RETURN tFoundId
ENDFCT
;*****************************************************************************************
;Routine check SPLINE Move backward
;*****************************************************************************************
GLOBAL DEF ArcMotionSplineMoveBack(tDistance :IN,tVel :IN,tConstDist :IN,tDecayDist: IN)
DECL CHAR MsgText[40]
DECL REAL tDistance,tVel,tConstDist,tDecayDist
DECL MBW_PARA_TARGET tMBW_PARA_TARGET
DECL MBW_PARA_OFFSET tMBW_PARA_OFFSET
DECL MBW_RESULT tMBW_RESULT
tMBW_PARA_TARGET.DISTANCE   = tDistance
tMBW_PARA_TARGET.VEL        = tVel
tMBW_PARA_OFFSET.CONST_DIST = tConstDist
tMBW_PARA_OFFSET.DECAY_DIST = tDecayDist
tMBW_RESULT                 = MOVE_BACKWARD(tMBW_PARA_TARGET, tMBW_PARA_OFFSET)
IF tMBW_RESULT.ERROR <> #MBW_OK THEN
  SWITCH tMBW_RESULT.ERROR
    CASE #MBW_WRONG_CONTEXT
      MsgText[]="MBW_WRONG_CONTEXT"
    CASE #MBW_NO_MOTION
      MsgText[]="MBW_NO_MOTION"
    CASE #MBW_NO_SPLINE
      MsgText[]="MBW_NO_SPLINE"
    CASE #MBW_MAX_DEVIATION
      MsgText[]="MBW_MAX_DEVIATION"
    CASE #MBW_WRONG_STATUS
      MsgText[]="MBW_MBW_WRONG_STATUS"
    CASE #MBW_WRONG_TURN
      MsgText[]="MBW_WRONG_TURN"
    CASE #MBW_SYNC_IMPOSSIBLE
      MsgText[]="MBW_SYNC_IMPOSSIBLE"
    CASE #MBW_NESTED_CALL
      MsgText[]="MBW_NESTED_CALL"
    CASE #MBW_DOUBLE_CALL
      MsgText[]="MBW_DOUBLE_CALL"
    CASE #MBW_MISSING_ARGUMENT
      MsgText[]="MBW_MISSING_ARGUMENT"
    CASE #MBW_INVALID_ARGUMENT
      MsgText[]="MBW_INVALID_ARGUBMENT"
    CASE #MBW_EARLY_ABORTED
      MsgText[]="MBW_EARLY_ABORTED"
  ENDSWITCH
  SWITCH tMBW_RESULT.ERROR
    CASE #MBW_EARLY_ABORTED
      ArcMsgWriteS(,#QUIT,"ErrorSplineBackward","ARC",10060,OPT_VLSTOP_LOG,MsgText[])
      ArcRemoteSetClearMsg(10060)
      HALT
    DEFAULT
      WHILE TRUE
        ArcMsgWriteS(,#QUIT,"ErrorSplineBackward","ARC",10060,OPT_VLSTOP_LOG,MsgText[])
        ArcRemoteSetClearMsg(10060)
        HALT
      ENDWHILE
  ENDSWITCH
ENDIF
WAIT SEC 0
END
;*****************************************************************************************
;Routine Convert Enum ErrorMotion to String
;*****************************************************************************************
GLOBAL DEFFCT CHAR[40] ArcEnumErrorMotionToStr(tErrorMotion :IN)
DECL enArcErrorMotion_T tErrorMotion
SWITCH tErrorMotion
  CASE #MoveForward
    RETURN "MoveForward"
  CASE #MoveScratch
    RETURN "MoveScratch"
  CASE #KeepOnPosition
    RETURN "KeepOnPosition"
  CASE #MoveUpAndStop
    RETURN "MoveUpAndStop"
  CASE #MoveBackward
    RETURN "MoveBackward"
  CASE #MoveBackwardLimit
    RETURN "MoveBackward"
  CASE #BackFromStop
    RETURN"#BackFromStop"
  CASE #BackToSplineStart
    RETURN "BackToSplineStart"
  CASE #ContinueWithoutRetry
    RETURN "ContinueWithoutRetry"
  CASE #StartFromPos
    RETURN "StartFromPos"
ENDSWITCH
ENDFCT
;*****************************************************************************************
;Routine Convert Enum ErrorMotion to String Short
;*****************************************************************************************
GLOBAL DEFFCT CHAR[40] ArcEnumErrorToStrShort(tErrorMotion :IN)
DECL enArcErrorMotion_T tErrorMotion
SWITCH tErrorMotion
  CASE #MoveForward
    RETURN "MoveForward"
  CASE #MoveScratch
    RETURN "MoveScratch"
  CASE #KeepOnPosition
    RETURN "KeepOnPos"
  CASE #MoveUpAndStop
    RETURN "UpAndStop"
  CASE #MoveBackward
    RETURN "MoveBackward"
  CASE #MoveBackwardLimit
    RETURN "MoveBackward"
  CASE #BackFromStop
    RETURN"#BackFromStop"
  CASE #BackToSplineStart
    RETURN "BackSplStart"
  CASE #ContinueWithoutRetry
    RETURN "ContNoRetry"
  CASE #StartFromPos
    RETURN "StartFromPos"
ENDSWITCH
ENDFCT
;*****************************************************************************************
;Routine Convert Enum ArcCall to String
;*****************************************************************************************
GLOBAL DEFFCT CHAR[24] ArcCallEnumToStr(tArcCall :IN)
DECL enArcCall_T tArcCall
SWITCH tArcCall
  CASE #PreDefinition
    RETURN "PreDefinition"
  CASE #GasPreflow
    RETURN "GasPreflow"
  CASE #ArcOnMoveStd
    RETURN "ArcOnMoveStd"
  CASE #ArcOnSplSingle
    RETURN "ArcOnSplSingle"
  CASE #ArcOnAfterMoveStd
    RETURN "ArcOnAfterMoveStd"
  CASE #ArcOnAfterSplSingle
    RETURN "ArcOnAfterSplSingle"
  CASE #ArcSwiBeforeMoveStd
    RETURN "ArcSwiBeforeMoveStd"
  CASE #ArcSwiMoveStd
    RETURN "ArcSwiMoveStd"
  CASE #ArcSwiSplSingle
    RETURN "#ArcSwiSplSingle"
  CASE #ArcSwiAfterMoveStd
    RETURN "ArcSwiAfterMoveStd"
  CASE #ArcOffBeforeOffStd
    RETURN "ArcOffBeforeOffStd"
  CASE #ArcOffBeforeOffStd2
    RETURN "ArcOffBeforeOffStd2"
  CASE #ArcOffBeforeMoveStd
    RETURN "ArcOffBeforeMoveStd"
  CASE #ArcOffMoveStd
    RETURN "ArcOffMoveStd"
  CASE #ArcOffSplSingle
    RETURN "ArcOffSplSingle"
  CASE #ArcOffAfterMoveStd
    RETURN "ArcOffAfterMoveStd"
  CASE #ArcOffAfterSplSingle
    RETURN "ArcOffAfterSplSingle"
  CASE #ArcOnMoveSpl
    RETURN "ArcOnMoveSpl"
  CASE #ArcSwiMoveSpl
    RETURN "ArcSwiMoveSpl"
  CASE #ArcOffMoveSpl
    RETURN "ArcOffMoveSpl"
  DEFAULT
    RETURN "NoCall"
ENDSWITCH
ENDFCT
