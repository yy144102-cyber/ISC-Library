tOptionActivated = FALSE
IF (gArcTechAdvancedOption == TRUE) THEN
  IF ((wArcMoveBackAtOffOption == TRUE) AND (tAdvancedSet.MoveBackAtArcOffOption <> #None) AND (tAdvancedSet.MoveBackAtArcOffDistance > 0)) THEN
    tOptionActivated = TRUE
