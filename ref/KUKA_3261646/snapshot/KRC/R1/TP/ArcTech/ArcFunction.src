;******************************************************************************
;[Global Routine] ATA Prestart On Option active
;******************************************************************************
GLOBAL DEFFCT BOOL ArcAtaPreStartOption(tAdvancedSet :IN)
DECL stAdvanced_T tAdvancedSet
DECL BOOL tOptionActivated
tOptionActivated = FALSE
IF (gArcTechAdvancedOption == TRUE) THEN
  IF ((wArcPreStartEnabled == TRUE) AND (tAdvancedSet.PreStartOn == TRUE)) THEN
    IF (tAdvancedSet.PreStartLocal == TRUE) THEN
      IF (tAdvancedSet.PreStartTime > 0) THEN
        tOptionActivated = TRUE
      ENDIF
    ELSE
      IF (wArcPreStartTime > 0) THEN
        tOptionActivated = TRUE
      ENDIF
    ENDIF
  ENDIF
ENDIF
RETURN tOptionActivated
ENDFCT
