ENDFCT
;*****************************************************************************************
;[Global String Routine] Extract Robot Modul Name
;*****************************************************************************************
GLOBAL DEFFCT CHAR[24] ArcExtractName(tStr[] :IN)
DECL INT tI,tII,tStrLen,tStart,tLen,tEnd
DECL CHAR tStr[],Str1[24]
tStrLen = StrLen(tStr[])
IF (tStrLen < 1) THEN
  RETURN " "
ENDIF
tII = 1
FOR tI = 5 TO tStrLen
   IF (tStr[tI] == ".") THEN
     RETURN Str1[]
   ENDIF
   Str1[tII] = tStr[tI]
   tII = tII + 1
ENDFOR
RETURN " "
ENDFCT
;******************************************************************************
;[Global Routine] Calc Target Position
;******************************************************************************
GLOBAL DEFFCT E6POS ArcCalcTargetPos(tPosStartIn:IN, tPosEndIn:IN, tDistance:IN)
DECL E6POS tPosStartIn, tPosEndIn, tPosTarget
DECL REAL tDistance, tDistBetween, tDistTarget
tDistBetween  = ArcDiffBetween(tPosStartIn,tPosEndIn)
IF (tDistBetween == 0) THEN
  ArcMsgWriteS(,#NOTIFY ,"AtbInternalError","ARC",10094,Opt_NOVLSTOP_LOG,gArcActIlfWelderName[],"Error PosCalc")
  RETURN tPosStartIn
ENDIF
tDistTarget   = tDistance / tDistBetween
tPosTarget    = tPosStartIn
tPosTarget.X  = tPosStartIn.X + ((tPosEndIn.X - tPosStartIn.X) * tDistTarget)
tPosTarget.Y  = tPosStartIn.Y + ((tPosEndIn.Y - tPosStartIn.Y) * tDistTarget)
tPosTarget.Z  = tPosStartIn.Z + ((tPosEndIn.Z - tPosStartIn.Z) * tDistTarget)
RETURN tPosTarget
ENDFCT
;******************************************************************************
;[Global Routine] Receipt Welder
;******************************************************************************
GLOBAL DEF ArcReceiptWelder()
DECL INT tI
IF (ArcWeldCondition(gArcActIlfWelder) == TRUE) THEN
  SWITCH ArcInputGroupStatusOn(gArcActIlfWelder,wArcIRdyWeldSource[,],0)
    CASE 0
      ArcWriteDiag(gArcGeneralDebug,"[FUNCTION] ReceiptWelder")
      ArcOutputPulseGroupSet(gArcActIlfWelder,wArcOReceiptError[,])
      tI = ArcOutputGroupStatusOff(gArcActIlfWelder,wArcOReceiptError[,],1)
  ENDSWITCH
ENDIF
END
;******************************************************************************
;[Global ArcTech Advanced User Calls
;******************************************************************************
GLOBAL DEF ArcAtaUserCalls(tCall:IN,tArcDat:IN)
DECL enArcUsrCall_T tCall
DECL stArcDat_T tArcDat
IF (gArcTechAdvancedOption == TRUE) THEN
  SWITCH tCall
    CASE #PreStrikeParam
      ATA_UsrPreStrikeParams(tArcDat)
    CASE #PosStrikeParam
      ATA_UsrPostStrikeParams(tArcDat)
    CASE #PreArcOn
      ATA_UsrPre_ArcOn(tArcDat,gArcSeamName[])
    CASE #PostArcOn
      ATA_UsrPost_ArcOn(tArcDat,gArcSeamName[])
    CASE #PreArcSwi
      ATA_UsrPre_ArcSwi(tArcDat)
    CASE #PostArcSwi
      ATA_UsrPost_ArcSwi(tArcDat)
    CASE #PreArcOff
      ATA_UsrPre_ArcOff(tArcDat)
    CASE #PostArcOff
      ATA_UsrPost_ArcOff(tArcDat)
    CASE #PreRestart
      ATA_UsrPreRestart()
    CASE #PostRestart
      ATA_UsrPostRestart()
    CASE #PreSplStart
      ATA_UsrPreSplStart()
    CASE #PostSplStart
      ATA_UsrPostSplStart()
    CASE #ErrorHandle
      ATA_UsrErrorHandle()
    DEFAULT
      ;New Interface
      ATA_UserCall(tCall)
  ENDSWITCH
ENDIF
END
;******************************************************************************
;[Global] ArcTech Is external Base selected
;******************************************************************************
GLOBAL DEFFCT BOOL ArcIsExternalBase()
DECL INT tIndex
IF ($ACT_BASE == 0) THEN
  RETURN FALSE
ENDIF
tIndex = MACHINE_FRAME_DAT[$ACT_BASE].MACH_DEF_INDEX
IF (tIndex == 0) THEN
  RETURN FALSE
ENDIF
SWITCH MACHINE_DEF[tIndex].MECH_TYPE
CASE #NONE, #ROBOT
  RETURN FALSE
DEFAULT
  RETURN TRUE
ENDSWITCH
ENDFCT
;******************************************************************************
;[Global] ArcTech get Act Position 
;******************************************************************************
GLOBAL DEFFCT E6POS ArcGetActPos()
DECL E6POS tDifPos
IF (ArcIsSttActive() == FALSE) THEN
  RETURN $POS_ACT
ENDIF
SWITCH ArcCallFromRoutine()
  CASE 1 ;Call from Robot
    tDifPos   = $NULLFRAME
    tDifPos.X = $SEN_PREA[50]
    tDifPos.Y = $SEN_PREA[51]
    tDifPos.Z = $SEN_PREA[52]
    tDifPos.A = $SEN_PREA[53]
    tDifPos.B = $SEN_PREA[54]
    tDifPos.C = $SEN_PREA[55]
    RETURN INV_POS(tDifPos) : $POS_ACT  
  CASE 2 ;Call from Robot Trigger
    RETURN $POS_ACT
ENDSWITCH
RETURN $POS_ACT
ENDFCT
;******************************************************************************
;[Global] ArcTech Move to with act motion type
;******************************************************************************
GLOBAL DEF ArcMoveTo(tPos:IN,tOvAppl:IN)
DECL BOOL tDoNewMotion
DECL E6POS tPos
DECL REAL tOvAppl
DECL REAL tOvApplMem
ON_ERROR_PROCEED
tOvAppl = tOvAppl
IF ($ERR.NUMBER > 0) THEN
  ERR_CLEAR($ERR)
  tOvAppl = $OV_APPL
ENDIF
tOvApplMem = $OV_APPL
$OV_APPL   = tOvAppl
;ArcCallFromRoutine = 1 Call from Robot
tDoNewMotion = ((stArcCallState.MoveType <> #Std) AND (ArcCallFromRoutine() == 1))
IF (tDoNewMotion == TRUE) THEN
  ArcWriteDiag(gArcGeneralDebug,"[FUNCTION]-ArcMoveTo SLIN tPos")
  SLIN tPos
ELSE
  ArcWriteDiag(gArcGeneralDebug,"[FUNCTION]-ArcMoveTo LIN tPos")
  LIN tPos
ENDIF
$OV_APPL   = tOvApplMem
END
;******************************************************************************
;[Global] ArcTech Move to with act motion type
;******************************************************************************
GLOBAL DEF ArcMoveFromTo(tPos:IN,tFrame:IN)
DECL BOOL tDoNewMotion
DECL E6POS tPos
DECL FRAME tFrame
;ArcCallFromRoutine = 1 Call from Robot
tDoNewMotion = ((stArcCallState.MoveType <> #Std) AND (ArcCallFromRoutine() == 1))
IF (tDoNewMotion == TRUE) THEN
  ArcWriteDiag(gArcGeneralDebug,"[FUNCTION]-ArcMoveFromTo SLIN tPos : tFrame")
  SLIN tPos : tFrame
ELSE
  ArcWriteDiag(gArcGeneralDebug,"[FUNCTION]-ArcMoveFromTo LIN tPos : tFrame")
  LIN tPos : tFrame
ENDIF
END
;******************************************************************************
;[Global Routine] Set $DISTANCE TO 0
;******************************************************************************
GLOBAL DEF SetDistanceToZero()
DECL BOOL tDoNewMotion
DECL INT tI
DECL REAL tDist
DECL E6POS tPOS_ACT
tDist = 0.5
IF (tDist >= $DISTANCE) THEN
  RETURN
ENDIF
;ArcCallFromRoutine = 1 Call from Robot
tDoNewMotion = ((stArcCallState.MoveType <> #Std) AND (ArcCallFromRoutine() == 1))
FOR tI = 1 TO 10
  tPOS_ACT = ArcGetActPos()
  IF (tDoNewMotion == TRUE) THEN
    ArcWriteDiag(gArcGeneralDebug,"[FUNCTION]-SetDistanceToZero SLIN tPOS_ACT")
    SLIN tPOS_ACT
  ELSE
    ArcWriteDiag(gArcGeneralDebug,"[FUNCTION]-SetDistanceToZero LIN tPOS_ACT")
    LIN tPOS_ACT
  ENDIF
  IF (tDist >= $DISTANCE) THEN
    EXIT
  ENDIF
ENDFOR
END
