tError = ArcSetValueToChannel(#ArcSwi,tWelderNr,tArcMode,4,tWeld.Channel4)
tError = ArcSetValueToChannel(#ArcSwi,tWelderNr,tArcMode,5,tWeld.Channel5)
tError = ArcSetValueToChannel(#ArcSwi,tWelderNr,tArcMode,6,tWeld.Channel6)
tError = ArcSetValueToChannel(#ArcSwi,tWelderNr,tArcMode,7,tWeld.Channel7)
tError = ArcSetValueToChannel(#ArcSwi,tWelderNr,tArcMode,8,tWeld.Channel8)
