tError = ArcSetValueToChannel(#ArcOff,tWelderNr,tArcMode,8,tCrater.Channel8)
END
;*****************************************************************************************
;[Global Routine] Arc Get Point Value from param
;*****************************************************************************************
GLOBAL DEFFCT INT ArcGetValueFromParam(tClChannel :IN,tValuePara :IN)
DECL BOOL tCalcOk
DECL INT tI
DECL REAL tMaxValue
DECL REAL tValuePara
DECL REAL tPara
DECL REAL tVal
DECL REAL tParam
DECL REAL tValue
DECL REAL tReturn
DECL stArcCtrlLine_T tCtrlLine[5]
DECL stArcClChannel_T tClChannel
tCalcOk = FALSE
tReturn = 0.0
SWITCH tClChannel.NrPoints
  CASE 2
    tCtrlLine[1] = tClChannel.P1
    tCtrlLine[2] = tClChannel.P2
  CASE 3
    tCtrlLine[1] = tClChannel.P1
    tCtrlLine[2] = tClChannel.P2
    tCtrlLine[3] = tClChannel.P3
  CASE 4
    tCtrlLine[1] = tClChannel.P1
    tCtrlLine[2] = tClChannel.P2
    tCtrlLine[3] = tClChannel.P3
    tCtrlLine[4] = tClChannel.P4
  CASE 5
    tCtrlLine[1] = tClChannel.P1
    tCtrlLine[2] = tClChannel.P2
    tCtrlLine[3] = tClChannel.P3
    tCtrlLine[4] = tClChannel.P4
    tCtrlLine[5] = tClChannel.P5
DEFAULT
  RETURN tValuePara
ENDSWITCH
tMaxValue  = tCtrlLine[tClChannel.NrPoints].Val
FOR tI = 2 TO tClChannel.NrPoints
  IF (tCtrlLine[tI].Para >= tValuePara) THEN; AND (tClChannel.NrPoints >= tI) THEN 
    tCalcOk = TRUE
    tVal = tCtrlLine[tI].Val - tCtrlLine[tI-1].Val
    tPara = 0.0
    tParam = 0.0
    IF ((tCtrlLine[tI].Para - tCtrlLine[tI-1].Para) >= 1E-08)  THEN
      tPara = tCtrlLine[tI].Para - tCtrlLine[tI-1].Para
      tParam = tVal/tPara
    ENDIF
    tValue = tCtrlLine[tI-1].Val - tParam * tCtrlLine[tI-1].Para
    tReturn = tValuePara * tParam + tValue
    tReturn = ArcSetRangeValue(tReturn,tCtrlLine[tI-1].Val,tCtrlLine[tI].Val)
  ENDIF  
ENDFOR
IF (tCalcOk == FALSE) THEN
  tReturn = tMaxValue
ENDIF
RETURN tReturn
ENDFCT
;*****************************************************************************************
;[Global Routine] Arc Get Point Value from control line
;*****************************************************************************************
GLOBAL DEFFCT INT ArcGetValueFromCtrlLine(tClChannel :IN,tValuePara :IN)
DECL BOOL tValOutSideMinMax
DECL INT tI
DECL INT tSelectedtCtrlLine
DECL REAL tValuePara
DECL REAL tPara
DECL REAL tVal
DECL REAL tPitch
DECL REAL tValue
DECL REAL tReturn
DECL REAL tMinPara
DECL REAL tMaxPara
DECL stArcCtrlLine_T tCtrlLine[5]
DECL stArcClChannel_T tClChannel

SWITCH tClChannel.NrPoints
  CASE 2
    tCtrlLine[1] = tClChannel.P1
    tCtrlLine[2] = tClChannel.P2
  CASE 3
    tCtrlLine[1] = tClChannel.P1
    tCtrlLine[2] = tClChannel.P2
    tCtrlLine[3] = tClChannel.P3
  CASE 4
    tCtrlLine[1] = tClChannel.P1
    tCtrlLine[2] = tClChannel.P2
    tCtrlLine[3] = tClChannel.P3
    tCtrlLine[4] = tClChannel.P4
  CASE 5
    tCtrlLine[1] = tClChannel.P1
    tCtrlLine[2] = tClChannel.P2
    tCtrlLine[3] = tClChannel.P3
    tCtrlLine[4] = tClChannel.P4
    tCtrlLine[5] = tClChannel.P5
DEFAULT
  RETURN tValuePara
ENDSWITCH

tReturn             = 0.0
tPara               = 0.0
tPitch              = 0.0
tSelectedtCtrlLine  = 0
tValOutSideMinMax   = FALSE

tMinPara = tCtrlLine[1].Para
tMaxPara = tCtrlLine[tClChannel.NrPoints].Para

IF (tValuePara <= tMinPara) THEN
  tSelectedtCtrlLine = 2
  tValOutSideMinMax = TRUE
ENDIF

IF (tValuePara >= tMaxPara) THEN
  tSelectedtCtrlLine = tClChannel.NrPoints
  tValOutSideMinMax = TRUE
ENDIF

IF (tValOutSideMinMax == FALSE) THEN
  FOR tI = 2 TO tClChannel.NrPoints
    IF ((tValuePara >= tCtrlLine[tI - 1].Para) AND (tValuePara <= tCtrlLine[tI].Para)) THEN
      tSelectedtCtrlLine = tI
    ENDIF
  ENDFOR
ENDIF

IF (tSelectedtCtrlLine >= 2) THEN
  tVal = tCtrlLine[tSelectedtCtrlLine].Val - tCtrlLine[tSelectedtCtrlLine - 1].Val
  IF ((tCtrlLine[tSelectedtCtrlLine].Para - tCtrlLine[tSelectedtCtrlLine - 1].Para) >= 1E-08)  THEN
    tPara = tCtrlLine[tSelectedtCtrlLine].Para - tCtrlLine[tSelectedtCtrlLine - 1].Para
    tPitch = tVal / tPara
  ENDIF
  tValue = tCtrlLine[tSelectedtCtrlLine - 1].Val - (tPitch * tCtrlLine[tSelectedtCtrlLine - 1].Para)
  tReturn = (tValuePara * tPitch) + tValue
ELSE
  ArcMsgWriteS(,#NOTIFY,"AtbInternalError","ARC",10094,OPT_VLSTOP_LOG,gArcActIlfWelderName[],"SelectedControlLine invalid")
  tReturn = tValuePara
ENDIF
RETURN tReturn
ENDFCT
;*****************************************************************************************
;[Global Routine] Decimal/Two s Complement Converter
;Parameter:
;         -tReturnValue: Structure
;         -tSignalGroup: Signal Group
;         -tSetVal     : Value to set Negative / Positive
; Return:
;          1 = Signal and set value are same
;          0 = Value Set tu Siganal
;         -1 = Signal UNKNOWN
;         -2 = Signal Length = 0
;         -3 = Signal Length too small
; Examples:
;         Positive:
;                 tSetVal:34 --> tReturnValue:34
;                 tSetVal:46 --> tReturnValue:46
;         Negative:
;                 tSetVal:-34 --> tReturnValue:222
;                 tSetVal:-46 --> tReturnValue:210
;*****************************************************************************************
GLOBAL DEFFCT INT ArcCalcChannelValue(tReturnValue :OUT,tSignalGroup :IN,tSetVal :IN)
DECL BOOL tSignalLenOk
DECL INT tI
DECL INT tMaxNr
DECL INT tReturnValue
DECL REAL tSetValCalc
DECL REAL tSetVal
DECL stArcSignal_T tSignalGroup
IF (tReturnValue == tSetVal) THEN
  RETURN 1 ;Signal and set value are same
ENDIF
tSignalLenOk = TRUE
tReturnValue = 0
IF (tSignalGroup.Length == 0) THEN
 RETURN -2 ;Return: Length = 0
ENDIF
tSetValCalc = ABS(tSetVal)
tMaxNr = 0
FOR tI = 1 TO tSignalGroup.Length
  tMaxNr = tMaxNr * 2 + 1
  tSetValCalc = tSetValCalc / 2.0
  IF (tSetValCalc < 1.0) THEN
    tSignalLenOk = FALSE
  ENDIF
ENDFOR
IF (tSignalLenOk == TRUE) THEN
  RETURN -3 ;Return: Signal Length too small
ENDIF
IF (tSetVal >= 0) THEN
  tReturnValue = tSetVal
ELSE
  tReturnValue = ABS(tSetVal)
  IF (tReturnValue > 0) THEN
    tReturnValue = tReturnValue - 1
  ENDIF
  tReturnValue = (tReturnValue B_EXOR tMaxNr)
ENDIF
RETURN 0 ;Return Ok
ENDFCT
;*****************************************************************************************
;[Global Routine] Set value to Rdm driver
;*****************************************************************************************
GLOBAL DEF ArcSetValueToRdm(tCahnnelNr :IN,tInValue :IN)
DECL INT tInValue
DECL INT tCahnnelNr
SWITCH tCahnnelNr
  CASE 1
    gArcActChannel1 = tInValue
  CASE 2
    gArcActChannel2 = tInValue
  CASE 3
    gArcActChannel3 = tInValue
  CASE 4
    gArcActChannel4 = tInValue
  CASE 5
    gArcActChannel5 = tInValue
  CASE 6
    gArcActChannel6 = tInValue
  CASE 7
    gArcActChannel7 = tInValue
  CASE 8
    gArcActChannel8 = tInValue
ENDSWITCH
END
;*****************************************************************************************
;[Global Routine] Convert Channel to integer value
;*****************************************************************************************
GLOBAL DEFFCT INT ArcChannelToInt(tKrlId :IN)
DECL enKrlId_T tKrlId
SWITCH tKrlId
  CASE #Channel1
    RETURN 1
  CASE #Channel2
    RETURN 2
  CASE #Channel3
    RETURN 3
  CASE #Channel4
    RETURN 4
  CASE #Channel5
    RETURN 5
  CASE #Channel6
    RETURN 6
  CASE #Channel7
    RETURN 7
  CASE #Channel8
    RETURN 8
ENDSWITCH
RETURN -1
ENDFCT
;*****************************************************************************************
;[Global Routine] Get Parameter
;*****************************************************************************************
GLOBAL DEFFCT stParameter_T ArcGetParameter(tWelderNr :IN,tArcMode :IN,tKrlId :IN)
DECL INT tI
DECL INT tWelderNr
DECL INT tArcMode
DECL enKrlId_T tKrlId
DECL stParameter_T tParamDef
FOR tI = 1 TO 30
  tParamDef = ArcGetParamDef(tWelderNr,tArcMode,tI)
  IF (tParamDef.KrlId == tKrlId) THEN
    tParamDef = tParamDef
    EXIT
  ENDIF
ENDFOR
RETURN tParamDef
ENDFCT
;*****************************************************************************************
;[Global Routine] Arc Check Parameter Id
;*****************************************************************************************
GLOBAL DEFFCT INT ArcCheckParamId(tParam :OUT,tSelectMode :IN,tNumParam :IN,tParamId[] :IN)
DECL BOOL tB
DECL INT tI
DECL INT tReturn
DECL INT tNumParam
DECL INT tSelectMode
DECL CHAR tParamId[]
DECL CHAR tParamSetId[24]
DECL stParam_T tParam[,,]
tReturn = -1
IF (gArcAWOption == FALSE) THEN
  RETURN tReturn
ENDIF
IF (tNumParam <= 0 ) THEN
  RETURN tReturn
ENDIF
FOR tI = 1 TO tNumParam
  tB = STRCOPY(tParamSetId[]," ")
  ON_ERROR_PROCEED
  tParamSetId[] = tParam[tSelectMode,tI,1].SetName[]
  IF ($ERR.NUMBER > 0) THEN
    ERR_CLEAR($ERR)
    RETURN -1
  ENDIF
  IF (STRCOMP(tParamSetId[],tParamId[],#NOT_CASE_SENS)) THEN
    IF StrLen(tParamSetId[]) == StrLen(tParamId[]) THEN
      RETURN tI
    ENDIF
  ENDIF
ENDFOR
RETURN tReturn
ENDFCT
;*****************************************************************************************
;[Global Routine] Check Struc Param Exist
;*****************************************************************************************
GLOBAL DEFFCT BOOL ArcStrucParamExist(tParam : OUT,tSelectMode :IN,tSelectParam :IN,tPos :IN)
DECL INT tSelectMode
DECL INT tSelectParam
DECL INT tPos
DECL stParam_T tParam[,,]
ON_ERROR_PROCEED
tParam[tSelectMode,tSelectParam,tPos] = tParam[tSelectMode,tSelectParam,tPos]
IF ($ERR.NUMBER > 0) THEN
  ERR_CLEAR($ERR)
  RETURN FALSE
ENDIF
ON_ERROR_PROCEED
tParam[tSelectMode,tSelectParam,tPos].KrlId = tParam[tSelectMode,tSelectParam,tPos].KrlId
IF ($ERR.NUMBER > 0) THEN
  ERR_CLEAR($ERR)
  RETURN FALSE
ENDIF
RETURN TRUE
ENDFCT
;*****************************************************************************************
;[GLOBAL Routine] Routine Technology 
;FG   = Function generator
;ARS  = Arc Sense
;STT  = Seam Tech Tracking 
;*****************************************************************************************
GLOBAL DEFFCT enTechnology_T ArcSwitchActiveTech()
IF (gArcRSIOption == TRUE) THEN
  IF (gArcSttV3Option == TRUE) THEN ;Seam Tech Tracking V3.X
    IF (gArcTrackActive == TRUE) THEN
      RETURN #STT 
    ENDIF
  ENDIF
  IF (ArcIsSttActive() == TRUE) THEN ;Seam Tech Tracking V4.X
    IF (gArcTrackActive == TRUE) THEN
      RETURN #STT 
    ENDIF
  ENDIF
  IF (gArcSenseOption == TRUE) THEN ;Arc Sense
    IF (gArcSensorActive == TRUE) THEN
      RETURN #ARS 
    ENDIF
  ENDIF
  IF (gArcRsiWeavingActive == TRUE) THEN
    RETURN #RSI
  ENDIF
ENDIF
IF (gArcWeaveOption == TRUE) THEN ;Function generator Active
  RETURN #FG 
ENDIF
RETURN #NONE
ENDFCT
;*****************************************************************************************
;[Routine] Set Value To
;*****************************************************************************************
GLOBAL DEFFCT INT ArcSetValue(tWelder :IN,tArcMode :IN,tKrlId :IN,tValue :IN)
DECL INT tWelder
DECL INT tArcMode
DECL INT tReturn
DECL REAL tValue
DECL enKrlId_T tKrlId
tReturn = 0
SWITCH tKrlId
  CASE #Channel1
    tReturn = ArcSetValueToChannel(#None,tWelder,tArcMode,1,tValue)
  CASE #Channel2
    tReturn = ArcSetValueToChannel(#None,tWelder,tArcMode,2,tValue)
  CASE #Channel3
    tReturn = ArcSetValueToChannel(#None,tWelder,tArcMode,3,tValue)
  CASE #Channel4
    tReturn = ArcSetValueToChannel(#None,tWelder,tArcMode,4,tValue)
  CASE #Channel5
    tReturn = ArcSetValueToChannel(#None,tWelder,tArcMode,5,tValue)
  CASE #Channel6
    tReturn = ArcSetValueToChannel(#None,tWelder,tArcMode,6,tValue)
  CASE #Channel7
    tReturn = ArcSetValueToChannel(#None,tWelder,tArcMode,7,tValue)
  CASE #Channel8  
    tReturn = ArcSetValueToChannel(#None,tWelder,tArcMode,8,tValue)
  CASE #Length
    tValue = ArcSetRangeValue(tValue,cArcWeaveMinLength,cArcWeaveMaxLength)
    SWITCH ArcSwitchActiveTech()
      CASE #FG
        ArcWeaveSetValue_C(1,#Length, tValue)
      CASE #ARS,#RSI
        IF (ArsRSI_CHECKID(gArcSenseContId) == FALSE) THEN
          tReturn = -1
        ELSE
          tReturn = ArsRSI_SETPUBLICPAR(gArcSenseContId,Ars_SigGen[], Ars_SigGen_Period[],  tValue)
        ENDIF
      CASE #STT
        IF (ArsRSI_CHECKID(gArcSttContId) == FALSE) THEN
          tReturn = -1
        ELSE
          tReturn = ArsRSI_SETPUBLICPAR(gArcSttContId,Stt_SigGen[], Stt_SigGen_Period[], tValue)
        ENDIF 
    ENDSWITCH
  CASE #Amplitude
    tValue = ArcSetRangeValue(tValue,cArcWeaveMinAmplitude,cArcWeaveMaxAmplitude)
    SWITCH ArcSwitchActiveTech()
      CASE #FG
        ArcWeaveSetValue_C(1,#Amplitude,tValue)
      CASE #ARS,#RSI
        IF (ArsRSI_CHECKID(gArcSenseContId) == FALSE) THEN
          tReturn = -1
        ELSE
          tReturn =  ArsRSI_SETPUBLICPAR(gArcSenseContId,Ars_SigGen[], Ars_SigGen_Amplitude[], tValue)
        ENDIF
      CASE #STT
        IF (ArsRSI_CHECKID(gArcSttContId) == FALSE) THEN
          tReturn = -1
        ENDIF
        tReturn = ArsRSI_SETPUBLICPAR(gArcSttContId,Stt_SigGen[], Stt_SigGen_Amplitude[],  tValue)
    ENDSWITCH
  CASE #Angle
    tValue = ArcSetRangeValue(tValue,cArcWeaveMinAngle,cArcWeaveMaxAngle)
    SWITCH ArcSwitchActiveTech()
      CASE #FG
        ;ArcWeaveSetValue_C(1,#Angle,tAdaptiveWelding.OutValue) ;TODO With Trigger Check if it is possible
      CASE #ARS,#RSI
        IF (ArsRSI_CHECKID(gArcSenseContId) == FALSE) THEN
          tReturn = -1
        ELSE
          tReturn =  ArsRSI_SETPUBLICPAR(gArcSenseContId,Ars_SigGen[], Ars_SigGen_Angle[], tValue)
        ENDIF      
      CASE #STT        
        IF (ArsRSI_CHECKID(gArcSttContId) == FALSE) THEN
          tReturn = -1
        ENDIF
        ;TODO Check if it is possible?
        ;tReturn = ArsRSI_SETPUBLICPAR(gArcSttContId,Stt_SigGen[], Stt_SigGen_Angle[],  tValue)
    ENDSWITCH
ENDSWITCH
RETURN tReturn
ENDFCT
;******************************************************************************
;[Global Routine] Init max number of modi
;******************************************************************************
GLOBAL DEF ArcInitNumberOfArcModi()
DECL INT tI
FOR tI = 1 TO 4
  gArcMaxNrOfArcModi[tI] = 0
ENDFOR
FOR tI = 1 TO 16
  IF (ArcCheckModeCoding(1, wArcW1ModiCoding[tI]) == TRUE) THEN
    gArcMaxNrOfArcModi[1] = tI
  ENDIF
  IF (ArcCheckModeCoding(2, wArcW2ModiCoding[tI]) == TRUE) THEN
    gArcMaxNrOfArcModi[2] = tI
  ENDIF
  IF (ArcCheckModeCoding(3, wArcW3ModiCoding[tI]) == TRUE) THEN
    gArcMaxNrOfArcModi[3] = tI
  ENDIF
  IF (ArcCheckModeCoding(4, wArcW4ModiCoding[tI]) == TRUE) THEN
    gArcMaxNrOfArcModi[4] = tI
  ENDIF
ENDFOR
END
;******************************************************************************
;[Routine] Check mode coding
;******************************************************************************
DEFFCT BOOL ArcCheckModeCoding(tWelder :IN, tModeCoding :OUT)
DECL INT tWelder
DECL stArcModeCoding_T tModeCoding
ON_ERROR_PROCEED
tModeCoding.StrikeParamDisable = tModeCoding.StrikeParamDisable
IF ($ERR.NUMBER > 0) THEN
  ERR_CLEAR($ERR)
  RETURN FALSE
ENDIF
RETURN ($ERR.NUMBER == 0) AND (wArcWelder[tWelder].Type <> #NONE)
ENDFCT
;******************************************************************************
;[Global Routine] Get Modi Coding
;******************************************************************************
GLOBAL DEFFCT stArcModeCoding_T ArcGetModiCoding(tWelderNr :IN,tArcMode :IN)
DECL INT tWelderNr
DECL INT tArcMode
DECL stArcModeCoding_T tArcModeCoding
tArcModeCoding = {InUse FALSE}
IF (tArcMode <= 0) THEN
  ArcMsgWriteI(,#QUIT,"SignalToWriteArcModeIsTooBig","ARC",10056,OPT_VLSTOP_LOG,tArcMode)
  RETURN tArcModeCoding
ENDIF
SWITCH tWelderNr
  CASE 1
    ON_ERROR_PROCEED
    tArcModeCoding = wArcW1ModiCoding[tArcMode]
  CASE 2
    ON_ERROR_PROCEED
    tArcModeCoding = wArcW2ModiCoding[tArcMode]
  CASE 3
    ON_ERROR_PROCEED
    tArcModeCoding = wArcW3ModiCoding[tArcMode]
  CASE 4
    ON_ERROR_PROCEED
    tArcModeCoding = wArcW4ModiCoding[tArcMode]
ENDSWITCH
IF ($ERR.NUMBER > 0) THEN
  ERR_CLEAR($ERR)
  ArcMsgWriteI(,#QUIT,"UnConfiguredArcModeInUse","ARC",10082,OPT_VLSTOP_LOG,tArcMode)
ENDIF
RETURN tArcModeCoding
ENDFCT
;******************************************************************************
;[Routine] Get Arc Get Innput Channel Ctrl Line
;******************************************************************************
DEFFCT stArcClChannel_T ArcGetIChannelCtrlLine(tWelderNr :IN,tChannel :IN)
DECL INT tWelderNr
DECL INT tChannel
DECL stArcClChannel_T tArcClChannel
tArcClChannel = {NrPoints 0}
SWITCH tWelderNr
  CASE 1
    ON_ERROR_PROCEED
    tArcClChannel = wArcW1IChannel[tChannel]
  CASE 2
    ON_ERROR_PROCEED
    tArcClChannel = wArcW2IChannel[tChannel]
  CASE 3
    ON_ERROR_PROCEED
    tArcClChannel = wArcW3IChannel[tChannel]
  CASE 4
    ON_ERROR_PROCEED
    tArcClChannel = wArcW4IChannel[tChannel]
ENDSWITCH
IF ($ERR.NUMBER > 0) THEN
  ERR_CLEAR($ERR)
  ArcMsgWriteS(,#QUIT,"AtbInternalError","ARC",10094,OPT_VLSTOP_LOG,ArcActWelderToStr(tWelderNr),"IControlLineMissing")
ENDIF
RETURN tArcClChannel
ENDFCT
;******************************************************************************
;[Routine] Get Arc Get Innput Channel Ctrl Line
;******************************************************************************
DEFFCT stArcClChannel_T ArcGetOChannelCtrlLine(tWelderNr :IN,tArcMode :IN,tChannel :IN)
DECL INT tWelderNr
DECL INT tArcMode
DECL INT tChannel
DECL stArcClChannel_T tArcClChannel
tArcClChannel = {NrPoints 0}
SWITCH tWelderNr
  CASE 1
    ON_ERROR_PROCEED
    tArcClChannel = wArcW1OChannel[tArcMode,tChannel]
  CASE 2
    ON_ERROR_PROCEED
    tArcClChannel = wArcW2OChannel[tArcMode,tChannel]
  CASE 3
    ON_ERROR_PROCEED
    tArcClChannel = wArcW3OChannel[tArcMode,tChannel]
  CASE 4
    ON_ERROR_PROCEED
    tArcClChannel = wArcW4OChannel[tArcMode,tChannel]
ENDSWITCH
IF ($ERR.NUMBER > 0) THEN
  ERR_CLEAR($ERR)
  ArcMsgWriteS(,#QUIT,"AtbInternalError","ARC",10094,OPT_VLSTOP_LOG,ArcActWelderToStr(tWelderNr),"OControlLineMissing")
ENDIF
ON_ERROR_PROCEED
tArcClChannel.UsedInArcCommand = tArcClChannel.UsedInArcCommand
IF ($ERR.NUMBER > 0) THEN
  ERR_CLEAR($ERR)
  tArcClChannel.UsedInArcCommand = 7 ;Used in All Commands 'B111'
ENDIF
RETURN tArcClChannel
ENDFCT
;******************************************************************************
;[Global Routine] Get parameter definition
;******************************************************************************
GLOBAL DEFFCT stParameter_T ArcGetParamDef(tWelderNr :IN,tArcMode :IN,tIndex :IN)
DECL INT tWelderNr
DECL INT tArcMode
DECL INT tIndex
DECL INT tHandle
DECL stParameter_T tArcParameter
tArcParameter = {Active FALSE,KrlId #None}
IF (tArcMode <= 0) THEN
  ArcMsgWriteI(,#NOTIFY,"SignalToWriteArcModeIsTooBig","ARC",10056,OPT_VLSTOP_LOG,tArcMode)
  RETURN tArcParameter
ENDIF
SWITCH tWelderNr
  CASE 1
    ON_ERROR_PROCEED
    tArcParameter = wArcW1ParamDef[tArcMode,tIndex]
  CASE 2
    ON_ERROR_PROCEED
    tArcParameter = wArcW2ParamDef[tArcMode,tIndex]
  CASE 3
    ON_ERROR_PROCEED
    tArcParameter = wArcW3ParamDef[tArcMode,tIndex]
  CASE 4
    ON_ERROR_PROCEED
    tArcParameter = wArcW4ParamDef[tArcMode,tIndex]
ENDSWITCH
IF ($ERR.NUMBER > 0) THEN
  ERR_CLEAR($ERR)
  tHandle = 0
  ArcMsgWriteS(tHandle,#QUIT,"AtbInternalError","ARC",10094,OPT_VLSTOP_LOG,ArcActWelderToStr(tWelderNr),"GetParamDef")
ENDIF
RETURN tArcParameter
ENDFCT
;******************************************************************************
;[Global Routine] Get parameter definition
;******************************************************************************
GLOBAL DEFFCT stArcBurnFree_T ArcGetBurnFree(tWelderNr :IN)
DECL INT tWelderNr
DECL stArcBurnFree_T tBurnFree
tBurnFree = {Option{Active FALSE,Mode 0,TimePulse 0.0,GasFlowTime 0.0,Retries 0},Param{JobModeId[] " ",ParamSetId[] " ",CraterTime 0.0,PostflowTime 0.0,Channel1 0.0,Channel2 0.0,Channel3 0.0,Channel4 0.0,Channel5 0.0,Channel6 0.0,Channel7 0.0,Channel8 0.0,BurnBackTime 0.0}}
SWITCH tWelderNr
  CASE 1
    ON_ERROR_PROCEED
    tBurnFree = wArcW1BurnFree
  CASE 2
    ON_ERROR_PROCEED
    tBurnFree = wArcW2BurnFree
  CASE 3
    ON_ERROR_PROCEED
    tBurnFree = wArcW3BurnFree
  CASE 4
    ON_ERROR_PROCEED
    tBurnFree = wArcW4BurnFree
ENDSWITCH
IF ($ERR.NUMBER > 0) THEN
  ERR_CLEAR($ERR)
  ArcMsgWriteS(,#QUIT,"AtbInternalError","ARC",10094,OPT_VLSTOP_LOG,ArcActWelderToStr(tWelderNr),"GetBurnFree")
ENDIF
RETURN tBurnFree
ENDFCT
;******************************************************************************
;[Global Routine] Get parameter definition
;******************************************************************************
GLOBAL DEFFCT BOOL ArcGetSlopeChannel(tWelderNr :IN,tArcMode :IN,tKrlId :IN)
DECL BOOL tSlope
DECL INT tWelderNr
DECL INT tArcMode
DECL enKrlId_T tKrlId
DECL stArcSlopeActive_T tArcSlopeActive
tSlope = FALSE
SWITCH tWelderNr
  CASE 1
    ON_ERROR_PROCEED
    tArcSlopeActive = wArcW1SlopeActive[tArcMode]
  CASE 2
    ON_ERROR_PROCEED
    tArcSlopeActive = wArcW2SlopeActive[tArcMode]
  CASE 3
    ON_ERROR_PROCEED
    tArcSlopeActive = wArcW3SlopeActive[tArcMode]
  CASE 4
    ON_ERROR_PROCEED
    tArcSlopeActive = wArcW4SlopeActive[tArcMode]
ENDSWITCH
SWITCH tKrlId
  CASE #Channel1
    ON_ERROR_PROCEED
    tSlope = tArcSlopeActive.C1
  CASE #Channel2
    ON_ERROR_PROCEED
    tSlope = tArcSlopeActive.C2
  CASE #Channel3
    ON_ERROR_PROCEED
    tSlope = tArcSlopeActive.C3
  CASE #Channel4
    ON_ERROR_PROCEED
    tSlope = tArcSlopeActive.C4
  CASE #Channel5
    ON_ERROR_PROCEED
    tSlope = tArcSlopeActive.C5
  CASE #Channel6
    ON_ERROR_PROCEED
    tSlope = tArcSlopeActive.C6
  CASE #Channel7
    ON_ERROR_PROCEED
    tSlope = tArcSlopeActive.C7
  CASE #Channel8
    ON_ERROR_PROCEED
    tSlope = tArcSlopeActive.C8
  CASE #Velocity
    ON_ERROR_PROCEED
    tSlope = tArcSlopeActive.Velocity
  CASE #Length
    ON_ERROR_PROCEED
    ;tSlope = tArcSlopeActive.Length ;ToDo Missing Work Visual Part
    tSlope = TRUE
  CASE #Amplitude
    ON_ERROR_PROCEED
    ;tSlope = tArcSlopeActive.Amplitude ;ToDo Missing Work Visual Part
    tSlope = TRUE
  CASE #Angle
    ON_ERROR_PROCEED
    ;tSlope = tArcSlopeActive.Angle ;ToDo Missing Work Visual Part
     tSlope = FALSE
ENDSWITCH  
IF ($ERR.NUMBER > 0) THEN
  ERR_CLEAR($ERR)
  ArcMsgWriteS(,#QUIT,"AtbInternalError","ARC",10094,OPT_VLSTOP_LOG,ArcActWelderToStr(tWelderNr),"GetSlopeChannel")
ENDIF
RETURN tSlope
ENDFCT

;******************************************************************************
;[Global Routine] Arc refresh signals
;******************************************************************************
GLOBAL DEF ArcRefreshSignals()
  IF (gArcSignalGroupSelection == TRUE) THEN
    gArcIErrRecoveryPlcSign = ArcInSignalGroup(wsArcIErrRecoveryPlcSign,0,0)
  ELSE  
    gArcIErrRecoveryPlcSign = ArcBitToInt($IN[],wsArcIErrRecoveryPlcSign)
  ENDIF  
END
;******************************************************************************
;[Global Routine] Initialization of Vel Appl
;    0 -  Call from Robot Stop
;    1 -  Call from Robot Continue
;    2 -  Call from Robot Trigger
;    3 -  Call from SubMit
;    4 -  Call from SubMit Trigger
;******************************************************************************
GLOBAL DEF ArcVelApplOff(tCall :IN)
DECL INT tCall
IF (gArcIsOnSimEnvironment == TRUE) THEN
  RETURN ;Workaround for KukaSim
ENDIF
SWITCH tCall
  CASE 0 ;Call from Robot
    $VEL_APPL = {MODE #OFF,CP 0.0}
  CASE 1 ;Call from Robot
    CONTINUE
    $VEL_APPL = {MODE #OFF,CP 0.0}
  CASE 2 ;Call from Robot Trigger
    $VEL_APPL = {MODE #OFF,CP 0.0}
  CASE 3 ;Call from SubMit
    $VEL_APPL = {MODE #OFF,CP 0.0}
  CASE 4 ;Call from SubMit Trigger
    $VEL_APPL = {MODE #OFF,CP 0.0}
ENDSWITCH
END
;******************************************************************************
;[Global Routine] Initialization of Vel Appl
;    0 -  Call from Robot Stop
;    1 -  Call from Robot Continue
;    2 -  Call from Robot Trigger
;    3 -  Call from SubMit
;    4 -  Call from SubMit Trigger
;******************************************************************************
GLOBAL DEF ArcVelApplSet(tCall :IN,tVelocity :IN)
DECL INT tCall
DECL REAL tVelocity
DECL REAL tVelocityCp
tVelocityCp = ArcSetRangeValue(tVelocity,cArcVelApplMin,cArcVelApplMax)
SWITCH tCall
  CASE 0 ;Call from Robot Stop    
    $VEL_APPL.MODE = #ON
    $VEL_APPL.CP = tVelocityCp
  CASE 1 ;Call from Robot Continue
    CONTINUE
    $VEL_APPL.MODE = #ON
    CONTINUE    
    $VEL_APPL.CP = tVelocityCp  
  CASE 2 ;Call from Robot Trigger
    $VEL_APPL.MODE = #ON
    $VEL_APPL.CP = tVelocityCp
  CASE 3 ;Call from SubMit
    $VEL_APPL.MODE = #ON
    $VEL_APPL.CP = tVelocityCp
  CASE 4 ;Call from SubMit Trigger
    $VEL_APPL.MODE = #ON
    $VEL_APPL.CP = tVelocityCp
ENDSWITCH  
END
;******************************************************************************
;[Global Routine] Convert Integer welder to String
;******************************************************************************
GLOBAL DEFFCT CHAR[13] ArcActWelderToStr(tWelderNr: IN)
DECL INT tWelderNr
SWITCH tWelderNr
  CASE 1
    RETURN "Welder: 1"
  CASE 2
    RETURN "Welder: 2"
  CASE 3
    RETURN "Welder: 3"
  CASE 4
    RETURN "Welder: 4"
ENDSWITCH
RETURN "Welder: ERROR"  
ENDFCT
;******************************************************************************
;[Global Routine] Calculation of Alpha Angle
;******************************************************************************
GLOBAL DEFFCT REAL CalcAngleA(tSideA: IN, tSideB: IN)
DECL REAL tSideA, tSideB
;
;                beta
;                  *
;               *  *
;            *     * SideB
;         *        *
; alpha ************
;          SideA
;
IF (tSideA > 0) THEN
  RETURN ATAN2(tSideB, tSideA)
ELSE
  RETURN 0
ENDIF
ENDFCT
;******************************************************************************
;[Global Routine] Calculation of SideC
;******************************************************************************
GLOBAL DEFFCT REAL CalcSideC(tSideA: IN, tSideB: IN)
DECL REAL tSideA, tSideB
;
;                beta
;                  *
;       SideC   *  *
;            *     * SideB
;         *        *
; alpha ************
;          SideA
;
IF (tSideB > 0) THEN
  RETURN SQRT((tSideA * tSideA) + (tSideB * tSideB))
ELSE
  RETURN 0
ENDIF
ENDFCT
;******************************************************************************
;[Global Routine] Calculation of SideA
;******************************************************************************
GLOBAL DEFFCT REAL CalcSideA(tAlpha: IN, tSideB: IN)
DECL REAL tAlpha, tSideB
;
;                beta
;                  *
;       SideC   *  *
;            *     * SideB
;         *        *
; alpha ************
;          SideA
;
IF (tAlpha > 0) THEN
  ;RETURN tSideB / TAN((3.14 / 180) * tAlpha)
  RETURN tSideB / TAN(tAlpha)
ELSE
  RETURN 0
ENDIF
ENDFCT
;******************************************************************************
;[Global Routine] Thermal Control initialisation
;******************************************************************************
GLOBAL DEFFCT BOOL ArcTcInit(tArcCommandType: IN,tArcDat: IN, tTcDat: IN)
DECL enArcCommandType_T tArcCommandType
DECL stArcDat_T tArcDat
DECL stArcTcSet_T tTcDat

;            *
;          *   *
;        *       *
;      * |       | *
;    *   |       |   *
;  * |   |       |   | *
;----|---|-------|---|--------------------------
;    |   |       |   |    *                   *
;    |   |       |   |      *               *
;    |   |       |   |      | *           * |
;    |   |       |   |      |   *       *   |
;    |   |       |   |      |   | *   * |   |
;    |   |       |   |      |   |   *   |   |
;    1   2       3   4      5   6       7   8

ArcWriteDiag(gArcGeneralDebug,"[TC] Init")

stArcActTcSet = tTcDat

IF (ArcAtaThermalContOption(tTcDat) == TRUE) THEN
  IF ((tArcDat.Weave.Pattern == #Triangle) OR (tArcDat.Weave.Pattern == #Trapecoid) OR (tArcDat.Weave.Pattern == #None)) THEN
    ;Weave Pattern for ThermalControl is OK
  ELSE
    ArcMsgWriteS(,#NOTIFY,"AtbInternalError","ARC",10094,OPT_VLSTOP_LOG, gArcActIlfWelderName[],"ThermalControl:", "Invalid Weave Pattern")
  ENDIF
ENDIF

IF ((tArcDat.Weave.Pattern == #Triangle) OR (tArcDat.Weave.Pattern == #Trapecoid)) THEN
  IF ((tTcDat.Set1.Active == TRUE) AND (tTcDat.Set2.Active == TRUE)) THEN
    IF ((tTcDat.Set1.Threshold == 0) AND (tTcDat.Set2.Threshold == 0)) THEN
      stArcTcState[1].ExeStep = TRUE
      stArcTcState[1].TcSet = #Wdat
      stArcTcState[1].Threshold = tTcDat.Set1.Threshold
      stArcTcState[4].ExeStep = TRUE
      stArcTcState[4].TcSet = #TcSet1
      stArcTcState[4].Threshold = tTcDat.Set1.Threshold
      stTcInfo.Mode = #WeavePosOnly
    ENDIF
    IF ((tTcDat.Set1.Threshold > 0) AND (tTcDat.Set2.Threshold < 0)) THEN
      stArcTcState[1].ExeStep = TRUE
      stArcTcState[1].TcSet = #TcSet1
      stArcTcState[1].Threshold = tTcDat.Set1.Threshold
      stArcTcState[4].ExeStep = TRUE
      stArcTcState[4].TcSet = #Wdat
      stArcTcState[4].Threshold = tTcDat.Set1.Threshold
      stArcTcState[5].ExeStep = TRUE
      stArcTcState[5].TcSet = #TcSet2
      stArcTcState[5].Threshold = tTcDat.Set2.Threshold
      stArcTcState[8].ExeStep = TRUE
      stArcTcState[8].TcSet = #Wdat
      stArcTcState[8].Threshold = tTcDat.Set2.Threshold
      stTcInfo.Mode = #Weave
    ENDIF
    IF ((tTcDat.Set1.Threshold < 0) AND (tTcDat.Set2.Threshold > 0)) THEN
      stArcTcState[1].ExeStep = TRUE
      stArcTcState[1].TcSet = #TcSet2
      stArcTcState[1].Threshold = tTcDat.Set2.Threshold
      stArcTcState[4].ExeStep = TRUE
      stArcTcState[4].TcSet = #Wdat
      stArcTcState[4].Threshold = tTcDat.Set2.Threshold
      stArcTcState[5].ExeStep = TRUE
      stArcTcState[5].TcSet = #TcSet1
      stArcTcState[5].Threshold = tTcDat.Set1.Threshold
      stArcTcState[8].ExeStep = TRUE
      stArcTcState[8].TcSet = #Wdat
      stArcTcState[8].Threshold = tTcDat.Set1.Threshold
      stTcInfo.Mode = #Weave
    ENDIF
    IF ((tTcDat.Set1.Threshold > 0) AND (tTcDat.Set2.Threshold > 0)) THEN
      stTcInfo.Mode = #WeaveDoublePos
      IF (tTcDat.Set1.Threshold < tTcDat.Set2.Threshold) THEN
        stArcTcState[1].ExeStep = TRUE
        stArcTcState[1].TcSet = #TcSet1
        stArcTcState[1].Threshold = tTcDat.Set1.Threshold
        stArcTcState[2].ExeStep = TRUE
        stArcTcState[2].TcSet = #TcSet2
        stArcTcState[2].Threshold = tTcDat.Set2.Threshold
        stArcTcState[3].ExeStep = TRUE
        stArcTcState[3].TcSet = #TcSet1
        stArcTcState[3].Threshold = tTcDat.Set2.Threshold
        stArcTcState[4].ExeStep = TRUE
        stArcTcState[4].TcSet = #Wdat
        stArcTcState[4].Threshold = tTcDat.Set1.Threshold
      ELSE
        stArcTcState[1].ExeStep = TRUE
        stArcTcState[1].TcSet = #TcSet2
        stArcTcState[1].Threshold = tTcDat.Set2.Threshold
        stArcTcState[2].ExeStep = TRUE
        stArcTcState[2].TcSet = #TcSet1
        stArcTcState[2].Threshold = tTcDat.Set1.Threshold
        stArcTcState[3].ExeStep = TRUE
        stArcTcState[3].TcSet = #TcSet2
        stArcTcState[3].Threshold = tTcDat.Set1.Threshold
        stArcTcState[4].ExeStep = TRUE
        stArcTcState[4].TcSet = #Wdat
        stArcTcState[4].Threshold = tTcDat.Set2.Threshold
      ENDIF
    ENDIF
    IF ((tTcDat.Set1.Threshold < 0) AND (tTcDat.Set2.Threshold < 0)) THEN
      stTcInfo.Mode = #WeaveDoubleNeg
      IF (tTcDat.Set1.Threshold > tTcDat.Set2.Threshold) THEN
        stArcTcState[5].ExeStep = TRUE
        stArcTcState[5].TcSet = #TcSet1
        stArcTcState[5].Threshold = tTcDat.Set1.Threshold
        stArcTcState[6].ExeStep = TRUE
        stArcTcState[6].TcSet = #TcSet2
        stArcTcState[6].Threshold = tTcDat.Set2.Threshold
        stArcTcState[7].ExeStep = TRUE
        stArcTcState[7].TcSet = #TcSet1
        stArcTcState[7].Threshold = tTcDat.Set2.Threshold
        stArcTcState[8].ExeStep = TRUE
        stArcTcState[8].TcSet = #Wdat
        stArcTcState[8].Threshold = tTcDat.Set1.Threshold
      ELSE
        stArcTcState[5].ExeStep = TRUE
        stArcTcState[5].TcSet = #TcSet2
        stArcTcState[5].Threshold = tTcDat.Set2.Threshold
        stArcTcState[6].ExeStep = TRUE
        stArcTcState[6].TcSet = #TcSet1
        stArcTcState[6].Threshold = tTcDat.Set1.Threshold
        stArcTcState[7].ExeStep = TRUE
        stArcTcState[7].TcSet = #TcSet2
        stArcTcState[7].Threshold = tTcDat.Set1.Threshold
        stArcTcState[8].ExeStep = TRUE
        stArcTcState[8].TcSet = #Wdat
        stArcTcState[8].Threshold = tTcDat.Set2.Threshold
      ENDIF
    ENDIF
  ENDIF
  IF ((tTcDat.Set1.Active == TRUE) AND (tTcDat.Set1.Threshold > 0) AND (tTcDat.Set2.Active == FALSE)) THEN
    stArcTcState[1].ExeStep = TRUE
    stArcTcState[1].TcSet = #TcSet1
    stArcTcState[1].Threshold = tTcDat.Set1.Threshold
    stArcTcState[4].ExeStep = TRUE
    stArcTcState[4].TcSet = #Wdat
    stArcTcState[4].Threshold = tTcDat.Set1.Threshold
    stTcInfo.Mode = #WeavePosOnly
  ENDIF
  IF ((tTcDat.Set2.Active == TRUE) AND (tTcDat.Set2.Threshold > 0) AND (tTcDat.Set1.Active == FALSE)) THEN
    stArcTcState[1].ExeStep = TRUE
    stArcTcState[1].TcSet = #TcSet2
    stArcTcState[1].Threshold = tTcDat.Set2.Threshold
    stArcTcState[4].ExeStep = TRUE
    stArcTcState[4].TcSet = #Wdat
    stArcTcState[4].Threshold = tTcDat.Set2.Threshold
    stTcInfo.Mode = #WeavePosOnly
  ENDIF
  IF ((tTcDat.Set1.Active == TRUE) AND (tTcDat.Set1.Threshold < 0) AND (tTcDat.Set2.Active == FALSE)) THEN
    stArcTcState[5].ExeStep = TRUE
    stArcTcState[5].TcSet = #TcSet1
    stArcTcState[5].Threshold = tTcDat.Set1.Threshold
    stArcTcState[8].ExeStep = TRUE
    stArcTcState[8].TcSet = #Wdat
    stArcTcState[8].Threshold = tTcDat.Set1.Threshold
    stTcInfo.Mode = #WeaveNegOnly
  ENDIF
  IF ((tTcDat.Set2.Active == TRUE) AND (tTcDat.Set2.Threshold < 0) AND (tTcDat.Set1.Active == FALSE)) THEN
    stArcTcState[5].ExeStep = TRUE
    stArcTcState[5].TcSet = #TcSet2
    stArcTcState[5].Threshold = tTcDat.Set2.Threshold
    stArcTcState[8].ExeStep = TRUE
    stArcTcState[8].TcSet = #Wdat
    stArcTcState[8].Threshold = tTcDat.Set2.Threshold
    stTcInfo.Mode = #WeaveNegOnly
  ENDIF

  IF ((tTcDat.Set1.Active == TRUE) AND (tTcDat.Set1.Threshold == 0) AND (tTcDat.Set2.Active == FALSE)) THEN
    stArcTcState[5].ExeStep = TRUE
    stArcTcState[5].TcSet = #TcSet1
    stArcTcState[5].Threshold = tTcDat.Set1.Threshold
    stArcTcState[8].ExeStep = TRUE
    stArcTcState[8].TcSet = #Wdat
    stArcTcState[8].Threshold = tTcDat.Set1.Threshold
    stTcInfo.Mode = #WeaveNegOnly
  ENDIF
  IF ((tTcDat.Set2.Active == TRUE) AND (tTcDat.Set2.Threshold == 0) AND (tTcDat.Set1.Active == FALSE)) THEN
    stArcTcState[5].ExeStep = TRUE
    stArcTcState[5].TcSet = #TcSet2
    stArcTcState[5].Threshold = tTcDat.Set2.Threshold
    stArcTcState[8].ExeStep = TRUE
    stArcTcState[8].TcSet = #Wdat
    stArcTcState[8].Threshold = tTcDat.Set2.Threshold
    stTcInfo.Mode = #WeaveNegOnly
  ENDIF
ENDIF

IF (tArcCommandType == #ArcOn) THEN
  SWITCH stTcInfo.Mode
    CASE #Weave, #WeavePosOnly, #WeaveDoublePos
      stTcInfo.ThresholdAct = stArcTcState[1].Threshold
    CASE #WeaveNegOnly, #WeaveDoubleNeg
      stTcInfo.ThresholdAct = stArcTcState[5].Threshold
  ENDSWITCH
ENDIF

IF (tArcDat.Weave.Pattern == #None) THEN
  IF ((tTcDat.Set1.Active == TRUE) AND (tTcDat.Set2.Active == TRUE)) THEN
    IF (tTcDat.Set1.Threshold > 0) THEN
      stArcTcState[1].ExeStep = TRUE
      stArcTcState[1].TcSet = #TcSet1
      stArcTcState[1].Threshold = tTcDat.Set1.Threshold
      stArcTcState[2].ExeStep = TRUE
      stArcTcState[2].TcSet = #Wdat
      stArcTcState[2].Threshold = tTcDat.Set1.Threshold
      stTcInfo.Mode = #Length
    ENDIF
  ENDIF
  IF ((tTcDat.Set1.Active == TRUE) AND (tTcDat.Set1.Threshold > 0) AND (tTcDat.Set2.Active == FALSE)) THEN
    stArcTcState[1].ExeStep = TRUE
    stArcTcState[1].TcSet = #TcSet1
    stArcTcState[1].Threshold = tTcDat.Set1.Threshold
    stArcTcState[2].ExeStep = TRUE
    stArcTcState[2].TcSet = #Wdat
    stArcTcState[2].Threshold = tTcDat.Set1.Threshold
    stTcInfo.Mode = #Length
  ENDIF
  IF ((tTcDat.Set2.Active == TRUE) AND (tTcDat.Set2.Threshold > 0) AND (tTcDat.Set1.Active == FALSE)) THEN
    stArcTcState[1].ExeStep = TRUE
    stArcTcState[1].TcSet = #TcSet2
    stArcTcState[1].Threshold = tTcDat.Set2.Threshold
    stArcTcState[2].ExeStep = TRUE
    stArcTcState[2].TcSet = #Wdat
    stArcTcState[2].Threshold = tTcDat.Set2.Threshold
    stTcInfo.Mode = #Length
  ENDIF
ENDIF

IF (stTcInfo.Mode == #None) THEN
  RETURN FALSE
ENDIF

RETURN TRUE
ENDFCT
;******************************************************************************
;[Global Routine] Thermal Control On
;******************************************************************************
GLOBAL DEF ArcTcOn(tIgnitionType: IN)
DECL enIgnitionType tIgnitionType

IF (stTcInfo.Active == TRUE) THEN
  ArcWriteDiag(gArcGeneralDebug,"[TC] Is Active")
  RETURN ;Is already aktiv
ENDIF

IF (stTcInfo.Mode <> #None) THEN
  stTcInfo.Active = TRUE
  ArcWriteDiag(gArcGeneralDebug,"[TC] Activate")
ELSE
  RETURN
ENDIF

IF (stTcInfo.Sleep == FALSE) THEN
  IF (stArcCallState.MoveType == #SplBlock) THEN
    stTcInfo.DistOffset = $DISTANCE
  ENDIF
ENDIF

stTcInfo.Sleep = FALSE

IF (stTcInfo.Mode == #Length) THEN
  IF (tIgnitionType == #OnSeam) THEN
    stTcInfo.DistOffset = $DISTANCE
    stTcInfo.CtrLength = 1
  ENDIF
  stTcInfo.ThresholdAct = stArcTcState[1].Threshold + stTcInfo.DistOffset
ELSE
  ;ToDo Use Analog Channel and $TECH_ANA_FLT_OFF = TRUE to get more exactly values for weaving
  ;$TECH_ANA_FLT_OFF[ctArcMechGenerator1] = TRUE ;ArcCustom.dat (Write protected) ZYKL. ANALOGAUSGABE DES TECHVALS GEFILTERT (FALSE)/UNGEFILTERT (TRUE) AUSGEBEN 
  ;WAIT FOR $TECH_ANA_FLT_OFF[ctArcMechGenerator1] == TRUE
  ;ANOUT ON CHANNEL_11 = 1.0 * $TECHVAL[ctArcMechGenerator1] + 0.0 DELAY = 0.0
ENDIF

INTERRUPT OFF irtArcTcGreater
INTERRUPT OFF irtArcTcSmaller

SWITCH stTcInfo.Mode
  CASE #Weave, #WeavePosOnly, #WeaveDoublePos
    stTcInfo.StateCounter = 1
    GLOBAL INTERRUPT DECL irtArcTcGreater WHEN $TECHVAL[ctArcMechGenerator1] >= stTcInfo.ThresholdAct DO ArcTcState()
    GLOBAL INTERRUPT DECL irtArcTcSmaller WHEN $TECHVAL[ctArcMechGenerator1] <= stTcInfo.ThresholdAct DO ArcTcState()
    ;GLOBAL INTERRUPT DECL irtArcTcGreater WHEN CHANNEL_11 >= stTcInfo.ThresholdAct DO ArcTcState()
    ;GLOBAL INTERRUPT DECL irtArcTcSmaller WHEN CHANNEL_11 <= stTcInfo.ThresholdAct DO ArcTcState()
    INTERRUPT ON irtArcTcGreater
  CASE #WeaveNegOnly, #WeaveDoubleNeg
    stTcInfo.StateCounter = 5
    GLOBAL INTERRUPT DECL irtArcTcGreater WHEN $TECHVAL[ctArcMechGenerator1] >= stTcInfo.ThresholdAct DO ArcTcState()
    GLOBAL INTERRUPT DECL irtArcTcSmaller WHEN $TECHVAL[ctArcMechGenerator1] <= stTcInfo.ThresholdAct DO ArcTcState()
    ;GLOBAL INTERRUPT DECL irtArcTcGreater WHEN CHANNEL_11 >= stTcInfo.ThresholdAct DO ArcTcState()
    ;GLOBAL INTERRUPT DECL irtArcTcSmaller WHEN CHANNEL_11 <= stTcInfo.ThresholdAct DO ArcTcState()
    INTERRUPT ON irtArcTcSmaller
  CASE #Length
    stTcInfo.StateCounter = 1
    GLOBAL INTERRUPT DECL irtArcTcGreater WHEN $DISTANCE >= stTcInfo.ThresholdAct DO ArcTcState()
    INTERRUPT ON irtArcTcGreater
  DEFAULT
    ArcMsgWriteS(,#NOTIFY,"AtbInternalError","ARC",10094,OPT_VLSTOP_LOG,gArcActIlfWelderName[],"stTcInfo.Mode not valid")
ENDSWITCH
END
;******************************************************************************
;[Global Routine] Thermal Control State Machine
;******************************************************************************
GLOBAL DEF ArcTcState()
DECL INT tI
DECL BOOL tFound

tFound = FALSE

INTERRUPT OFF irtArcTcGreater
INTERRUPT OFF irtArcTcSmaller

SWITCH stTcInfo.StateCounter
  CASE 1
    SetTcDataSet(stArcTcState[stTcInfo.StateCounter].TcSet)
  CASE 2
    SetTcDataSet(stArcTcState[stTcInfo.StateCounter].TcSet)
  CASE 3
    SetTcDataSet(stArcTcState[stTcInfo.StateCounter].TcSet)
  CASE 4
    SetTcDataSet(stArcTcState[stTcInfo.StateCounter].TcSet)
  CASE 5
    SetTcDataSet(stArcTcState[stTcInfo.StateCounter].TcSet)
  CASE 6
    SetTcDataSet(stArcTcState[stTcInfo.StateCounter].TcSet)
  CASE 7
    SetTcDataSet(stArcTcState[stTcInfo.StateCounter].TcSet)
  CASE 8
    SetTcDataSet(stArcTcState[stTcInfo.StateCounter].TcSet)
  DEFAULT
    ArcMsgWriteS(,#NOTIFY,"AtbInternalError","ARC",10094,OPT_VLSTOP_LOG,gArcActIlfWelderName[],"stTcInfo.StateCounter not valid")
ENDSWITCH

;Search for next Step
FOR tI = stTcInfo.StateCounter TO 7
  stTcInfo.StateCounter = stTcInfo.StateCounter + 1
  IF (stArcTcState[stTcInfo.StateCounter].ExeStep == TRUE) THEN
    tFound = TRUE
    EXIT
  ENDIF
ENDFOR

;Search from beginning for next Step
IF (tFound == FALSE) THEN
  stTcInfo.StateCounter = 0
  FOR tI = 1 TO 7
    stTcInfo.StateCounter = stTcInfo.StateCounter + 1
    IF (stArcTcState[stTcInfo.StateCounter].ExeStep == TRUE) THEN
      EXIT
    ENDIF
  ENDFOR
ENDIF

IF (stTcInfo.Mode == #Length) THEN
  stTcInfo.CtrLength = stTcInfo.CtrLength + 1
  stTcInfo.ThresholdAct = (stArcTcState[stTcInfo.StateCounter].Threshold * stTcInfo.CtrLength) + stTcInfo.DistOffset
ELSE
  stTcInfo.ThresholdAct = stArcTcState[stTcInfo.StateCounter].Threshold
ENDIF

IF (stArcTcState[stTcInfo.StateCounter].IntComp == #Greater) THEN
  INTERRUPT ON irtArcTcGreater
ELSE
  INTERRUPT ON irtArcTcSmaller
ENDIF

;ArcMsgWriteR(,#NOTIFY,"Debug ArcState = %1 %2 %3","ArcDiag",,,stTcInfo.StateCounter,stTcInfo.ThresholdAct,$DISTANCE)

END
;******************************************************************************
;[Global Routine] Thermal Control Set Thermal Control DataSet
;******************************************************************************
GLOBAL DEF SetTcDataSet(tTcSet: IN)
DECL INT tArcMode, tWelder, tError
DECL enTcSet tTcSet

tWelder = gArcActIlfWelder

SWITCH tTcSet
  CASE #Wdat
    stTcInfo.TcSet = #Wdat
    stTcInfo.CtrWdat = stTcInfo.CtrWdat + 1
    tArcMode = ArcCheckModeId(tWelder,stArcActWeldSet.JobModeId[], #NOTIFY)
    tError = ArcSetValueToChannel(#None,tWelder,tArcMode,1,stArcActWeldSet.Channel1)
    tError = ArcSetValueToChannel(#None,tWelder,tArcMode,2,stArcActWeldSet.Channel2)
    tError = ArcSetValueToChannel(#None,tWelder,tArcMode,3,stArcActWeldSet.Channel3)
    tError = ArcSetValueToChannel(#None,tWelder,tArcMode,4,stArcActWeldSet.Channel4)
    tError = ArcSetValueToChannel(#None,tWelder,tArcMode,5,stArcActWeldSet.Channel5)
    tError = ArcSetValueToChannel(#None,tWelder,tArcMode,6,stArcActWeldSet.Channel6)
    tError = ArcSetValueToChannel(#None,tWelder,tArcMode,7,stArcActWeldSet.Channel7)
    tError = ArcSetValueToChannel(#None,tWelder,tArcMode,8,stArcActWeldSet.Channel8)
  CASE #TcSet1
    stTcInfo.TcSet = #TcSet1
    stTcInfo.CtrSet1 = stTcInfo.CtrSet1 + 1
    tArcMode = ArcCheckModeId(tWelder,stArcActTcSet.Set1.JobModeId[], #NOTIFY)
    tError = ArcSetValueToChannel(#None,tWelder,tArcMode,1,stArcActTcSet.Set1.C1)
    tError = ArcSetValueToChannel(#None,tWelder,tArcMode,2,stArcActTcSet.Set1.C2)
    tError = ArcSetValueToChannel(#None,tWelder,tArcMode,3,stArcActTcSet.Set1.C3)
    tError = ArcSetValueToChannel(#None,tWelder,tArcMode,4,stArcActTcSet.Set1.C4)
    tError = ArcSetValueToChannel(#None,tWelder,tArcMode,5,stArcActTcSet.Set1.C5)
    tError = ArcSetValueToChannel(#None,tWelder,tArcMode,6,stArcActTcSet.Set1.C6)
    tError = ArcSetValueToChannel(#None,tWelder,tArcMode,7,stArcActTcSet.Set1.C7)
    tError = ArcSetValueToChannel(#None,tWelder,tArcMode,8,stArcActTcSet.Set1.C8)
  CASE #TcSet2
    stTcInfo.TcSet = #TcSet2
    stTcInfo.CtrSet2 = stTcInfo.CtrSet2 + 1
    tArcMode = ArcCheckModeId(tWelder,stArcActTcSet.Set2.JobModeId[], #NOTIFY)
    tError = ArcSetValueToChannel(#None,tWelder,tArcMode,1,stArcActTcSet.Set2.C1)
    tError = ArcSetValueToChannel(#None,tWelder,tArcMode,2,stArcActTcSet.Set2.C2)
    tError = ArcSetValueToChannel(#None,tWelder,tArcMode,3,stArcActTcSet.Set2.C3)
    tError = ArcSetValueToChannel(#None,tWelder,tArcMode,4,stArcActTcSet.Set2.C4)
    tError = ArcSetValueToChannel(#None,tWelder,tArcMode,5,stArcActTcSet.Set2.C5)
    tError = ArcSetValueToChannel(#None,tWelder,tArcMode,6,stArcActTcSet.Set2.C6)
    tError = ArcSetValueToChannel(#None,tWelder,tArcMode,7,stArcActTcSet.Set2.C7)
    tError = ArcSetValueToChannel(#None,tWelder,tArcMode,8,stArcActTcSet.Set2.C8)
ENDSWITCH
END
;******************************************************************************
;[Global Routine] Thermal Control Sleep
;******************************************************************************
GLOBAL DEF ArcTcSleep()
stTcInfo.Active = FALSE
stTcInfo.Sleep = TRUE
INTERRUPT OFF irtArcTcGreater
INTERRUPT OFF irtArcTcSmaller
END
;******************************************************************************
;[Global Routine] Thermal Control Initialize Interrupts
;******************************************************************************
GLOBAL DEF ArcTcOff()
DECL INT tI
ArcWriteDiag(gArcGeneralDebug,"[TC] Off")

FOR tI = 1 TO 8
  stArcTcState[tI].ExeStep = FALSE
  stArcTcState[tI].TcSet = #None
  stArcTcState[tI].Threshold = 0
ENDFOR

stTcInfo.ThresholdAct = 0
stTcInfo.Mode = #None
stTcInfo.TcSet = #Wdat
stTcInfo.CtrSet1 = 0
stTcInfo.CtrSet2 = 0
stTcInfo.CtrWdat = 0
stTcInfo.CtrLength = 1
stTcInfo.DistOffset = 0
stTcInfo.StateCounter = 1
stTcInfo.Active = FALSE
stTcInfo.Sleep = FALSE

INTERRUPT OFF irtArcTcGreater
INTERRUPT OFF irtArcTcSmaller
END
;******************************************************************************
;[Global Routine] Step Weld initialisation
;******************************************************************************
GLOBAL DEF ArcStepInit(tStepDat: IN)
DECL stArcStepDat_T tStepDat
IF (stArcFeatureState.Act.StepWeld == TRUE) THEN
  SWITCH tStepDat.Type
    CASE #SetDistance
      ;Calc Step automatically
      stArcStepWeldInfo.WeldDist    = tStepDat.WeldDist
      IF (tStepDat.WeldDist == 0) THEN
        stArcStepWeldInfo.NotWeldDist = (tStepDat.TotalDist / tStepDat.StepsNumber)
      ELSE
        stArcStepWeldInfo.NotWeldDist = ((tStepDat.TotalDist - (tStepDat.StepsNumber * tStepDat.WeldDist)) / (tStepDat.StepsNumber - 1))
      ENDIF
    CASE #SetStepLength
      ;Until max. StepsNumber
      stArcStepWeldInfo.WeldDist    = tStepDat.WeldDist
      stArcStepWeldInfo.NotWeldDist = tStepDat.StepDist - tStepDat.WeldDist
    CASE #UntilArcOff
      ;Until ArcOff
      stArcStepWeldInfo.WeldDist    = tStepDat.WeldDist
      stArcStepWeldInfo.NotWeldDist = tStepDat.StepDist - tStepDat.WeldDist
    DEFAULT
  ENDSWITCH
  stArcStepWeldInfo.Type        = tStepDat.Type
  stArcStepWeldInfo.StepsNumber = tStepDat.StepsNumber
  stArcStepWeldInfo.ShiftDist   = tStepDat.ShiftDist
  
  stArcStepWeldInfo.SwiExecuted     = FALSE
  stArcStepWeldInfo.DistArcOn       = 0
  stArcStepWeldInfo.LastWeldOnDist  = 0
  IF (stArcCallState.MoveType == #SplBlock) THEN
    stArcStepWeldInfo.DistArcOn = $DISTANCE
  ENDIF
  IF (stArcStepWeldInfo.ShiftDist > 0.0) THEN
    ArcWriteDiag(gArcGeneralDebug,"[STEPWELD] Init Shift")
    stArcStepWeldInfo.WeldActive      = FALSE
    stArcStepWeldInfo.NextCheckLength =  tStepDat.ShiftDist + stArcStepWeldInfo.DistArcOn
    IF (tStepDat.WeldDist == 0) THEN
      stArcStepWeldInfo.NextCheckLength =  tStepDat.ShiftDist + stArcStepWeldInfo.DistArcOn
    ENDIF
  ELSE
    stArcStepWeldInfo.WeldActive = TRUE
    ArcWriteDiag(gArcGeneralDebug,"[STEPWELD] Init NoShift")
    stArcStepWeldInfo.NextCheckLength = tStepDat.WeldDist + stArcStepWeldInfo.DistArcOn
    IF (tStepDat.WeldDist == 0) THEN
      stArcStepWeldInfo.NextCheckLength = tStepDat.StepDist + stArcStepWeldInfo.DistArcOn
    ENDIF
  ENDIF
  stArcStepWeldInfo.StepCount = 0
ELSE
  stArcStepWeldInfo.WeldDist        = 0.0
  stArcStepWeldInfo.NotWeldDist     = 0.0
  stArcStepWeldInfo.StepsNumber     = 0
  stArcStepWeldInfo.ShiftDist       = 0.0
  stArcStepWeldInfo.WeldActive      = FALSE
  stArcStepWeldInfo.NextCheckLength = 0
  stArcStepWeldInfo.LastWeldOnDist  = 0
  stArcStepWeldInfo.StepCount       = 0
  stArcStepWeldInfo.DistArcOn       = 0
ENDIF
END
;******************************************************************************
;[Global Routine] Step ArcOn
;******************************************************************************
GLOBAL DEF ArcStepOn(tArcDat:IN)
DECL stArcDat_T tArcDat
IF (stArcCallState.MoveType <> #SplBlock) THEN
  IF ($DISTANCE > 0) THEN
    SetDistanceToZero()
  ENDIF
  WAIT FOR $DISTANCE < stArcStepWeldInfo.NextCheckLength
ENDIF
GLOBAL INTERRUPT DECL irtStepWeld WHEN $DISTANCE > stArcStepWeldInfo.NextCheckLength DO ArcStepRun()
INTERRUPT ON irtStepWeld
END
;******************************************************************************
;[Global Routine] Step ArcOff
;******************************************************************************
GLOBAL DEF ArcStepOff()
IF (stArcFeatureState.Act.StepWeld == TRUE) THEN
  $OV_APPL = cOvApplDefault
  INTERRUPT OFF irtStepWeld
ENDIF
END
;******************************************************************************
;[Global Routine] Step Point
;******************************************************************************
DEF ArcStepRun()
DECL REAL tDistWeldStep, tDistStart
DECL enArcState_T tArcStateResult
INTERRUPT OFF irtStepWeld
IF (stArcFeatureState.Act.OnTheFlyOn == FALSE) THEN
  BRAKE F
ENDIF

tDistWeldStep = stArcStepWeldInfo.NotWeldDist + stArcStepWeldInfo.WeldDist
tDistStart    = stArcStepWeldInfo.DistArcOn + stArcStepWeldInfo.ShiftDist

IF (stArcStepWeldInfo.WeldActive == TRUE) THEN
  stArcStepWeldInfo.WeldActive = FALSE
  $OV_APPL = cOvApplDefault * 1.25
  ;Switch welding OFF
  IF (enArcCurrentState == #Welding) THEN
    IF (stArcFeatureState.Act.Weave == TRUE) THEN
      ArcWeaveOff(2)
    ENDIF
    tArcStateResult = SetArcState(#StopWelding)
    gArcIgnoreError = TRUE
  ENDIF
  ;Calc. next weld ON
  stArcStepWeldInfo.StepCount = stArcStepWeldInfo.StepCount + 1
  stArcStepWeldInfo.NextCheckLength = tDistStart + (stArcStepWeldInfo.StepCount * tDistWeldStep)
  IF ((stArcStepWeldInfo.StepCount >= stArcStepWeldInfo.StepsNumber) AND (stArcStepWeldInfo.Type <> #UntilArcOff))THEN
    stArcFeatureState.Act.StepWeld = FALSE
    gArcIgnoreError                = TRUE
  ENDIF
ELSE
  stArcStepWeldInfo.LastWeldOnDist = $DISTANCE
  $OV_APPL = cOvApplDefault
  stArcStepWeldInfo.WeldActive = TRUE
  IF (stArcStepWeldInfo.WeldDist == 0) THEN
    ;Switch welding ON und OFF
    stArcStepWeldInfo.WeldActive = TRUE
    StartIgnition()
    tArcStateResult = SetArcState(#StopWelding)
    gArcIgnoreError = TRUE
    stArcStepWeldInfo.WeldActive = FALSE
    IF ((stArcStepWeldInfo.StepCount == 0) AND (stArcStepWeldInfo.ShiftDist == 0)) THEN
      stArcStepWeldInfo.StepCount = 1
    ENDIF
    stArcStepWeldInfo.StepCount = stArcStepWeldInfo.StepCount + 1
    stArcStepWeldInfo.NextCheckLength = tDistStart + (stArcStepWeldInfo.StepCount * stArcStepWeldInfo.NotWeldDist)
  ELSE
    ;Switch welding ON
    IF (stArcStepWeldInfo.SwiExecuted == TRUE) THEN
      ;ArcFeatureSelect(#ArcSwiTrigger,tArcDat,tArcWPDatIn,tTcDat)
      stArcStepWeldInfo.SwiExecuted = FALSE
      gArcActModeSwi = ArcCheckModeId(gArcActIlfWelder,stArcDatAct.Weld.JobModeId[], #NOTIFY)
      ArcSetArcMode(gArcActIlfWelder,gArcActModeSwi)
      ArcSetWeldValueChannel(gArcActIlfWelder,gArcActModeSwi,stArcDatAct.Weld)
    ENDIF
    StartIgnition()
    IF (stArcFeatureState.Act.Weave == TRUE) THEN
      ArcSetWeaveParameter(#TriggerCall,stArcActWeaveSet)
      ArcWeaveOn(#TriggerCall,stArcActWeaveSet)
    ENDIF
    ;Calc. next weld OFF
    IF (stArcStepWeldInfo.StepCount == 0) THEN
      stArcStepWeldInfo.NextCheckLength = tDistStart + stArcStepWeldInfo.WeldDist
    ELSE
      stArcStepWeldInfo.NextCheckLength = tDistStart + (stArcStepWeldInfo.StepCount * tDistWeldStep) + stArcStepWeldInfo.WeldDist
    ENDIF
  ENDIF
ENDIF

IF (stArcFeatureState.Act.StepWeld == TRUE) THEN
  INTERRUPT ON irtStepWeld
ENDIF
END
;******************************************************************************
;[Global Routine] ATA OnTheFly On Option active
;******************************************************************************
GLOBAL DEFFCT BOOL ArcAtaOnTheFlyOnOption(tAdvancedSet :IN)
DECL stAdvanced_T tAdvancedSet
