;[Global Routine] ATA Seam Control Option active
;******************************************************************************
GLOBAL DEFFCT BOOL ArcAtaSeamControlOption()
DECL BOOL tOptionActivated
tOptionActivated = FALSE
IF (gArcTechAdvancedOption == TRUE) THEN
  IF (wArcSeamControlByPLC == TRUE) THEN
    tOptionActivated = TRUE
  ENDIF
ENDIF
RETURN tOptionActivated
ENDFCT
;******************************************************************************
;[Global Routine] ATA Step Weld Option active
;******************************************************************************
GLOBAL DEFFCT BOOL ArcAtaStepWeldOption(tStepDat :IN)
DECL stArcStepDat_T tStepDat
DECL BOOL tOptionActivated
tOptionActivated = FALSE
IF (gArcTechAdvancedOption == TRUE) THEN
  IF ((wArcStepWeldOption == TRUE) AND (tStepDat.Active == TRUE)) THEN
    IF ((tStepDat.WeldDist >= 0) AND (tStepDat.ShiftDist >= 0)) THEN
      SWITCH tStepDat.Type
        CASE #SetDistance
          ;Calc Step automatically
          IF ((tStepDat.TotalDist >= 1) AND (tStepDat.StepsNumber >= 2)) THEN
            tOptionActivated = TRUE
          ELSE
            ArcWriteDiag(gArcGeneralDebug,"[STEPWELD] SetDistance Config Error") 
          ENDIF
        CASE #SetStepLength
          ;Until max. StepsNumber
          IF ((tStepDat.StepDist >= 1) AND (tStepDat.StepsNumber >= 1)) THEN
            tOptionActivated = TRUE
          ELSE
            ArcWriteDiag(gArcGeneralDebug,"[STEPWELD] SetStepLength Config Error") 
          ENDIF
        CASE #UntilArcOff
          ;Until ArcOff
          IF (tStepDat.StepDist >= 1) THEN
            tOptionActivated = TRUE
          ELSE
            ArcWriteDiag(gArcGeneralDebug,"[STEPWELD] UntilArcOff Config Error") 
          ENDIF
        DEFAULT
          ;Feature not active
      ENDSWITCH 
    ENDIF
  ENDIF
ENDIF
RETURN tOptionActivated
ENDFCT
