;*****************************************************************************************
;[Global Routine] Subtraction of 2 $ROB_TIMER variables
;*****************************************************************************************
GLOBAL DEFFCT INT ArcCalcRobTime(tValueHigh:IN,tValueLow:IN)
DECL REAL tValueHigh, tValueLow, tOverflow
IF (tValueLow > tValueHigh) THEN
  ;$ROB_TIMER Overflow
  tOverflow = cIntMax - tValueLow
  RETURN tOverflow + tValueHigh
ELSE
  RETURN tValueHigh - tValueLow
ENDIF
ENDFCT
;*****************************************************************************************
;[Global Routine] Return True if Distance is on windows
;*****************************************************************************************
GLOBAL DEFFCT BOOL ArcDistanceWindow(tDistance :IN,tWindows :IN)
DECL REAL tDistance,tWindows,tDistanceMin,tDistanceMax
tDistanceMin = ($DISTANCE + tDistance) - tWindows
tDistanceMax = ($DISTANCE + tDistance) + tWindows
IF (tDistanceMin <= 0) THEN
  tDistanceMin = 0
ENDIF
IF ($DISTANCE >= tDistanceMin) THEN
  IF ($DISTANCE <= tDistanceMax) THEN
    RETURN TRUE
  ENDIF
ENDIF
RETURN FALSE
ENDFCT
;*****************************************************************************************
;[Global Routine] Check if Wire is Free
;*****************************************************************************************
GLOBAL DEF ArcCheckIfWireIsFree(tWelderNr :IN,tArcBurnFreeOption :IN)
DECL BOOL tArcBurnFreeOption
DECL INT tI
DECL INT tWelderNr
DECL INT tBurnFreeCounter
DECL REAL tArcLinkXTWaitTime
DECL CHAR tPara2[26],tPara3[26]
DECL stArcBurnFree_T tArcBurnFree
SWITCH wArcWelder[tWelderNr].Type
  CASE #ARCLINKXT
    ArcWriteDiag(gArcGeneralDebug,"[WIRE] ArcLinkXT WireIsFree")
    enArcCurrentCheckWire = #CheckWireArcLinkXT
  DEFAULT
    ArcWriteDiag(gArcGeneralDebug,"[WIRE] WireIsFree") 
    enArcCurrentCheckWire = #CheckWireFree
ENDSWITCH
tBurnFreeCounter = 0

IF (ArcWeldCondition(gArcActIlfWelder) == FALSE) THEN
  ArcWriteDiag(gArcGeneralDebug,"[WIRE] WireIsFree Cold")
  enArcCurrentCheckWire = #WireIsFree
ENDIF

tArcBurnFree = ArcGetBurnFree(tWelderNr)

REPEAT
  SWITCH enArcCurrentCheckWire
    ;++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    CASE #CheckWireFree ;(Default)
    ;++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
      ArcOutputReset(tWelderNr,wArcOWireDetectRequest[])
      SWITCH ArcInputStatusOn(tWelderNr,wArcIWireFreeDetection[],wArcWireFreeTimeout)
        CASE 0
          IF ($VEL_ACT > 0.0) THEN
            BRAKE ;OnTheFly Stop
          ENDIF
          enArcCurrentCheckWire = #ErrorWireIsNotFree
        CASE -1,1
          enArcCurrentCheckWire = #WireIsFree
      ENDSWITCH
    ;++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    CASE #CheckWireArcLinkXT ;(ArcLinkXT)
    ;++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
      tArcLinkXTWaitTime = 0.06 ;60ms
      IF (stArcActCraterSet.PostflowTime < tArcLinkXTWaitTime) THEN
        WAIT SEC tArcLinkXTWaitTime - stArcActCraterSet.PostflowTime
      ENDIF
      ArcOutputSet(tWelderNr,wArcOWireDetectRequest[])
      WAIT SEC tArcLinkXTWaitTime
      SWITCH ArcInputStatusOn(tWelderNr,wArcIWireFreeDetection[],0)
        CASE 0
          enArcCurrentCheckWire = #ErrorWireIsNotFree
        CASE -1,1
          enArcCurrentCheckWire = #WireIsFree
      ENDSWITCH
      ArcOutputReset(tWelderNr,wArcOWireDetectRequest[]) 
    ;++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    CASE #ErrorWireIsNotFree
    ;++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
      enArcCurrentCheckWire = #ErrorWireFreeManuallyCut
      IF (tArcBurnFreeOption == TRUE) AND (tArcBurnFree.Option.Active == TRUE) THEN
        IF (tBurnFreeCounter < tArcBurnFree.Option.Retries) THEN
          tBurnFreeCounter = tBurnFreeCounter + 1
          SWITCH wArcWelder[tWelderNr].Type
            CASE #ARCLINKXT 
              enArcCurrentCheckWire = #BurnFreeStartArcLinkXT
            DEFAULT
              enArcCurrentCheckWire = #BurnFreeStart
          ENDSWITCH
        ENDIF
      ENDIF
    ;++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    CASE #ErrorWireFreeManuallyCut
    ;++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
      ArcOutputSet(tWelderNr,wArcOBurnFreeFault[])
      ArcWriteDiag(gArcGeneralDebug,"[WIRE] ErrorWireFreeManuallyCut")
      ArcStrParam(wArcIWireFreeDetection[tWelderNr].Description[],tPara2[],tPara3[])
      ArcMsgWriteS(,#QUIT,"ManuallyCutOffWireNecessary","ARC",10095,OPT_VLSTOP_LOG,gArcSeamName[],tPara2[],tPara3[])
      ArcRemoteSetClearMsg(10095)
      ArcOutputReset(tWelderNr,wArcOBurnFreeFault[])
      SWITCH wArcWelder[tWelderNr].Type
        CASE #ARCLINKXT 
          enArcCurrentCheckWire = #CheckWireArcLinkXT
        DEFAULT
          enArcCurrentCheckWire = #CheckWireFree
      ENDSWITCH
    ;++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    CASE #BurnFreeStart
    ;++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++         
      ArcOutputPulseGroupSet(tWelderNr,wArcOReceiptError[,])
      tI = ArcOutputGroupStatusOff(tWelderNr,wArcOReceiptError[,],1)
      ArcSetArcMode(tWelderNr,tArcBurnFree.Option.Mode)
      ArcSetCraterValueChannel(tWelderNr,tArcBurnFree.Option.Mode,tArcBurnFree.Param) ;TODO Check
      WAIT SEC 0.2 ;Settling time for welding source
      IF ((ArcWeldCondition(gArcActIlfWelder) == TRUE) AND (RobotReadyForWeld(#NONE) == TRUE)) THEN
        SWITCH ArcInputGroupStatusOn(tWelderNr,wArcIWeldPeriphery[,],0) 
          CASE 1
            ArcWriteDiag(gArcGeneralDebug,"[ArcLinkXT] BurnFreeStart")
            ArcMsgWriteS(,#NOTIFY,"BurnFreeMechanismStarted","ARC",10063,OPT_VLSTOP_LOG,gArcSeamName[])
            ArcOutputGroupSet(tWelderNr,wArcOGasPreFlowStart[,])
            WAIT SEC tArcBurnFree.Option.GasFlowTime
            ArcOutputGroupSet(tWelderNr,wArcOWeldStart[,])
            WAIT SEC tArcBurnFree.Option.TimePulse
            ArcOutputGroupSet(tWelderNr,wArcOWeldEnd[,])
            ArcOutputGroupSet(tWelderNr,wArcOGasPostFlowEnd[,])
        ENDSWITCH
      ENDIF
      enArcCurrentCheckWire = #CheckWireFree
    ;++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    CASE #BurnFreeStartArcLinkXT ;(ArcLinkXT)
    ;++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
      ArcOutputPulseGroupSet(tWelderNr,wArcOReceiptError[,])
      tI = ArcOutputGroupStatusOff(tWelderNr,wArcOReceiptError[,],1)
      ArcSetArcMode(tWelderNr,tArcBurnFree.Option.Mode);Set arc mode for burnfree param set
      ArcSetCraterValueChannel(tWelderNr,tArcBurnFree.Option.Mode,tArcBurnFree.Param) ;TODO Check
      WAIT SEC 0.2 ;Settling time for welding source
      IF ((ArcWeldCondition(gArcActIlfWelder) == TRUE) AND (RobotReadyForWeld(#NONE) == TRUE)) THEN 
        SWITCH ArcInputGroupStatusOn(tWelderNr,wArcIWeldPeriphery[,],0) 
          CASE 1
            ArcWriteDiag(gArcGeneralDebug,"[ArcLinkXT] BurnFreeStart")
            ArcMsgWriteS(,#NOTIFY,"BurnFreeMechanismStarted","ARC",10063,OPT_VLSTOP_LOG,gArcSeamName[])
            ArcOutputSet(tWelderNr,wArcOBurnBack[])
            WAIT SEC 0.05
            ArcOutputGroupSet(tWelderNr,wArcOGasPreFlowStart[,])
            IF (tArcBurnFree.Option.GasFlowTime > 0.012) THEN
              WAIT SEC tArcBurnFree.Option.GasFlowTime
            ELSE
              WAIT SEC 0.012
            ENDIF
            ArcOutputGroupSet(tWelderNr,wArcOWeldStart[,])
            IF (tArcBurnFree.Option.TimePulse > 0.012) THEN
              WAIT SEC tArcBurnFree.Option.TimePulse
            ELSE
              WAIT SEC 0.012
            ENDIF
            ArcOutputReset(tWelderNr,wArcOBurnBack[])
            ArcOutputGroupSet(tWelderNr,wArcOWeldEnd[,])
            WAIT SEC 0.012
            ArcOutputGroupSet(tWelderNr,wArcOGasPostFlowEnd[,])
        ENDSWITCH 
      ENDIF        
      enArcCurrentCheckWire = #CheckWireArcLinkXT
  ENDSWITCH
UNTIL enArcCurrentCheckWire == #WireIsFree
enArcCurrentCheckWire = #NOTHING
END
;*****************************************************************************************
;[Global Routine] Check ILF Version
;*****************************************************************************************
GLOBAL DEF ArcCheckILFVersion(tArcDat:IN,tArcWPDat:IN,tArcWPHDat:OUT)
DECL BOOL tB
DECL BOOL tILFCondition
DECL CHAR tParam1[26]
DECL CHAR tParam2[26]
DECL CHAR tIpName[32]
DECL stArcDat_T tArcDat
DECL stArcDat_T tArcWPDat
DECL stArcDat_T tArcWPHDat
tILFCondition = FALSE

tILFCondition = ArcWithNewIlf(305000000,tArcWPDat) AND tArcDat.Advanced.PreStartOn OR tILFCondition ;Need new ilf TRIGGER used for prestart function
tILFCondition = ArcWithNewIlf(305000000,tArcWPDat) AND ArcAtaMoveBackOption(tArcDat.Advanced) OR tILFCondition ;Need new ilf TRIGGER used for ArcOff TODO Check

IF (tILFCondition == TRUE) THEN
  tParam1[] = " "
  tParam2[] = " "
  tIpName[] = " "
  tB = STRCOPY(tParam1[],ArcStrRemoveLeft(tArcWPDat.WdatId[], "W"))
  ON_ERROR_PROCEED
  tIpName[] = $PRO_IP.NAME[]
  IF ($ERR.NUMBER > 0) THEN
    tIpName[] = "Missing Name"
  ENDIF
  tB = STRCOPY(tParam2[],ArcStrRemoveLeft(tIpName[], "/R1/"))
  ArcMsgWriteS(,#NOTIFY,"IlfNeedUpdate","ARC",10132,OPT_VLSTOP_LOG,tParam1[],tParam2[])
ENDIF
END
;*****************************************************************************************
;[Routine] New version of ILF
;*****************************************************************************************
DEFFCT BOOL ArcWithNewIlf(tNewIlf :IN,tArcWPDat :IN)
DECL INT tNewIlf
DECL stArcDat_T tArcWPDat
RETURN (tNewIlf  > tArcWPDat.Info.Version)
ENDFCT
;*****************************************************************************************
;[Global Routine] Initialization of time Array
;*****************************************************************************************
GLOBAL DEF ArcTimeInit()
DECL INT tI
stArcWeldTime.Error = 0
stArcWeldTime.TimeStamps.Preflow = 0
stArcWeldTime.TimeStamps.Ignition = 0
stArcWeldTime.TimeStamps.FirstWeld = 0
stArcWeldTime.TimeStamps.Weld = 0
stArcWeldTime.TimeStamps.StopWelding = 0
stArcWeldTime.TimeStamps.PostFlow = 0
stArcWeldTime.TimeStamps.WeldingDone = 0
stArcWeldTime.TimeStamps.Error = 0
END
;*****************************************************************************************
;[Global Routine] Calculate Arc Times
;*****************************************************************************************
GLOBAL DEF ArcTimeEvaluation()
IF (stArcActStartSet.PurgeTime > 0) THEN
  stArcWeldTime.Purge = ArcCalcRobTime(stArcWeldTime.TimeStamps.Preflow, stArcWeldTime.TimeStamps.Purge)
ELSE
  stArcWeldTime.Purge = 0
ENDIF
stArcWeldTime.Preflow = ArcCalcRobTime(stArcWeldTime.TimeStamps.Ignition, stArcWeldTime.TimeStamps.Preflow)
stArcWeldTime.Ignition = ArcCalcRobTime(stArcWeldTime.TimeStamps.FirstWeld, stArcWeldTime.TimeStamps.Ignition)
stArcWeldTime.WeldWithError = ArcCalcRobTime(stArcWeldTime.TimeStamps.StopWelding, stArcWeldTime.TimeStamps.FirstWeld)
stArcWeldTime.Weld = ArcCalcRobTime(stArcWeldTime.TimeStamps.StopWelding, stArcWeldTime.TimeStamps.Weld) + stArcWeldTime.Error
stArcWeldTime.Crater = ArcCalcRobTime(stArcWeldTime.TimeStamps.PostFlow, stArcWeldTime.TimeStamps.StopWelding)
stArcWeldTime.PostFlow = ArcCalcRobTime(stArcWeldTime.TimeStamps.WeldingDone, stArcWeldTime.TimeStamps.PostFlow)

stArcWeldTime.Seam = stArcWeldTime.Preflow + stArcWeldTime.Ignition + stArcWeldTime.Weld + stArcWeldTime.Crater + stArcWeldTime.PostFlow
stArcWeldTime.SeamNoGas = stArcWeldTime.Ignition + stArcWeldTime.Weld + stArcWeldTime.Crater
END
;*****************************************************************************************
;[Global Routine] Get all value from Channes
;*****************************************************************************************
GLOBAL DEF ArcReadInputChannels()
DECL INT tWelderNr
DECL INT tChannelValue
DECL REAL tParamValue
tWelderNr = gArcActIlfWelder
IF (wArcWelder[tWelderNr].Type == #NONE) THEN
  RETURN
ENDIF
mArcReadInputIndex = mArcReadInputIndex + 1
SWITCH mArcReadInputIndex
  CASE 1,2,3,4,5,6,7,8 ;Number of Channels
  DEFAULT
    mArcReadInputIndex = 1
ENDSWITCH
tParamValue = 0.0
IF (wsArcIChannel[tWelderNr,mArcReadInputIndex].Active == TRUE) THEN
  IF (gArcSignalGroupSelection == TRUE) THEN
    tChannelValue = ArcInSignalGroup(wsArcIChannel[tWelderNr,mArcReadInputIndex],tWelderNr,mArcReadInputIndex)
  ELSE  
    tChannelValue = ArcBitToInt($IN[],wsArcIChannel[tWelderNr,mArcReadInputIndex])
  ENDIF 
  tParamValue = ArcGetValueFromParam(ArcGetIChannelCtrlLine(tWelderNr,mArcReadInputIndex),tChannelValue)
ENDIF
gArcWeldingInfo[tWelderNr,mArcReadInputIndex] = tParamValue
END
;*****************************************************************************************
;[Global Routine] Get Sensor Value #GIN or #AIN
;*****************************************************************************************
GLOBAL DEF ArcReadInputSensor()
DECL INT tWelderNr
DECL INT tValue
DECL REAL tParamValue
tWelderNr = gArcActIlfWelder
IF (wArcWelder[tWelderNr].Type == #NONE) THEN
  RETURN
ENDIF
tValue = 0.0
IF (wsArcISenseSignals[tWelderNr].Active == TRUE) THEN
  SWITCH wsArcISenseSignals[tWelderNr].SigType
    CASE #GIN
      IF (gArcSignalGroupSelection == TRUE) THEN
        tValue = ArcInSignalGroup(wsArcISenseSignals[tWelderNr],tWelderNr,0)
      ELSE  
        tValue = ArcBitToInt($IN[],wsArcISenseSignals[tWelderNr])
      ENDIF       
    CASE #AIN    
      tValue = $ANIN[wsArcISenseSignals[tWelderNr].AnaIndex]
  ENDSWITCH
ENDIF
gArcITrackingSensor[tWelderNr] = tValue
END
;*****************************************************************************************
;[Global Routine] Set value to Channel
; Return:
;          1 = Signal and set value are same
;          0 = Value Set tu Siganal
;         -1 = Signal UNKNOWN
;         -2 = Signal Length = 0
;         -3 = Signal Length too small
;*****************************************************************************************
GLOBAL DEFFCT INT ArcSetValueToChannel(tCommand: IN,tWelderNr :IN,tArcMode :IN,tChannel :IN,tInValue :IN)
DECL INT tWelderNr
DECL INT tArcMode
DECL INT tChannel
DECL INT tValue
DECL INT tReturn
DECL REAL tInValue
DECL REAL tValueParam
DECL BOOL tSetChannel
DECL enArcCommandType_T tCommand
DECL stArcSignal_T tOChannel
DECL stArcClChannel_T tOChannelCl
DECL stParameter_T tParameter
IF (wArcWelder[tWelderNr].Type == #NONE) THEN
  RETURN -1
ENDIF
SWITCH tChannel
  CASE 1,2,3,4,5,6,7,8
  DEFAULT
    RETURN -1
ENDSWITCH
IF (tArcMode > 0) THEN
  tOChannelCl = ArcGetOChannelCtrlLine(tWelderNr,tArcMode,tChannel)
  IF (gArcCtrlLineWithMinMax == TRUE) THEN
    tValueParam = ArcGetValueFromParam(tOChannelCl,tInValue)
  ELSE
    tValueParam = ArcGetValueFromCtrlLine(tOChannelCl,tInValue)
  ENDIF
  tParameter  = ArcGetParamDef(tWelderNr,tArcMode,tChannel)
  IF (tParameter.Active == FALSE) THEN
    RETURN 0 ;Channel disabled
  ENDIF
  tSetChannel = FALSE
  SWITCH tCommand
    CASE #None
      tSetChannel = TRUE
    CASE #ArcOn
      IF (tOChannelCl.UsedInArcCommand B_AND 'B001' > 0) THEN
        tSetChannel = TRUE
      ENDIF
    CASE #ArcSwi
      IF (tOChannelCl.UsedInArcCommand B_AND 'B010' > 0) THEN
        tSetChannel = TRUE
      ENDIF
    CASE #ArcOff
      IF (tOChannelCl.UsedInArcCommand B_AND 'B100' > 0) THEN
        tSetChannel = TRUE
      ENDIF
    DEFAULT
      tSetChannel = TRUE
  ENDSWITCH
  IF ((gArcUsedInCommandOption == TRUE) AND (tSetChannel == FALSE)) THEN
    RETURN 0 ;Channel Not Used in ArcCommand
  ENDIF
ELSE
  tValueParam = tInValue
ENDIF
tOChannel   = wsArcOChannel[tWelderNr,tChannel]
IF (gArcSignalGroupSelection == TRUE) THEN
  tValue    = ArcInSignalGroup(tOChannel,tWelderNr,tChannel)
ELSE
  tValue    = ArcBitToInt($OUT[],tOChannel)
ENDIF
tReturn     = ArcCalcChannelValue(tValue,tOChannel,tValueParam)
IF (tReturn == 0) THEN
  IF (gArcSignalGroupSelection == TRUE) THEN
    ArcOutSignalGroup(tOChannel,tWelderNr,tChannel,tValue)
  ELSE
    ArcIntToBit($OUT[],tOChannel,tValue)
  ENDIF 
  ArcSetValueToRdm(tChannel,tValue)
ENDIF
IF (gArcDebugC1ToAnalog10 == TRUE) THEN
  IF (tChannel == 1) THEN
    $ANOUT[10] = tValueParam ;Debug Channel 1
    ;ArcMsgR(tValueParam,0,0)
  ENDIF
ENDIF
RETURN tReturn
ENDFCT
;*****************************************************************************************
;[Global Routine] Set Strike value to Channels
;*****************************************************************************************
GLOBAL DEF ArcSetStrikeValueChannel(tWelderNr :IN,tArcMode :IN,tStrike :IN)
DECL INT tWelderNr
DECL INT tArcMode
DECL INT tError
DECL INT tCh
DECL stStrike_T tStrike
tError = ArcSetValueToChannel(#ArcOn,tWelderNr,tArcMode,1,tStrike.Channel1)
tError = ArcSetValueToChannel(#ArcOn,tWelderNr,tArcMode,2,tStrike.Channel2)
tError = ArcSetValueToChannel(#ArcOn,tWelderNr,tArcMode,3,tStrike.Channel3)
tError = ArcSetValueToChannel(#ArcOn,tWelderNr,tArcMode,4,tStrike.Channel4)
tError = ArcSetValueToChannel(#ArcOn,tWelderNr,tArcMode,5,tStrike.Channel5)
tError = ArcSetValueToChannel(#ArcOn,tWelderNr,tArcMode,6,tStrike.Channel6)
tError = ArcSetValueToChannel(#ArcOn,tWelderNr,tArcMode,7,tStrike.Channel7)
IF (wArcWelder[tWelderNr].Type == #ARCLINKXT) THEN
  tCh = tStrike.Channel8 
  tCh = tCh  B_AND 'B01111111'
  tError = ArcSetValueToChannel(#ArcOn,tWelderNr,tArcMode,8,tCh) ;TODO Check with ArklinkXt
ELSE
  tError = ArcSetValueToChannel(#ArcOn,tWelderNr,tArcMode,8,tStrike.Channel8)
ENDIF
END
