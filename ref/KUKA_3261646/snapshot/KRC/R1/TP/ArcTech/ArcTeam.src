;*****************************************************************************************
;Routine Convert stArcStateInt State to enArcState_T
;*****************************************************************************************
DEFFCT enArcState_T ArcIntStateToEnum(tState :IN)
DECL INT tState
DECL INT Init
DECL INT Error
DECL INT CheckRobotReady
DECL INT CheckPeriphery
DECL INT PrepIgnition
DECL INT Ignition
DECL INT WaitArcStable
DECL INT IgnitionFailed
DECL INT RobotNotRdy
DECL INT PowerSourceNotRdy
DECL INT PeriNotRdy
DECL INT NoGasFlow
DECL INT BreakStateMachine
DECL INT CheckPowerSource
DECL INT IgnitionErrorRestart
DECL INT IgnitionErrorStrategy
DECL INT Welding
DECL INT WeldingDone
DECL INT StopWelding
DECL INT GasPostFlow
DECL INT StopGasFlow
DECL INT RestartAfterError
DECL INT Nothing
Init = stArcStateInt.Init
Error = stArcStateInt.Error
CheckRobotReady = stArcStateInt.CheckRobotReady
CheckPeriphery = stArcStateInt.CheckPeriphery
PrepIgnition = stArcStateInt.PrepIgnition
Ignition = stArcStateInt.Ignition
WaitArcStable = stArcStateInt.WaitArcStable
IgnitionFailed = stArcStateInt.IgnitionFailed
RobotNotRdy = stArcStateInt.RobotNotRdy
PowerSourceNotRdy = stArcStateInt.PowerSourceNotRdy
PeriNotRdy = stArcStateInt.PeriNotRdy
NoGasFlow = stArcStateInt.NoGasFlow
BreakStateMachine = stArcStateInt.BreakStateMachine
CheckPowerSource = stArcStateInt.CheckPowerSource
IgnitionErrorRestart = stArcStateInt.IgnitionErrorRestart
IgnitionErrorStrategy = stArcStateInt.IgnitionErrorStrategy
Welding = stArcStateInt.Welding
WeldingDone = stArcStateInt.WeldingDone
StopWelding = stArcStateInt.StopWelding
GasPostFlow = stArcStateInt.GasPostFlow
StopGasFlow = stArcStateInt.StopGasFlow
RestartAfterError = stArcStateInt.RestartAfterError
Nothing = stArcStateInt.Nothing
SWITCH tState
  CASE Init
    RETURN #Init
  CASE Error
    RETURN #Error
  CASE CheckRobotReady
    RETURN #CheckRobotReady
  CASE CheckPeriphery
    RETURN #CheckPeriphery
  CASE PrepIgnition
    RETURN #PrepIgnition
  CASE Ignition
    RETURN #Ignition
  CASE WaitArcStable
    RETURN #WaitArcStable
  CASE IgnitionFailed
    RETURN #IgnitionFailed
  CASE RobotNotRdy
    RETURN #RobotNotRdy
  CASE PowerSourceNotRdy
    RETURN #PowerSourceNotRdy
  CASE PeriNotRdy
    RETURN #PeriNotRdy
  CASE NoGasFlow
    RETURN #NoGasFlow
  CASE BreakStateMachine
    RETURN #BreakStateMachine
  CASE CheckPowerSource
    RETURN #CheckPowerSource
  CASE IgnitionErrorRestart
    RETURN #IgnitionErrorRestart
  CASE IgnitionErrorStrategy
    RETURN #IgnitionErrorStrategy
  CASE Welding
    RETURN #Welding
  CASE WeldingDone
    RETURN #WeldingDone
  CASE StopWelding
    RETURN #StopWelding
  CASE GasPostFlow
    RETURN #GasPostFlow
  CASE StopGasFlow
    RETURN #StopGasFlow
  CASE RestartAfterError
    RETURN #RestartAfterError
  CASE Nothing
    RETURN #Nothing
ENDSWITCH
ENDFCT
;*****************************************************************************************
;[Error recovery]
;*****************************************************************************************
;*****************************************************************************************
;[Error recovery] Initialization when prog reset or line select
;*****************************************************************************************
GLOBAL DEF ATA_ER_EventInit()
ATAg_ER_BeginMemPoint = FALSE
ATAg_ER_ArcGroupEnabled = FALSE
ATAg_ER_ExtSensorActive = FALSE
ATAg_ER_Init()
END
;*****************************************************************************************
;[Error recovery] Initialization all used signals
;*****************************************************************************************
DEF ATAg_ER_Init()
DECL BOOL tB
tB = STRCOPY(ATAg_ER_ProgNameError[]," ")
tB = STRCOPY(ATAg_ER_PointLineError[]," ")
tB = STRCOPY(ATAg_ER_ProgName[]," ")
tB = STRCOPY(ATAg_ER_PointLine[]," ")  
ATAg_ER_WeldDone = FALSE
ATAg_ER_SkipSeam = FALSE
ATAg_ER_ChkRepeatGroup = FALSE
ATAg_ER_GoToNexSeam = FALSE
ATAg_ER_IsMyError = FALSE
ATAg_ER_ExtError = FALSE
ATAg_ER_SensorActive = FALSE
ATAg_ER_ExtSensorActive = FALSE
ATAg_ER_ErrorOnSeam = FALSE
ArcOutputReset(gArcActIlfWelder,wArcOPlcCleanPosition[])
END
;*****************************************************************************************
;[Error recovery] On Service Position Dialogue Switch
;*****************************************************************************************
GLOBAL DEF ATA_ER_Retry()
IF (gArcTechAdvancedOption == TRUE) THEN
  ATA_UserCall(#AdvErrSeamRepeat)
ENDIF
ATAg_ER_IsMyError = FALSE ;Reset My Error
ATAg_ER_ChkRepeatGroup = TRUE ;RepeatGroup
ArcWriteDiag(gArcGeneralDebug,"[TEAM] Retry Seam")
END
;*****************************************************************************************
;[Error recovery] On Service Position Dialogue Switch
;*****************************************************************************************
GLOBAL DEF ATA_ER_Abort()
IF (gArcTechAdvancedOption == TRUE) THEN
  ATA_UserCall(#AdvErrSeamSkip)
ENDIF
ATAg_ER_IsMyError = FALSE ;Reset My Error
ArcWriteDiag(gArcGeneralDebug,"[TEAM] Abort Seam")
END
;*****************************************************************************************
;[Error recovery] On Service GoTo next Seam
;*****************************************************************************************
GLOBAL DEF ATA_ER_NextSeam()
IF (gArcTechAdvancedOption == TRUE) THEN
  ATA_UserCall(#AdvErrSeamSkip)
ENDIF
ATAg_ER_IsMyError = FALSE ;Reset My Error
ATAg_ER_GoToNexSeam = TRUE
ATAg_ER_ChkRepeatGroup = TRUE ;RepeatGroup
gArcWeldErrorCounter = 0
ArcWriteDiag(gArcGeneralDebug,"[TEAM] Skip Seam")
END
;*****************************************************************************************
;[Error recovery] Routine on Service position
;*****************************************************************************************
;GLOBAL DEF enArcErrorDecision_T ATA_ER_ServicePos()
GLOBAL DEF ATA_ER_ServicePos()
DECL enArcErrorDecision_T retVal
retVal = AdvancedErrorDecision()
SWITCH retVal
  CASE #Retry
    ATA_ER_Retry()
  CASE #Abort
    ATA_ER_NextSeam()
  DEFAULT
    ATA_ER_Abort()
ENDSWITCH
END
;*****************************************************************************************
;[Error recovery] Routine: use separate variable
;*****************************************************************************************
DEFFCT BOOL ATA_ER_ErrorOnSeam(tExError :IN)
DECL INT tTimeout
DECL BOOL tExError
tTimeout = 10
WAIT FOR ((enArcCurrentState == #WeldingDone) OR (enArcCurrentState == #Error) OR (enArcCurrentState == #IgnitionFailed) OR (enArcCurrentState == #Nothing) OR (TIMER_LIMIT(tTimeOut)))
RETURN ((gArcWeldErrorCounter > 0) OR (tExError == TRUE)) 
ENDFCT
;*****************************************************************************************
;[Error recovery] Routine Never used (check if error on seam to do Inspection program)
;*****************************************************************************************
GLOBAL DEFFCT BOOL ATA_ER_DoProgInspection()
DECL INT tAdd
DECL BOOL tRes
CONTINUE
IF (StrLen(ATAg_ER_ProgNameError[])) > 2 THEN
  RETURN TRUE
ELSE
  RETURN FALSE
ENDIF
ENDFCT
;*****************************************************************************************
;[Error recovery] Routine Never used (Case1: "ErrorOnSeam if exist seam on this program or exit", Case2: NoError do this program)
;*****************************************************************************************
GLOBAL DEFFCT BOOL ATA_ER_DoProg()
DECL INT tAdd
DECL BOOL tB
CONTINUE
IF (StrLen(ATAg_ER_ProgNameError[]) > 2) THEN
  tB = STRCOPY(ATAg_ER_ProgName[]," ")
  mPRO_IP = $PRO_IP
  IF (StrLen(mPRO_IP.NAME[]) > 0) THEN
    tAdd=StrAdd(ATAg_ER_ProgName[],mPRO_IP.NAME[])
    ATAg_ER_ProgName[] = ArcStrRemoveLeft(ATAg_ER_ProgName[],"/R1/")
    ATAg_ER_ProgName[] = ArcStrRemoveRight(ATAg_ER_ProgName[],".src")
    ATAg_ER_ProgName[] = ArcStrRemoveSpace(ATAg_ER_ProgName[])
    IF (STRCOMP(ATAg_ER_ProgNameError[],ATAg_ER_ProgName[],#NOT_CASE_SENS)) THEN
      RETURN TRUE
    ELSE
      RETURN FALSE
    ENDIF
  ELSE
    ArcMsgWriteS(,#NOTIFY ,"AtAInternalError","ARC",20010,Opt_NOVLSTOP_LOG,"ProIp Name")
    RETURN TRUE
  ENDIF
ELSE
  RETURN TRUE
ENDIF
ENDFCT
;*****************************************************************************************
;[Error recovery] Routine On "ArcOn" flag position,name,line...
;*****************************************************************************************
GLOBAL DEF ATA_ER_BeginMemPoint(tSetSpeed :IN)
DECL BOOL tB
DECL BOOL tSetSpeed
DECL BOOL tRes
DECL INT tI
DECL INT tOffset
DECL STATE_T tState
ATAg_ER_WeldDone = FALSE
ATAg_ER_SkipSeam = FALSE
ATAg_ER_ChkRepeatGroup = FALSE
ATAg_ER_BeginMemPoint = TRUE
IF (ATAg_ER_ArcGroupEnabled == TRUE) THEN
  gArcDryVelFactor = 1
  mPRO_IP = $PRO_IP
  ATA_ER_RoutineVisible(mPRO_IP)  
  tB = STRCOPY(ATAg_ER_ProgName[]," ")
  tB = STRCOPY(ATAg_ER_PointLine[]," ")  
  IF (mPRO_IP.SNR > 1)THEN
    tB = STRCOPY(ATAg_ER_ProgName[],mPRO_IP.NAME[])
    ATAg_ER_ProgName[]=ArcStrRemoveLeft(ATAg_ER_ProgName[],"/R1/")
    ATAg_ER_ProgName[]=ArcStrRemoveRight(ATAg_ER_ProgName[],".src")
    ATAg_ER_ProgName[]=ArcStrRemoveSpace(ATAg_ER_ProgName[])
    tOffset = 0
    SWRITE(ATAg_ER_PointLine[],tState,tOffset,"%s,Line:%d",ATAg_ER_ProgName[],mPRO_IP.SNR)
    ATAg_ER_PointLine[]=ArcStrRemoveSpace(ATAg_ER_PointLine[])
    IF (StrLen(ATAg_ER_PointLineError[])) > 2 THEN
      IF (STRCOMP(ATAg_ER_PointLineError[],ATAg_ER_PointLine[],#NOT_CASE_SENS))AND(STRCOMP(ATAg_ER_ProgNameError[],ATAg_ER_ProgName[],#NOT_CASE_SENS)) THEN
        IF ATAg_ER_GoToNexSeam THEN
          ATAg_ER_Init()
          ArcWriteDiag(gArcGeneralDebug,"[TEAM] ATA_ER_BeginMemPoint NextSeam")
          ATAg_ER_WeldDone = TRUE
          ATAg_ER_SkipSeam = TRUE
          IF (tSetSpeed == TRUE) THEN
            gArcDryVelFactor = gArcFactorFastSpeed
          ENDIF
        ENDIF
        IF (gArcWeldErrorCounter <= 1) THEN
          tB = STRCOPY(ATAg_ER_PointLineError[]," ")
          tB = STRCOPY(ATAg_ER_ProgNameError[]," ")
        ENDIF
      ELSE
        ArcWriteDiag(gArcGeneralDebug,"[TEAM] ATA_ER_BeginMemPoint WeldDone")
        ATAg_ER_WeldDone = TRUE
        tB = STRCOPY(ATAg_ER_PointLine[]," ")
        tB = STRCOPY(ATAg_ER_ProgName[]," ")
        IF (tSetSpeed == TRUE) THEN
          gArcDryVelFactor = gArcFactorFastSpeed
        ENDIF
      ENDIF
    ELSE
      IF gArcSyncList > 1 THEN
        IF ATAg_ER_ExtError THEN
          ATAg_ER_WeldDone=TRUE
          IF (tSetSpeed == TRUE) THEN
            gArcDryVelFactor = gArcFactorFastSpeed
          ENDIF
        ENDIF
      ENDIF
    ENDIF
  ELSE
    ArcMsgWriteS(,#NOTIFY ,"AtAInternalError","ARC",20010,Opt_NOVLSTOP_LOG,"ProIp LineNr: ",ArcIntToStr(mPRO_IP.SNR))
  ENDIF
ENDIF
END
;*****************************************************************************************
;[Error recovery] Routine On "ArcOff" on error flag position,name,line...
;*****************************************************************************************
GLOBAL DEF ATA_ER_EndMemPoint()
DECL BOOL tB
IF ATAg_ER_ArcGroupEnabled == TRUE THEN
  IF ATA_ER_ErrorOnSeam(FALSE) == TRUE THEN
    ArcWriteDiag(gArcGeneralDebug,"[TEAM] ATA_ER_EndMemPoint Error")
    ATAg_ER_ErrorOnSeam = TRUE
    tB = STRCOPY(ATAg_ER_SeamName[],gArcSeamName[])
    IF (StrLen(ATAg_ER_PointLineError[])) < 2 THEN
      IF (StrLen(ATAg_ER_ProgName[])) > 2 THEN
        ATAg_ER_PointLineError[] = ArcStrRemoveSpace(ATAg_ER_PointLine[])
        ATAg_ER_ProgNameError[] = ArcStrRemoveSpace(ATAg_ER_ProgName[])
      ENDIF
    ENDIF
  ENDIF
ENDIF
tB = STRCOPY(ATAg_ER_PointLine[]," ")
tB = STRCOPY(ATAg_ER_ProgName[]," ")
ATAg_ER_WeldDone = FALSE
ATAg_ER_SkipSeam = FALSE
ATAg_ER_BeginMemPoint = FALSE
gArcDryVelFactor = 1
END
;*****************************************************************************************
;[Error recovery] Reset Variables
;*****************************************************************************************
GLOBAL DEF ATA_ER_Reset()
DECL BOOL tB
tB = STRCOPY(ATAg_ER_GroupName[]," ")
tB = STRCOPY(ATAg_ER_SeamName[]," ")
END
;*****************************************************************************************
;[Error recovery] Routine on end of group check ModeOp to-do
;*****************************************************************************************
GLOBAL DEFFCT BOOL ATA_ER_ChkSeamGroup(tInt :IN)
DECL BOOL tBool
DECL INT tInt
DECL INT tI
IF (gArcIsOnSimEnvironment == TRUE) THEN
  RETURN FALSE
ENDIF
IF (ATAg_ER_ArcGroupEnabled == TRUE) THEN
  ;CONTINUE
  ;ATO_PLCRepeatGroupNumber=tInt
  SWITCH $MODE_OP
    CASE #T1
      RETURN ATA_ER_ChkSeamGroupT1(tInt)
    CASE #T2
      RETURN ATA_ER_ChkSeamGroupT2(tInt)
    CASE #AUT
      RETURN ATA_ER_ChkSeamGroupAUT(tInt)
    CASE #EX
      RETURN ATA_ER_ChkSeamGroupEX(tInt)
    DEFAULT
      ArcMsgWriteS(,#NOTIFY ,"AtAInternalError","ARC",20010,Opt_NOVLSTOP_LOG,"ErrorOnMODE_OP")
      ATAg_ER_Init()
      RETURN FALSE
  ENDSWITCH
ELSE
  ArcMsgWrite(,#NOTIFY ,"ErrorRecoveryStrategyDisabled","ARC",20009,Opt_NOVLSTOP_LOG)
  ATAg_ER_Init()
  RETURN FALSE
ENDIF
ENDFCT
;*****************************************************************************************
;[Error recovery] Show Message on select line inside repeat until group
;*****************************************************************************************
GLOBAL DEF ATA_ER_ForceExit()
IF (ATAg_ER_SensorActive == TRUE) THEN
  ArcMsgWrite(,#QUIT ,"ILFSenseRtUnsuitableOnErrorRecovery","ARC",20013,Opt_NOVLSTOP_LOG)
  ArcRemoteSetClearMsg(20013)
  ATAg_ER_SensorActive=FALSE
ELSE
  IF (gArcTechAdvancedOption == TRUE) THEN
    ArcMsgWriteS(,#NOTIFY ,"GroupSelectedManually","ARC",20008,Opt_NOVLSTOP_LOG,"LineSelected")
  ELSE
    ArcMsgWriteS(,#NOTIFY ,"AtAInternalError","ARC",20010,Opt_NOVLSTOP_LOG,"Missing:ArcTechAdvanced")
  ENDIF 
ENDIF
END
;*****************************************************************************************
;[Error recovery] Routine On End seam group ModeOp=T1 Show dialogue to-do
;*****************************************************************************************
DEFFCT BOOL ATA_ER_ChkSeamGroupT1(tInt :IN)
DECL INT tInt
DECL INT tAnswer
IF ATA_ER_ErrorOnSeam(ATAg_ER_ExtError)==TRUE THEN
  tAnswer = ArcMsgWriteDialog(,"ErrorOnSeamMoveToServicepostion","ARC",20014,Opt_VLSTOP_LOG,"Common#Ok")
  ArcRemoteSetDialogAnswer(20014,tAnswer)
  RETURN TRUE
ELSE
  IF ATAg_ER_NoErrorT1Dialog==TRUE THEN
    tAnswer = ArcMsgWriteDialog(,"CheckUserPosition","ARC",20015,Opt_VLSTOP_LOG,"Common#Yes","Common#No")
    ArcRemoteSetDialogAnswer(20015,tAnswer)
    SWITCH tAnswer
      CASE 1
        RETURN TRUE
    ENDSWITCH
  ENDIF
  ATAg_ER_Init()
  RETURN FALSE
ENDIF
ENDFCT
;*****************************************************************************************
;[Error recovery] Routine On End seam group ModeOp=T2 Show dialogue only on error seam
;*****************************************************************************************
DEFFCT BOOL ATA_ER_ChkSeamGroupT2(tInt :IN)
DECL INT tInt
DECL INT tAnswer
IF ATA_ER_ErrorOnSeam(ATAg_ER_ExtError)==TRUE THEN
  tAnswer = ArcMsgWriteDialog(,"ErrorOnSeamMoveToServicepostion","ARC",20014,Opt_VLSTOP_LOG,"Common#Ok")
  ArcRemoteSetDialogAnswer(10524,tAnswer)
  RETURN TRUE
ELSE
  ATAg_ER_Init()
  RETURN FALSE
ENDIF
ENDFCT
;*****************************************************************************************
;[Error recovery] Routine On End seam group ModeOp=#Aut no dialogue
;*****************************************************************************************
DEFFCT BOOL ATA_ER_ChkSeamGroupAUT(tInt :IN)
DECL INT tInt
IF ATA_ER_ErrorOnSeam(ATAg_ER_ExtError)==TRUE THEN
  RETURN TRUE
ELSE
  ATAg_ER_Init()
  RETURN FALSE
ENDIF
ENDFCT
;*****************************************************************************************
;[Error recovery] On End seam group ModeOp=#EX no dialogue
;*****************************************************************************************
DEFFCT BOOL ATA_ER_ChkSeamGroupEX(tInt :IN)
DECL INT tInt
IF ATA_ER_ErrorOnSeam(ATAg_ER_ExtError)==TRUE THEN
  RETURN TRUE
ELSE
  ATAg_ER_Init()
  RETURN FALSE
ENDIF
ENDFCT
;*****************************************************************************************
;[Error recovery] check if Arc Routine are visible
;*****************************************************************************************
DEF ATA_ER_RoutineVisible(tPRO_IP:IN)
DECL INT tI,tAdd
DECL CHAR tFileVisible[128]
STRUC FileName CHAR Name[128]
DECL FileName FileVisible[2]
DECL PRO_IP tPRO_IP 
tFileVisible[]="Error recovery file is visible: "
FileVisible[1].Name[]="arcmain.src"
FileVisible[2].Name[]="arcteam.src"
FOR tI=1 TO 2
  IF (StrFind(1,tPRO_IP.NAME[],FileVisible[tI].Name[],#NOT_CASE_SENS) > 0) THEN
    tAdd=StrAdd(tFileVisible[],tPRO_IP.NAME[])
    ArcMsgWriteS(,#QUIT ,"WarningRoutineVisible","ARC",20011,Opt_NOVLSTOP_LOG,tFileVisible[])
  ENDIF
ENDFOR
END
;*****************************************************************************************
;[Error recovery] check if Error is present on external Robot
;*****************************************************************************************
GLOBAL DEF ATA_ER_GroupProgSync(tStr[] :IN, tNum :IN)
DECL INT tNum,tI
DECL CHAR tStr[]
gArcSyncList = tNum
ATAg_ER_ExtError = FALSE
IF (gArcSyncList > 1) THEN
  ArcProgramSync(tStr[],gArcSyncList)
  IF (ATAg_ER_IsMyError == FALSE) THEN
    tI = 2
    WHILE ArcRTRobotExist(tI) == TRUE
      IF (tI B_AND gArcSyncList)== tI THEN
        IF (ArcRemoteGetVarB($COOP_KRC[tI].NAME[],"ATAg_ER_IsMyError",#NOTIFY) == TRUE) THEN
          ATAg_ER_ExtError = TRUE
        ENDIF
      ENDIF
      tI = tI + 1
    ENDWHILE
  ENDIF
  ArcProgramSync("EndGroupSync",gArcSyncList)
ENDIF
END
;*****************************************************************************************
;[Error recovery] check if Plc Selection is same an all Robots
;*****************************************************************************************
GLOBAL DEFFCT BOOL ATA_ER_PLCSignalSync()
DECL CHAR RmdCmd[128]
DECL BOOL RemoteRes
DECL BOOL tPlcSelection
DECL INT tI,tArcErrRecoverySignExt
tPlcSelection = TRUE
IF (gArcSyncList > 1) THEN
  ArcProgramSync("StartPlcSyncro",gArcSyncList)
  tI = 2
  WHILE ArcRTRobotExist(tI) == TRUE
    IF (tI B_AND gArcSyncList)==tI THEN
      tArcErrRecoverySignExt = 0
      tArcErrRecoverySignExt = ArcRemoteGetVarI($COOP_KRC[tI].NAME[],"gArcIErrRecoveryPlcSign",#NONE)
      IF gArcIErrRecoveryPlcSign <> tArcErrRecoverySignExt THEN
        tPlcSelection = FALSE
      ENDIF
    ENDIF
    tI = tI + 1
  ENDWHILE
ENDIF
RETURN tPlcSelection
ENDFCT
;*****************************************************************************************
;[Error recovery] check if Sensore is Active
;*****************************************************************************************
GLOBAL DEF ATA_ER_ChkIfSensorActive()
IF ((ATAg_ER_ArcGroupEnabled == TRUE) AND (gArcSensorActive == TRUE)) THEN
  LOOP
    ATAg_ER_SensorActive = TRUE
    ArcMsgWrite(,#QUIT,"ILFSenseUnsuitableOnErrorRecovery","ARC",20012,Opt_NOVLSTOP_LOG)
    ArcRemoteSetClearMsg(20012)
  ENDLOOP
ENDIF
END
;*****************************************************************************************
;[Error recovery] Loop on #P_Ative send to all Robot Stop
;*****************************************************************************************
GLOBAL DEF ATA_ER_LoopSensorActive()
DECL BOOL Result
DECL INT tI
IF (ATAg_ER_SensorActive == TRUE) THEN
  IF (gArcSyncList > 1) THEN
    tI = 2
    WHILE ArcRTRobotExist(tI) == TRUE
      IF (tI B_AND gArcSyncList)== tI THEN
        ArcRemoteSetVarB($COOP_KRC[tI].NAME[],"ATAg_ER_ExtSensorActive",TRUE,#NOTIFY)
      ENDIF
      tI = tI + 1
    ENDWHILE
  ENDIF
  ArcRobotStopFromSUBMIT(TRUE)
ELSE
  IF (ATAg_ER_ExtSensorActive==TRUE) THEN
    ArcMsgWrite(,#NOTIFY ,"ILFSenseRtUnsuitableOnErrorRecovery","ARC",20013,Opt_NOVLSTOP_LOG)
    ArcRobotStopFromSUBMIT(TRUE)
  ENDIF
ENDIF
END
;*****************************************************************************************
;[Error recovery] Check Seam has to be welded at beginning of seam
;*****************************************************************************************
GLOBAL DEFFCT BOOL ATA_ER_CheckSeamBegin()
DECL BOOL tResult
tResult = FALSE
IF (gArcTechAdvancedOption == TRUE) AND (ATAg_ER_ArcGroupEnabled == TRUE) THEN
  ATA_ER_BeginMemPoint(TRUE)
  IF (ATAg_ER_WeldDone == TRUE) THEN
    tResult = TRUE
  ENDIF
ENDIF
RETURN tResult
ENDFCT
;*****************************************************************************************
;[Error recovery] Check Seam has to be welded
;*****************************************************************************************
GLOBAL DEFFCT BOOL ATA_ER_CheckSeam()
DECL BOOL tResult
tResult = FALSE
IF (gArcTechAdvancedOption == TRUE) AND (ATAg_ER_ArcGroupEnabled == TRUE) THEN
  IF (ATAg_ER_WeldDone == TRUE) THEN
    tResult = TRUE
  ENDIF
ENDIF
RETURN tResult
ENDFCT
