&ACCESS R2
&COMMENT ArcTech
DEFDAT ArcSense PUBLIC
;*****************************************************************************************
;STRUC
;*****************************************************************************************
DECL GLOBAL stArcSQNameTable_T mSQNames[1]
mSQNames[1]={SqDescription[] "Default",StrucName[] "Default"}
;*****************************************************************************************
;BOOL
;*****************************************************************************************
DECL BOOL mRSIErrMsg                    = TRUE
DECL BOOL mResumeTrigger                = TRUE
DECL BOOL mControlIsOff                 = FALSE
DECL BOOL mSigGenStop                   = FALSE
;*****************************************************************************************
;INT
;*****************************************************************************************
DECL INT mSigQualTimeoutSec             = 15 ;For Timeout to find good signal. 15 = Default
;$Sen_Pint[] for First IO Block
DECL GLOBAL INT gArsIO1 = 10 ;Global because Statukey PlugIn reads this
;ArcSense BitDecode Inputs
;gArsIO 1 -> TRUE; Pause WeaveSignal Generator FALSE; StartSignal Generator
;gArsIO 2 -> TRUE; Reset WeaveSignal Generator FALSE; StartSignal Generator
;For Start WeaveSignal ArcSenseIO (ArcSenseIO 1 & ArcSenseIO 2 )
;gArsIO 3 -> TRUE; Reduce Weaveoffset          FALSE; Stop Reduce Weaveoffset
;gArsIO 4 -> TRUE; Stop RSI Process(Parameterdetection,SignalQuality,Control) ; False StartRSIProcess
;gArsIO 5 -> TRUE; ManualMove: CTRL Eingang fuer ManualMove Block
;gArsIO 6 -> TRUE; Threshold: Schlauch?berwachung Inactiv
;gArsIO 7 -> TRUE; RedCorGen: komplettter Abbau Weave+Sensor / False Abbau Weave only
;gArsIO 8 -> TRUE; ManualMove: HandShake Eingang für Manual Move Block
;gArsIO 9 -> TRUE; ManualMove: Move Y+
;gArsIO 10 -> TRUE;ManualMove: Move Y-
;gArsIO 11 -> TRUE;ManualMove: Move Z+
;gArsIO 12 -> TRUE;ManualMove: Move Z-
;gArsIO 13 -> TRUE; ReduceCorZ : starts to reduce the sensor offset Z, FALSE; Stops reducing the sensor offset Z
;gArsIO 14 -> TRUE; ReduceCorSensorY  starts to reduce the sensor offset Y, FALSE; Stops reducing the sensor offset Y
;gArsIO 15 -> TRUE; Analogsignal, FALSE; Digitalsignal
;gArsIO 16 -> TRUE; Weldingstate Hot, FALSE; Weldingstate Cold
;$Sen_Pint[] for Second IO Block
DECL GLOBAL INT gArsIO2 = 11 ;Global because Statukey PlugIn reads this
;ArcSense BitDecode Inputs
;gArsIO 17 -> TRUE; ToolDirection Z
;gArsIO 18 -> TRUE; Tcp Couple
;gArsIO 19 -> TRUE; Use Anout for simulatione
DECL GLOBAL INT gArsStateIO = 12 ;Global because Statukey PlugIn reads this
; gArsStateIO 1 -> ArcSense correction active or correction time after signal quality check
; gArsStateIO 2 -> RedCorGen: Finished Reduce Correction
; gArsStateIO 3 -> ControllerNG: Failed to Generate Reference Signal in Time
; gArsStateIO 4 -> Threshold: Left maximum allowed Threshold.
; gArsStateIO 5 -> ManualMove: Handshake Out
; gArsStateIO 6 -> SignalQuality: Failed to find Signal in Time
; gArsStateIO 7 -> RedCorZ: Abbau Sensor Only Rdy
; gArsStateIO 8 -> RedCorY: Abbau Sensor Only Rdy
; gArsStateIO 9 ->  ControllerNG: Critical Sanity Break (More then 10 Sanity breaks in short duration) Signal in Time
; gArsStateIO 10
; gArsStateIO 11
; gArsStateIO 12
; gArsStateIO 13
; gArsStateIO 14
; gArsStateIO 15
; gArsStateIO 16
;*****************************************************************************************
;REAL
;*****************************************************************************************
DECL REAL mSigQualSanity                = 0.175000 ;For Peak Detection. 0.175 = Default, 1 = highest sensitivity, 0 = lowest sensitivity
DECL REAL mSigQualFreqRange             = 0.100000 ;For Deviation between Input Signal and Weave Signal. 0.1 = Default, If lower it is more sensitiv
DECL REAL mSigQualPeriodOfWeave         = 0.496000
DECL REAL mMaxAmpControl                = 0.025    ;Maximum Control in one RSI Cycle (4ms)
DECL REAL mMaxHeigthCorCyc              = 1.00000
