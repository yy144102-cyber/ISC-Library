;********************************************************
;Kuka.Sim
;********************************************************
DEF ArcKukaSim(tArcFunc:IN, tArcDat:IN, tArcWPDat:IN, tTcDat:IN)
DECL enArcCall_T tArcFunc
DECL stArcDat_T tArcDat, tArcWPDat
DECL stArcTcSet_T tTcDatIn, tTcDat

ArcBasVelCalc(tArcFunc,tArcDat)

SWITCH tArcFunc
  CASE #ArcOnMoveStd, #ArcOnSplSingle
    IF (stArcFeatureState.Act.OnTheFlyOn == TRUE) THEN
      ;Debug KUKA.Sim
      ;;@Print ArcOn - OnTheFly
      ArcKukaSimTrace(TRUE)
      ArcFeatureSelect(#BeforeIgnition,tArcDat,tArcWPDat,tTcDat)
      ArcFeatureSelect(#AfterIgnition,tArcDat,tArcWPDat,tTcDat)
    ENDIF
  CASE #ArcOnAfterMoveStd, #ArcOnAfterSplSingle
    IF (stArcFeatureState.Act.OnTheFlyOn == FALSE) THEN
      WAIT FOR TRUE ;$Advance Stop
      ArcKukaSimArcOnInitVar()
      ;Debug KUKA.Sim
      ;;@Print ArcOn
      stArcCallState.ExecType = #AdvanceStopCall
      ArcFeatureSelect(#BeforeIgnition,tArcDat,tArcWPDat,tTcDat)
      WAIT SEC tArcDat.Strike.PreFlowTime
      WAIT SEC tArcDat.Strike.StartTime
      ArcKukaSimTrace(TRUE)
      ArcFeatureSelect(#AfterIgnition,tArcDat,tArcWPDat,tTcDat)
    ENDIF
  CASE #ArcSwiMoveStd, #ArcSwiSplSingle
    ArcFeatureSelect(#ArcSwiTrigger,tArcDat,tArcWPDat,tTcDat)
  CASE #ArcOffMoveStd, #ArcOffSplSingle
    IF (stArcFeatureState.Act.OnTheFlyOff == TRUE) THEN
      ;Debug KUKA.Sim
      ;;@Print ArcOff - OnTheFly
      ArcFeatureSelect(#BeforeCraterFill,tArcDat,tArcWPDat,tTcDat)
      ArcKukaSimTrace(FALSE)
      ArcFeatureSelect(#AfterCraterFill,tArcDat,tArcWPDat,tTcDat)
    ENDIF
  CASE #ArcOffAfterMoveStd, #ArcOffAfterSplSingle
    IF (stArcFeatureState.Act.OnTheFlyOff == FALSE) THEN
      WAIT FOR TRUE ;$Advance Stop
      ;Debug KUKA.Sim
      ;;@Print ArcOff
      ArcKukaSimArcOffInitVar()
      ArcOffStrategy(#AtArcOff,stArcDatAct)
      stArcCallState.ExecType = #AdvanceStopCall
      ArcFeatureSelect(#BeforeCraterFill,tArcDat,tArcWPDat,tTcDat)
      WAIT SEC tArcDat.Crater.CraterTime
      WAIT SEC tArcDat.Crater.PostFlowTime
      ArcKukaSimTrace(FALSE)
      ArcFeatureSelect(#AfterCraterFill,tArcDat,tArcWPDat,tTcDat)
    ENDIF
  CASE #ArcOffBeforeOffStd2, #ArcOffBefOffSplSingle2
    IF (ArcAtaMoveBackOption(tArcDat.Advanced) == TRUE) THEN
      gMoveBackAtArcOffPos = $POS_ACT
      stMoveBackAtArcOff.PosRecorded = TRUE
      ;stMoveBackAtArcOff.Velocity = stArcActWeldSet.Velocity
      stMoveBackAtArcOff.Velocity = gArcBasVelDefinition
      IF (stMoveBackAtArcOff.Velocity == 0) THEN
        stMoveBackAtArcOff.Velocity = 0.005
      ENDIF
    ENDIF
  ;CASE #ArcOffBeforeOffStd, #ArcOffBeforeOffSplSingle 
    ;ArcFeatureSelect(#BeforeArcOff,tArcDat,tArcWPDat,tTcDat)
    
  CASE #ArcOnMoveSpl
    ArcKukaSimArcOnInitVar()
    enArcMotionBeforeArcOn = enArcMotionInfo[2]
    ;Debug KUKA.Sim
    ;;@Print ArcOn - SplBlock
    ArcKukaSimTrace(TRUE)
    ArcFeatureSelect(#BeforeIgnition,tArcDat,tArcWPDat,tTcDat)
    ArcFeatureSelect(#AfterIgnition,tArcDat,tArcWPDat,tTcDat)
  CASE #ArcSwiMoveSpl
    ArcFeatureSelect(#ArcSwiTrigger,tArcDat,tArcWPDat,tTcDat)
  CASE #ArcOffMoveSpl
    ;Debug KUKA.Sim
    ;;@Print ArcOff - SplBlock
    ArcKukaSimArcOffInitVar()
    ;ArcOffStrategy(#AtArcOff,stArcDatAct) ;Move Backward ist not working in KUKA.Sim
    ArcFeatureSelect(#BeforeCraterFill,tArcDat,tArcWPDat,tTcDat)
    WAIT SEC tArcDat.Crater.CraterTime
    WAIT SEC tArcDat.Crater.PostFlowTime
    ArcKukaSimTrace(FALSE)
    ArcFeatureSelect(#AfterCraterFill,tArcDat,tArcWPDat,tTcDat)
ENDSWITCH
END
;********************************************************
;Trace for Kuka.Sim
;********************************************************
DEF ArcKukaSimTrace(tActive :IN)
DECL BOOL tActive
DECL INT tI
DECL INT tIndex
IF (gArcKukaSimTraceOn == FALSE) THEN
  RETURN
ENDIF

;SIM Default trace configuration
;Actionsignal $OUT[17] -> red
;Actionsignal $OUT[18] -> blue
;Actionsignal $OUT[19] -> green
;Actionsignal $OUT[20] -> white
;Actionsignal $OUT[21] -> black
;Actionsignal $OUT[22] -> grey
;Actionsignal $OUT[23] -> yellow
;Actionsignal $OUT[24] -> brown
;Actionsignal $OUT[25] -> cyan
;Actionsignal $OUT[26] -> purple
;Actionsignal $OUT[27] -> Null
;Actionsignal $OUT[28] -> orange
;Actionsignal $OUT[29] -> pink
;Actionsignal $OUT[30] -> beige
;Actionsignal $OUT[31] -> cream
;Actionsignal $OUT[32] -> khaki

IF ($ACT_TOOL > 0) THEN
  tIndex = $ACT_TOOL + 16
  $OUT[tIndex] = tActive
ELSE
  FOR tI = 17 TO 32
    $OUT[tI] = FALSE
  ENDFOR
ENDIF
END
;********************************************************
;Kuka.Sim Init Variables ArcOn
;********************************************************
DEF ArcKukaSimArcOnInitVar()
  gMoveBackAtArcOffPos              = gArcE6PosNull
  stMoveBackAtArcOff.PosRecorded    = FALSE
  stMoveBackAtArcOff.Done           = FALSE
END
;********************************************************
;Kuka.Sim Init Variables ArcOff
;********************************************************
DEF ArcKukaSimArcOffInitVar()
  ;Slope ist not working in KUKA.Sim
  stArcDatAct.Advanced.SlopeOptionOff         = #None
  stArcDatAct.Advanced.SlopeStartOptionOff    = #None
  stArcDatAct.Advanced.SlopeDistanceOff       = 0
END
;********************************************************
;Arc Scratch Feature
;********************************************************
DEF ArcScratchFeature()

IF (stMoveScratch.Enable == TRUE) THEN
  stArcIgnErrSet.IgnitionReaction = #MoveScratch
ENDIF

IF ((stArcIgnErrSet.IgnitionReaction == #MoveScratch) AND (stMoveScratch.BeforeArcOn == TRUE)) THEN
  gArcColdSeam = TRUE
  enArcErrorState = #DefaultError
  enArcActiveStrategy = #MoveScratch
  ArcWriteDiag(gArcGeneralDebug,"[MAIN] MoveScratch at Beginning")
  ArcErrorOnIgnition(stArcIgnErrSet)
ENDIF
END
