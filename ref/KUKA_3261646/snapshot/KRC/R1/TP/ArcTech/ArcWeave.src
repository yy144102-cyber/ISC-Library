  tArcWeaveSetStandard.FCT.CPS3.X7 = tPattern.CPS3.X7
  tArcWeaveSetSpline.FCT.POLYNOMIAL.CPS3.X7 = tPattern.CPS3.X7
  tArcWeaveSetStandard.FCT.CPS3.Y7 = tPattern.CPS3.Y7
  tArcWeaveSetSpline.FCT.POLYNOMIAL.CPS3.Y7 = tPattern.CPS3.Y7
  tCpNum = tCpNum + 1
ELSE
  tBool = FALSE
ENDIF
IF (ArcVarExistR(tPattern.CPS3.X8) AND (tBool == TRUE)) THEN
  tArcWeaveSetStandard.FCT.CPS3.X8 = tPattern.CPS3.X8
  tArcWeaveSetSpline.FCT.POLYNOMIAL.CPS3.X8 = tPattern.CPS3.X8
  tArcWeaveSetStandard.FCT.CPS3.Y8 = tPattern.CPS3.Y8
  tArcWeaveSetSpline.FCT.POLYNOMIAL.CPS3.Y8 = tPattern.CPS3.Y8
  tCpNum = tCpNum + 1
ELSE
  tBool = FALSE
ENDIF
IF (ArcVarExistR(tPattern.CPS3.X9) AND (tBool == TRUE)) THEN
  tArcWeaveSetStandard.FCT.CPS3.X9 = tPattern.CPS3.X9
  tArcWeaveSetSpline.FCT.POLYNOMIAL.CPS3.X9 = tPattern.CPS3.X9
  tArcWeaveSetStandard.FCT.CPS3.Y9 = tPattern.CPS3.Y9
  tArcWeaveSetSpline.FCT.POLYNOMIAL.CPS3.Y9 = tPattern.CPS3.Y9
  tCpNum = tCpNum + 1
ELSE
  tBool = FALSE
ENDIF
IF (ArcVarExistR(tPattern.CPS3.X10) AND (tBool == TRUE)) THEN
  tArcWeaveSetStandard.FCT.CPS3.X10 = tPattern.CPS3.X10
  tArcWeaveSetSpline.FCT.POLYNOMIAL.CPS3.X10 = tPattern.CPS3.X10
  tArcWeaveSetStandard.FCT.CPS3.Y10 = tPattern.CPS3.Y10
  tArcWeaveSetSpline.FCT.POLYNOMIAL.CPS3.Y10 = tPattern.CPS3.Y10
  tCpNum = tCpNum + 1
ELSE
  tBool = FALSE
ENDIF
IF (tCpNum > 0) THEN
  tArcWeaveSetStandard.FCT.CPNUM = tCpNum                             ;Total number of valid control points with reference to the following 4 control point structures
  tArcWeaveSetStandard.CLASS = #PATH                                  ;The input variable is the arc Length of a spline motion $DISTANCE (unit: mm)
  tArcWeaveSetStandard.FCTCTRL.GEOREF = tPattern.FCTCTRL.GEOREF       ;Reference coordinate system selection (TECHSYS sys)
  tArcWeaveSetStandard.FCT.ORDER = 1                                  ;Weave pattern is defined by a polygon (sufficient in the case of thermal weaving alone)
  tArcWeaveSetSpline.FCT.POLYNOMIAL.CPNUM = tCpNum                    ;Total number of valid control points with reference to the following 4 control point structures
  tArcWeaveSetSpline.FCT.POLYNOMIAL.BOUND_COND = #CYCLIC              ;the function is evaluated cyclically.
  tArcWeaveSetSpline.CLASS = #PATH                                    ;the input variable is the arc Length of a spline motion $DISTANCE (unit: mm)
  tArcWeaveSetSpline.REF_SYS.GEOREF = tPattern.FCTCTRL.GEOREF         ;Reference coordinate system selection (TECHSYS sys)
  tArcWeaveSetSpline.REF_SYS.ANGLES.C = tPattern.ANGLE                ;The orientation of the TCP changes
  IF ((tWeaveSet.Pattern == #Trapecoid) AND ((tWeaveSet.LeftSideDelay > 0) OR (tWeaveSet.RightSideDelay > 0))) THEN
    tArcWeaveSetSpline.FCT.POLYNOMIAL.ORDER = 1                         ;Weave pattern is defined by a polygon (sufficient in the case of thermal weaving alone)
    tArcWeaveSetSpline.FADE_IN = 0.25
    tArcWeaveSetSpline.FADE_OUT = 0.25
  ELSE
    tArcWeaveSetSpline.FCT.POLYNOMIAL.ORDER = 3                         ;Weave pattern is defined by a cubic spline (required in the case of mechanical weaving)
  ENDIF
ELSE
  tArcWeaveSetStandard = mArcInitWeavePtp
  tArcWeaveSetSpline.MODE = #OFF
  tArcWeaveSetSpline.FCTCTRL.SCALE_IN   = mDefault_SPL_SCALE_IN
  tArcWeaveSetSpline.FCTCTRL.SCALE_OUT  = mDefault_SPL_SCALE_OUT
ENDIF
END
;*****************************************************************************************
;[Routine] Set Weave Length and Aplitude
;*****************************************************************************************
GLOBAL DEF ArcWeaveSetLAValue(tWeaveSet :IN)
DECL REAL tLength,tAmplitude
DECL stWeave_T tWeaveSet
IF (gArcIsOnSimEnvironment == FALSE) THEN
  IF (ArcCallFromRoutine() <> 1) THEN ;Must been Call From Robot
    RETURN
  ENDIF
ENDIF
IF (ArcCheckFgCondition() == TRUE) THEN
  tLength    = ArcSetRangeValue(tWeaveSet.Length,cArcWeaveMinLength,cArcWeaveMaxLength)
  tAmplitude = ArcSetRangeValue(tWeaveSet.Amplitude,cArcWeaveMinAmplitude,cArcWeaveMaxAmplitude)
  IF (IsAnySpline()) THEN
    IF (($SPL_TECH[ctArcMechGenerator1].REF_SYS.GEOREF <> #NONE) AND ($SPL_TECH[ctArcMechGenerator1].FCT.POLYNOMIAL.CPNUM > 2)) THEN
      $SPL_TECH[ctArcMechGenerator1].FCTCTRL.SCALE_IN  = tLength
      $SPL_TECH[ctArcMechGenerator1].FCTCTRL.SCALE_OUT = tAmplitude
    ENDIF
    IF (($SPL_TECH[ctArcMechGenerator2].REF_SYS.GEOREF <> #NONE) AND ($SPL_TECH[ctArcMechGenerator2].FCT.POLYNOMIAL.CPNUM > 2)) THEN
      $SPL_TECH[ctArcMechGenerator2].FCTCTRL.SCALE_IN  = tLength
      $SPL_TECH[ctArcMechGenerator2].FCTCTRL.SCALE_OUT = tAmplitude
    ENDIF
    IF (($SPL_TECH[ctArcMechGenerator2].REF_SYS.GEOREF <> #NONE) AND ($SPL_TECH[ctArcMechGenerator2].FCT.POLYNOMIAL.CPNUM > 2)) THEN
      $SPL_TECH[ctArcMechGenerator3].FCTCTRL.SCALE_IN  = tLength
      $SPL_TECH[ctArcMechGenerator3].FCTCTRL.SCALE_OUT = tAmplitude
    ENDIF
  ENDIF
  IF (stArcCallState.MoveType == #Std) THEN
    IF (($TECH[ctArcMechGenerator1].FCTCTRL.GEOREF <> #NONE) AND ($TECH[ctArcMechGenerator1].FCT.CPNUM > 2)) THEN
      $TECH[ctArcMechGenerator1].FCTCTRL.SCALE_IN  = tLength
      $TECH[ctArcMechGenerator1].FCTCTRL.SCALE_OUT = tAmplitude
    ENDIF
    IF (($TECH[ctArcMechGenerator2].FCTCTRL.GEOREF <> #NONE) AND ($TECH[ctArcMechGenerator2].FCT.CPNUM > 2)) THEN
      $TECH[ctArcMechGenerator2].FCTCTRL.SCALE_IN  = tLength
      $TECH[ctArcMechGenerator2].FCTCTRL.SCALE_OUT = tAmplitude
    ENDIF
    IF (($TECH[ctArcMechGenerator3].FCTCTRL.GEOREF <> #NONE) AND ($TECH[ctArcMechGenerator3].FCT.CPNUM > 2)) THEN
      $TECH[ctArcMechGenerator3].FCTCTRL.SCALE_IN  = tLength
      $TECH[ctArcMechGenerator3].FCTCTRL.SCALE_OUT = tAmplitude
    ENDIF  
  ENDIF
ELSE
  $TECH[ctArcMechGenerator1].FCTCTRL.SCALE_IN      = mDefault_SCALE_IN
  $TECH[ctArcMechGenerator1].FCTCTRL.SCALE_OUT     = mDefault_SCALE_OUT
  $TECH[ctArcMechGenerator2].FCTCTRL.SCALE_IN      = mDefault_SCALE_IN
  $TECH[ctArcMechGenerator2].FCTCTRL.SCALE_OUT     = mDefault_SCALE_OUT
  $TECH[ctArcMechGenerator3].FCTCTRL.SCALE_IN      = mDefault_SCALE_IN
  $TECH[ctArcMechGenerator3].FCTCTRL.SCALE_OUT     = mDefault_SCALE_OUT
  $SPL_TECH[ctArcMechGenerator1].FCTCTRL.SCALE_IN  = mDefault_SPL_SCALE_IN
  $SPL_TECH[ctArcMechGenerator1].FCTCTRL.SCALE_OUT = mDefault_SPL_SCALE_OUT
  $SPL_TECH[ctArcMechGenerator2].FCTCTRL.SCALE_IN  = mDefault_SPL_SCALE_IN
  $SPL_TECH[ctArcMechGenerator2].FCTCTRL.SCALE_OUT = mDefault_SPL_SCALE_OUT
  $SPL_TECH[ctArcMechGenerator3].FCTCTRL.SCALE_IN  = mDefault_SPL_SCALE_IN
  $SPL_TECH[ctArcMechGenerator3].FCTCTRL.SCALE_OUT = mDefault_SPL_SCALE_OUT
ENDIF
END
;*****************************************************************************************
;[Routine] Set from TRIGGER Weave Length and Amplitude
;*****************************************************************************************
GLOBAL DEF ArcWeaveSetLAValue_C(tWeaveSet :IN)
DECL REAL tLength,tAmplitude
DECL stWeave_T tWeaveSet
IF (gArcIsOnSimEnvironment == FALSE) THEN
  IF (ArcCallFromRoutine() <> 2) THEN ;Must been Call From Robot Trigger
    RETURN
  ENDIF
ENDIF
IF (ArcCheckFgCondition() == TRUE) THEN
  tLength    = ArcSetRangeValue(tWeaveSet.Length,cArcWeaveMinLength,cArcWeaveMaxLength)
  tAmplitude = ArcSetRangeValue(tWeaveSet.Amplitude,cArcWeaveMinAmplitude,cArcWeaveMaxAmplitude)
  IF (IsAnySpline()) THEN
    IF (($SPL_TECH_C[ctArcMechGenerator1].REF_SYS.GEOREF <> #NONE) AND ($SPL_TECH_C[ctArcMechGenerator1].FCT.POLYNOMIAL.CPNUM > 2)) THEN
      $SPL_TECH_C[ctArcMechGenerator1].FCTCTRL.SCALE_IN  = tLength
      $SPL_TECH_C[ctArcMechGenerator1].FCTCTRL.SCALE_OUT = tAmplitude
    ENDIF
    IF (($SPL_TECH_C[ctArcMechGenerator2].REF_SYS.GEOREF <> #NONE) AND ($SPL_TECH_C[ctArcMechGenerator2].FCT.POLYNOMIAL.CPNUM > 2)) THEN
      $SPL_TECH_C[ctArcMechGenerator2].FCTCTRL.SCALE_IN  = tLength
      $SPL_TECH_C[ctArcMechGenerator2].FCTCTRL.SCALE_OUT = tAmplitude
    ENDIF
    IF (($SPL_TECH_C[ctArcMechGenerator3].REF_SYS.GEOREF <> #NONE) AND ($SPL_TECH_C[ctArcMechGenerator3].FCT.POLYNOMIAL.CPNUM > 2)) THEN
      $SPL_TECH_C[ctArcMechGenerator3].FCTCTRL.SCALE_IN  = tLength
      $SPL_TECH_C[ctArcMechGenerator3].FCTCTRL.SCALE_OUT = tAmplitude
    ENDIF
  ENDIF
  IF (stArcCallState.MoveType == #Std) THEN
    IF (($TECH_C[ctArcMechGenerator1].FCTCTRL.GEOREF <> #NONE) AND ($TECH_C[ctArcMechGenerator1].FCT.CPNUM > 2)) THEN
      $TECH_C[ctArcMechGenerator1].FCTCTRL.SCALE_IN  = tLength
      $TECH_C[ctArcMechGenerator1].FCTCTRL.SCALE_OUT = tAmplitude
    ENDIF
    IF (($TECH_C[ctArcMechGenerator2].FCTCTRL.GEOREF <> #NONE) AND ($TECH_C[ctArcMechGenerator2].FCT.CPNUM > 2)) THEN
      $TECH_C[ctArcMechGenerator2].FCTCTRL.SCALE_IN  = tLength
      $TECH_C[ctArcMechGenerator2].FCTCTRL.SCALE_OUT = tAmplitude
    ENDIF
    IF (($TECH_C[ctArcMechGenerator3].FCTCTRL.GEOREF <> #NONE) AND ($TECH_C[ctArcMechGenerator3].FCT.CPNUM > 2)) THEN
      $TECH_C[ctArcMechGenerator3].FCTCTRL.SCALE_IN  = tLength
      $TECH_C[ctArcMechGenerator3].FCTCTRL.SCALE_OUT = tAmplitude
    ENDIF
  ENDIF
ELSE
  $TECH_C[ctArcMechGenerator1].FCTCTRL.SCALE_IN      = mDefault_C_SCALE_IN
  $TECH_C[ctArcMechGenerator1].FCTCTRL.SCALE_OUT     = mDefault_C_SCALE_OUT
  $TECH_C[ctArcMechGenerator2].FCTCTRL.SCALE_IN      = mDefault_C_SCALE_IN
  $TECH_C[ctArcMechGenerator2].FCTCTRL.SCALE_OUT     = mDefault_C_SCALE_OUT
  $TECH_C[ctArcMechGenerator3].FCTCTRL.SCALE_IN      = mDefault_C_SCALE_IN
  $TECH_C[ctArcMechGenerator3].FCTCTRL.SCALE_OUT     = mDefault_C_SCALE_OUT
  $SPL_TECH_C[ctArcMechGenerator1].FCTCTRL.SCALE_IN  = mDefault_C_SPL_SCALE_IN
  $SPL_TECH_C[ctArcMechGenerator1].FCTCTRL.SCALE_OUT = mDefault_C_SPL_SCALE_OUT
  $SPL_TECH_C[ctArcMechGenerator2].FCTCTRL.SCALE_IN  = mDefault_C_SPL_SCALE_IN
  $SPL_TECH_C[ctArcMechGenerator2].FCTCTRL.SCALE_OUT = mDefault_C_SPL_SCALE_OUT
  $SPL_TECH_C[ctArcMechGenerator3].FCTCTRL.SCALE_IN  = mDefault_C_SPL_SCALE_IN
  $SPL_TECH_C[ctArcMechGenerator3].FCTCTRL.SCALE_OUT = mDefault_C_SPL_SCALE_OUT
ENDIF
END
;*****************************************************************************************
;[Routine] Set from TRIGGER Weave Length and Amplitude
;*****************************************************************************************
GLOBAL DEF ArcWeaveSetValue_C(tArcMechGenerator :IN,tKrlId :IN, tValue :IN)
DECL REAL tLength
DECL REAL tAmplitude
DECL REAL tAngle
DECL REAL tValue
DECL INT tArcMechGenerator
DECL enKrlId_T tKrlId
IF (ArcCheckFgCondition() == TRUE) THEN
  tLength    = ArcSetRangeValue(tValue,cArcWeaveMinLength,cArcWeaveMaxLength)
  tAmplitude = ArcSetRangeValue(tValue,cArcWeaveMinAmplitude,cArcWeaveMaxAmplitude)
  tAngle     = ArcSetRangeValue(tValue,cArcWeaveMinAngle,cArcWeaveMaxAngle)
  IF (IsAnySpline()) THEN
    IF (($SPL_TECH_C[tArcMechGenerator].REF_SYS.GEOREF <> #NONE) AND ($SPL_TECH_C[tArcMechGenerator].FCT.POLYNOMIAL.CPNUM > 2)) THEN
      SWITCH tKrlId
        CASE #Length
          $SPL_TECH_C[tArcMechGenerator].FCTCTRL.SCALE_IN  = tLength
        CASE #Amplitude
          $SPL_TECH_C[tArcMechGenerator].FCTCTRL.SCALE_OUT = tAmplitude
        CASE #Angle
          $SPL_TECH_C[tArcMechGenerator].REF_SYS.ANGLES.C = tAngle
      ENDSWITCH
    ENDIF
  ENDIF
  IF (stArcCallState.MoveType == #Std) THEN
    IF (($TECH_C[tArcMechGenerator].FCTCTRL.GEOREF <> #NONE) AND ($TECH_C[tArcMechGenerator].FCT.CPNUM > 2)) THEN
      SWITCH tKrlId
        CASE #Length
          $TECH_C[tArcMechGenerator].FCTCTRL.SCALE_IN  = tLength
       CASE #Amplitude
         $TECH_C[tArcMechGenerator].FCTCTRL.SCALE_OUT = tAmplitude
       CASE #Angle
         $TECHANGLE_C.C = tAngle
       ENDSWITCH
    ENDIF
  ENDIF
ENDIF
END
;*****************************************************************************************
;[Routine] Set Off Tech
;*****************************************************************************************
DEF ArcWeaveSetTechOff(tArcWeaveSetStandard :OUT)
DECL TECH tArcWeaveSetStandard
tArcWeaveSetStandard.MODE              = #OFF
tArcWeaveSetStandard.FCTCTRL.SCALE_IN  = mDefault_SCALE_IN
tArcWeaveSetStandard.FCTCTRL.SCALE_OUT = mDefault_SCALE_OUT
END
;*****************************************************************************************
;[Routine] Set Off Spline Tech
;*****************************************************************************************
DEF ArcWeaveSetTechSplOff(tArcWeaveSetSpline :OUT)
DECL SPL_TECH tArcWeaveSetSpline
tArcWeaveSetSpline.MODE              = #OFF
tArcWeaveSetSpline.FCTCTRL.SCALE_IN  = mDefault_SPL_SCALE_IN
tArcWeaveSetSpline.FCTCTRL.SCALE_OUT = mDefault_SPL_SCALE_OUT
END
;*****************************************************************************************
;Weave Delay On
;*****************************************************************************************
GLOBAL DEF ArcWeaveDelayActive(tWeavePattern:IN)
DECL BOOL tBool
DECL REAL tAmplitude
DECL stWeavePattern_T tWeavePattern
ON_ERROR_PROCEED
tWeavePattern.Tech1 = tWeavePattern.Tech1
IF ($ERR.NUMBER > 0) THEN
  ERR_CLEAR($ERR)
  RETURN
ENDIF
tBool = FALSE
IF ((tWeavePattern.Tech1.LDelay.Active == TRUE) OR (tWeavePattern.Tech1.RDelay.Active == TRUE)) THEN
  tAmplitude = tWeavePattern.Tech1.FCTCTRL.SCALE_OUT
  tBool = TRUE
ENDIF  
IF ((tWeavePattern.Tech2.LDelay.Active == TRUE) OR (tWeavePattern.Tech2.RDelay.Active == TRUE)) THEN
  tAmplitude = tWeavePattern.Tech2.FCTCTRL.SCALE_OUT
  tBool = TRUE
ENDIF  
IF ((tWeavePattern.Tech3.LDelay.Active == TRUE) OR (tWeavePattern.Tech3.RDelay.Active == TRUE)) THEN
  tAmplitude = tWeavePattern.Tech3.FCTCTRL.SCALE_OUT
  tBool = TRUE
ENDIF  
IF (tBool == FALSE) THEN
  IF (gArcWeaveFGDelayActive == TRUE) THEN
    INTERRUPT OFF irtArcWeaveDelay
  ENDIF
  gArcWeaveFGDelayActive = FALSE
  mWeavePattern = mArcWeavePatternInit
  ;ArcWriteDiag("[WEAVE] ArcWeaveDelayActive Deactive")
  RETURN
ENDIF
mWeavePattern            = tWeavePattern
gArcThresholdPosWeaveDly = tAmplitude * ABS(gArcTechValThreshold)
gArcThresholdNegWeaveDly = (-gArcThresholdPosWeaveDly)
IF (gArcWeaveFGDelayActive == TRUE) THEN
  RETURN
ENDIF
gArcWeaveFGDelayActive   = TRUE
$CYCFLAG[cfArcWeaveEdgeCfNr] = ((gArcWeaveFGDelayActive == TRUE) AND (gArcThresholdNegWeaveDly > $TECHVAL[ctArcMechGenerator1]) OR ($TECHVAL[ctArcMechGenerator1] > gArcThresholdPosWeaveDly) OR (gArcThresholdNegWeaveDly > $TECHVAL[ctArcMechGenerator2]) OR ($TECHVAL[ctArcMechGenerator2] > gArcThresholdPosWeaveDly) OR (gArcThresholdNegWeaveDly > $TECHVAL[ctArcMechGenerator3]) OR ($TECHVAL[ctArcMechGenerator3] > gArcThresholdPosWeaveDly))
GLOBAL INTERRUPT DECL irtArcWeaveDelay WHEN $CYCFLAG[cfArcWeaveEdgeCfNr]  DO ArcWaitDelay()
INTERRUPT ON irtArcWeaveDelay
;ArcWriteDiag("[WEAVE] ArcWeaveDelayActive Active")
END
;*****************************************************************************************
;Weave Delay Wait
;*****************************************************************************************
DEF ArcWaitDelay()
INTERRUPT OFF irtArcWeaveDelay
IF (ArcWeaveDelay(ctArcMechGenerator1,mWeavePattern.Tech1) == FALSE) THEN
  IF (ArcWeaveDelay(ctArcMechGenerator1,mWeavePattern.Tech2) == FALSE) THEN
    IF (ArcWeaveDelay(ctArcMechGenerator1,mWeavePattern.Tech3) == FALSE) THEN
    ENDIF
  ENDIF
ENDIF
INTERRUPT ON irtArcWeaveDelay
END
;*****************************************************************************************
;Weave Delay
;*****************************************************************************************
DEFFCT BOOL ArcWeaveDelay(tNum :IN, tPattern: OUT)
DECL INT tNum
DECL INT tMemTime
DECL REAL tWaitTime
DECL REAL tArcActOvAppl
DECL stPattern_T tPattern
tWaitTime = 0.0
IF ($TECH_C[tNum].FCTCTRL.GEOREF <> #NONE) OR ($SPL_TECH_C[tNum].REF_SYS.GEOREF <> #NONE)THEN
  IF ($TECHVAL[tNum] > gArcTechValThreshold) THEN
    IF (tPattern.LDelay.Active == TRUE) THEN
      tWaitTime = tPattern.LDelay.TimeDelay
    ENDIF    
  ENDIF
  IF ($TECHVAL[tNum] < (gArcTechValThreshold*(-1))) THEN
    IF (tPattern.RDelay.Active == TRUE) THEN
      tWaitTime = tPattern.RDelay.TimeDelay
    ENDIF
  ENDIF
ENDIF
IF (tWaitTime > 0.0) THEN
  tArcActOvAppl = $OV_APPL
  $OV_APPL = 0
  ;WAIT FOR TIMER_LIMIT(tWaitTime) Problem with nesting when error
  tMemTime = ArcCalcTimeoutSec(tWaitTime)
  REPEAT
  UNTIL ($ROB_TIMER > tMemTime)
  IF (tArcActOvAppl > 0) THEN
    $OV_APPL = tArcActOvAppl
  ELSE
    $OV_APPL = cOvApplDefault
  ENDIF
  RETURN TRUE
ENDIF
RETURN FALSE
ENDFCT
;*****************************************************************************************
;[Routine] check ArcTechGeoRef Active
;*****************************************************************************************
DEFFCT BOOL ArcTechGeoRefActive(tTechGeoRef :OUT)
DECL TECHGEOREF tTechGeoRef
ON_ERROR_PROCEED
tTechGeoRef = tTechGeoRef
IF ($ERR.NUMBER > 0) THEN
  ERR_CLEAR($ERR)
  RETURN FALSE
ENDIF
IF (tTechGeoRef == #NONE) THEN
  RETURN FALSE
ENDIF
RETURN TRUE
ENDFCT
;*****************************************************************************************
;[Routine] Check Delay Value
;*****************************************************************************************
DEFFCT stPattern_T ArcCheckDelayValue(tPattern :OUT,tLTimeDelay :IN,tRTimeDelay :IN)
DECL REAL tLTimeDelay,tRTimeDelay
DECL stPattern_T tPattern
ON_ERROR_PROCEED
tPattern.LDelay.Active = tPattern.LDelay.Active
IF ($ERR.NUMBER == 0) THEN
  IF (tLTimeDelay > 0.0) THEN
    tPattern.LDelay.TimeDelay = tLTimeDelay
  ELSE
    tPattern.LDelay = {Active FALSE,TimeDelay 0.0}
  ENDIF
ELSE
  ERR_CLEAR($ERR)
  tPattern.LDelay = {Active FALSE,TimeDelay 0.0}
ENDIF
ON_ERROR_PROCEED
tPattern.RDelay.Active = tPattern.RDelay.Active
IF ($ERR.NUMBER == 0) THEN
  IF (tRTimeDelay > 0.0) THEN
    tPattern.RDelay.TimeDelay = tRTimeDelay
  ELSE
    tPattern.RDelay = {Active FALSE,TimeDelay 0.0}
  ENDIF
ELSE
  ERR_CLEAR($ERR)
  tPattern.RDelay = {Active FALSE,TimeDelay 0.0}
ENDIF
ON_ERROR_PROCEED
tPattern.FCTCTRL.GEOREF = tPattern.FCTCTRL.GEOREF
IF ($ERR.NUMBER == 0) THEN
  IF (tPattern.FCTCTRL.GEOREF == #NONE) THEN
    tPattern.LDelay = {Active FALSE,TimeDelay 0.0}
    tPattern.RDelay = {Active FALSE,TimeDelay 0.0}
  ENDIF
ELSE
  ERR_CLEAR($ERR)
  tPattern.LDelay = {Active FALSE,TimeDelay 0.0}
  tPattern.RDelay = {Active FALSE,TimeDelay 0.0}
ENDIF
RETURN tPattern
ENDFCT
;*****************************************************************************************
;[Routine] Check if Weave Pattern Valid Switch ON
;*****************************************************************************************
DEFFCT BOOL ArcCheckFgCondition()
DECL BOOL tActive
tActive = TRUE
IF (stArcFeatureState.Act.Weave == FALSE) THEN 
   tActive = FALSE
ENDIF
RETURN tActive
ENDFCT
