  tArcWeaveSetStandard.FCT.CPS3.X6 = tPattern.CPS3.X6
  tArcWeaveSetSpline.FCT.POLYNOMIAL.CPS3.X6 = tPattern.CPS3.X6
  tArcWeaveSetStandard.FCT.CPS3.Y6 = tPattern.CPS3.Y6
  tArcWeaveSetSpline.FCT.POLYNOMIAL.CPS3.Y6 = tPattern.CPS3.Y6
