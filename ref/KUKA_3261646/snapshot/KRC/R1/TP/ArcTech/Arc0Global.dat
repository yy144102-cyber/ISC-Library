;*****************************************************************************************
DECL GLOBAL CHAR gArcGlobalPath[128] ;Path for Recovery User program
gArcGlobalPath[]="KRC:\R1\TP\ArcTech\ArcUser\UserArcGlobalWDats.dat" ;DEFAULT  - "KRC:\R1\TP\ArcTech\ArcUser\UserArcGlobalWDats.dat"
;*****************************************************************************************
;Arc Tech Error Recovery Variables (from ArcCustom)
;*****************************************************************************************
DECL GLOBAL CHAR ATAg_ER_Path[128] ;Path for Recovery User program
ATAg_ER_Path[]="KRC:\R1\Program\ArcTechErrorRecovery" ;DEFAULT  - "KRC:\R1\Program\ArcTeErrorRecovery"
DECL GLOBAL CHAR ATAg_ER_TemplatePath[128] ;Path for Recovery Template
ATAg_ER_TemplatePath[]="KRC:\R1\Program\ArcTechErrorRecovery\Template" ;DEFAULT  - "KRC:\R1\Program\ArcTechErrorRecovery\Template"
DECL GLOBAL CHAR ATAg_ER_ServicePosPath[128] ;Path for ServicePosition
ATAg_ER_ServicePosPath[]="KRC:\R1\Program\ArcTechErrorRecovery\ServicePosition" ;DEFAULT  - "KRC:\R1\Program\ArcTechErrorRecovery\ServicePosition" 
DECL GLOBAL CHAR ATAg_ER_ServPosPrgName[24] ; Name of the Service Position Module
ATAg_ER_ServPosPrgName[]="ServicePosition" ;DEFAULT  - "ServicePosition"
;*****************************************************************************************
;Arc Trace Recording (Starts at ArcOn - Ends at ArcOff) (from ArcCustom)
;*****************************************************************************************
DECL GLOBAL BOOL gArcTraceOn=FALSE ;enables/disables trace function
DECL GLOBAL CHAR gArcTraceName[24]
gArcTraceName[]="Arc" ;Trace Name = Arc + SeamName
DECL GLOBAL CHAR gArcTraceDef[64]
gArcTraceDef[]="Tracedef_KRC_IpoActualValues.xml" ;Used TraceDef
DECL GLOBAL BOOL gArcKukaSimTraceOn=TRUE ;enables/disables trace function for KUKA.Sim
;*****************************************************************************************
;ArcTechAdvanced adjustments (from ArcCustom)
;*****************************************************************************************
;*****************************************************************************************
;ArcSense (Tracking) (from ArcCustom)
;*****************************************************************************************
DECL GLOBAL BOOL gArsSideControlOn=TRUE ;enables/disables ArcSense Side Control
DECL GLOBAL BOOL gArsHeightControlOn=TRUE ;enables/disables ArcSense Height Control
DECL GLOBAL BOOL gArsSwiDontChangeParam=FALSE ;If true there is no new signal referencing at arc swi when paramter changed
DECL GLOBAL INT gArsSigQualSensitivity=2 ;For Signal Detection Sensitivity (0 = OFF, 1 = Default, 2 = Lower sensitivity 3 = Lowest sensitivity)
DECL GLOBAL INT gArsPeriodsCorrSlow=10 ;Periods slower correction after BiasChanged or when find seam middle is active
DECL GLOBAL REAL gArsSoftStartCtn=0.100000 ;ArcSense SoftStartCounter at Begin max = 1
DECL GLOBAL REAL gArsMaxCorrWeaveSide=1.00000 ;Maximum Correction Side for one Weave Cycle in mm
DECL GLOBAL REAL gArsMaxCorrWeaveHeight=1.00000 ;Maximum Correction Height for one Weave Cycle in mm
DECL GLOBAL REAL gArsControlSelection=0.0 ;Selection of control algroythm
DECL GLOBAL REAL gArsMinInputValue=0.01000000 ;Minimum Input Value
DECL GLOBAL INT gArsAmpMaxOutIdx=0 ;Amplitude max reached toggle bit Output Index
DECL GLOBAL INT gArsMinRefCycleOn=5 ;Minimum reference cycles at ArcOn (2 - 10)
DECL GLOBAL INT gArsMinRefCycleSwi=3 ;Minimum reference cycles at ArcSwi (2 - 10)
DECL GLOBAL INT gArsNrCycRefMidVal=4 ;Number of cycles for middle value calculation when new reference (0 - 10) 0 = OFF
DECL GLOBAL INT gArsMidValRefPercent=100 ;Correction in percent for middle value when new referecne (0 - 100)
;*****************************************************************************************
;Arc Adaptive Welding (from ArcCustom)
;*****************************************************************************************
DECL GLOBAL INT gArcAwFuncEnable='B0111' ;Adaptive Welding Function  'B0001' = Active Strike ,'B0010' = Active Welding,'B0100' = Active Crater,'B0111' = Active Strike,Welding,Crater
DECL GLOBAL INT gAawDiagEnable='B0111' ;Adaptive Welding Diagnostic 'B0001' = Active Strike ,'B0010' = Active Welding,'B0100' = Active Crater,'B0111' = Active Strike,Welding,Crater,'B1111' = Active ALL
DECL GLOBAL enAawFilterType_T gAawFilterType=#Disabled ;#Disabled = Filter Disable #AverageSource = Average Source Value (Return Average Source value)  #CutSourcePeak = Cut Peak Source (Return same Value)
DECL GLOBAL INT gAawPerCentFilter=100 ;Adaptive Welding Filter input source value Value(0 - 100)
DECL GLOBAL BOOL gAawConstFrequency=TRUE ;Adaptive Welding Constant Frequency Velocity ... Length
DECL GLOBAL INT gAawAnalogFactor=10 ;Multiplication factor for analog input ($ANIN[X] * gAawAnalogFactor)

;*****************************************************************************************
;DECL STRUC
;*****************************************************************************************
GLOBAL STRUC stPowerSource_T INT Mode,REAL Channel1,Channel2,Channel3,Channel4,Channel5,Channel6,Channel7,Channel8

;*****************************************************************************************
;PowerSources Fronius
;*****************************************************************************************
;TPS
;Mode 0 = Program standard
;Mode 1 = Pulsed arc program
;Mode 2 = Job mode
;Mode 3 = Parameter selection internally
;Mode 4 = Manual
;Mode 5 = CC/CV
;TPSI/TWIN
;Mode 0 = Internal parameter selection
;Mode 1 = Special 2-step mode characteristics
;Mode 2 = Job mode
;Mode 3 = 2-step mode characteristics
DECL GLOBAL stPowerSource_T stArcInitFroniusTps={Mode 3,Channel1 1.00000,Channel2 0.0,Channel3 0.0,Channel4 0.0,Channel5 0.0,Channel6 0.0,Channel7 0.0,Channel8 0.0}
DECL GLOBAL stPowerSource_T stArcInitFroniusTpsI={Mode 0,Channel1 1.00000,Channel2 0.0,Channel3 0.0,Channel4 0.0,Channel5 0.0,Channel6 0.0,Channel7 0.0,Channel8 0.0}
DECL GLOBAL stPowerSource_T stArcInitFroniusTwin={Mode 0,Channel1 1.00000,Channel2 0.0,Channel3 0.0,Channel4 0.0,Channel5 0.0,Channel6 0.0,Channel7 0.0,Channel8 0.0}
;*****************************************************************************************
;PowerSources EWM
;*****************************************************************************************
DECL GLOBAL stPowerSource_T stArcInitEwm={Mode 1,Channel1 1.00000,Channel2 0.0,Channel3 0.0,Channel4 0.0,Channel5 0.0,Channel6 0.0,Channel7 0.0,Channel8 0.0}
;*****************************************************************************************
;PowerSources Kemppi
;*****************************************************************************************
DECL GLOBAL stPowerSource_T stArcInitKemppi={Mode 1,Channel1 0.0,Channel2 0.0,Channel3 0.0,Channel4 0.0,Channel5 0.0,Channel6 0.0,Channel7 0.0,Channel8 0.0}
;*****************************************************************************************
;PowerSources Lorch
;*****************************************************************************************
DECL GLOBAL stPowerSource_T stArcInitLorch={Mode 7,Channel1 1.00000,Channel2 0.0,Channel3 0.0,Channel4 0.0,Channel5 0.0,Channel6 0.0,Channel7 0.0,Channel8 0.0}
;*****************************************************************************************
;PowerSources ArcLinkXT
;*****************************************************************************************
DECL GLOBAL stPowerSource_T stArcInitArcLinkXT={Mode 0,Channel1 0.0,Channel2 0.0,Channel3 0.0,Channel4 0.0,Channel5 0.0,Channel6 0.0,Channel7 0.0,Channel8 0.0}
;*****************************************************************************************
;PowerSources Standard
;*****************************************************************************************
DECL GLOBAL stPowerSource_T stArcInitStandard={Mode 0,Channel1 0.0,Channel2 0.0,Channel3 0.0,Channel4 0.0,Channel5 0.0,Channel6 0.0,Channel7 0.0,Channel8 0.0}
