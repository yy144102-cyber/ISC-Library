;******************************************************************************
;[Message Routine] Routine Message Options
;******************************************************************************
DEFFCT KrlMsgOpt_T ArcMsgWriteOp(tMsgOption[] :IN)
DECL CHAR tMsgOption[]
DECL KrlMsgOpt_T KrlMsgOpt
KrlMsgOpt={VL_STOP FALSE,CLEAR_P_RESET FALSE,CLEAR_P_SAW FALSE,LOG_TO_DB FALSE}
IF ArcChkString(tMsgOption[],4) THEN
  IF (tMsgOption[1]=="1") THEN
    KrlMsgOpt.VL_STOP=TRUE
  ENDIF
  IF (tMsgOption[2]=="1") THEN
    KrlMsgOpt.CLEAR_P_RESET=TRUE
  ENDIF
  IF (tMsgOption[3]=="1") THEN
    KrlMsgOpt.CLEAR_P_SAW=TRUE
  ENDIF
  IF (tMsgOption[4]=="1") THEN
    KrlMsgOpt.LOG_TO_DB=TRUE
  ENDIF
ENDIF
RETURN KrlMsgOpt
ENDFCT
;******************************************************************************
;[Message Routine] Routine on Dialog Set Dialog Answer
;******************************************************************************
GLOBAL DEFFCT INT ArcGetDialogNrSK()
RETURN mNumberOfDlgSK
ENDFCT
;******************************************************************************
;[Message Routine] Routine on Dialog Set Dialog Answer
;******************************************************************************
GLOBAL DEF ArcSetMsgDialogAnswer(tSKNr :IN)
DECL INT tSKNr
IF (ArcCheckRangeValue(tSKNr,1,7) == 1) THEN
   mArcMsgInputDialogAnswer = tSKNr
ENDIF
END
;******************************************************************************
;[Message Routine] Routine Wait for Dialogue return Answer
;******************************************************************************
DEFFCT INT ArcMsgDialogHandle(tHandle :IN)
DECL BOOL tRemoteEna,tBool,tInt
DECL INT tHandle,tAnswer,tMsgNumber,tI
WHILE (EXISTS_KRLDLG(tHandle,tAnswer))
  WAIT SEC 0.5
ENDWHILE
IF ((tAnswer == 0) AND (gArcRemoteDialogAnswer == 0) AND (mArcMsgInputDialogAnswer == 0)) THEN
  WAIT FOR FALSE
ENDIF
IF ((tAnswer == 0) AND (gArcRemoteDialogAnswer == 0)) THEN
  tAnswer = mArcMsgInputDialogAnswer
ENDIF
mArcMsgInputDialogAnswer = 0
mNumberOfDlgSK = 0
RETURN tAnswer
ENDFCT
;******************************************************************************
;[Message Routine] Routine check if return Handle exist
;******************************************************************************
DEFFCT INT ArcCheckMsgHandle(tHandle :OUT,Handle :IN)
DECL BOOL tRemoteEna,tBool
DECL INT tI,tHandle,Handle,tMsgNumber
ERR_CLEAR($ERR)
ON_ERROR_PROCEED
tHandle = tHandle
tBool =($ERR.NUMBER == 0)
ERR_CLEAR($ERR)
IF (tBool == TRUE) THEN
  RETURN Handle
ELSE
  WHILE (Exists_KrlMsg(Handle) == TRUE)
    WAIT SEC 0.1
  ENDWHILE
  RETURN -1
ENDIF
ENDFCT
;******************************************************************************
;[Message Routine] Routine check init Handle
;******************************************************************************
DEFFCT BOOL ArcCheckInitHandle(tHandle :OUT)
DECL BOOL tInt
DECL INT tHandle
ERR_CLEAR($ERR)
ON_ERROR_PROCEED
tHandle = tHandle
tInt =($ERR.NUMBER == 0)
ERR_CLEAR($ERR)
IF (tInt == TRUE) THEN
  RETURN (tHandle <= 0)
ELSE
  RETURN TRUE
ENDIF
ENDFCT
;******************************************************************************
;[Message Routine] Convert Enum ArcUser to EKRLMSGTYPE
;******************************************************************************
DEFFCT EKRLMSGTYPE ArcGetMsgType(tMsgType :IN)
DECL enArcMessageType_T tMsgType
SWITCH tMsgType
  CASE #NOTIFY
    RETURN #NOTIFY
  CASE #STATE
    RETURN #STATE
  CASE #QUIT
    RETURN #QUIT
  CASE #WAITING
    RETURN #WAITING
  DEFAULT
    RETURN #NOTIFY
ENDSWITCH
ENDFCT
;******************************************************************************
;[Message Routine] Routine check Len String
;******************************************************************************
DEFFCT BOOL ArcChkString(tStr[] :IN, tMaxLen :IN)
DECL CHAR tStr[]
DECL INT MsgLen, tMaxLen
MsgLen = STRLEN(tStr[])
IF (MsgLen > tMaxLen) THEN
  RETURN FALSE
ELSE
  RETURN TRUE
ENDIF
ENDFCT
;******************************************************************************
;Routine Message
;STRUC KRLMSG_T CHAR MODUL[24],  INT NR,  CHAR MSG_TXT[80]
;******************************************************************************
DEFFCT KRLMSG_T ArcChkKRLMSG_T(tMsgModul[] :OUT, tMsgNr :OUT, tMsgText[] :OUT)
DECL INT tMsgNr
DECL CHAR tMsgModul[],tMsgText[]
DECL KRLMSG_T returnKRLMSG_T
returnKRLMSG_T={MODUL[] " ",NR 1, MSG_TXT[] " "}
IF (StrLen(tMsgText[]) < 1) THEN
  tMsgText[] ="Message text empty"
ENDIF
IF (StrLen(tMsgModul[]) <= 1) THEN
  tMsgModul[] = "*"
ENDIF
ERR_CLEAR($ERR)
ON_ERROR_PROCEED
tMsgNr = tMsgNr
IF ($ERR.NUMBER > 0) THEN
  tMsgNr = 1
ENDIF
ERR_CLEAR($ERR)
IF (tMsgNr <= 0) THEN
  tMsgNr = 1
ENDIF
IF (StrLen(tMsgModul[]) <= 24) THEN
  IF (StrLen(tMsgText[]) <= 80) THEN
    returnKRLMSG_T.MODUL[]=tMsgModul[]
    returnKRLMSG_T.MSG_TXT[]=tMsgText[]
    returnKRLMSG_T.NR=tMsgNr
    RETURN returnKRLMSG_T
  ELSE
    ;ArcMsg("Diag Error on value KRLMSG_T.MSG_TXT[]")
  ENDIF
ELSE
  ;ArcMsg("Diag Error on value KRLMSG_T.MODUL[]")
ENDIF
RETURN returnKRLMSG_T
ENDFCT
;******************************************************************************
;Routine Parameter
;ENUM KRLMSGPARTYPE_T  VALUE, KEY, EMPTY
;STRUC KRLMSGPAR_T KRLMSGPARTYPE_T PAR_TYPE,  CHAR PAR_TXT[26],  INT PAR_INT,  REAL PAR_REAL,  BOOL PAR_BOOL
;******************************************************************************
DEFFCT KRLMSGPAR_T ArcChkKRLMSGPAR_T(bMsgPara :OUT,iMsgPara :OUT,rMsgPara :OUT,sMsgPara[] :OUT)
DECL BOOL tB
DECL BOOL bMsgPara
DECL INT  iMsgPara
DECL REAL rMsgPara
DECL CHAR sMsgPara[]
DECL KRLMSGPAR_T returnKRLMSGPAR_T
returnKRLMSGPAR_T.PAR_TYPE = #EMPTY
ON_ERROR_PROCEED
bMsgPara = bMsgPara
IF ($ERR.NUMBER == 0) THEN
  returnKRLMSGPAR_T.PAR_TYPE = #VALUE
  returnKRLMSGPAR_T.PAR_BOOL = bMsgPara
  RETURN returnKRLMSGPAR_T
ENDIF
ERR_CLEAR($ERR)
ON_ERROR_PROCEED
iMsgPara = iMsgPara
IF ($ERR.NUMBER == 0) THEN
  returnKRLMSGPAR_T.PAR_TYPE = #VALUE
  returnKRLMSGPAR_T.PAR_INT = iMsgPara
  RETURN returnKRLMSGPAR_T
ENDIF
ERR_CLEAR($ERR)
ON_ERROR_PROCEED
rMsgPara = rMsgPara
IF ($ERR.NUMBER == 0) THEN
  returnKRLMSGPAR_T.PAR_TYPE = #VALUE
  returnKRLMSGPAR_T.PAR_REAL = rMsgPara
  RETURN returnKRLMSGPAR_T
ENDIF
ERR_CLEAR($ERR)
IF (StrLen(sMsgPara[]) >= 1) THEN
  returnKRLMSGPAR_T.PAR_TYPE = #VALUE
  IF (StrLen(sMsgPara[]) <= 26) THEN
    IF (sMsgPara[1] == "#") THEN      
      tB = STRCOPY(sMsgPara[],ArcStrRemoveLeft(sMsgPara[],"#")) 
      returnKRLMSGPAR_T.PAR_TYPE = #KEY   
    ENDIF
    returnKRLMSGPAR_T.PAR_TXT[] = sMsgPara[]
  ELSE
    returnKRLMSGPAR_T.PAR_TXT[] = "*Wrong Parameter>26Char*"
  ENDIF
  RETURN returnKRLMSGPAR_T  
ENDIF
returnKRLMSGPAR_T.PAR_TYPE = #VALUE
returnKRLMSGPAR_T.PAR_TXT[] = " "
RETURN returnKRLMSGPAR_T
ENDFCT
;******************************************************************************
;Routine HMI Dialogue
;STRUC KRLMSGDLGSK_T KRLMSGPARTYPE_T SK_TYPE,  CHAR SK_TXT[10]
;******************************************************************************
DEFFCT KrlMsgDlgSK_T ArcMakeDialogSK(SK[] :OUT)
DECL CHAR SK[]
DECL KrlMsgDlgSK_T tKrlMsgDlgSK_T
tKrlMsgDlgSK_T.SK_TYPE = #KEY
IF (StrLen(SK[]) > 0 ) THEN 
  IF (StrLen(SK[]) <= 10 ) THEN
    tKrlMsgDlgSK_T.SK_TXT[] = SK[]
  ELSE
    tKrlMsgDlgSK_T.SK_TXT[] = "Char>10"
  ENDIF
ELSE
  tKrlMsgDlgSK_T.SK_TXT[] = " "
ENDIF
RETURN tKrlMsgDlgSK_T
ENDFCT
;******************************************************************************
;[Message Routine] Number of Sk on Dialog
;******************************************************************************
DEFFCT INT ArcNuberOffDlgSk(tKrlMsgDlgSK_T[] :OUT)
DECL INT tI,NrSk
DECL KrlMsgDlgSK_T tKrlMsgDlgSK_T[]
NrSk = 0
FOR tI = 1 TO 7
  IF (STRCOMP(tKrlMsgDlgSK_T[tI].SK_TXT[]," ",#Not_CASE_Sens) == FALSE) THEN
    IF (STRLEN(tKrlMsgDlgSK_T[tI].SK_TXT[])>=1) THEN
      NrSk = NrSk +1
    ENDIF
  ENDIF
ENDFOR
RETURN NrSk
ENDFCT
;******************************************************************************
;[Global Message Routine] Clear specific KRL message from Handle
;******************************************************************************
GLOBAL DEF ArcMsgWriteClearHandle(NrHandle :OUT)
DECL INT NrHandle
DECL BOOL ClearMsg
ON_ERROR_PROCEED
NrHandle = NrHandle
IF ($ERR.NUMBER > 0) THEN
  NrHandle = 0
  ERR_CLEAR($ERR)
  RETURN
ENDIF
IF (NrHandle > 0) THEN
  IF EXISTS_KRLMSG(NrHandle) THEN
    ClearMsg = CLEAR_KRLMSG(NrHandle)
  ENDIF
  NrHandle=0
ENDIF
END
;******************************************************************************
;[Global Message Routine] Clear specific KRL message from Message number #QUIT
;******************************************************************************
GLOBAL DEF ArcMsgWriteClearNumber(MsgNumber :IN)
DECL BOOL tBool
DECL INT tI,tNumMessage,MsgNumber
DECL MSGBUF_T tArcMsgBuffer[100]
tNumMessage = GET_MSGBUFFER (tArcMsgBuffer[])
FOR tI = 1 TO tNumMessage
  SWITCH tArcMsgBuffer[tI].TYPE
    CASE #USR_QUIT
      IF (MsgNumber == tArcMsgBuffer[tI].NR) THEN
        tBool = CLEAR_KRLMSG(tArcMsgBuffer[tI].HANDLE)
        EXIT
      ENDIF
  ENDSWITCH
ENDFOR
END
;******************************************************************************
;[Global Message Routine] Clear specific KRL message from Message number #QUIT
;******************************************************************************
GLOBAL DEF ArcMsgWriteAnswerNumber(MsgNumber :IN)
DECL BOOL tBool
DECL INT tI,tNumMessage,MsgNumber
DECL MSGBUF_T tArcMsgBuffer[100]
IF ABS(MsgNumber) > 0 THEN
  tNumMessage = GET_MSGBUFFER (tArcMsgBuffer[])
  FOR tI = 1 TO tNumMessage
    SWITCH tArcMsgBuffer[tI].TYPE
      CASE #USR_DLG
        IF (MsgNumber == tArcMsgBuffer[tI].NR) THEN
          tBool = CLEAR_KRLMSG(tArcMsgBuffer[tI].HANDLE)
          EXIT
        ENDIF
    ENDSWITCH
  ENDFOR
ENDIF
END
;******************************************************************************
;[Global Message Routine] Clear specific one KRL message
;******************************************************************************
GLOBAL DEFFCT BOOL ArcMsgWriteExist(MsgNr :OUT)
DECL INT MsgNr
IF (ArcVarExistI(MsgNr) == TRUE) THEN
  IF (EXISTS_KRLMSG(MsgNr) == TRUE) THEN
    RETURN TRUE
  ELSE
    MsgNr=0
    RETURN FALSE
  ENDIF
ENDIF
RETURN FALSE
ENDFCT
;******************************************************************************
;[Message Routine] Routine Wait for Message absent
;******************************************************************************
GLOBAL DEF ArcMsgWaitForAbsent(tHandle :IN)
DECL INT tHandle
IF (EXISTS_KRLMSG(tHandle) == TRUE) THEN
  WHILE (EXISTS_KRLMSG(tHandle) == TRUE)
    WAIT SEC 0.1
  ENDWHILE
ENDIF
END
;******************************************************************************
;[Dialog Routine] Get Dialog Present
;******************************************************************************
GLOBAL DEFFCT BOOL ArcMsgWriteDialogPresent(tHandle :IN)
DECL INT tHandle,iAnswer
RETURN EXISTS_KRLDLG(tHandle,iAnswer)
ENDFCT 
;******************************************************************************
;[Dialog Routine] Get Dialog Answer
;******************************************************************************
GLOBAL DEFFCT INT ArcMsgWriteDialogAnswer(tHandle :IN)
DECL INT tHandle,iAnswer
iAnswer = 0
IF EXISTS_KRLDLG(tHandle,iAnswer) == FALSE THEN
  RETURN iAnswer
ENDIF
RETURN -1
ENDFCT
;******************************************************************************
;[Dialog Routine] Clear Dialog
;******************************************************************************
GLOBAL DEF ArcClearMsgWriteDialog(tHandle :IN)
DECL BOOL tBool
DECL INT tHandle,iAnswer
IF EXISTS_KRLDLG(tHandle,iAnswer) THEN
  tBool = CLEAR_KRLMSG(tHandle)
ENDIF
END
;******************************************************************************
;[Global Message Routine] Programmer Message
;******************************************************************************
GLOBAL DEF ArcMsg(tMsgText[] :IN)
DECL CHAR tMsgText[]
ArcMsgWrite(,#NOTIFY,tMsgText[],"ArcDiag")
END
;******************************************************************************
;[Global Message Routine] Programmer Message Write Boolean Value
;******************************************************************************
GLOBAL DEF ArcMsgB(tBool1 :IN,tBool2 :IN,tBool3 :IN)
DECL BOOL tBool1,tBool2,tBool3
ArcMsgWriteB(,#NOTIFY,"Variable Bool = %1 %2 %3","ArcDiag",,,tBool1,tBool2,tBool3)
END
;******************************************************************************
;[Global Message Routine] Programmer Message Write Integer Value
;******************************************************************************
GLOBAL DEF ArcMsgI(tInt1 :IN,tInt2 :IN,tInt3 :IN)
DECL INT tInt1,tInt2,tInt3
ArcMsgWriteI(,#NOTIFY,"Variable Integer = %1 %2 %3","ArcDiag",,,tInt1,tInt2,tInt3)
END
;******************************************************************************
;[Global Message Routine] Programmer Message Write Real Value
;******************************************************************************
GLOBAL DEF ArcMsgR(tReal1 :IN,tReal2 :IN,tReal3 :IN)
DECL REAL tReal1,tReal2,tReal3
ArcMsgWriteR(,#NOTIFY,"Variable Real = %1 %2 %3","ArcDiag",,,tReal1,tReal2,tReal3)
END
;*****************************************************************************************
;[GLOBAL Message Routine] Split parameter string max char 26
;*****************************************************************************************
GLOBAL DEF ArcStrParam(tStr[] :IN,tParam1[] :OUT,tParam2[] :OUT)
DECL BOOL tB
DECL INT tI,tII,tIII,tLenNr
DECL CHAR tStr[],tParam1[],tParam2[]
tLenNr = StrLen(tStr[])
tII = 1
tIII = 1
tB = STRCOPY(tParam1[]," ")
tB = STRCOPY(tParam2[]," ")
tParam1[]=" "
tParam2[]=" "
FOR tI = 1 TO (tLenNr)
  IF (tI > 0) AND (tI <= 26) THEN
    tParam1[tII] = tStr[tI]
    tII = tII + 1
  ENDIF
  IF (tI > 26) AND (tI <= 52) THEN
    tParam2[tIII] = tStr[tI]
    tIII = tIII + 1
  ENDIF
ENDFOR
END

