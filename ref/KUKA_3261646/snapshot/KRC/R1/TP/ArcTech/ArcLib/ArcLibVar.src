&ACCESS R2
&COMMENT ArcTech
DEF ArcLibVar( )
END
;*****************************************************************************************
;[Global Routine] Routine check if boolean Variable exist
;*****************************************************************************************
GLOBAL DEFFCT BOOL ArcVarExistB(tVar :OUT,tBool :IN)
DECL BOOL tVar,tBool
DECL INT tReturn,tReturn1
ON_ERROR_PROCEED
tVar = tVar
tReturn = $ERR.NUMBER
ERR_CLEAR($ERR)
IF (tReturn > 0) THEN
  ON_ERROR_PROCEED
  tBool = tBool
  tReturn1 = $ERR.NUMBER
  ERR_CLEAR($ERR)
  IF (tReturn1 == 0) THEN
    tVar = tBool
  ENDIF
ENDIF
RETURN (tReturn == 0)
ENDFCT
