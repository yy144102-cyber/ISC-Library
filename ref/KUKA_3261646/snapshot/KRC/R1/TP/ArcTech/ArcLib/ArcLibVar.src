;*****************************************************************************************
;[Global Routine] Routine check if String Variable exist
;Krl bug for :OUT in one structure
;*****************************************************************************************
GLOBAL DEFFCT BOOL ArcVarExistS(tVar[] :OUT,tChar[] :IN)
DECL CHAR tVar[],tChar[]
IF (StrLen(tVar[]) == 0) THEN
  IF (StrLen(tChar[]) > 0) THEN
    IF STRCOPY(tVar[],tChar[]) THEN
    ENDIF
  ENDIF
  RETURN FALSE
ENDIF
RETURN TRUE
ENDFCT
;*****************************************************************************************
;[Global Routine] Routine check if Array Variable Signal exist
;*****************************************************************************************
GLOBAL DEFFCT BOOL ArcArraySignalExist(tVar[] :OUT,tNum :IN)
DECL stArcSignal_T tVar[]
DECL INT tReturn,tNum
ON_ERROR_PROCEED
tVar[tNum]=tVar[tNum]
tReturn=$ERR.NUMBER
ERR_CLEAR($ERR)
RETURN (tReturn == 0)
ENDFCT
