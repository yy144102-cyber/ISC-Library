;*****************************************************************************************
;Remote Read String Variable
;*****************************************************************************************
GLOBAL DEFFCT CHAR[256] ArcRemoteGetVarS(tRemoteRobot[] :IN,tVar[] :IN,tMsgType :IN)
DECL BOOL tB
DECL INT tError,tPrError
DECL CHAR tVar[],tVar1[128],tRemoteRobot[],tVarRead[256]
DECL enArcMessageType_T tMsgType
REPEAT
  tError = 0
  tB = STRCOPY(tVarRead[]," ")
  tB = STRCOPY(tVar1[],tVar[])
  ON_ERROR_PROCEED
  tVarRead[] = REMOTEREAD(tRemoteRobot[],tVar1[], tError)
  tPrError = $ERR.NUMBER
  ERR_CLEAR($ERR)
  IF (tPrError > 0) THEN
    ;ArcMsg("Diag ERROR: REMOTECMD")
    RETURN " "
  ENDIF
  IF (tError > 0) THEN
    ArcMsgWriteS(,tMsgType,"Error on Remote Write to Robot: %1 Variable: %2","ARC",1,Opt_NOVLSTOP_NOLOG,tRemoteRobot[],tVar[])
    SWITCH tMsgType
      CASE #NONE, #NOTIFY
        RETURN " "
    ENDSWITCH    
