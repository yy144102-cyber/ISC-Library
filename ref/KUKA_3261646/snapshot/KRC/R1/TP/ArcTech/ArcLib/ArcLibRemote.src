&ACCESS R2
&COMMENT ArcTech
DEF ArcLibRemote( )
END
;*****************************************************************************************
;Remote Write Boolean Variable
;*****************************************************************************************
GLOBAL DEF ArcRemoteSetVarB(tRemoteRobot[] :IN,tVar[] :IN,tValue :IN,tMsgType :IN)
DECL BOOL tValue
DECL BOOL tCmdOk
DECL INT tPrError
DECL CHAR tVar[],tRemoteRobot[],tVarWrite[128],tVarWrite1[256]
DECL enArcMessageType_T tMsgType
IF (tValue == TRUE) THEN
  tVarWrite1[] = ArcStrAdd(tVar[],"=TRUE")
ELSE
  tVarWrite1[] = ArcStrAdd(tVar[],"=FALSE")
ENDIF
tVarWrite[] = tVarWrite1[]
REPEAT
  ON_ERROR_PROCEED
  tCmdOk = REMOTECMD(tRemoteRobot[],tVarWrite[])
  tPrError = $ERR.NUMBER
  ERR_CLEAR($ERR)
  IF (tPrError > 0) THEN
    ;ArcMsg("Diag ERROR: REMOTECMD")
    RETURN
  ENDIF
  IF (tCmdOk == FALSE) THEN
    ArcMsgWriteS(,tMsgType,"Error on Remote Write to Robot: %1 Variable: %2","ARC",1,Opt_NOVLSTOP_NOLOG,tRemoteRobot[],tVar[])
    SWITCH tMsgType
      CASE #NONE, #NOTIFY
        RETURN
    ENDSWITCH
  ENDIF
UNTIL (tCmdOk == TRUE)
END
;*****************************************************************************************
;Remote Write Integer Variable
;*****************************************************************************************
GLOBAL DEF ArcRemoteSetVarI(tRemoteRobot[] :IN,tVar[] :IN,tValue :IN,tMsgType :IN)
DECL INT tValue, tPrError
DECL BOOL tCmdOk
DECL CHAR tVar[],tRemoteRobot[],tVarWrite[128],tVarWrite1[256]
DECL enArcMessageType_T tMsgType
tVarWrite1[] = ArcStrAdd3(tVar[],"=",ArcIntToStr(tValue))
tVarWrite[]=tVarWrite1[]
REPEAT
  ON_ERROR_PROCEED
  tCmdOk = REMOTECMD(tRemoteRobot[],tVarWrite[])
  tPrError = $ERR.NUMBER
  ERR_CLEAR($ERR)
  IF (tPrError > 0) THEN
    ;ArcMsg("Diag ERROR: REMOTECMD")
    RETURN
  ENDIF
  IF (tCmdOk == FALSE) THEN
    ArcMsgWriteS(,tMsgType,"Error on Remote Write to Robot: %1 Variable: %2","ARC",1,Opt_NOVLSTOP_NOLOG,tRemoteRobot[],tVar[])
    SWITCH tMsgType
      CASE #NONE, #NOTIFY
        RETURN
    ENDSWITCH
  ENDIF
UNTIL (tCmdOk == TRUE)
END
