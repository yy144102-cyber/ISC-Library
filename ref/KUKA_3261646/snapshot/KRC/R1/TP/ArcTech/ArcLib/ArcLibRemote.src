UNTIL (tError == 0)
IF STRLEN(tVarRead[]) < 1 THEN
  RETURN " "
ENDIF
RETURN tVarRead[]
ENDFCT
;*****************************************************************************************
;[Global Routine] RobotTeam program synchronization
;*****************************************************************************************
GLOBAL DEF ArcProgramSync(tProgSync[] :IN, tNumRobot :IN)
DECL INT tNumRobot
DECL CHAR tProgSync[] ; Name Max 64 Char
IF tNumRobot > 1 THEN
  SYNCCMD(#PROGSYNC, tProgSync[], tNumRobot)
ENDIF
END
;*****************************************************************************************
;[Global Routine] RobotTeam Motion synchronization
;*****************************************************************************************
GLOBAL DEF ArcMotionSync(tMotionSync[] :IN, tNumRobot :IN)
DECL INT tNumRobot
DECL CHAR tMotionSync[] ; Name Max 64 Char
IF tNumRobot > 1 THEN
  SYNCCMD(#MOTIONSYNC, tMotionSync[], tNumRobot)
ENDIF
END
;*****************************************************************************************
;[Global Message Routine] Set Clear KRL message from Remote
;*****************************************************************************************
GLOBAL DEF ArcRemoteSetClearMsg(tMsgNumber :IN)
DECL INT tI,tMsgNumber
tI = 2
WHILE ArcRTRobotExist(tI) == TRUE
  ArcRemoteSetVarI($COOP_KRC[tI].NAME[],"gArcMsgRemoteClearNumber",tMsgNumber,#NONE)
  tI = tI + 1
ENDWHILE
END
;******************************************************************************
;[Global Message Routine] Set Answer and Clear KRL Dialogue message from Remote
;******************************************************************************
GLOBAL DEF ArcRemoteSetDialogAnswer(tMsgDilogueNumber :IN,tAnswerNr :OUT)
DECL INT tI,tMsgDilogueNumber,tAnswerNr
IF (tAnswerNr > 0) THEN
  tI = 2
  WHILE ArcRTRobotExist(tI) == TRUE
    ArcRemoteSetVarI($COOP_KRC[tI].NAME[],"gArcRemoteDialogAnswer",tAnswerNr,#NONE)
    ArcRemoteSetVarI($COOP_KRC[tI].NAME[],"gArcRemoteDialogNumber",tMsgDilogueNumber,#NONE)
    tI = tI + 1
  ENDWHILE
ELSE
  tAnswerNr = gArcRemoteDialogAnswer
ENDIF
gArcRemoteDialogAnswer = 0
END
;******************************************************************************
;[Global Message Routine] Clear specific KRL message from Remote
;******************************************************************************
GLOBAL DEF ArcRemoteClearMsg()
IF (gArcMsgRemoteClearNumber > 0) THEN
  ArcMsgWriteClearNumber(gArcMsgRemoteClearNumber)
  gArcMsgRemoteClearNumber = 0
ENDIF
IF (gArcRemoteDialogNumber > 0) AND (gArcRemoteDialogAnswer > 0) THEN
  ArcMsgWriteAnswerNumber(gArcRemoteDialogNumber)
  gArcRemoteDialogNumber = 0
ENDIF
END
;******************************************************************************
;[Global Message Routine] Remote write Messagge
;******************************************************************************
GLOBAL DEF ArcRemoteWriteMsg(tEnable :IN,tMsgText[] :IN,tMsgNr :IN)
DECL BOOL tEnable
DECL INT tMsgNr,tI
DECL CHAR tMsgText[]
IF (tEnable == TRUE) THEN
  tI = 2
  WHILE ArcRTRobotExist(tI) == TRUE
    ArcRemoteSetChar($COOP_KRC[tI].NAME[],"ArcErrorRemoteRobot[]",$COOP_KRC[1].NAME[],#NONE)
    ArcRemoteSetChar($COOP_KRC[tI].NAME[],"ArcErrorRemoteMsg[]",tMsgText[],#NONE)
    ArcRemoteSetVarI($COOP_KRC[tI].NAME[],"gArcRemoteMsgNum",tMsgNr,#NONE)
    tI = tI + 1
  ENDWHILE
ENDIF
END
;******************************************************************************
;[Global Message Routine] Remote write Messagge
;******************************************************************************
GLOBAL DEF ArcRemoteShowMsg()
DECL CHAR tStr[128]
DECL CHAR tStrInt[24]
IF (gArcRemoteMsgNum > 0) THEN
  tStr[] = ArcIntToStr(gArcRemoteMsgNum)
  tStrInt[] = tStr[]
  ArcMsgWriteS(,#NOTIFY,"ErrorOnRemoteRobot","ARC",20016,Opt_NOVLSTOP_LOG,ArcErrorRemoteRobot[],ArcErrorRemoteMsg[],tStrInt[])
  gArcRemoteMsgNum = 0
ENDIF
END
