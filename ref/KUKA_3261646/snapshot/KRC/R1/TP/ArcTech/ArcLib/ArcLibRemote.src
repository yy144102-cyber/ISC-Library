;*****************************************************************************************
;Remote Write CHAR Variable
;*****************************************************************************************
GLOBAL DEF ArcRemoteSetChar(tRemoteRobot[] :IN,tVar[] :IN,tValue[] :IN,tMsgType :IN)
DECL CHAR tValue[]
DECL BOOL tCmdOk
DECL INT tPrError
DECL CHAR tVar[],tRemoteRobot[],tVarWrite[128],tVarWrite1[256]
DECL enArcMessageType_T tMsgType
IF (gArcIsOnSimEnvironment == TRUE) THEN
  RETURN ;TODO Remove
ENDIF  
tVarWrite1[] = ArcStrAdd3("'"'",tValue[],"'"'")
tVarWrite1[] = ArcStrAdd3(tVar[],"=",tVarWrite1[])
tVarWrite[]=tVarWrite1[]
REPEAT
  ON_ERROR_PROCEED
  tCmdOk = REMOTECMD(tRemoteRobot[],tVarWrite[])
  tPrError = $ERR.NUMBER
  ERR_CLEAR($ERR)
  IF (tPrError > 0) THEN
    ;ArcMsg("Diag ERROR: REMOTECMD")
    RETURN
  ENDIF
  IF (tCmdOk == FALSE) THEN
    ArcMsgWriteS(,tMsgType,"Error on Remote Write to Robot: %1 Variable: %2","ARC",1,Opt_NOVLSTOP_NOLOG,tRemoteRobot[],tVar[])
    SWITCH tMsgType
      CASE #NONE, #NOTIFY
        RETURN
    ENDSWITCH
  ENDIF
UNTIL (tCmdOk == TRUE)
END
;*****************************************************************************************
;Remote Read Boolean Variable
;*****************************************************************************************
GLOBAL DEFFCT BOOL ArcRemoteGetVarB(tRemoteRobot[] :IN,tVar[] :IN,tMsgType :IN)
DECL BOOL tB 
DECL INT tError,tPrError
DECL CHAR tVar[],tVar1[128],tRemoteRobot[],tVarRead[256]
DECL enArcMessageType_T tMsgType
REPEAT
  tError = 0
  tB = STRCOPY(tVarRead[]," ")  
  tB = STRCOPY(tVar1[],tVar[])
  ON_ERROR_PROCEED
  tVarRead[] = REMOTEREAD(tRemoteRobot[],tVar1[], tError)
  tPrError = $ERR.NUMBER
  ERR_CLEAR($ERR)
  IF (tPrError > 0) THEN
    ;ArcMsg("Diag ERROR: REMOTECMD")
    RETURN FALSE
  ENDIF
  IF (tError > 0) THEN
    ArcMsgWriteS(,tMsgType,"Error on Remote Write to Robot: %1 Variable: %2","ARC",1,Opt_NOVLSTOP_NOLOG,tRemoteRobot[],tVar[])
    SWITCH tMsgType
      CASE #NONE, #NOTIFY
        RETURN FALSE
    ENDSWITCH
  ENDIF
UNTIL (tError == 0)
IF STRLEN(tVarRead[]) < 1 THEN
  RETURN FALSE
ENDIF
RETURN ArcStrToBool(tVarRead[])
ENDFCT
;*****************************************************************************************
;Remote Read Integer Variable
;*****************************************************************************************
GLOBAL DEFFCT INT ArcRemoteGetVarI(tRemoteRobot[] :IN,tVar[] :IN,tMsgType :IN)
DECL BOOL tB
DECL INT tError,tPrError
DECL CHAR tVar[],tVar1[128],tRemoteRobot[],tVarRead[256]
DECL enArcMessageType_T tMsgType
REPEAT
  tError = 0
  tB = STRCOPY(tVarRead[]," ")
  tB = STRCOPY(tVar1[],tVar[])
  ON_ERROR_PROCEED
  tVarRead[] = REMOTEREAD(tRemoteRobot[],tVar1[], tError)
  tPrError = $ERR.NUMBER
  ERR_CLEAR($ERR)
  IF (tPrError > 0) THEN
    ;ArcMsg("Diag ERROR: REMOTECMD")
    RETURN 0
  ENDIF
  IF (tError > 0) THEN
    ArcMsgWriteS(,tMsgType,"Error on Remote Write to Robot: %1 Variable: %2","ARC",1,Opt_NOVLSTOP_NOLOG,tRemoteRobot[],tVar[])
    SWITCH tMsgType
      CASE #NONE, #NOTIFY
        RETURN 0
    ENDSWITCH
  ENDIF
UNTIL (tError == 0)
IF STRLEN(tVarRead[]) < 1 THEN
  RETURN 0
ENDIF
RETURN ArcStrToInt(tVarRead[])
ENDFCT
