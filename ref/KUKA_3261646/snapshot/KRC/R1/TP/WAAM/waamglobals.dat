GLOBAL STRUC EWM_DATA INT ErrorNum,CHAR Error[255],BOOL Resetable

DECL GLOBAL EWM_DATA EwmData[255]
EwmData[4]={ErrorNum 4,Error[] "Wire feed error",Resetable TRUE}
EwmData[5]={ErrorNum 5,Error[] "Inverter emergency stop circuit temperature error",Resetable FALSE}
EwmData[6]={ErrorNum 6,Error[] "Excess mains voltage",Resetable FALSE}
EwmData[7]={ErrorNum 7,Error[] "Insufficient mains voltage",Resetable FALSE}
EwmData[8]={ErrorNum 8,Error[] "Low water level",Resetable FALSE}
EwmData[9]={ErrorNum 9,Error[] "Gas Error",Resetable TRUE}
EwmData[10]={ErrorNum 10,Error[] "Excess secondary circuit voltage",Resetable FALSE}
EwmData[11]={ErrorNum 11,Error[] "Protective conductor error",Resetable FALSE}
EwmData[12]={ErrorNum 12,Error[] "System quick stop",Resetable TRUE}
EwmData[13]={ErrorNum 13,Error[] "Internal error, please contact EWM",Resetable FALSE}
EwmData[17]={ErrorNum 17,Error[] "Error in pilot current module",Resetable TRUE}
EwmData[18]={ErrorNum 18,Error[] "Wire feed problem in cold wire unit",Resetable TRUE}
EwmData[19]={ErrorNum 19,Error[] "Gas error, external gas 1",Resetable TRUE}
EwmData[20]={ErrorNum 20,Error[] "Gas error, external gas 2",Resetable TRUE}
EwmData[21]={ErrorNum 21,Error[] "Error in flow of external coolant circuit",Resetable TRUE}
EwmData[22]={ErrorNum 22,Error[] "Error in external network",Resetable TRUE}
EwmData[23]={ErrorNum 23,Error[] "Excess temperature of external coolant circuit",Resetable TRUE}
EwmData[24]={ErrorNum 24,Error[] "External HF choke excess temperature",Resetable TRUE}
EwmData[49]={ErrorNum 49,Error[] "Process ignition error",Resetable TRUE}

GLOBAL STRUC MESSAGES_DATA INT Handle,CHAR Msg[128],BOOL Active

DECL GLOBAL MESSAGES_DATA MessageData[10]
MessageData[1]={Handle 0,Msg[] "E-Stop Relay Not Healthy. Press E-Stop Reset PB",Active FALSE}
MessageData[2]={Handle 0,Msg[] "LH Access Gate Relay Not Healthy",Active FALSE}
MessageData[3]={Handle 0,Msg[] "RH Access Gate Relay Not Healthy",Active FALSE}
MessageData[4]={Handle 0,Msg[] "Robot 2 is NOT in HOME",Active FALSE}
MessageData[5]={Handle 0,Msg[] "Collision Device Tripped.",Active FALSE}
MessageData[6]={Handle 0,Msg[] "Cell Air Pressure Missing or Low",Active FALSE}
MessageData[7]={Handle 0,Msg[] "Request To Enter Cell Pressed. Open the Access Door.",Active FALSE}
MessageData[8]={Handle 0,Msg[] "Masterkey Removed.",Active FALSE}

