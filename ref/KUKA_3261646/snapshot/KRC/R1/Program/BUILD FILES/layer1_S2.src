&ACCESS RV
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF layer1_S2()
;FOLD INI;%{PE}
;FOLD BASISTECH INI
GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
INTERRUPT ON 3
BAS (#INITMOV,0 )
;ENDFOLD (BASISTECH INI)
;FOLD USER INI
;Make your modifications here
;ENDFOLD (USER INI)
;ENDFOLD (INI)

;FOLD Actual psition
$BWDSTART = FALSE
PDAT_ACT = PPDAT
FDAT_ACT = FHome
BAS(#PTP_PARAMS, 10)
SET_CD_PARAMS(0)
PTP $POS_ACT
;ENDFOLD

$BWDSTART = FALSE
PDAT_ACT = PPDAT
FDAT_ACT = FHome
BAS(#PTP_PARAMS, 10)
SET_CD_PARAMS(0)
PTP XHOMEX

$BWDSTART = FALSE
PDAT_ACT = PPDAT
FDAT_ACT = FWeld
BAS(#PTP_PARAMS, 10)
SET_CD_PARAMS(0)
PTP Approach1

TRIGGER WHEN DISTANCE = 1 DELAY = 0 DO oLayerIndex = 1   ; Layer index is the stage number
TRIGGER WHEN DISTANCE = 1 DELAY = 0 DO oLayerType = 10
TRIGGER WHEN DISTANCE = 1 DELAY = 0 DO oLayerNum = 2
TRIGGER WHEN DISTANCE = 1 DELAY = 0 DO oSideNum = 1
TRIGGER WHEN DISTANCE = 1 DELAY = 0 DO WAAM_RSI_ON() PRIO=-1
TRIGGER WHEN DISTANCE = 1 DELAY = 0 DO oLayerCompleted=False
WAIT SEC 1.0

; make sure arc start point is good
$BWDSTART = FALSE
LDAT_ACT = LCPDAT
FDAT_ACT = FWeld
BAS(#CP_PARAMS, 0.05)
SET_CD_PARAMS(0)
LIN XP1
WAIT SEC 1

TRIGGER WHEN DISTANCE = 1 DELAY = ArcGetDelay(#PreDefinition, WDAT1) DO ArcMainNG(#PreDefinition, WDAT1, WPV) PRIO = -1
TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT1) DELAY = ArcGetDelay(#GasPreflow, WDAT1) DO ArcMainNG(#GasPreflow, WDAT1, WPV) PRIO = -1
TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT1) DELAY = 0 DO ArcMainNG(#ArcOnMoveStd, WDAT1, WPV) PRIO = -1
ArcMainNG(#ArcOnBeforeMoveStd, WDAT1, WPV)
$BWDSTART = FALSE
LDAT_ACT = LCPDAT
FDAT_ACT = FWeld
BAS(#CP_PARAMS, WDAT1.Weld.Velocity)
SET_CD_PARAMS(0)
LIN XP1
ArcMainNG(#ArcOnAfterMoveStd, WDAT1, WPV)

