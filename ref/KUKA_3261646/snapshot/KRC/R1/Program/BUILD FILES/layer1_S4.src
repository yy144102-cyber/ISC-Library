TRIGGER WHEN PATH = ArcGetPath(#ArcOffBefore, WDAT1393) DELAY = 0 DO ArcMainNG(#ArcOffBeforeOffStd, WDAT1393, WPV) PRIO = -1
TRIGGER WHEN PATH = ArcGetPath(#ArcOffBefore2, WDAT1393) DELAY = 0 DO ArcMainNG(#ArcOffBeforeOffStd2, WDAT1393, WPV) PRIO = -1
TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOff, WDAT1393) DELAY = 0 DO ArcMainNG(#ArcOffMoveStd, WDAT1393, WPV) PRIO = -1
ArcMainNG(#ArcOffBeforeMoveStd, WDAT1393, WPV)
BAS(#CP_PARAMS,WDAT1393.Weld.Velocity)
CIRC XP1380, XP1381
ArcMainNG(#ArcOffAfterMoveStd, WDAT1393, WPV)

TRIGGER WHEN DISTANCE = 1 DELAY = 0 DO oLayerCompleted=True
WAAM_RSI_OFF()
WAAM_RSI_DELETE()

$BWDSTART = FALSE
LDAT_ACT = LCPDAT
FDAT_ACT = FWeld
BAS(#CP_PARAMS, 0.1)
SET_CD_PARAMS(0)
LIN Retract1393

WAIT SEC 0

$BWDSTART = FALSE
PDAT_ACT = PPDAT
FDAT_ACT = FHome
BAS(#PTP_PARAMS, 10)
SET_CD_PARAMS(0)
PTP XHOMEX

END

