$OUT[58] = FALSE
$OUT[59] = FALSE



;FOLD PTP HOMEC Vel=60 % PDAT2 Tool[5]:Torch_Cleaning Base[0] ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.old; Kuka.IsGlobalPoint=False; Kuka.PointName=HOMEC; Kuka.BlendingEnabled=False; Kuka.MoveDataPtpName=PDAT2; Kuka.VelocityPtp=60; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=PTP
;ENDFOLD
$BWDSTART = FALSE
PDAT_ACT = PPDAT2
FDAT_ACT = FHOMEC
BAS(#PTP_PARAMS, 60.0)
SET_CD_PARAMS (0)
PTP XHOMEC
;ENDFOLD

;FOLD SPTP P1 Vel=50 % PDAT1 Tool[5]:Torch_Cleaning Base[0] ;%{PE}
