TRIGGER WHEN PATH = ArcGetPath(#ArcOffBefore, WDAT181) DELAY = 0 DO ArcMainNG(#ArcOffBeforeOffStd, WDAT181, WPV) PRIO = -1
TRIGGER WHEN PATH = ArcGetPath(#ArcOffBefore2, WDAT181) DELAY = 0 DO ArcMainNG(#ArcOffBeforeOffStd2, WDAT181, WPV) PRIO = -1
TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOff, WDAT181) DELAY = 0 DO ArcMainNG(#ArcOffMoveStd, WDAT181, WPV) PRIO = -1
ArcMainNG(#ArcOffBeforeMoveStd, WDAT181, WPV)
BAS(#CP_PARAMS,WDAT181.Weld.Velocity)
CIRC XP180, XP181
ArcMainNG(#ArcOffAfterMoveStd, WDAT181, WPV)

TRIGGER WHEN DISTANCE = 1 DELAY = 0 DO oLayerCompleted=True
WAAM_RSI_OFF()
WAAM_RSI_DELETE()

$BWDSTART = FALSE
LDAT_ACT = LCPDAT
FDAT_ACT = FWeld
BAS(#CP_PARAMS, 0.1)
SET_CD_PARAMS(0)
LIN Retract181

WAIT SEC 0

$BWDSTART = FALSE
PDAT_ACT = PPDAT
FDAT_ACT = FHome
BAS(#PTP_PARAMS, 10)
SET_CD_PARAMS(0)
PTP XHOMEX

END

