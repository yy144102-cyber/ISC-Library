TRIGGER WHEN PATH = ArcGetPath(#ArcOffBefore, WDAT1162) DELAY = 0 DO ArcMainNG(#ArcOffBeforeOffStd, WDAT1162, WPV) PRIO = -1
TRIGGER WHEN PATH = ArcGetPath(#ArcOffBefore2, WDAT1162) DELAY = 0 DO ArcMainNG(#ArcOffBeforeOffStd2, WDAT1162, WPV) PRIO = -1
TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOff, WDAT1162) DELAY = 0 DO ArcMainNG(#ArcOffMoveStd, WDAT1162, WPV) PRIO = -1
ArcMainNG(#ArcOffBeforeMoveStd, WDAT1162, WPV)
BAS(#CP_PARAMS,WDAT1162.Weld.Velocity)
LIN XP1162
ArcMainNG(#ArcOffAfterMoveStd, WDAT1162, WPV)

$BWDSTART = FALSE
LDAT_ACT = LCPDAT
FDAT_ACT = FWeld
BAS(#CP_PARAMS, 0.1)
SET_CD_PARAMS(0)
LIN Retract1162

WAIT SEC 0

$BWDSTART = FALSE
PDAT_ACT = PPDAT
FDAT_ACT = FHome
BAS(#PTP_PARAMS, 10)
SET_CD_PARAMS(0)
PTP XHOMEX

END

