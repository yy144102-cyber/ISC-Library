&ACCESS RVO
&REL 18
&PARAM DISKPATH = KRC:\R1\Program\Working
DEF  CircCheck ( )
DECL INT i,PointVal
DECL REAL Radius
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

PointVal = 6
Radius = 1000.0

BASE_DATA[17].X = 0.0
BASE_DATA[17].Y = 0.0
BASE_DATA[17].Z = 300.0
BASE_DATA[17].A = 75.75
BASE_DATA[17].B = 0.0
BASE_DATA[17].C = 0.0
;BASE_DATA[17].X = 0.0
;BASE_DATA[17].Y = 0.0
;BASE_DATA[17].Z = 275.0
;BASE_DATA[17].A = 75.75
;BASE_DATA[17].B = 0.02
;BASE_DATA[17].C = 0.01

INIPosition(PointVal,Radius)
MotionPar(#PTPmotion,10)
PTP $POS_ACT
PTP Point[1]

MotionPar(#CPmotion,0.06)
LCPDAT1.APO_DIST = 10.0
LDAT_ACT=LCPDAT1
FOR i = 2 TO PointVal STEP 2
   CIRC Point[i],Point[i+1] C_DIS C_DIS
ENDFOR

END

DEF MotionPar(Type:IN,Velocity:IN)
DECL Motion Type
DECL REAL Velocity

;FOLD ParSet
   SWITCH Type
      CASE #PTPmotion
         $BWDSTART=FALSE
          PDAT_ACT=PPDAT1
          FDAT_ACT=FP1
          BAS(#PTP_PARAMS,Velocity)
          SET_CD_PARAMS (0)
      CASE #CPmotion
         $BWDSTART=FALSE
         LDAT_ACT=LCPDAT1
         FDAT_ACT=FP1
         BAS(#CP_PARAMS,Velocity)
         SET_CD_PARAMS (0)
      DEFAULT
         HALT
   ENDSWITCH
;ENDFOLD

END

DEF INIPosition(PointVal:IN,Radius:IN)
DECL INT i,PointVal
DECL REAL Radius,Angle,Value

;FOLD Position Calculation
   FOR i = 1 TO PointVal + 1
      Point[i].X = 0.0
      Point[i].Y = 0.0
      Point[i].Z = 600.0
      Point[i].A = 0.0
      Point[i].B = 0.0
      Point[i].C = 0.0
      Point[i].S = 18
      Point[i].T = 3
      Point[i].E1 = 0.0
   ENDFOR

   ;----Define Radius---------------
   Value = 0.0
   Angle = 360.0 / PointVal
   FOR i = 1 TO PointVal + 1
      Point[i].X = (-Radius) * SIN(Value)
      Value = Value + Angle
   ENDFOR
   Value = 0.0
   Angle = 360.0 / PointVal
   FOR i = 1 TO PointVal + 1
      Point[i].Y = Radius * COS(Value)
      Value = Value + Angle
   ENDFOR
   ;----Define Radius--------END----- 

   Value = -180.0
   Angle = 360.0 / PointVal
   FOR i = 1 TO PointVal + 1
      Point[i].A = Value
      Value = Value + Angle
   ENDFOR
   Value = 0.0
   Angle = 360.0 / PointVal
   FOR i = 1 TO PointVal + 1
      Point[i].E1 = Value
      Value = Value - Angle
   ENDFOR
;ENDFOLD

END