&ACCESS RVO
&REL 13
&PARAM DISKPATH = KRC:\R1\Program\Working
DEF  CENTER ( )
DECL INT StartLayer,EndLayer
DECL REAL HightPitch,TiltAngle,Radius
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

MotionPar(#PTPmotion,10.0)
PTP $POS_ACT

StartLayer = 1
EndLayer = 500
Radius = 1003.5
TiltAngle = 47.0
HightPitch = 2.495
INIPosition(StartLayer,HightPitch,Radius,TiltAngle)
MotionPar(#CPmotion,0.1)

XHOMEX.X = 0.0
XHOMEX.Y = 0.0
XHOMEX.Z = 0.0
XHOMEX.A = 90.0

LIN XHOMEX
;LIN XHOVERX



END

DEF MotionPar(Type:IN,Velocity:IN)
DECL Motion Type
DECL REAL Velocity

;FOLD ParSet
   SWITCH Type
      CASE #PTPmotion
         $BWDSTART=FALSE
         PDAT_ACT=PPDAT1
         FDAT_ACT=FP1
         BAS(#PTP_PARAMS,Velocity)
         SET_CD_PARAMS (0)
      CASE #CPmotion
         $BWDSTART=FALSE
         LDAT_ACT=LCPDAT1
         FDAT_ACT=FP1
         BAS(#CP_PARAMS,Velocity)
         SET_CD_PARAMS (0)
      DEFAULT
         HALT
   ENDSWITCH
;ENDFOLD

END

DEF INIPosition(Layer:IN,Pitch:IN,Radius:IN,TiltAngle:IN)
DECL INT i,Layer
DECL REAL Pitch,Hight,Radius,RotateAngle,TiltAngle,Value

;FOLD Position Calculation
   FOR i = 1 TO 73
      Point[i].X = 0.0
      Point[i].Y = 0.0
      Point[i].Z = 0.0
      Point[i].A = 0.0
      Point[i].B = 0.0
      Point[i].C = 0.0
      Point[i].S = 18
      Point[i].T = 3
      Point[i].E1 = 0.0
   ENDFOR

   RotateAngle = 0.0
   FOR i = 1 TO 73
      Point[i].X = Radius * SIN(RotateAngle)
      RotateAngle = RotateAngle - 5.0
   ENDFOR
   RotateAngle = 0.0
   FOR i = 1 TO 73
      Point[i].Y = Radius * COS(RotateAngle)
      RotateAngle = RotateAngle + 5.0
   ENDFOR

   IF Layer == 1 THEN
      Hight = 0.0
   ENDIF
   IF Layer == 2 THEN
      Hight = 3.0
   ENDIF
   IF Layer == 3 THEN
      Hight = 4.5
   ENDIF
   IF Layer == 4 THEN
      Hight = 6.0
   ENDIF
   IF Layer >= 5 THEN
      Hight = 6.0 + (Pitch * (Layer - 4))
   ENDIF
   
   Value = Hight * COS(TiltAngle)
   RotateAngle = 0.0
   FOR i = 1 TO 73
      IF (RotateAngle == 0.0) OR (RotateAngle == -90.0) OR (RotateAngle == -180.0) OR (RotateAngle == -270.0) OR (RotateAngle == -360.0) THEN
         Point[i].X = Point[i].X + Hight * COS(TiltAngle)
      ELSE
         Point[i].X = Point[i].X + Value * SIN(RotateAngle)
      ENDIF
         RotateAngle = RotateAngle - 5.0
   ENDFOR
   RotateAngle = 0.0
   FOR i = 1 TO 73
      IF (RotateAngle == 0.0) OR (RotateAngle == 90.0) OR (RotateAngle == 180.0) OR (RotateAngle == 270.0) OR (RotateAngle == 360.0) THEN
         Point[i].Y = Point[i].Y + Hight * COS(TiltAngle)
      ELSE
         Point[i].Y = Point[i].Y + Value * COS(RotateAngle)
      ENDIF
      RotateAngle = RotateAngle + 5.0
   ENDFOR
   FOR i = 1 TO 73
      Point[i].Z = Hight * SIN(TiltAngle)
   ENDFOR

   RotateAngle = -180.0
   FOR i = 1 TO 73
      Point[i].A = RotateAngle
      RotateAngle = RotateAngle + 5.0
   ENDFOR
   RotateAngle = TiltAngle
   FOR i = 1 TO 73
      Point[i].C = RotateAngle
   ENDFOR
   RotateAngle = 0.0
   FOR i = 1 TO 73
      Point[i].E1 = RotateAngle
      RotateAngle = RotateAngle - 5.0
   ENDFOR
;ENDFOLD

END

DEF HightClaculation(TiltAngle:IN,Pitch:IN)
DECL INT i
DECL REAL TiltAngle,Pitch,Value,RotateAngle

;FOLD Hight Calculation
   Value = Pitch * COS(TiltAngle)
   RotateAngle = 0.0
   FOR i = 1 TO 73
      IF (RotateAngle == 0.0) OR (RotateAngle == -90.0) OR (RotateAngle == -180.0) OR (RotateAngle == -270.0) OR (RotateAngle == -360.0) THEN
         Point[i].X = Point[i].X + Pitch * COS(TiltAngle)
      ELSE
         Point[i].X = Point[i].X + Value * SIN(RotateAngle)
      ENDIF
         RotateAngle = RotateAngle - 5.0
   ENDFOR
   RotateAngle = 0.0
   FOR i = 1 TO 73
      IF (RotateAngle == 0.0) OR (RotateAngle == 90.0) OR (RotateAngle == 180.0) OR (RotateAngle == 270.0) OR (RotateAngle == 360.0) THEN
         Point[i].Y = Point[i].Y + Pitch * COS(TiltAngle)
      ELSE
         Point[i].Y = Point[i].Y + Value * COS(RotateAngle)
      ENDIF
      RotateAngle = RotateAngle + 5.0
   ENDFOR
   FOR i = 1 TO 73
      Point[i].Z = Pitch * SIN(TiltAngle)
   ENDFOR
;ENDFOLD

END

DEF WeldingAct(Type:IN,Layer:IN)
DECL Action Type
DECL INT Layer

;FOLD Welding Action
   $BWDSTART=FALSE
   LDAT_ACT=LCPDAT1
   FDAT_ACT=FP1
   SET_CD_PARAMS (0)
   SWITCH Type
      CASE #_ON
         IF Layer == 1 THEN
            TRIGGER WHEN DISTANCE = 1 DELAY = ArcGetDelay(#PreDefinition, WDAT1) DO ArcMainNG(#PreDefinition, WDAT1, WP1) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT1) DELAY = ArcGetDelay(#GasPreflow, WDAT1) DO ArcMainNG(#GasPreflow, WDAT1, WP1) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT1) DELAY = ArcGetDelay(#ArcPreOn, WDAT1) DO ArcMainNG(#ArcOnMoveStd, WDAT1, WP1) PRIO = -1 
            ArcMainNG(#ArcOnBeforeMoveStd, WDAT1, WP1)
            BAS(#CP_PARAMS, WDAT1.Weld.Velocity)
            LIN $POS_ACT
            ArcMainNG(#ArcOnAfterMoveStd, WDAT1, WP1)
         ENDIF
         IF Layer == 2 THEN
            TRIGGER WHEN DISTANCE = 1 DELAY = ArcGetDelay(#PreDefinition, WDAT2) DO ArcMainNG(#PreDefinition, WDAT2, WP2) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT2) DELAY = ArcGetDelay(#GasPreflow, WDAT2) DO ArcMainNG(#GasPreflow, WDAT2, WP2) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT2) DELAY = ArcGetDelay(#ArcPreOn, WDAT2) DO ArcMainNG(#ArcOnMoveStd, WDAT2, WP2) PRIO = -1 
            ArcMainNG(#ArcOnBeforeMoveStd, WDAT2, WP2)
            BAS(#CP_PARAMS, WDAT2.Weld.Velocity)
            LIN $POS_ACT
            ArcMainNG(#ArcOnAfterMoveStd, WDAT2, WP2)
         ENDIF
         IF Layer == 3 THEN
            TRIGGER WHEN DISTANCE = 1 DELAY = ArcGetDelay(#PreDefinition, WDAT3) DO ArcMainNG(#PreDefinition, WDAT3, WP3) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT3) DELAY = ArcGetDelay(#GasPreflow, WDAT3) DO ArcMainNG(#GasPreflow, WDAT3, WP3) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT3) DELAY = ArcGetDelay(#ArcPreOn, WDAT3) DO ArcMainNG(#ArcOnMoveStd, WDAT3, WP3) PRIO = -1 
            ArcMainNG(#ArcOnBeforeMoveStd, WDAT3, WP3)
            BAS(#CP_PARAMS, WDAT3.Weld.Velocity)
            LIN $POS_ACT
            ArcMainNG(#ArcOnAfterMoveStd, WDAT3, WP3)
         ENDIF
         IF Layer == 4 THEN
            TRIGGER WHEN DISTANCE = 1 DELAY = ArcGetDelay(#PreDefinition, WDAT4) DO ArcMainNG(#PreDefinition, WDAT4, WP4) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT4) DELAY = ArcGetDelay(#GasPreflow, WDAT4) DO ArcMainNG(#GasPreflow, WDAT4, WP4) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT4) DELAY = ArcGetDelay(#ArcPreOn, WDAT4) DO ArcMainNG(#ArcOnMoveStd, WDAT4, WP4) PRIO = -1 
            ArcMainNG(#ArcOnBeforeMoveStd, WDAT4, WP4)
            BAS(#CP_PARAMS, WDAT4.Weld.Velocity)
            LIN $POS_ACT
            ArcMainNG(#ArcOnAfterMoveStd, WDAT4, WP4)
         ENDIF
         IF Layer >= 5 THEN
            TRIGGER WHEN DISTANCE = 1 DELAY = ArcGetDelay(#PreDefinition, WDAT5) DO ArcMainNG(#PreDefinition, WDAT5, WP5) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT5) DELAY = ArcGetDelay(#GasPreflow, WDAT5) DO ArcMainNG(#GasPreflow, WDAT5, WP5) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT5) DELAY = ArcGetDelay(#ArcPreOn, WDAT5) DO ArcMainNG(#ArcOnMoveStd, WDAT5, WP5) PRIO = -1 
            ArcMainNG(#ArcOnBeforeMoveStd, WDAT5, WP5)
            BAS(#CP_PARAMS, WDAT5.Weld.Velocity)
            LIN $POS_ACT
            ArcMainNG(#ArcOnAfterMoveStd, WDAT5, WP5)
         ENDIF
      CASE #_OFF
         IF (Layer >= 1) AND (Layer <= 4) THEN
            TRIGGER WHEN PATH = ArcGetPath(#ArcOffBefore, WDAT1) DELAY = 0 DO ArcMainNG(#ArcOffBeforeOffStd, WDAT1, WP1) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#ArcOffBefore2, WDAT1) DELAY = 0 DO ArcMainNG(#ArcOffBeforeOffStd2, WDAT1, WP1) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOff, WDAT1) DELAY = 0 DO ArcMainNG(#ArcOffMoveStd, WDAT1, WP1) PRIO = -1
            ArcMainNG(#ArcOffBeforeMoveStd, WDAT1, WP1)
            ArcMainNG(#ArcOffAfterMoveStd, WDAT1, WP1)
         ELSE
            TRIGGER WHEN PATH = ArcGetPath(#ArcOffBefore, WDAT5) DELAY = 0 DO ArcMainNG(#ArcOffBeforeOffStd, WDAT5, WP5) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#ArcOffBefore2, WDAT5) DELAY = 0 DO ArcMainNG(#ArcOffBeforeOffStd2, WDAT5, WP5) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOff, WDAT5) DELAY = 0 DO ArcMainNG(#ArcOffMoveStd, WDAT5, WP5) PRIO = -1
            ArcMainNG(#ArcOffBeforeMoveStd, WDAT5, WP5)
            ArcMainNG(#ArcOffAfterMoveStd, WDAT5, WP5)
         ENDIF
      DEFAULT
         HALT
   ENDSWITCH
;ENDFOLD

END

DEF JobSwitch(Layer:IN)
DECL INT Layer

;FOLD Welding Action
   IF Layer == 1 THEN
      TRIGGER WHEN DISTANCE = 1 DELAY = 0 DO ArcMainNG(#ArcSwiMoveStd, WDAT2, WP2) PRIO = -1
      ArcMainNG(#ArcSwiBeforeMoveStd, WDAT2, WP2)
      ArcMainNG(#ArcSwiAfterMoveStd, WDAT2, WP2)
   ENDIF
   IF Layer == 2 THEN
      TRIGGER WHEN DISTANCE = 1 DELAY = 0 DO ArcMainNG(#ArcSwiMoveStd, WDAT3, WP3) PRIO = -1
      ArcMainNG(#ArcSwiBeforeMoveStd, WDAT3, WP3)
      ArcMainNG(#ArcSwiAfterMoveStd, WDAT3, WP3)
   ENDIF
   IF Layer == 3 THEN
      TRIGGER WHEN DISTANCE = 1 DELAY = 0 DO ArcMainNG(#ArcSwiMoveStd, WDAT4, WP4) PRIO = -1
      ArcMainNG(#ArcSwiBeforeMoveStd, WDAT4, WP4)
      ArcMainNG(#ArcSwiAfterMoveStd, WDAT4, WP4)
   ENDIF
   IF Layer >= 4 THEN
      TRIGGER WHEN DISTANCE = 1 DELAY = 0 DO ArcMainNG(#ArcSwiMoveStd, WDAT5, WP5) PRIO = -1
      ArcMainNG(#ArcSwiBeforeMoveStd, WDAT5, WP5)
      ArcMainNG(#ArcSwiAfterMoveStd, WDAT5, WP5)
   ENDIF
;ENDFOLD

END