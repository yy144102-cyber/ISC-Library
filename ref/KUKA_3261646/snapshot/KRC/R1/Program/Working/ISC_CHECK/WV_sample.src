&ACCESS RVO
&REL 77
&PARAM DISKPATH = KRC:\R1\Program\Working
DEF  WV_sample ( )
DECL INT i,j,StartLayer,EndLayer
DECL REAL Interval,Pitch,BSX,BSY,BSZ,Angle
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

StartLayer = 16
EndLayer = 100
Interval = 60.0
Pitch = 2.5
BSX = 250.0
BSY = 0.0
BSZ = 1.5
Angle = 18.0
INIBase(BSX,BSY,BSZ)
MotionPar(#PTPmotion,10.0)
PTP $POS_ACT
PTP XHOMEX
PTP XHOVERX

FOR i = StartLayer TO EndLayer
   I[1] = i   
   HightCalc(i,Pitch)
   oLayerNum = i
   oSideNum = 1
   oLayerType = 10
   oLayerIndex = 1
   WAAM_RSI_ON()
   
;-----------------------------------------
   IF i <> (i / 2 * 2) THEN
      FOR j = 1 TO 316
       ;kisuu 1,3,5,7,9
         PointL1[j].B = -Angle
         PointL1[j].T = 10
      ENDFOR
   ELSE
       ;guusuu 2,4,6,8
      FOR j = 1 TO 316
        PointL2[j].B = Angle
        PointL2[j].T = 11
      ENDFOR
   ENDIF
;-----------------------------------------
   
   IF i <> (i / 2 * 2) THEN
      MotionPar(#CPmotion,0.1)
      LIN PointL1[1]
   ELSE
      MotionPar(#CPmotion,0.1)
      LIN PointL2[1]
   ENDIF
   oIsScanning = TRUE
   WAIT SEC 1.0
   WeldingAct(#_ON,i)
   MotionPar(#CPmotion,WDAT1.Weld.Velocity)
   
   IF i <> (i / 2 * 2) THEN
      ;kisuu 1,3,5,7,9
      FOR j = 2 TO 310
         LIN PointL1[j] C_DIS C_DIS
      ENDFOR
      ;TRIGGER WHEN PATH = 0.0 DELAY = 0.0 DO JobSwitch() PRIO = 1
      TRIGGER WHEN DISTANCE = 1 DELAY = 0 DO ArcMainNG(#ArcSwiMoveStd, WDAT10, WP10) PRIO = -1
      ArcMainNG(#ArcSwiBeforeMoveStd, WDAT10, WP10)
      ArcMainNG(#ArcSwiAfterMoveStd, WDAT10, WP10)
      FOR j = 311 TO 316
         LIN PointL1[j] C_DIS C_DIS
      ENDFOR
   ELSE
      ;guusuu 2,4,6,8
      FOR j = 2 TO 310
         LIN PointL2[j] C_DIS C_DIS
      ENDFOR
      ;TRIGGER WHEN PATH = 0.0 DELAY = 0.0 DO JobSwitch() PRIO = 1
      TRIGGER WHEN DISTANCE = 1 DELAY = 0 DO ArcMainNG(#ArcSwiMoveStd, WDAT10, WP10) PRIO = -1
      ArcMainNG(#ArcSwiBeforeMoveStd, WDAT10, WP10)
      ArcMainNG(#ArcSwiAfterMoveStd, WDAT10, WP10)
      FOR j = 311 TO 316
         LIN PointL2[j] C_DIS C_DIS
      ENDFOR
   ENDIF
   WeldingAct(#_OFF,i)
   WAIT SEC Interval
   oIsScanning = FALSE
   WAAM_RSI_OFF()
ENDFOR

MotionPar(#PTPmotion,10.0)
PTP XHOVERX
PTP XHOMEX

END

DEF MotionPar(Type:IN,Velocity:IN)
DECL Motion Type
DECL REAL Velocity

;FOLD ParSet
   SWITCH Type
      CASE #PTPmotion
         $BWDSTART=FALSE
         PDAT_ACT=PPDAT1
         FDAT_ACT=FP1
         BAS(#PTP_PARAMS,Velocity)
         SET_CD_PARAMS (0)
      CASE #CPmotion
         $BWDSTART=FALSE
         LDAT_ACT=LCPDAT1
         FDAT_ACT=FP1
         BAS(#CP_PARAMS,Velocity)
         SET_CD_PARAMS (0)
      DEFAULT
         HALT
   ENDSWITCH
;ENDFOLD

END

DEF INIBase(BSX:IN,BSY:IN,BSZ:IN)
DECL REAL BSX,BSY,BSZ

;FOLD Position Calculation
   BASE_DATA[1].X = 1750.0 + BSX
   BASE_DATA[1].Y = 0.0 + BSY
   BASE_DATA[1].Z = -960.0 + BSZ
   BASE_DATA[1].A = -90.0
   BASE_DATA[1].B = -0.5
   BASE_DATA[1].C = -0.1
;ENDFOLD

END

DEF HightCalc(Layer:IN,Pitch:IN)
DECL INT i,Layer
DECL REAL Pitch,Hight

;FOLD Position Calculation
   IF Layer == 1 THEN
      Layer = 1
      Hight = 0.0
   ENDIF
   IF Layer == 2 THEN
      Layer = 1
      Hight = 3.0
   ENDIF
   IF Layer == 3 THEN
      Layer = 1
      Hight = 6.5
   ENDIF
   IF Layer == 4 THEN
      Layer = 1
      Hight = 9.0
   ENDIF
   IF Layer >= 5 THEN
      Layer = Layer - 4
      Hight = 11.3
   ENDIF
   FOR i = 1 TO 316
      PointL1[i].Z = (Pitch * (Layer - 1)) + Hight
      PointL2[i].Z = (Pitch * (Layer - 1)) + Hight
   ENDFOR
;ENDFOLD

END

DEFFCT REAL VelocityCalc(Velocity:IN)
DECL REAL Velocity,_Result

;FOLD Velocity Calculation
   IF ($OUT[9] == TRUE) OR ($OUT[10] == TRUE) THEN
      _Result = (Velocity / 60.0) / 1000.0
   ELSE
      _Result = (3000.0 / 60.0) / 1000.0
   ENDIF
   RETURN(_Result)
;ENDFOLD

ENDFCT

DEF WeldingAct(Type:IN,Layer:IN)
DECL Action Type
DECL INT Layer

;FOLD Welding Action
   SWITCH Type
      CASE #_ON
         IF Layer == 1 THEN
            TRIGGER WHEN DISTANCE = 1 DELAY = ArcGetDelay(#PreDefinition, WDAT1) DO ArcMainNG(#PreDefinition, WDAT1, WP1) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT1) DELAY = ArcGetDelay(#GasPreflow, WDAT1) DO ArcMainNG(#GasPreflow, WDAT1, WP1) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT1) DELAY = ArcGetDelay(#ArcPreOn, WDAT1) DO ArcMainNG(#ArcOnMoveStd, WDAT1, WP1) PRIO = -1 
            ArcMainNG(#ArcOnBeforeMoveStd, WDAT1, WP1)
            MotionPar(#CPmotion,0.1)
            LIN $POS_ACT
            ArcMainNG(#ArcOnAfterMoveStd, WDAT1, WP1)
         ENDIF
         IF Layer == 2 THEN
            TRIGGER WHEN DISTANCE = 1 DELAY = ArcGetDelay(#PreDefinition, WDAT2) DO ArcMainNG(#PreDefinition, WDAT2, WP2) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT2) DELAY = ArcGetDelay(#GasPreflow, WDAT2) DO ArcMainNG(#GasPreflow, WDAT2, WP2) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT2) DELAY = ArcGetDelay(#ArcPreOn, WDAT2) DO ArcMainNG(#ArcOnMoveStd, WDAT2, WP2) PRIO = -1 
            ArcMainNG(#ArcOnBeforeMoveStd, WDAT2, WP2)
            MotionPar(#CPmotion,0.1)
            LIN $POS_ACT
            ArcMainNG(#ArcOnAfterMoveStd, WDAT2, WP2)
         ENDIF
         IF Layer == 3 THEN
            TRIGGER WHEN DISTANCE = 1 DELAY = ArcGetDelay(#PreDefinition, WDAT3) DO ArcMainNG(#PreDefinition, WDAT3, WP3) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT3) DELAY = ArcGetDelay(#GasPreflow, WDAT3) DO ArcMainNG(#GasPreflow, WDAT3, WP3) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT3) DELAY = ArcGetDelay(#ArcPreOn, WDAT3) DO ArcMainNG(#ArcOnMoveStd, WDAT3, WP3) PRIO = -1 
            ArcMainNG(#ArcOnBeforeMoveStd, WDAT3, WP3)
            MotionPar(#CPmotion,0.1)
            LIN $POS_ACT
            ArcMainNG(#ArcOnAfterMoveStd, WDAT3, WP3)
         ENDIF
         IF Layer == 4 THEN
            TRIGGER WHEN DISTANCE = 1 DELAY = ArcGetDelay(#PreDefinition, WDAT4) DO ArcMainNG(#PreDefinition, WDAT4, WP4) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT4) DELAY = ArcGetDelay(#GasPreflow, WDAT4) DO ArcMainNG(#GasPreflow, WDAT4, WP4) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT4) DELAY = ArcGetDelay(#ArcPreOn, WDAT4) DO ArcMainNG(#ArcOnMoveStd, WDAT4, WP4) PRIO = -1 
            ArcMainNG(#ArcOnBeforeMoveStd, WDAT4, WP4)
            MotionPar(#CPmotion,0.1)
            LIN $POS_ACT
            ArcMainNG(#ArcOnAfterMoveStd, WDAT4, WP4)
         ENDIF
         IF Layer >= 5 THEN
            TRIGGER WHEN DISTANCE = 1 DELAY = ArcGetDelay(#PreDefinition, WDAT5) DO ArcMainNG(#PreDefinition, WDAT5, WP5) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT5) DELAY = ArcGetDelay(#GasPreflow, WDAT5) DO ArcMainNG(#GasPreflow, WDAT5, WP5) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT5) DELAY = ArcGetDelay(#ArcPreOn, WDAT5) DO ArcMainNG(#ArcOnMoveStd, WDAT5, WP5) PRIO = -1 
            ArcMainNG(#ArcOnBeforeMoveStd, WDAT5, WP5)
            MotionPar(#CPmotion,0.1)
            LIN $POS_ACT
            ArcMainNG(#ArcOnAfterMoveStd, WDAT5, WP5)
         ENDIF
      CASE #_OFF
         IF Layer == 1 THEN
            TRIGGER WHEN PATH = ArcGetPath(#ArcOffBefore, WDAT1) DELAY = 0 DO ArcMainNG(#ArcOffBeforeOffStd, WDAT1, WP1) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#ArcOffBefore2, WDAT1) DELAY = 0 DO ArcMainNG(#ArcOffBeforeOffStd2, WDAT1, WP1) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOff, WDAT1) DELAY = 0 DO ArcMainNG(#ArcOffMoveStd, WDAT1, WP1) PRIO = -1
            ArcMainNG(#ArcOffBeforeMoveStd, WDAT1, WP1)
            MotionPar(#CPmotion,0.1)
            LIN $POS_ACT
            ArcMainNG(#ArcOffAfterMoveStd, WDAT1, WP1)
         ENDIF
         IF Layer == 2 THEN
            TRIGGER WHEN PATH = ArcGetPath(#ArcOffBefore, WDAT2) DELAY = 0 DO ArcMainNG(#ArcOffBeforeOffStd, WDAT2, WP2) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#ArcOffBefore2, WDAT2) DELAY = 0 DO ArcMainNG(#ArcOffBeforeOffStd2, WDAT2, WP2) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOff, WDAT2) DELAY = 0 DO ArcMainNG(#ArcOffMoveStd, WDAT2, WP2) PRIO = -1
            ArcMainNG(#ArcOffBeforeMoveStd, WDAT2, WP2)
            MotionPar(#CPmotion,0.1)
            LIN $POS_ACT
            ArcMainNG(#ArcOffAfterMoveStd, WDAT2, WP2)
         ENDIF
         IF Layer == 3 THEN
            TRIGGER WHEN PATH = ArcGetPath(#ArcOffBefore, WDAT3) DELAY = 0 DO ArcMainNG(#ArcOffBeforeOffStd, WDAT3, WP3) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#ArcOffBefore2, WDAT3) DELAY = 0 DO ArcMainNG(#ArcOffBeforeOffStd2, WDAT3, WP3) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOff, WDAT3) DELAY = 0 DO ArcMainNG(#ArcOffMoveStd, WDAT3, WP3) PRIO = -1
            ArcMainNG(#ArcOffBeforeMoveStd, WDAT3, WP3)
            MotionPar(#CPmotion,0.1)
            LIN $POS_ACT
            ArcMainNG(#ArcOffAfterMoveStd, WDAT3, WP3)
         ENDIF
         IF Layer == 4 THEN
            TRIGGER WHEN PATH = ArcGetPath(#ArcOffBefore, WDAT4) DELAY = 0 DO ArcMainNG(#ArcOffBeforeOffStd, WDAT4, WP4) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#ArcOffBefore2, WDAT4) DELAY = 0 DO ArcMainNG(#ArcOffBeforeOffStd2, WDAT4, WP4) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOff, WDAT4) DELAY = 0 DO ArcMainNG(#ArcOffMoveStd, WDAT4, WP4) PRIO = -1
            ArcMainNG(#ArcOffBeforeMoveStd, WDAT4, WP4)
            MotionPar(#CPmotion,0.1)
            LIN $POS_ACT
            ArcMainNG(#ArcOffAfterMoveStd, WDAT4, WP4)
         ENDIF
         IF Layer >= 5 THEN
            TRIGGER WHEN PATH = ArcGetPath(#ArcOffBefore, WDAT5) DELAY = 0 DO ArcMainNG(#ArcOffBeforeOffStd, WDAT5, WP5) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#ArcOffBefore2, WDAT5) DELAY = 0 DO ArcMainNG(#ArcOffBeforeOffStd2, WDAT5, WP5) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOff, WDAT5) DELAY = 0 DO ArcMainNG(#ArcOffMoveStd, WDAT5, WP5) PRIO = -1
            ArcMainNG(#ArcOffBeforeMoveStd, WDAT5, WP5)
            MotionPar(#CPmotion,0.1)
            LIN $POS_ACT
            ArcMainNG(#ArcOffAfterMoveStd, WDAT5, WP5)
         ENDIF
      DEFAULT
         HALT
   ENDSWITCH
;ENDFOLD

END

DEF JobSwitch( )

;FOLD Welding Action
   TRIGGER WHEN DISTANCE = 1 DELAY = 0 DO ArcMainNG(#ArcSwiMoveStd, WDAT10, WP10) PRIO = -1
   ArcMainNG(#ArcSwiBeforeMoveStd, WDAT10, WP10)
   ArcMainNG(#ArcSwiAfterMoveStd, WDAT10, WP10)
;ENDFOLD

END