&ACCESS RVO
&REL 174
&PARAM DISKPATH = KRC:\R1\Program\Working
DEF  Square_10mm ( )
DECL INT i,StartLayer,EndLayer
DECL REAL HightPitch,Velocity,Length,Circle,St,Tu,FPX,HUL
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

MotionPar(#PTPmotion,10.0)
PTP $POS_ACT

StartLayer = 25
EndLayer = 600
FPX = 250.0;0tenkarano offset kyori
HUL = 30.0;Height up Length

Length = 900
Circle = 100.0
St = 18.0
Tu = 10.0
HightPitch = 2.63

INIPosition(StartLayer,HightPitch,Length,Circle,St,Tu,FPX,HUL)
MotionPar(#CPmotion,0.1)
LIN Point_1[1]

;------RSI INDCATOR-----------
oLayerNum = 1
oSideNum = 1
oLayerType = 10
oLayerIndex = 1
WAAM_RSI_ON()
oIsScanning = TRUE
;-----------------------------

WAIT SEC 1.0

WeldingAct(#_ON,StartLayer)

FOR i = StartLayer TO EndLayer
   I[1] = i
   ;FOLD Move

  ; LIN Point_1[1] C_Dis C_Dis
   LIN Point_1[2] C_Dis C_Dis
   LIN Point_1[3] C_Dis C_Dis
   Circ Point_1[4],Point_1[5] C_Dis C_Dis
   LIN Point_1[6] C_Dis C_Dis
   LIN Point_1[7] C_Dis C_Dis
   CIRC Point_1[8],Point_1[9] C_Dis C_Dis
   LIN Point_1[10] C_Dis C_Dis
   LIN Point_1[11] C_Dis C_Dis
   CIRC Point_1[12],Point_1[13] C_Dis C_Dis
   LIN Point_1[14] C_Dis C_Dis
   LIN Point_1[15] C_Dis C_Dis
   CIRC Point_1[16],Point_1[17] C_Dis C_Dis
   LIN Point_1[18] C_Dis C_Dis   
LIN Point_1[19] C_Dis C_Dis
   ;ENDFOLD
   JobSwitch(i)
   HightClaculation(i,HightPitch)
ENDFOR

WeldingAct(#_OFF,i - 1)
WAIT SEC 1.0
oIsScanning = FALSE
WAAM_RSI_OFF()
MotionPar(#PTPmotion,10.0)
PTP XHOVERX
PTP XHOMEX

END

DEF MotionPar(Type:IN,Velocity:IN)
DECL Motion Type
DECL REAL Velocity

;FOLD ParSet
   SWITCH Type
      CASE #PTPmotion
         $BWDSTART=FALSE
         PDAT_ACT=PPDAT1
         FDAT_ACT=FP1
         BAS(#PTP_PARAMS,Velocity)
         SET_CD_PARAMS (0)
      CASE #CPmotion
         $BWDSTART=FALSE
         LDAT_ACT=LCPDAT1
         FDAT_ACT=FP1
         BAS(#CP_PARAMS,Velocity)
         SET_CD_PARAMS (0)
      DEFAULT
         HALT
   ENDSWITCH
;ENDFOLD

END

DEF INIPosition(Layer:IN,Pitch:IN,Length:IN,Circle:IN,St:IN,Tu:IN,FPX:IN,HUL:IN)
DECL INT i,Layer,St,Tu
DECL REAL Pitch,Hight,Radius,Angle,Length,Pass,Circle,FPX,HUL

;FOLD Position Calculation
   
   Radius = Length / 2
   Pass = Radius - Circle
   Angle = Pass + Circle / sqrt(2)
   St = St
   
   
   Point_1[1].X = FPX
   Point_1[2].X = 0
   Point_1[3].X = Pass * (-1.0)
   Point_1[4].X = Angle * (-1.0)
   Point_1[5].X = Radius * (-1.0)
   Point_1[6].X = Radius * (-1.0)
   Point_1[7].X = Radius * (-1.0)
   Point_1[8].X = Angle * (-1.0)
   Point_1[9].X = Pass * (-1.0)
  Point_1[10].X = 0
  Point_1[11].X = Pass
  Point_1[12].X = Angle
  Point_1[13].X = Radius
  Point_1[14].X = Radius
  Point_1[15].X = Radius
  Point_1[16].X = Angle
  Point_1[17].X = Pass
  Point_1[18].X = FPX + HUL
  Point_1[19].X = FPX

  

   Point_1[1].Y = Radius * (-1.0)
   Point_1[2].Y = Radius * (-1.0)
   Point_1[3].Y = Radius * (-1.0)
   Point_1[4].Y = Angle * (-1.0)
   Point_1[5].Y = Pass * (-1.0)
   Point_1[6].Y = 0
   Point_1[7].Y = Pass
   Point_1[8].Y = Angle
   Point_1[9].Y = Radius
  Point_1[10].Y = Radius
  Point_1[11].Y = Radius
  Point_1[12].Y = Angle
  Point_1[13].Y = Pass
  Point_1[14].Y = 0.0
  Point_1[15].Y = Pass * (-1.0)
  Point_1[16].Y = Angle * (-1.0)
  Point_1[17].Y = Radius * (-1.0)
  Point_1[18].Y = Radius * (-1.0)
  Point_1[19].Y = Radius * (-1.0)
  

  Point_1[1].E1 =  360.0 - 360.0
  Point_1[2].E1 = 0.0 - 360.0 + Atan2( FPX, ( Radius) )
  Point_1[3].E1 = Atan2( (- Pass) , (- Radius) )-180.0 +  Atan2( FPX, ( Radius) )
  Point_1[4].E1 = 45.0 - 360.0 +  Atan2( FPX, ( Radius) )
  Point_1[5].E1 = Atan2( (- Radius) , (- Pass) ) - 180.0 +  Atan2( FPX, ( Radius) )
  Point_1[6].E1 = 90.0 - 360.0 +  Atan2( FPX, ( Radius) )
  Point_1[7].E1 =  Atan2( (- Radius) , ( Pass) ) -180.0 + Atan2( FPX, ( Radius) )
  Point_1[8].E1 = 135.0 - 360.0 + Atan2( FPX, ( Radius) )
  Point_1[9].E1 = Atan2( (- Pass) , Radius ) - 180.0 +  Atan2( FPX, ( Radius) )
  Point_1[10].E1 = 180.0 - 360.0 + Atan2( FPX, ( Radius) )
  Point_1[11].E1 = Atan2( ( Pass) , Radius ) - 180.0 + Atan2( FPX, ( Radius) )
  Point_1[12].E1 = 225.0 - 360.0 + Atan2( FPX, ( Radius) )
  Point_1[13].E1 = Atan2( Radius , Pass ) - 180.0 + Atan2( FPX, ( Radius) )
  Point_1[14].E1 = 270.0 - 360.0 + Atan2( FPX, ( Radius) )
  Point_1[15].E1 = Atan2( Radius , (-Pass)) - 180.0 + Atan2( FPX, ( Radius) )
  Point_1[16].E1 = 315.0 - 360.0 + Atan2( FPX, ( Radius) )
  Point_1[17].E1 = Atan2( Pass , (- Radius)) - 180.0 + Atan2( FPX, ( Radius) )
  Point_1[18].E1 = Atan2(( FPX + HUL ),( -Radius ) ) - Atan2( FPX, ( - Radius) )
  Point_1[19].E1 =  360.0 - 360.0

   Point_1[1].A =	180.0
   Point_1[2].A =	180.0
   Point_1[3].A =	180.0
   Point_1[4].A =	135.0
   Point_1[5].A =	90.0
   Point_1[6].A =	90.0
   Point_1[7].A =	90.0
   Point_1[8].A =	45.0
   Point_1[9].A =	0.0
  Point_1[10].A =	0.0
  Point_1[11].A =	0.0
  Point_1[12].A =	-45.0
  Point_1[13].A =	-90.0
  Point_1[14].A =	-90.0
  Point_1[15].A =	-90.0
  Point_1[16].A =	-135.0
  Point_1[17].A =	180.0
  Point_1[18].A =	180.0
  Point_1[19].A =	180.0
 
   Point_1[1].S = St
   Point_1[2].S = St
   Point_1[3].S = St
   Point_1[4].S = St
   Point_1[5].S = St
   Point_1[6].S = St
   Point_1[7].S = St
   Point_1[8].S = St
   Point_1[9].S = St
  Point_1[10].S = St
  Point_1[11].S = St
  Point_1[12].S = St
  Point_1[13].S = St
  Point_1[14].S = St
  Point_1[15].S = St
  Point_1[16].S = St
  Point_1[17].S = St
  Point_1[18].S = St
  Point_1[19].S = St


  Point_1[1].T = Tu
  Point_1[2].T = Tu
  Point_1[3].T = Tu
  Point_1[4].T = Tu
  Point_1[5].T = Tu
  Point_1[6].T = Tu
  Point_1[7].T = Tu
  Point_1[8].T = Tu
  Point_1[9].T = Tu
 Point_1[10].T = Tu
 Point_1[11].T = Tu
 Point_1[12].T = Tu
 Point_1[13].T = Tu
 Point_1[14].T = Tu
 Point_1[15].T = Tu
 Point_1[16].T = Tu
 Point_1[17].T = Tu
 Point_1[18].T = Tu
 Point_1[19].T = Tu

   IF Layer == 1 THEN
      Hight = 0.0
      FOR i = 1 TO 19
         Point_1[i].Z = Hight
      ENDFOR
      Point_1[19].Z = Point_1[19].Z + 5.0
   ENDIF
   IF Layer == 2 THEN
      Hight = 5.0
      FOR i = 1 TO 19      
         Point_1[i].Z = Hight
      ENDFOR
      Point_1[19].Z = Point_1[19].Z + 3.2
   ENDIF
   IF Layer == 3 THEN
      Hight = 8.2
      FOR i = 1 TO 19      
         Point_1[i].Z = Hight
      ENDFOR
      Point_1[19].Z = Point_1[19].Z + 2.8
   ENDIF
   IF Layer == 4 THEN
      Hight = 11.0
      FOR i = 1 TO 19      
         Point_1[i].Z = Hight
      ENDFOR
      Point_1[19].Z = Point_1[19].Z + 2.7
   ENDIF
   IF Layer >= 5 THEN
      Layer = Layer - 5
      Hight = 13.7
      FOR i = 1 TO 19
         Point_1[i].Z = Hight + (Pitch * Layer)
      ENDFOR
      Point_1[19].Z = Point_1[19].Z + Pitch
   ENDIF

;ENDFOLD

END

DEF HightClaculation(Layer:IN,Pitch:IN)
DECL INT i,Layer
DECL REAL Pitch,Hight

;FOLD Hight Calculation
   IF Layer == 1 THEN
      Hight = 5.0
      FOR i = 1 TO 19
         Point_1[i].Z = Hight
      ENDFOR
      Point_1[19].Z = Point_1[19].Z + 3.2
   ENDIF
   IF Layer == 2 THEN
      Hight = 8.2
      FOR i = 1 TO 19
         Point_1[i].Z = Hight
      ENDFOR
      Point_1[19].Z = Point_1[19].Z + 2.8
   ENDIF
   IF Layer == 3 THEN
      Hight = 11.0
      FOR i = 1 TO 19
         Point_1[i].Z = Hight
      ENDFOR
       Point_1[19].Z = Point_1[19].Z + 2.7
  ENDIF
   IF Layer >= 4 THEN
      Layer = Layer - 4
      Hight = 13.7
      FOR i = 1 TO 19
         Point_1[i].Z = Hight + (Pitch * Layer)
      ENDFOR
      Point_1[19].Z = Point_1[19].Z + Pitch
   ENDIF
;ENDFOLD

END


DEF WeldingAct(Type:IN,Layer:IN)
DECL Action Type
DECL INT Layer

;FOLD Welding Action
   SWITCH Type
      CASE #_ON
         IF Layer == 1 THEN
            TRIGGER WHEN DISTANCE = 1 DELAY = ArcGetDelay(#PreDefinition, WDAT1) DO ArcMainNG(#PreDefinition, WDAT1, WP1) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT1) DELAY = ArcGetDelay(#GasPreflow, WDAT1) DO ArcMainNG(#GasPreflow, WDAT1, WP1) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT1) DELAY = ArcGetDelay(#ArcPreOn, WDAT1) DO ArcMainNG(#ArcOnMoveStd, WDAT1, WP1) PRIO = -1 
            ArcMainNG(#ArcOnBeforeMoveStd, WDAT1, WP1)
            MotionPar(#CPmotion,WDAT1.Weld.Velocity)
            LIN $POS_ACT
            ArcMainNG(#ArcOnAfterMoveStd, WDAT1, WP1)
         ENDIF
         IF Layer == 2 THEN
            TRIGGER WHEN DISTANCE = 1 DELAY = ArcGetDelay(#PreDefinition, WDAT2) DO ArcMainNG(#PreDefinition, WDAT2, WP2) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT2) DELAY = ArcGetDelay(#GasPreflow, WDAT2) DO ArcMainNG(#GasPreflow, WDAT2, WP2) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT2) DELAY = ArcGetDelay(#ArcPreOn, WDAT2) DO ArcMainNG(#ArcOnMoveStd, WDAT2, WP2) PRIO = -1 
            ArcMainNG(#ArcOnBeforeMoveStd, WDAT2, WP2)
            MotionPar(#CPmotion,WDAT2.Weld.Velocity)
            LIN $POS_ACT
            ArcMainNG(#ArcOnAfterMoveStd, WDAT2, WP2)
         ENDIF
         IF Layer == 3 THEN
            TRIGGER WHEN DISTANCE = 1 DELAY = ArcGetDelay(#PreDefinition, WDAT3) DO ArcMainNG(#PreDefinition, WDAT3, WP3) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT3) DELAY = ArcGetDelay(#GasPreflow, WDAT3) DO ArcMainNG(#GasPreflow, WDAT3, WP3) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT3) DELAY = ArcGetDelay(#ArcPreOn, WDAT3) DO ArcMainNG(#ArcOnMoveStd, WDAT3, WP3) PRIO = -1 
            ArcMainNG(#ArcOnBeforeMoveStd, WDAT3, WP3)
            MotionPar(#CPmotion,WDAT3.Weld.Velocity)
            LIN $POS_ACT
            ArcMainNG(#ArcOnAfterMoveStd, WDAT3, WP3)
         ENDIF
         IF Layer == 4 THEN
            TRIGGER WHEN DISTANCE = 1 DELAY = ArcGetDelay(#PreDefinition, WDAT4) DO ArcMainNG(#PreDefinition, WDAT4, WP4) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT4) DELAY = ArcGetDelay(#GasPreflow, WDAT4) DO ArcMainNG(#GasPreflow, WDAT4, WP4) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT4) DELAY = ArcGetDelay(#ArcPreOn, WDAT4) DO ArcMainNG(#ArcOnMoveStd, WDAT4, WP4) PRIO = -1 
            ArcMainNG(#ArcOnBeforeMoveStd, WDAT4, WP4)
            MotionPar(#CPmotion,WDAT4.Weld.Velocity)
            LIN $POS_ACT
            ArcMainNG(#ArcOnAfterMoveStd, WDAT4, WP4)
         ENDIF
         IF Layer >= 5 THEN
            TRIGGER WHEN DISTANCE = 1 DELAY = ArcGetDelay(#PreDefinition, WDAT5) DO ArcMainNG(#PreDefinition, WDAT5, WP5) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT5) DELAY = ArcGetDelay(#GasPreflow, WDAT5) DO ArcMainNG(#GasPreflow, WDAT5, WP5) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT5) DELAY = ArcGetDelay(#ArcPreOn, WDAT5) DO ArcMainNG(#ArcOnMoveStd, WDAT5, WP5) PRIO = -1 
            ArcMainNG(#ArcOnBeforeMoveStd, WDAT5, WP5)
            MotionPar(#CPmotion,WDAT5.Weld.Velocity)
            LIN $POS_ACT
            ArcMainNG(#ArcOnAfterMoveStd, WDAT5, WP5)
         ENDIF
      CASE #_OFF
         IF (Layer >= 1) AND (Layer <= 4) THEN
            TRIGGER WHEN PATH = ArcGetPath(#ArcOffBefore, WDAT1) DELAY = 0 DO ArcMainNG(#ArcOffBeforeOffStd, WDAT1, WP1) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#ArcOffBefore2, WDAT1) DELAY = 0 DO ArcMainNG(#ArcOffBeforeOffStd2, WDAT1, WP1) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOff, WDAT1) DELAY = 0 DO ArcMainNG(#ArcOffMoveStd, WDAT1, WP1) PRIO = -1
            ArcMainNG(#ArcOffBeforeMoveStd, WDAT1, WP1)
            MotionPar(#CPmotion,WDAT1.Weld.Velocity)
            LIN $POS_ACT
            ArcMainNG(#ArcOffAfterMoveStd, WDAT1, WP1)
         ELSE
            TRIGGER WHEN PATH = ArcGetPath(#ArcOffBefore, WDAT5) DELAY = 0 DO ArcMainNG(#ArcOffBeforeOffStd, WDAT5, WP5) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#ArcOffBefore2, WDAT5) DELAY = 0 DO ArcMainNG(#ArcOffBeforeOffStd2, WDAT5, WP5) PRIO = -1
            TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOff, WDAT5) DELAY = 0 DO ArcMainNG(#ArcOffMoveStd, WDAT5, WP5) PRIO = -1
            ArcMainNG(#ArcOffBeforeMoveStd, WDAT5, WP5)
            MotionPar(#CPmotion,WDAT5.Weld.Velocity)
            LIN $POS_ACT
            ArcMainNG(#ArcOffAfterMoveStd, WDAT5, WP5)
         ENDIF
      DEFAULT
         HALT
   ENDSWITCH
;ENDFOLD

END

DEF JobSwitch(Layer:IN)
DECL INT Layer

;FOLD Welding Action
   IF Layer == 1 THEN
      TRIGGER WHEN DISTANCE = 1 DELAY = 0 DO ArcMainNG(#ArcSwiMoveStd, WDAT2, WP2) PRIO = -1
      ArcMainNG(#ArcSwiBeforeMoveStd, WDAT2, WP2)
      ArcMainNG(#ArcSwiAfterMoveStd, WDAT2, WP2)
      MotionPar(#CPmotion,WDAT2.Weld.Velocity)
   ENDIF
   IF Layer == 2 THEN
      TRIGGER WHEN DISTANCE = 1 DELAY = 0 DO ArcMainNG(#ArcSwiMoveStd, WDAT3, WP3) PRIO = -1
      ArcMainNG(#ArcSwiBeforeMoveStd, WDAT3, WP3)
      ArcMainNG(#ArcSwiAfterMoveStd, WDAT3, WP3)
      MotionPar(#CPmotion,WDAT3.Weld.Velocity)
   ENDIF
   IF Layer == 3 THEN
      TRIGGER WHEN DISTANCE = 1 DELAY = 0 DO ArcMainNG(#ArcSwiMoveStd, WDAT4, WP4) PRIO = -1
      ArcMainNG(#ArcSwiBeforeMoveStd, WDAT4, WP4)
      ArcMainNG(#ArcSwiAfterMoveStd, WDAT4, WP4)
      MotionPar(#CPmotion,WDAT4.Weld.Velocity)
   ENDIF
   IF Layer >= 4 THEN
      TRIGGER WHEN DISTANCE = 1 DELAY = 0 DO ArcMainNG(#ArcSwiMoveStd, WDAT5, WP5) PRIO = -1
      ArcMainNG(#ArcSwiBeforeMoveStd, WDAT5, WP5)
      ArcMainNG(#ArcSwiAfterMoveStd, WDAT5, WP5)
      MotionPar(#CPmotion,WDAT5.Weld.Velocity)
   ENDIF
;ENDFOLD

END