&ACCESS RVO
&REL 1
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\Program\Working
DEF WVDepositionRJ(Layer:IN,HightPitch:IN,Velocity:IN,SX:IN,SY:IN,SZ:IN)
DECL INT Layer
DECL REAL HightPitch,Velocity,SX,SY,SZ
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

PosCalc(Layer,HightPitch,SX,SY,SZ)
Velocity = VelocityCalc(Velocity)
MotionPar(#PTPmotion,10.0)
PTP $POS_ACT
MotionPar(#CPmotion,0.1)
LIN XHOVERX
LIN XAPRJPX
LIN Point[1]
oIsScanning = TRUE
WAIT SEC 1.0
WeldingAct(#_ON,Layer)
MotionPar(#CPmotion,Velocity)

