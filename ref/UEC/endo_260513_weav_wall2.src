&ACCESS RVP
&REL 154
DEF endo_260513_weav_wall2( )
DECL INT I,N,J,K
DECL REAL move_speed,updown_speed,TS,TS_cal,dwell_time,offset,bead_width,bead_length,pitch
DECL FRAME z_pitch,weld_xpyp01,weld_xpyp02,weld_xpym01,weld_xpym02,weld_xmym01,weld_xmym02,weld_xmyp01,weld_xmyp02
;FOLD INI
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

;VALUE
move_speed = 0.07 ; m/s
updown_speed = 0.01 ; m/s

;INPUT
TS = 4000 ;mm/min
bead_width = 7.5 ;mm
bead_length = 4 ;mm
N = 30

dwell_time = 90 ;s
pitch = 1.3 ;mm


;CALCULATION
TS_cal = TS / 60000 ;m/s

;CONVERT
z_pitch.Z = pitch
weld_xpyp01.X = bead_length / 4
weld_xpyp01.Y = bead_width
weld_xpyp02.X = bead_length / 2
weld_xpyp02.Y = bead_width * 2

weld_xpym01.X = bead_length / 4
weld_xpym01.Y = -1 * bead_width
weld_xpym02.X = bead_length / 2
weld_xpym02.Y = -1 * bead_width * 2

weld_xmyp01.X = -1 * bead_length / 4
weld_xmyp01.Y = bead_width
weld_xmyp02.X = -1 * bead_length / 2
weld_xmyp02.Y = bead_width * 2

weld_xmym01.X = -1 * bead_length / 4
weld_xmym01.Y = -1 * bead_width
weld_xmym02.X = -1 * bead_length / 2
weld_xmym02.Y = -1 * bead_width * 2

;FOLD PTP HOME2  Vel=3 % DEFAULT Tool[2] Base[3];%{PE}%R 8.3.22,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME2, 3:, 5:3, 7:DEFAULT
$BWDSTART=FALSE
PDAT_ACT=PDEFAULT
FDAT_ACT=FHOME2
BAS(#PTP_PARAMS,3)
PTP XHOME2 
;ENDFOLD
coordinate_ohta()
; T2&B4 CHECK!

;MOVE start

$VEL.CP = move_speed
LIN {X 21.46, Y 141.37}

LIN {Z 100}
$VEL.CP = updown_speed
LIN {Z 62.66}

FOR J = 1 TO 10
  
;WELDING 1st
  arcon_ohta()
  FOR I = 1 TO N
    $VEL.CP = TS_cal
    LIN_REL weld_xpyp01 C_SPL
    LIN_REL weld_xpym02 C_SPL
    LIN_REL weld_xpyp01 C_SPL
  ENDFOR 
  arcoff_ohta()

  
  WAIT SEC dwell_time
;WELDING 2nd
  LIN_REL z_pitch
  
  arcon_ohta()
  FOR I = 1 TO N
    $VEL.CP = TS_cal
    LIN_REL weld_xmyp01 C_SPL
    LIN_REL weld_xmym02 C_SPL
    LIN_REL weld_xmyp01 C_SPL
  ENDFOR
  arcoff_ohta()
  WAIT SEC dwell_time
  LIN_REL z_pitch
  

ENDFOR

;RETURN
$VEL.CP = updown_speed
LIN_REL {Z 50}
$VEL.CP = move_speed
LIN {Z 200}
;FOLD PTP HOME2  Vel=3 % DEFAULT Tool[2] Base[3];%{PE}%R 8.3.22,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME2, 3:, 5:3, 7:DEFAULT
$BWDSTART=FALSE
PDAT_ACT=PDEFAULT
FDAT_ACT=FHOME2
BAS(#PTP_PARAMS,3)
PTP XHOME2 
;ENDFOLDEND


END